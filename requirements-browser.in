# Top-level pins for the browser acceptance check (tools/_check_site_browser.py): the gate
# packages plus Playwright. requirements-browser.txt is the hash-pinned lock compiled from this
# file; edit here, then regenerate the lock (see its header). The Chromium build is the one this
# Playwright version downloads with `python -m playwright install --with-deps chromium`, so
# pinning Playwright pins the browser too.
-r requirements.in
playwright==1.63.0
