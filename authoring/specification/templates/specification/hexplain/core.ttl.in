# Hexplain Core Ontology 1.3 — vocabulary + SHACL shapes
# Properties declare rdfs:range; domain and cardinality are in SHACL (no rdfs:domain).
@prefix :         <https://hexplain.io/ns/core#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix bddo:     <https://hexplain.io/ns/bddo#> .
@prefix dlv:      <https://hexplain.io/ns/dlv#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix vann:     <http://purl.org/vocab/vann/> .

<https://hexplain.io/ns/core> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/core/1.3> ; owl:versionInfo "1.3" ;
    owl:priorVersion <https://hexplain.io/ns/core/1.2> ;
    dcterms:modified "2026-10-12"^^xsd:date ;
    owl:imports <https://hexplain.io/ns/bddo> , <https://hexplain.io/ns/dlv> ;
    rdfs:label "Hexplain Core Ontology"@en ;
    rdfs:comment "Properties linking the physical, layout, and semantic layers of the Hexplain framework."@en ;
    dcterms:created "2025-08-16"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "hexplain" ; vann:preferredNamespaceUri "https://hexplain.io/ns/core#" .

:MappingRule a owl:Class ; rdfs:label "Mapping Rule"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "A rule for conditionally mapping a physical field to a semantic property."@en .
:ClassMappingRule a owl:Class ; rdfs:label "Class Mapping Rule"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "A rule selecting the owl:Class a bddo:Struct represents based on a discriminator condition; used in a hexplain:hasConditionalClassMapping list to model tagged unions / variant records."@en .

# Mapping properties (values are class/property IRIs: RDFS + SHACL, OWL 2 Full; domain in SHACL). rdfs:range declared.
:mapsToClass a owl:ObjectProperty ; rdfs:label "maps to class"@en ; rdfs:range owl:Class ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "Relates a bddo:Struct to the owl:Class it physically represents."@en .
:mapsToProperty a owl:ObjectProperty ; rdfs:label "maps to property"@en ; rdfs:range rdf:Property ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "Relates a bddo:Field to the rdf:Property it supplies a value for."@en .
:hasDataLayout a owl:ObjectProperty ; rdfs:label "has data layout"@en ; rdfs:range dlv:DataLayout ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "Relates a bddo:Field to a dlv:DataLayout describing its multi-dimensional interpretation."@en .
:isEncodedWith a owl:ObjectProperty ; rdfs:label "is encoded with"@en ; rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The algorithm needed to interpret a data block, drawn from whichever codec or compression register the profile binds. A processor decodes the block, then re-parses the decoded bytes against the field's data type when it is a bddo:Struct."@en .
# ---------- Instance byte range ----------
# Asserted on a LIFTED RESOURCE by the Semantic Lifter's Processing Model, not declared by a
# profile: every instance the lifter mints carries the byte range it was read from whenever
# ExtractOptions.includeByteRange is enabled (the default), giving query-time functions a
# cheap path to a node's bytes without re-resolving the profile or re-parsing the asset.
:byteOffset a owl:DatatypeProperty ; rdfs:label "byte offset"@en ; rdfs:range xsd:nonNegativeInteger ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The zero-based byte offset, within its asset, of a lifted resource's physical extent."@en .
:byteLength a owl:DatatypeProperty ; rdfs:label "byte length"@en ; rdfs:range xsd:nonNegativeInteger ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The length in bytes, from hexplain:byteOffset, of a lifted resource's physical extent."@en .
# ---------- Encoding pipelines ----------
# One codec is the exception, not the rule. A TIFF strip is horizontally differenced and
# then deflated; an HDF5 dataset runs a filter pipeline (shuffle, then deflate); a Zarr
# array chains delta into Blosc, itself parameterised by an inner codec, a shuffle mode and
# a level; a Parquet page is dictionary- or run-length-encoded before Snappy. With a single
# unparameterised codec, all of these could say only the last step and lost both the earlier
# ones and every setting -- enough to identify the compression but never enough to undo it.
#
# ORDER IS ENCODE ORDER: the steps as the writer applied them, so a reader inverts them in
# REVERSE. Stating this matters, because a pipeline read the wrong way round is still a
# plausible-looking pipeline; TIFF's difference-then-deflate inverts to inflate-then-undifference.
:EncodingStep a owl:Class ; rdfs:label "Encoding Step"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "One stage of an encoding pipeline: a codec, plus the parameters it was applied with."@en .
:CodecParameter a owl:Class ; rdfs:label "Codec Parameter"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "A named setting of a codec. Deliberately a name/value pair rather than a fixed vocabulary: codec options are open-ended and vendor-specific, and enumerating them would date immediately."@en .
:hasEncodingStep a owl:ObjectProperty ; rdfs:label "has encoding step"@en ; rdfs:range rdf:List ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "Ordered rdf:List of EncodingStep, in the order the ENCODER applied them; a decoder inverts them in reverse. Mutually exclusive with hexplain:isEncodedWith, which remains the shorthand for a single unparameterised codec."@en .
:codec a owl:ObjectProperty ; rdfs:label "codec"@en ; rdfs:range skos:Concept ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The algorithm this step applies, drawn from whichever codec or compression register the profile binds -- the same registers hexplain:isEncodedWith draws on."@en ;
    skos:scopeNote "Use on a hexplain:EncodingStep of a physical description: the codec a PROCESSOR runs to decode a field's bytes. Not aenc:codec, which records on a lifted stream which codec its content is encoded with and runs nothing; a profile usually maps the one to the other."@en .
:codecParameter a owl:ObjectProperty ; rdfs:label "codec parameter"@en ; rdfs:range :CodecParameter ; rdfs:isDefinedBy <https://hexplain.io/ns/core> .
:parameterName a owl:DatatypeProperty ; rdfs:label "parameter name"@en ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The setting's name as the codec itself names it: \"clevel\", \"shuffle\", \"predictor\"."@en .
:parameterValue a owl:DatatypeProperty ; rdfs:label "parameter value"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The setting's value, as the literal the format carries. Left untyped: a level is an integer, a Blosc inner codec a string, a flag a boolean."@en .
:parameterExpression a owl:DatatypeProperty ; rdfs:label "parameter expression"@en ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "A HEL expression giving the parameter's value, evaluated in the field's struct context each time the step runs. Its result must be a value of the parameter's contract type and within its declared values, or the parse raises a Validation error (a result of the wrong HEL type is a Type / HEL error). Mutually exclusive with hexplain:parameterValue."@en .
:codecFromExpression a owl:DatatypeProperty ; rdfs:label "codec from expression"@en ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "Selects the step's codec at run time: a HEL expression, evaluated in the field's struct context, whose String result is the IRI of one of the step's hexplain:codecCandidates or that IRI's local name (a profile typically maps a wire code to it with a SKOS map). A result naming no candidate is a Validation error. Replaces hexplain:codec on the step and requires hexplain:codecCandidates."@en .
:codecCandidates a owl:ObjectProperty ; rdfs:label "codec candidates"@en ; rdfs:range rdf:List ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "Ordered rdf:List of hexplain:EncodingStep, one per codec the step's hexplain:codecFromExpression may select, each naming its codec with hexplain:codec and carrying its own parameters. Kind connectivity is checked per candidate: each candidate's kind must connect with the step before it and the step after it in the pipeline; candidates may be of different kinds. Load-time checks and code generation use exactly this set."@en .
:codecSessionScope a owl:ObjectProperty ; rdfs:label "codec session scope"@en ; rdfs:range bddo:SessionScope ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "Where the sessions of the field's session-keeping codecs live: bddo:PerInstance keeps one session per step for every decode of the field within one instance of its struct; bddo:PerLayout keeps one for the field across the whole parse. Absent, every decode starts a new session. A session never outlives the parse."@en .

# ---------- Codec contracts ----------
# A register concept names an algorithm; its contract says how every implementation, in every
# language, must behave: what it consumes and produces, which parameters it takes, whether it
# keeps state across blocks, which errors it may raise, and which vector suite proves it.
:CodecContract a owl:Class ; rdfs:label "Codec Contract"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The portable contract of an executable codec, stated on its register concept with hexplain:codecContract: its kind, parameters, session behaviour, the error categories it may raise, the contract version and the version of its normative vector suite in specification/codecs/<Name>/vectors/. A register concept without a contract is a catalogue entry that no processor is required to execute."@en .
:codecContract a owl:ObjectProperty ; rdfs:label "codec contract"@en ; rdfs:range :CodecContract ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The contract of the codec this register concept names. At most one per concept."@en .
:contractVersion a owl:DatatypeProperty ; rdfs:label "contract version"@en ; rdfs:range xsd:integer ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The contract's version, a positive integer. Adding an optional parameter increments it; removing a parameter or changing the meaning of one requires a new concept IRI."@en .
:vectorSuiteVersion a owl:DatatypeProperty ; rdfs:label "vector suite version"@en ; rdfs:range xsd:integer ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The suiteVersion of the codec's normative vector suite (specification/codecs/<Name>/vectors/manifest.json) that a conforming implementation passes."@en .
:CodecKind a owl:Class ; rdfs:label "Codec Kind"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "What a codec consumes and produces when it decodes: bytes, or samples (a typed sample array with its width, height, bands, sample type, byte order and bits per sample). One of the three individuals below."@en .
:BytesToBytes a owl:NamedIndividual, :CodecKind ; rdfs:label "bytes to bytes"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "Compression, shuffles, bit reversal, and predictors over serialized samples whose layout the parameters describe."@en .
:SamplesToSamples a owl:NamedIndividual, :CodecKind ; rdfs:label "samples to samples"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "Transforms of a typed sample array, such as colour conversions."@en .
:BytesToSamples a owl:NamedIndividual, :CodecKind ; rdfs:label "bytes to samples"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "Image codecs; the output reports its width, height, bands and sample type."@en .
:codecKind a owl:ObjectProperty ; rdfs:label "codec kind"@en ; rdfs:range :CodecKind ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The codec's kind. A pipeline whose adjacent steps' kinds do not connect is refused when the description is loaded."@en .
:keepsSession a owl:DatatypeProperty ; rdfs:label "keeps session"@en ; rdfs:range xsd:boolean ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "True when the codec keeps state across blocks (JPEG tables, a CCITT reference line across strips). The processor creates the session at a scope a later profile property declares, and passes it to every call."@en .
:encodes a owl:DatatypeProperty ; rdfs:label "encodes"@en ; rdfs:range xsd:boolean ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "True when the contract covers the encode direction as well as decode: the codec's normative vector suite then holds encode steps and at least one round trip (an encode step whose output the next decode step reads back to the encode step's input), and a writer may select the codec. Absent or false, the contract is decode-only: its suite holds no encode step, and a processor asked to encode with the codec raises an Unsupported error."@en .
:raisesCategory a owl:DatatypeProperty ; rdfs:label "raises category"@en ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "A Processing Model error category the codec may raise while it runs, by its conformance-suite notation: Validation, Checksum, Unsupported, ResourceLimit or Description (a parameter value the contract admits but the codec cannot act on, found only when the step runs)."@en .
:CodecParameterSpec a owl:Class ; rdfs:label "Codec Parameter Spec"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "One parameter a codec contract declares: its name, type, whether it is required, its default and the values it may take."@en .
:declaresParameter a owl:ObjectProperty ; rdfs:label "declares parameter"@en ; rdfs:range :CodecParameterSpec ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "A parameter of the contract. A step that names a parameter the contract does not declare, omits a required one, or gives a value outside the declared type or values is a Description error."@en .
:parameterKey a owl:DatatypeProperty ; rdfs:label "parameter key"@en ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The parameter's name, as a profile states it with hexplain:parameterName."@en .
:CodecParameterType a owl:Class ; rdfs:label "Codec Parameter Type"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The type of a codec parameter's value: one of the six individuals below. A list-valued parameter holds a list of values of this type."@en .
:IntegerParameterType a owl:NamedIndividual, :CodecParameterType ; rdfs:label "integer"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "An integer; a profile states it as an xsd:integer literal or a HEL Integer."@en .
:BooleanParameterType a owl:NamedIndividual, :CodecParameterType ; rdfs:label "boolean"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "A boolean; xsd:boolean or a HEL Boolean."@en .
:StringParameterType a owl:NamedIndividual, :CodecParameterType ; rdfs:label "string"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "A string; xsd:string or a HEL String."@en .
:BytesParameterType a owl:NamedIndividual, :CodecParameterType ; rdfs:label "bytes"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "A byte string; xsd:hexBinary or a HEL Bytes value (for example a field's raw bytes)."@en .
:IriParameterType a owl:NamedIndividual, :CodecParameterType ; rdfs:label "IRI"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "An IRI; an IRI node, or a HEL String holding an absolute IRI."@en .
:FloatParameterType a owl:NamedIndividual, :CodecParameterType ; rdfs:label "float"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "A binary64 number; xsd:decimal, xsd:double or xsd:integer, or a HEL Float or Integer."@en .
:parameterType a owl:ObjectProperty ; rdfs:label "parameter type"@en ; rdfs:range :CodecParameterType ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The type of the parameter's value."@en ;
    skos:scopeNote "Use exactly once on a hexplain:CodecParameterSpec, with one of the six hexplain:CodecParameterType individuals. Not bddo:parameterType, which types a parameterised Struct's bddo:Parameter with a HEL value type."@en .
:requiredParameter a owl:DatatypeProperty ; rdfs:label "required parameter"@en ; rdfs:range xsd:boolean ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "True when every step must state the parameter; false or absent otherwise."@en .
:listValued a owl:DatatypeProperty ; rdfs:label "list valued"@en ; rdfs:range xsd:boolean ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "True when the parameter takes an ordered list of values of its type (an rdf:List in a profile, a HEL list in an expression)."@en .
:listLength a owl:DatatypeProperty ; rdfs:label "list length"@en ; rdfs:range xsd:integer ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The exact number of items a list-valued parameter holds."@en .
:defaultValue a owl:DatatypeProperty ; rdfs:label "default value"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The value an optional parameter takes when a step omits it, as a literal of the parameter's type; for a list-valued parameter, one string of the items separated by single spaces."@en .
:minimumValue a owl:DatatypeProperty ; rdfs:label "minimum value"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The smallest value a numeric parameter (or each item of a numeric list) may take, as a numeric literal."@en .
:maximumValue a owl:DatatypeProperty ; rdfs:label "maximum value"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The largest value a numeric parameter (or each item of a numeric list) may take, as a numeric literal."@en .
:allowedValue a owl:DatatypeProperty ; rdfs:label "allowed value"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "One of the values the parameter (or each item of a list) may take. When stated, no other value is allowed."@en .

:hasConditionalMapping a owl:ObjectProperty ; rdfs:label "has conditional mapping"@en ; rdfs:range rdf:List ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> .
:condition a owl:DatatypeProperty ; rdfs:label "mapping condition"@en ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ; rdfs:seeAlso bddo:condition .
:semanticProperty a owl:ObjectProperty ; rdfs:label "semantic property"@en ; rdfs:range rdf:Property ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> .
:valueExpression a owl:DatatypeProperty ; rdfs:label "value expression"@en ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "A HEL expression computing the value to emit for the mapped property instead of the field's raw parsed value (e.g. fixed-point or unit scaling). Evaluated in the field's context."@en .
:valueDatatype a owl:ObjectProperty ; rdfs:label "value datatype"@en ; rdfs:range rdfs:Datatype ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The xsd datatype of a computed hexplain:valueExpression result; defaults to the natural datatype of the HEL result type."@en .

# Object-valued edges: the mapped triple's object is an IRI, not a literal.
:mapsToObjectProperty a owl:ObjectProperty ; rdfs:label "maps to object property"@en ; rdfs:range owl:ObjectProperty ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "Relates a bddo:Field to the owl:ObjectProperty whose object is an IRI rather than a literal: the resource minted for a nested Struct instance (when the field's bddo:dataType is a bddo:Struct) or the field's enumeration symbol IRI (when it carries a bddo:enumeration whose bddo:enumSymbol values are IRIs). Use hexplain:mapsToProperty for literal-valued fields and this property for IRI-valued edges, so that a described format yields a connected RDF graph rather than isolated literals."@en .

# Conditional class mapping (tagged unions / variant records).
:hasConditionalClassMapping a owl:ObjectProperty ; rdfs:label "has conditional class mapping"@en ; rdfs:range rdf:List ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "Ordered rdf:List of hexplain:ClassMappingRule on a bddo:Struct. The class the Struct maps to is the hexplain:semanticClass of the first rule whose hexplain:condition holds — modelling tagged unions and variant records, where a record's type depends on a discriminator field. Mutually exclusive with hexplain:mapsToClass."@en .
:semanticClass a owl:ObjectProperty ; rdfs:label "semantic class"@en ; rdfs:range owl:Class ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The owl:Class selected by a hexplain:ClassMappingRule when its condition holds."@en .

# Unit of measure and language tag annotations.
:unit a owl:ObjectProperty ; rdfs:label "unit"@en ;
    # rdfs:Resource, not skos:Concept: the range would type every QUDT unit (a qudt:Unit) and every
    # UCUM-based unit IRI a skos:Concept, which they are not. Widening the range removes an
    # inference; it invalidates nothing, and UnitShape still requires an IRI.
    rdfs:range rdfs:Resource ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The unit of measure of the quantity a bddo:Field carries, as the IRI of a unit: a QUDT unit (unit:SEC), a UCUM-based unit IRI, or a concept of a unit register a profile binds. Nothing is inferred about the unit's type. Annotation only: it records the physical unit of the emitted value and does not rescale it — use hexplain:valueExpression for numeric conversion."@en .
:language a owl:DatatypeProperty ; rdfs:label "language"@en ; rdfs:range xsd:language ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "A fixed BCP-47 language tag applied to the string literal emitted for a bddo:Field, producing a language-tagged literal. Mutually exclusive with hexplain:languageFromField."@en .
:languageFromField a owl:ObjectProperty ; rdfs:label "language from field"@en ; rdfs:range bddo:Field ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The bddo:Field whose parsed string value supplies the BCP-47 language tag for this field's emitted string literal, for formats that carry a text run's language in a sibling field. Mutually exclusive with hexplain:language."@en .

#################### Register bindings ####################
# A profile states which controlled register supplies the values of a property whose range is
# skos:Concept. Aspects deliberately do NOT import registers -- that absence is what makes a
# register swappable -- so the binding is declared here, per profile, and enforced by
# hexplain:RegisterBindingShape.
hexplain:RegisterBinding a owl:Class ; rdfs:label "register binding"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "A statement that one property draws its values from one controlled register."@en .
hexplain:usesRegister a owl:ObjectProperty ; rdfs:label "uses register"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ; rdfs:range hexplain:RegisterBinding ;
    rdfs:comment "Binds a property used by this profile to the register supplying its values."@en .
hexplain:forProperty a owl:ObjectProperty ; rdfs:label "for property"@en ; rdfs:range rdf:Property ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The property being bound."@en .
hexplain:register a owl:ObjectProperty ; rdfs:label "register"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:range skos:ConceptScheme ;
    rdfs:comment "The skos:ConceptScheme whose members are the permitted values."@en .

#################### Register lifecycle and cross-layer correspondence ####################
# A register concept is never deleted or reused: when policy retires or replaces it, the IRI
# stays resolvable with owl:deprecated true, a hexplain:status saying why, a skos:historyNote
# and, when a successor exists, dcterms:isReplacedBy (tools/test_register_lifecycle.py).
hexplain:RegisterStatus a owl:Class ; rdfs:label "Register Status"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The lifecycle state of a register entry (a concept, collection or scheme). Closed set: hexplain:statusValid, hexplain:statusDeprecated, hexplain:statusSuperseded."@en .
hexplain:statusValid a owl:NamedIndividual , hexplain:RegisterStatus ; rdfs:label "Valid"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The entry is current. An entry with no hexplain:status is valid unless it is owl:deprecated."@en .
hexplain:statusDeprecated a owl:NamedIndividual , hexplain:RegisterStatus ; rdfs:label "Deprecated"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The entry is retained for existing data but SHOULD NOT be used in new data; there is no single successor. It carries owl:deprecated true and a skos:historyNote."@en .
hexplain:statusSuperseded a owl:NamedIndividual , hexplain:RegisterStatus ; rdfs:label "Superseded"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The entry is retained for existing data and replaced by the entry or entries named with dcterms:isReplacedBy, which new data SHOULD use. It carries owl:deprecated true and a skos:historyNote."@en .
hexplain:status a owl:ObjectProperty ; rdfs:label "status"@en ; rdfs:range hexplain:RegisterStatus ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The lifecycle state of a register entry. Absent means valid for an entry that is not owl:deprecated."@en .
hexplain:correspondsTo a owl:AnnotationProperty ; rdfs:label "corresponds to"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "Links a register concept to the ontology individual that names the same thing in another layer (for example a checksum-register concept to the bddo:ChecksumAlgorithm individual a physical description uses). An annotation, not a SKOS mapping and not owl:sameAs: it asserts no equivalence between a concept and an individual and licenses no inference; tools use it to keep the two identifiers aligned."@en .

# ---------- SHACL ----------
hexplain:MapsToClassShape a sh:NodeShape ;
    sh:targetSubjectsOf hexplain:mapsToClass ;
    sh:message "hexplain:mapsToClass is declared on a bddo:Struct." ;
    sh:class bddo:Struct ;
    # OWL vocabularies type classes owl:Class; RDFS ones (schema.org, for one) type them rdfs:Class.
    sh:property [ sh:path hexplain:mapsToClass ; sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class owl:Class ] [ sh:class rdfs:Class ] ) ;
        sh:message "Each value of hexplain:mapsToClass is an IRI naming an instance of owl:Class or rdfs:Class." ] .
hexplain:MapsToPropertyShape a sh:NodeShape ;
    sh:targetSubjectsOf hexplain:mapsToProperty ;
    sh:message "hexplain:mapsToProperty is declared on a bddo:Field." ;
    sh:class bddo:Field ;
    sh:property [ sh:path hexplain:mapsToProperty ; sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class rdf:Property ] [ sh:class owl:DatatypeProperty ]
                [ sh:class owl:ObjectProperty ] [ sh:class owl:AnnotationProperty ] ) ;
        sh:message "Each value of hexplain:mapsToProperty is an IRI naming an instance of rdf:Property, owl:DatatypeProperty, owl:ObjectProperty or owl:AnnotationProperty." ] .
hexplain:HasDataLayoutShape a sh:NodeShape ;
    sh:targetSubjectsOf hexplain:hasDataLayout ;
    sh:message "hexplain:hasDataLayout is declared on a bddo:Field." ;
    sh:class bddo:Field ;
    sh:property [ sh:path hexplain:hasDataLayout ; sh:class dlv:DataLayout ; sh:maxCount 1 ;
        sh:message "hexplain:hasDataLayout takes at most one value; each is an instance of dlv:DataLayout." ] .
hexplain:IsEncodedWithShape a sh:NodeShape ;
    sh:targetSubjectsOf hexplain:isEncodedWith ;
    sh:message "A block is encoded one way: a single hexplain:isEncodedWith codec or a hexplain:hasEncodingStep pipeline, never both." ;
    sh:property [ sh:path hexplain:isEncodedWith ; sh:nodeKind sh:IRI ; sh:class skos:Concept ; sh:maxCount 1 ;
        sh:message "hexplain:isEncodedWith takes at most one value; each is an IRI naming an instance of skos:Concept." ] ;
    # A block is encoded one way or the other: a single shorthand codec, or a pipeline.
    sh:not [ sh:and ( [ sh:property [ sh:path hexplain:isEncodedWith ; sh:minCount 1 ] ]
                      [ sh:property [ sh:path hexplain:hasEncodingStep ; sh:minCount 1 ] ] ) ] .

hexplain:EncodingPipelineShape a sh:NodeShape ;
    sh:targetSubjectsOf hexplain:hasEncodingStep ;
    sh:property [ sh:path hexplain:hasEncodingStep ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "hexplain:hasEncodingStep must point to a single rdf:List." ] ;
    sh:property [ sh:path ( hexplain:hasEncodingStep [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:class hexplain:EncodingStep ;
        sh:message "Every member of a hasEncodingStep list must be a hexplain:EncodingStep." ] .

hexplain:EncodingStepShape a sh:NodeShape ;
    sh:targetClass hexplain:EncodingStep ;
    sh:targetSubjectsOf hexplain:codec , hexplain:codecParameter , hexplain:codecFromExpression ;
    sh:message "An encoding step names its codec with hexplain:codec or selects one with hexplain:codecFromExpression, never both and never neither." ;
    # A step names its codec, or selects it at run time -- never both, never neither.
    sh:xone ( [ sh:property [ sh:path hexplain:codec ; sh:minCount 1 ] ]
              [ sh:property [ sh:path hexplain:codecFromExpression ; sh:minCount 1 ] ] ) ;
    sh:property [ sh:path hexplain:codec ; sh:nodeKind sh:IRI ; sh:class skos:Concept ; sh:maxCount 1 ;
        sh:message "An encoding step names at most one codec, a skos:Concept IRI; it names one with hexplain:codec or selects one with hexplain:codecFromExpression, never both and never neither." ] ;
    sh:property [ sh:path hexplain:codecParameter ; sh:class hexplain:CodecParameter ;
        sh:message "Each value of hexplain:codecParameter is an instance of hexplain:CodecParameter." ] .

hexplain:CodecSelectionShape a sh:NodeShape ;
    sh:targetSubjectsOf hexplain:codecFromExpression , hexplain:codecCandidates ;
    sh:property [ sh:path hexplain:codecFromExpression ; sh:or ( [ sh:datatype xsd:string ] [ sh:datatype bddo:HelExpression ] ) ; sh:maxCount 1 ;
        sh:message "hexplain:codecFromExpression takes at most one value, a HEL expression, an xsd:string or bddo:HelExpression literal." ] ;
    sh:property [ sh:path hexplain:codecCandidates ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "A step that selects its codec at run time lists its candidates in one hexplain:codecCandidates list." ] ;
    sh:property [ sh:path ( hexplain:codecCandidates [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:class hexplain:EncodingStep ;
        sh:message "Every candidate is a hexplain:EncodingStep." ] ;
    # A selecting step carries no parameters of its own; parameters belong to the candidate steps.
    sh:property [ sh:path hexplain:codecParameter ; sh:maxCount 0 ;
        sh:message "A step that selects its codec at run time carries no hexplain:codecParameter; parameters belong to the candidate steps." ] .

# A parameter without both halves says nothing; its value is a literal or an expression.
hexplain:CodecParameterShape a sh:NodeShape ;
    sh:targetClass hexplain:CodecParameter ;
    sh:message "A codec parameter states its value exactly one way: hexplain:parameterValue or hexplain:parameterExpression." ;
    sh:targetObjectsOf hexplain:codecParameter ;
    sh:targetSubjectsOf hexplain:parameterName , hexplain:parameterValue , hexplain:parameterExpression ;
    sh:property [ sh:path hexplain:parameterName ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "hexplain:parameterName takes exactly one value, an xsd:string literal." ] ;
    sh:xone ( [ sh:property [ sh:path hexplain:parameterValue ; sh:minCount 1 ] ]
              [ sh:property [ sh:path hexplain:parameterExpression ; sh:minCount 1 ] ] ) ;
    sh:property [ sh:path hexplain:parameterValue ; sh:maxCount 1 ;
        sh:message "hexplain:parameterValue takes at most one value; a parameter states exactly one of hexplain:parameterValue and hexplain:parameterExpression." ] ;
    sh:property [ sh:path hexplain:parameterExpression ; sh:or ( [ sh:datatype xsd:string ] [ sh:datatype bddo:HelExpression ] ) ; sh:maxCount 1 ;
        sh:message "hexplain:parameterExpression takes at most one value, a HEL expression, an xsd:string or bddo:HelExpression literal." ] .

hexplain:CodecSessionScopeShape a sh:NodeShape ;
    sh:targetSubjectsOf hexplain:codecSessionScope ;
    sh:message "hexplain:codecSessionScope is declared on a bddo:Field." ;
    sh:class bddo:Field ;
    sh:property [ sh:path hexplain:codecSessionScope ; sh:maxCount 1 ; sh:in ( bddo:PerInstance bddo:PerLayout ) ;
        sh:message "hexplain:codecSessionScope is bddo:PerInstance or bddo:PerLayout, at most once." ] .

# ---------- Codec contract shapes ----------
hexplain:CodecContractBindingShape a sh:NodeShape ;
    sh:targetSubjectsOf hexplain:codecContract ;
    sh:message "hexplain:codecContract is declared on a register concept (a skos:Concept)." ;
    sh:class skos:Concept ;
    sh:property [ sh:path hexplain:codecContract ; sh:maxCount 1 ; sh:class hexplain:CodecContract ;
        sh:message "A register concept states at most one hexplain:codecContract, and it is a hexplain:CodecContract." ] .

hexplain:CodecContractShape a sh:NodeShape ;
    sh:targetClass hexplain:CodecContract ;
    sh:targetSubjectsOf hexplain:contractVersion , hexplain:vectorSuiteVersion , hexplain:codecKind ,
        hexplain:keepsSession , hexplain:encodes , hexplain:raisesCategory , hexplain:declaresParameter ;
    sh:property [ sh:path hexplain:contractVersion ; sh:datatype xsd:integer ; sh:minInclusive 1 ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A codec contract states exactly one hexplain:contractVersion, a positive integer." ] ;
    sh:property [ sh:path hexplain:vectorSuiteVersion ; sh:datatype xsd:integer ; sh:minInclusive 1 ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A codec contract states exactly one hexplain:vectorSuiteVersion, a positive integer." ] ;
    sh:property [ sh:path hexplain:codecKind ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( hexplain:BytesToBytes hexplain:SamplesToSamples hexplain:BytesToSamples ) ;
        sh:message "A codec contract states exactly one hexplain:codecKind." ] ;
    sh:property [ sh:path hexplain:keepsSession ; sh:datatype xsd:boolean ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A codec contract states hexplain:keepsSession once, as a boolean." ] ;
    sh:property [ sh:path hexplain:encodes ; sh:datatype xsd:boolean ; sh:maxCount 1 ;
        sh:message "hexplain:encodes takes at most one value, an xsd:boolean literal." ] ;
    sh:property [ sh:path hexplain:raisesCategory ; sh:datatype xsd:string ;
        sh:in ( "Validation" "Checksum" "Unsupported" "ResourceLimit" "Description" ) ;
        sh:message "hexplain:raisesCategory is one of Validation, Checksum, Unsupported, ResourceLimit and Description." ] ;
    sh:property [ sh:path hexplain:declaresParameter ; sh:class hexplain:CodecParameterSpec ;
        sh:message "Every hexplain:declaresParameter value is a hexplain:CodecParameterSpec." ] .

hexplain:CodecParameterSpecShape a sh:NodeShape ;
    sh:targetClass hexplain:CodecParameterSpec ;
    sh:targetSubjectsOf hexplain:parameterKey , hexplain:parameterType , hexplain:requiredParameter ,
        hexplain:listValued , hexplain:listLength , hexplain:defaultValue , hexplain:minimumValue ,
        hexplain:maximumValue , hexplain:allowedValue ;
    sh:property [ sh:path hexplain:parameterKey ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A codec parameter spec states exactly one hexplain:parameterKey, an xsd:string literal." ] ;
    sh:property [ sh:path hexplain:parameterType ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( hexplain:IntegerParameterType hexplain:BooleanParameterType hexplain:StringParameterType
                hexplain:BytesParameterType hexplain:IriParameterType hexplain:FloatParameterType ) ;
        sh:message "A codec parameter spec states exactly one hexplain:parameterType, one of the six hexplain:CodecParameterType individuals." ] ;
    sh:property [ sh:path hexplain:requiredParameter ; sh:datatype xsd:boolean ; sh:maxCount 1 ;
        sh:message "hexplain:requiredParameter takes at most one value, an xsd:boolean literal." ] ;
    sh:property [ sh:path hexplain:listValued ; sh:datatype xsd:boolean ; sh:maxCount 1 ;
        sh:message "hexplain:listValued takes at most one value, an xsd:boolean literal." ] ;
    sh:property [ sh:path hexplain:listLength ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxCount 1 ;
        sh:message "hexplain:listLength takes at most one value, an xsd:integer of at least 1." ] ;
    sh:property [ sh:path hexplain:defaultValue ; sh:nodeKind sh:Literal ; sh:maxCount 1 ;
        sh:message "hexplain:defaultValue takes at most one value, a literal." ] ;
    sh:property [ sh:path hexplain:minimumValue ; sh:nodeKind sh:Literal ; sh:maxCount 1 ;
        sh:message "hexplain:minimumValue takes at most one value, a literal." ] ;
    sh:property [ sh:path hexplain:maximumValue ; sh:nodeKind sh:Literal ; sh:maxCount 1 ;
        sh:message "hexplain:maximumValue takes at most one value, a literal." ] ;
    sh:property [ sh:path hexplain:allowedValue ; sh:nodeKind sh:Literal ;
        sh:message "Each value of hexplain:allowedValue is a literal." ] .

hexplain:ValueExpressionShape a sh:NodeShape ;
    sh:targetSubjectsOf hexplain:valueExpression, hexplain:valueDatatype ;
    # A Field computes one value; a MappingRule computes the value for the arm it belongs to.
    # The second was rejected until now, which made conditional mapping able to choose the
    # PROPERTY per condition but never the VALUE -- so a field meaning different things under
    # different discriminators could name the right property and then emit the raw bytes into
    # it. NITF's IGEOLO is the case: 60 characters that are decimal degrees, degrees-minutes-
    # seconds, UTM or MGRS depending on ICORDS, and only the first two are even the same
    # quantity.
    sh:message "hexplain:valueExpression and hexplain:valueDatatype are declared on a bddo:Field or a hexplain:MappingRule." ;
    sh:or ( [ sh:class bddo:Field ] [ sh:class hexplain:MappingRule ] ) ;
    sh:property {{constraint:pattern_227}} ;
    sh:property {{constraint:pattern_226}} .
hexplain:HasConditionalMappingShape a sh:NodeShape ;
    sh:targetSubjectsOf hexplain:hasConditionalMapping ;
    sh:message "hexplain:hasConditionalMapping is declared on a bddo:Field." ;
    sh:class bddo:Field ;
    sh:property [ sh:path ( hexplain:hasConditionalMapping [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:class hexplain:MappingRule ;
        sh:message "Every member of a hasConditionalMapping list must be a hexplain:MappingRule." ] .
hexplain:MappingRuleShape a sh:NodeShape ;
    sh:targetClass hexplain:MappingRule ;
    sh:property {{constraint:pattern_214}} ;
    sh:property [ sh:path hexplain:semanticProperty ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:or ( [ sh:class rdf:Property ] [ sh:class owl:DatatypeProperty ]
                [ sh:class owl:ObjectProperty ] [ sh:class owl:AnnotationProperty ] ) ;
        sh:message "hexplain:semanticProperty takes exactly one value, an IRI naming an instance of rdf:Property, owl:DatatypeProperty, owl:ObjectProperty or owl:AnnotationProperty." ] ;
    # Optional: absent means the arm emits the field's parsed value unchanged.
    sh:property {{constraint:pattern_227}} ;
    sh:property {{constraint:pattern_226}} .
hexplain:MapsToObjectPropertyShape a sh:NodeShape ;
    sh:targetSubjectsOf hexplain:mapsToObjectProperty ;
    sh:message "hexplain:mapsToObjectProperty is declared on a bddo:Field." ;
    sh:class bddo:Field ;
    sh:property [ sh:path hexplain:mapsToObjectProperty ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:or ( [ sh:class rdf:Property ] [ sh:class owl:ObjectProperty ] ) ;
        sh:message "hexplain:mapsToObjectProperty takes at most one value; each is an IRI naming an instance of rdf:Property or owl:ObjectProperty." ] .
hexplain:HasConditionalClassMappingShape a sh:NodeShape ;
    sh:targetSubjectsOf hexplain:hasConditionalClassMapping ;
    sh:message "hexplain:hasConditionalClassMapping is declared on a bddo:Struct." ;
    sh:class bddo:Struct ;
    sh:property [ sh:path hexplain:mapsToClass ; sh:maxCount 0 ;
        sh:message "hexplain:mapsToClass and hexplain:hasConditionalClassMapping are mutually exclusive." ] ;
    sh:property [ sh:path ( hexplain:hasConditionalClassMapping [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:class hexplain:ClassMappingRule ;
        sh:message "Every member of a hasConditionalClassMapping list must be a hexplain:ClassMappingRule." ] .
hexplain:ClassMappingRuleShape a sh:NodeShape ;
    sh:targetClass hexplain:ClassMappingRule ;
    sh:property {{constraint:pattern_214}} ;
    # As for hexplain:mapsToClass: OWL vocabularies type classes owl:Class, RDFS ones (schema.org)
    # rdfs:Class, and a conditional class mapping may choose either.
    sh:property [ sh:path hexplain:semanticClass ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:or ( [ sh:class owl:Class ] [ sh:class rdfs:Class ] ) ;
        sh:message "hexplain:semanticClass takes exactly one value, an IRI naming an instance of owl:Class or rdfs:Class." ] .
hexplain:UnitShape a sh:NodeShape ;
    sh:targetSubjectsOf hexplain:unit ;
    sh:message "hexplain:unit is declared on a bddo:Field." ;
    sh:class bddo:Field ;
    sh:property [ sh:path hexplain:unit ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:message "hexplain:unit takes at most one value; each is an IRI." ] .
hexplain:LanguageShape a sh:NodeShape ;
    sh:targetSubjectsOf hexplain:language ;
    sh:message "hexplain:language is declared on a bddo:Field." ;
    sh:class bddo:Field ;
    sh:property [ sh:path hexplain:language ; sh:datatype xsd:language ; sh:maxCount 1 ;
        sh:message "hexplain:language takes at most one value; each is an xsd:language literal." ] ;
    sh:property [ sh:path hexplain:languageFromField ; sh:maxCount 0 ;
        sh:message "hexplain:language and hexplain:languageFromField are mutually exclusive." ] .
hexplain:LanguageFromFieldShape a sh:NodeShape ;
    sh:targetSubjectsOf hexplain:languageFromField ;
    sh:message "hexplain:languageFromField is declared on a bddo:Field." ;
    sh:class bddo:Field ;
    sh:property [ sh:path hexplain:languageFromField ; sh:class bddo:Field ; sh:maxCount 1 ;
        sh:message "hexplain:languageFromField takes at most one value; each is an instance of bddo:Field." ] .

hexplain:_prefixes sh:declare
    [ sh:prefix "hexplain" ; sh:namespace "https://hexplain.io/ns/core#"^^xsd:anyURI ] ,
    [ sh:prefix "skos" ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ] ,
    [ sh:prefix "owl" ; sh:namespace "http://www.w3.org/2002/07/owl#"^^xsd:anyURI ] .

# One shape enforces EVERY hexplain:usesRegister declaration, so adding a binding needs no new
# shape and no generated artifact. Targets exactly those nodes that use a bound property.
# Bindings are read together: a property bound more than once (one binding per register, as a
# property drawing from several schemes is) accepts a member of ANY scheme bound to it. Checking
# each binding on its own rejected every valid value once a graph held a US and a NATO binding
# for one marking property.
hexplain:RegisterBindingShape a sh:NodeShape ;
    rdfs:label "Register binding shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "A value of a property that a hexplain:RegisterBinding binds is skos:inScheme at least one of the registers bound to that property."@en ;
    sh:target [ a sh:SPARQLTarget ;
        sh:prefixes hexplain:_prefixes ;
        sh:select """SELECT DISTINCT ?this WHERE {
            ?binding hexplain:forProperty ?p .
            ?this ?p ?v .
        }""" ] ;
    sh:sparql [
        sh:message "Value {?value} of {?p} is in none of the registers bound to {?p}." ;
        sh:prefixes hexplain:_prefixes ;
        sh:select """SELECT DISTINCT $this ?p ?value WHERE {
            ?binding hexplain:forProperty ?p .
            $this ?p ?value .
            FILTER NOT EXISTS {
                ?any hexplain:forProperty ?p ; hexplain:register ?scheme .
                ?value skos:inScheme ?scheme .
            }
        }""" ] .

# A retired register value stays legal -- data written before the policy changed keeps its
# meaning -- but new data should not use it, so its use is reported, as a warning.
hexplain:RegisterDeprecatedValueShape a sh:NodeShape ;
    rdfs:label "Register deprecated value shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "A value of a bound property that is an owl:deprecated register entry is reported at sh:Warning, naming its replacement when it has one."@en ;
    sh:severity sh:Warning ;
    sh:target [ a sh:SPARQLTarget ;
        sh:prefixes hexplain:_prefixes ;
        sh:select """SELECT DISTINCT ?this WHERE {
            ?binding hexplain:forProperty ?p .
            ?this ?p ?v .
        }""" ] ;
    sh:sparql [
        sh:message "Value {?value} of {?p} is a deprecated register entry; new data should use its replacement ({?next}), if any." ;
        sh:prefixes hexplain:_prefixes ;
        sh:select """SELECT DISTINCT $this ?p ?value ?next WHERE {
            ?binding hexplain:forProperty ?p .
            $this ?p ?value .
            ?value owl:deprecated true .
            OPTIONAL { ?value <http://purl.org/dc/terms/isReplacedBy> ?next }
        }""" ] .

hexplain:RegisterStatusShape a sh:NodeShape ; rdfs:label "Register status shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "A register entry states at most one lifecycle status from the closed set; a deprecated or superseded entry is owl:deprecated true, a valid one is not, and a superseded entry names its successor."@en ;
    sh:targetSubjectsOf hexplain:status ;
    sh:property [ sh:path hexplain:status ; sh:maxCount 1 ;
        sh:in ( hexplain:statusValid hexplain:statusDeprecated hexplain:statusSuperseded ) ;
        sh:message "hexplain:status is one of hexplain:statusValid, hexplain:statusDeprecated or hexplain:statusSuperseded, at most once." ] ;
    sh:or (
        [ sh:property [ sh:path hexplain:status ; sh:hasValue hexplain:statusValid ] ]
        [ sh:property [ sh:path owl:deprecated ; sh:hasValue true ] ] ) ;
    sh:message "A deprecated or superseded register entry must carry owl:deprecated true." ;
    sh:sparql [
        sh:message "A register entry with hexplain:statusValid must not be owl:deprecated true." ;
        sh:prefixes hexplain:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this hexplain:status hexplain:statusValid ; owl:deprecated true .
        }""" ] ;
    sh:sparql [
        sh:message "A superseded register entry must name its successor with dcterms:isReplacedBy." ;
        sh:prefixes hexplain:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this hexplain:status hexplain:statusSuperseded .
            FILTER NOT EXISTS { $this <http://purl.org/dc/terms/isReplacedBy> ?next }
        }""" ] .

# Every deprecated register entry -- concept, scheme or collection -- carries the whole lifecycle
# record that tools/test_register_lifecycle.py checks: a retired status, a history or change note,
# and, when replaced, a successor other than itself that is not itself retired. Activated by
# owl:deprecated, so an entry that states no status at all is checked too; plain SHACL, with no
# SPARQL-based target, so every SHACL Core validator applies it. An ontology term that is
# owl:deprecated (a class or property) is not a register entry and passes the first alternative.
hexplain:RegisterLifecycleShape a sh:NodeShape ; rdfs:label "Register lifecycle shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "A deprecated register entry states hexplain:statusDeprecated or hexplain:statusSuperseded, a skos:historyNote or skos:changeNote, and replacements that are neither itself nor deprecated."@en ;
    sh:targetSubjectsOf owl:deprecated ;
    sh:or (
        [ sh:not [ sh:property [ sh:path owl:deprecated ; sh:hasValue true ] ] ]
        [ sh:not [ sh:or ( [ sh:class skos:Concept ] [ sh:class skos:ConceptScheme ] [ sh:class skos:Collection ]
                           [ sh:class skos:OrderedCollection ]
                           [ sh:property [ sh:path skos:inScheme ; sh:minCount 1 ] ] ) ] ]
        [ sh:property [ sh:path hexplain:status ; sh:minCount 1 ;
                        sh:in ( hexplain:statusDeprecated hexplain:statusSuperseded ) ] ;
          sh:or ( [ sh:property [ sh:path skos:historyNote ; sh:minCount 1 ] ]
                  [ sh:property [ sh:path skos:changeNote ; sh:minCount 1 ] ] ) ] ) ;
    sh:message "A deprecated register entry states hexplain:status hexplain:statusDeprecated or hexplain:statusSuperseded, and says what changed in a skos:historyNote or skos:changeNote." ;
    sh:sparql [
        sh:message "A register entry is not replaced by itself." ;
        sh:prefixes hexplain:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this <http://purl.org/dc/terms/isReplacedBy> $this .
        }""" ] ;
    sh:sparql [
        sh:message "Register entry {?next}, which replaces this one, is itself deprecated; name a current entry." ;
        sh:prefixes hexplain:_prefixes ;
        sh:select """SELECT $this ?next WHERE {
            $this <http://purl.org/dc/terms/isReplacedBy> ?next .
            FILTER(!sameTerm(?next, $this))
            ?next owl:deprecated true .
        }""" ] .

# ---------- Range datatype shapes ----------
# Each XSD rdfs:range above, enforced wherever the property is used: activation is by
# subjects-of, so an untyped subject is checked too (tools/test_range_datatypes.py).
# Integer ranges accept any XSD integer-family datatype within the range's bounds.
hexplain:IntegerValueShape a sh:NodeShape ; rdfs:label "Integer value shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    sh:message "An integer value is a literal of an XSD integer-family datatype (xsd:integer, xsd:positiveInteger, xsd:nonNegativeInteger, xsd:int, xsd:long, xsd:unsignedInt, xsd:unsignedLong, xsd:short, xsd:unsignedShort, xsd:byte or xsd:unsignedByte)." ;
    {{constraint:pattern_237}} .
hexplain:RangeDatatypeShape a sh:NodeShape ; rdfs:label "Range datatype shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    sh:targetSubjectsOf hexplain:byteLength ,
        hexplain:byteOffset ,
        hexplain:condition ,
        hexplain:parameterName ;
    sh:property [ sh:path hexplain:byteLength ; sh:node hexplain:IntegerValueShape ; sh:minInclusive 0 ;
        sh:message "hexplain:byteLength takes a non-negative integer (rdfs:range xsd:nonNegativeInteger)." ] ;
    sh:property [ sh:path hexplain:byteOffset ; sh:node hexplain:IntegerValueShape ; sh:minInclusive 0 ;
        sh:message "hexplain:byteOffset takes a non-negative integer (rdfs:range xsd:nonNegativeInteger)." ] ;
    sh:property [ sh:path hexplain:condition ; sh:or ( [ sh:datatype xsd:string ] [ sh:datatype bddo:HelExpression ] ) ;
        sh:message "hexplain:condition takes a HEL expression, an xsd:string or bddo:HelExpression literal (rdfs:range xsd:string)." ] ;
    sh:property [ sh:path hexplain:parameterName ; sh:datatype xsd:string ;
        sh:message "hexplain:parameterName takes an xsd:string literal (rdfs:range xsd:string)." ] .

# ---------- Term ownership ----------
# rdfs:isDefinedBy for the terms whose declaration above does not state it. A new term states
# its own; tools/test_term_reference.py requires it of every term this file defines.
