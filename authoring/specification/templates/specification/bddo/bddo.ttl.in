# Binary Data Description Ontology (BDDO) 1.3 — vocabulary + SHACL shapes
# Canonical machine-readable artifact. Namespace: https://hexplain.io/ns/bddo#
# Modeling: properties declare rdfs:range (value type). Domain and cardinality
# are expressed in SHACL only (no rdfs:domain), to avoid over-committing subjects.
@prefix :       <https://hexplain.io/ns/bddo#> .
@prefix bddo:   <https://hexplain.io/ns/bddo#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix vann:   <http://purl.org/vocab/vann/> .

<https://hexplain.io/ns/bddo> a owl:Ontology ;
    rdfs:seeAlso <https://hexplain.io/specification/bddo/bddo-doc.ttl> ;
    owl:versionIRI <https://hexplain.io/ns/bddo/1.3> ;
    owl:versionInfo "1.3" ;
    owl:priorVersion <https://hexplain.io/ns/bddo/1.2> ;
    dcterms:modified "2026-10-13"^^xsd:date ;
    rdfs:label "Binary Data Description Ontology (BDDO)"@en ;
    rdfs:comment "Vocabulary for declaratively describing the physical structure of binary data."@en ;
    dcterms:created "2025-08-16"^^xsd:date ;
    dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "bddo" ;
    vann:preferredNamespaceUri "https://hexplain.io/ns/bddo#" .

# ---------- Classes ----------
:Struct       a owl:Class ; rdfs:label "Struct"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "An ordered sequence of fields; a container in a binary format."@en .
:Field        a owl:Class ; rdfs:label "Field"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "A single element within a Struct: a value, a bit slice, or an array."@en ;
    skos:scopeNote "A physical field: a run of bytes or bits located by a Struct's member list. Not atab:Field, which is a typed column of a tabular schema after parsing; a bddo:Field that carries a column's bytes names that column through its semantic mapping."@en .
:DataType     a owl:Class ; rdfs:label "Data Type"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> .
:DataTypeRule a owl:Class ; rdfs:label "Data Type Rule"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> .
:Enumeration  a owl:Class ; rdfs:label "Enumeration"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> .
:EnumValue    a owl:Class ; rdfs:label "Enumeration Value"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> .
:Checksum     a owl:Class ; rdfs:label "Checksum"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "A checksum/hash over a byte range. Each END of the range is stated independently: a field reference (coversFromField/coversToField) or a HEL expression yielding a byte offset (coversFromExpression/coversToExpression). The two ends may use different mechanisms -- a checksum covering everything from a named header field to a length carried elsewhere needs exactly that. Note the boundary convention differs by mechanism, because each follows what its inputs naturally give: the field form runs from the FIRST byte of coversFromField to the LAST byte of coversToField (inclusive), while the expression form is the half-open [start,end) that the two offsets delimit."@en .
:EndiannessRule a owl:Class ; rdfs:label "Endianness Rule"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "One arm of a hasConditionalEndianness list: a HEL condition and the byte order it selects."@en .
:DispatchTable a owl:Class ; rdfs:label "Dispatch Table"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "A keyed, open selection of a Field's effective type. The value of the key (dispatchOnField or dispatchOnExpression) is matched by equality against the armKey of the table's DispatchArms; the matching arm's armDataType is the effective type, else dispatchDefault, else the Field's dataType. Arms are independent resources rather than list members, so a description that imports this one can contribute an arm without rewriting anything. Contrast hasConditionalDataType, whose ordered predicate rules are closed and may overlap."@en .
:DispatchArm a owl:Class ; rdfs:label "Dispatch Arm"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "One key-to-type association of a DispatchTable: the type a field takes when the table's key equals armKey. Keys are unique within a table across every graph that contributes to it."@en .
:SeekScope a owl:Class ; rdfs:label "Seek Scope"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "How far an offset-addressed read may reach: the innermost bounded region (the default, regionScope) or the whole stream (streamScope)."@en .
# A struct that is instantiated with values: the same row layout used for several widths, or a
# record whose element count is carried by the struct that holds it. Parameters are named like
# fields (by the simple key of their IRI) and read in HEL through the root `param`.
:Parameter a owl:Class ; rdfs:label "Parameter"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "One formal parameter of a parameterised Struct, a member of its bddo:hasParameter list. Its name is the simple key of its IRI (the local name after the last '.'), as for a Field; HEL reads the value the caller supplied as param.<name>. A parameter consumes no bytes, is not a field of the parsed tree and is never lifted."@en .
# A named intermediate value, computed once where it stands in the member list. It is a member
# of hasField (so its position, and therefore what it may read and what may read it, is the
# list order) but not a field: it consumes no bytes and is neither in the parsed tree nor lifted.
:ParameterType a owl:Class ; rdfs:label "Parameter Type"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The kind of HEL value a Parameter accepts: one of the five individuals below, one per HEL scalar value type."@en .
:IntegerParameter a owl:NamedIndividual, :ParameterType ; rdfs:label "Integer parameter"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The parameter accepts a HEL Integer."@en .
:FloatParameter a owl:NamedIndividual, :ParameterType ; rdfs:label "Float parameter"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The parameter accepts a HEL Float; an Integer argument is converted to the Float of the same value."@en .
:StringParameter a owl:NamedIndividual, :ParameterType ; rdfs:label "String parameter"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The parameter accepts a HEL String."@en .
:BytesParameter a owl:NamedIndividual, :ParameterType ; rdfs:label "Bytes parameter"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The parameter accepts a HEL Bytes value."@en .
:BooleanParameter a owl:NamedIndividual, :ParameterType ; rdfs:label "Boolean parameter"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The parameter accepts a HEL Boolean."@en .
# Where a session-keeping codec's state lives (hexplain:codecSessionScope).
:SessionScope a owl:Class ; rdfs:label "Session Scope"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "Where a field's session-keeping codecs keep their state across decodes: one of the two individuals below. The individuals are closed by hexplain:CodecSessionScopeShape."@en .
:PerInstance a owl:NamedIndividual, :SessionScope ; rdfs:label "per instance"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "One session per encoding step, shared by every decode of the field within one instance of the struct that declares it (the strips of one TIFF image); the next instance starts a new one."@en .
:PerLayout a owl:NamedIndividual, :SessionScope ; rdfs:label "per layout"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "One session per encoding step for the field across the whole parse, shared by every instance of its struct and, for a field laid out as a data layout, by all of the layout's chunks."@en .
:LocalBinding a owl:Class ; rdfs:label "Local Binding"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "A named HEL value local to one Struct instance: a member of the struct's bddo:hasField list whose bddo:localExpression is evaluated when its position in the list is reached, in the struct's context. Later members, and the struct's own size, count, offset and presence expressions evaluated after it, read it by bare name or instance.<name>. It consumes no bytes, is not part of the parsed tree and is never lifted. Its name is the simple key of its IRI, as for a Field."@en .
# A struct, a field and a data type are different kinds of thing: a field's value may be typed
# BY a struct, but no resource is both.
[] a owl:AllDisjointClasses ; owl:members ( :Struct :Field :DataType ) .
# The same disjointness as a validation rule: an OWL axiom is only a contradiction for a
# reasoner, so a description typing one node both a Struct and a Field would otherwise load.
:DisjointKindsShape a sh:NodeShape ; rdfs:label "Disjoint kinds shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "A node is at most one of bddo:Struct, bddo:Field and bddo:DataType (subclasses included), as the owl:AllDisjointClasses axiom states."@en ;
    sh:targetClass :Struct , :Field , :DataType ;
    sh:sparql [ sh:message "A node cannot be both a {?a} and a {?b}: bddo:Struct, bddo:Field and bddo:DataType are disjoint." ;
        sh:prefixes :_prefixes ;
        sh:select """SELECT $this ?a ?b WHERE {
            $this rdf:type/rdfs:subClassOf* ?a , ?b .
            FILTER(?a IN (bddo:Struct, bddo:Field) && ?b IN (bddo:Field, bddo:DataType) && !sameTerm(?a, ?b))
        }""" ] .

# ---------- Delimited text records ----------
# Line- and character-delimited text: key = value headers, CSV, whitespace-separated grids.
# Records may nest, via bddo:hasGrouping, but only in the three token-delimited styles that
# vocabulary describes -- this is not a general grammar. A document with real recursive
# structure is a bddo:TreeDocument instead.
:DelimitedRecords a owl:Class ; rdfs:subClassOf :Struct ; rdfs:label "Delimited Records"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "A Struct whose children are located by delimiter position rather than byte offset: a byte run split into records by recordDelimiter, each record optionally split into values by fieldDelimiter."@en .
:KeyValueHeader a owl:Class ; rdfs:subClassOf :DelimitedRecords ; rdfs:label "Key/Value Header"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "DelimitedRecords whose records are key/value pairs split by keyValueSeparator. Each expected key is a Field carrying bddo:key, or, with no bddo:key, named by its simple key (the local name of its IRI after the last '.'); record order is not significant."@en .
:DelimitedTable a owl:Class ; rdfs:subClassOf :DelimitedRecords ; rdfs:label "Delimited Table"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "DelimitedRecords whose records are rows with a fixed column sequence. The hasField list gives the columns in order; the row structure repeats until the byte run is exhausted."@en .
# ---------- Tree documents ----------
# XML and JSON labels wrap a payload that is otherwise already describable: PDS4, DIMAP, SAFE,
# SENTINEL-2, RadarSat-2, TerraSAR-X, CPHD and Zarr all pair a clean binary array with a
# manifest BDDO could not read, and the whole GML/KML/GeoJSON family is markup end to end.
#
# BDDO does not describe the SYNTAX of these documents -- it addresses nodes in the tree a
# conforming parser produces. That distinction is what keeps this from becoming an XML
# specification: the tree is someone else's output, and BDDO's job is only to say which node
# supplies which field.
:TreeDocument a owl:Class ; rdfs:subClassOf :Struct ; rdfs:label "Tree Document"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "A Struct whose children are located by a path into a parsed node tree rather than by byte offset or delimiter. The byte run is handed to a parser for the declared syntax; each Field names the node supplying its value."@en .
:TreeSyntax a owl:Class ; rdfs:label "Tree Syntax"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "Which tree grammar a TreeDocument is written in, and therefore how its nodePath values are read."@en .
:NamespaceBinding a owl:Class ; rdfs:label "Namespace Binding"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "A prefix-to-IRI binding for the paths of an XML TreeDocument."@en .

:RecordGrouping a owl:Class ; rdfs:label "Record Grouping"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "How a DelimitedRecords container nests: which records open a group, which close it, and where the group's name comes from. A container without one is flat, which is what every DelimitedRecords was before nesting existed."@en .
:GroupingStyle a owl:Class ; rdfs:label "Grouping Style"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "Which of the three ways a text format marks a nested group."@en .

# Controlled-vocabulary classes (typed enumerated individuals)
:Endianness       a owl:Class ; rdfs:label "Endianness"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> .
:BitOrder         a owl:Class ; rdfs:label "Bit Order"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> .
:BaseType         a owl:Class ; rdfs:label "Base Type"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> .
:OffsetBase       a owl:Class ; rdfs:label "Offset Base"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> .
:Encoding         a owl:Class ; rdfs:label "Encoding"@en ; skos:altLabel "character encoding"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    skos:scopeNote "A CHARACTER encoding, the mapping of bytes to text that bddo:encoding names on a string field. It is open: the individuals below are the registered encodings, and a profile may mint its own as a bddo:CustomEncoding. Not the content encoding of hx-encoding (aenc:codec, aenc:compression) nor a codec step of a hexplain:hasEncodingStep pipeline."@en .
# An encoding a profile mints for a format whose text is in a character set this vocabulary does
# not register: it is a bddo:Encoding, so bddo:encoding accepts it, and it names the IANA charset
# so that a processor can find a decoder for it (and so that two profiles minting the same charset
# can be told to agree). Its use is reported at sh:Warning, never refused.
:CustomEncoding   a owl:Class ; rdfs:subClassOf :Encoding ; rdfs:label "Custom Encoding"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "A character encoding minted by a profile rather than registered here, identified by exactly one bddo:ianaCharset: the IANA Character Sets registry name (or one of its registered aliases) of the charset it denotes. The name MUST determine the byte order of the code units, as \"UTF-16LE\" does and \"UTF-16\" or \"ISO-10646-UCS-2\" does not: a custom encoding has no term of its own to give one. A conforming processor decodes it when it supports that charset and reports an Unsupported error otherwise."@en .
:ChecksumAlgorithm a owl:Class ; rdfs:label "Checksum Algorithm"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> .
:AlignmentOrigin  a owl:Class ; rdfs:label "Alignment Origin"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The position from which alignment and padding boundaries are measured: one of the two individuals bddo:streamOrigin (the default) and bddo:structOrigin. Closed set, checked with sh:in by bddo:AlignmentOriginShape."@en .
# How the bytes of a floating-point field are laid out. IEEE 754 is the default and the only
# format the primitive float datatypes assume; the others are what older scientific and
# mainframe data carry (VICAR, old PDS and GRIB1 products, IBM-written files) and bfloat16 what
# machine-learning tensors carry. A format decides how bits are read, not how wide the value is:
# width and byte order still come from the datatype and the endianness.
:FloatFormat      a owl:Class ; rdfs:label "Float Format"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The bit layout of a floating-point value: one of the six individuals bddo:ieee754 (the default), bddo:ibmHexadecimal, bddo:vaxF, bddo:vaxD, bddo:vaxG and bddo:bfloat16. Closed set, checked with sh:in by bddo:FieldShape and bddo:DataTypeShape."@en .
# Any CRC is fixed by the six parameters of the Rocksoft model, so one class covers every CRC a
# format uses without a new individual per variant. The named CRC individuals below carry the
# same six parameters, and their catalogue check value, as statements about themselves.
:CustomCrc a owl:Class ; rdfs:subClassOf :ChecksumAlgorithm ; rdfs:label "Custom CRC"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "A CRC stated by its Rocksoft-model parameters rather than named: bddo:crcWidth (8..64 bits), bddo:crcPolynomial, bddo:crcInit, bddo:crcReflectIn, bddo:crcReflectOut and bddo:crcXorOut, all six required. Used as the value of bddo:checksumAlgorithm for a CRC that no named algorithm identifies."@en .
# Union of DataType and Struct, used as the range of dataType / ruleDataType
:DataTypeOrStruct a owl:Class ; rdfs:label "Data Type or Struct"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ; owl:unionOf ( :DataType :Struct ) .

# ---------- Structural properties ----------
:hasField     a owl:ObjectProperty ; rdfs:label "has field"@en ; rdfs:range rdf:List ;
    rdfs:comment "Ordered rdf:List of the members of a Struct: its Fields, and any LocalBindings among them, in the order they are processed."@en ;
    skos:scopeNote "Use on a bddo:Struct for its ordered physical members. Not atab:hasField, which links a tabular schema to its typed columns and takes a single column, not a list."@en .
:hasParameter a owl:ObjectProperty ; rdfs:label "has parameter"@en ; rdfs:range rdf:List ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "Ordered rdf:List of the bddo:Parameter resources of a parameterised Struct. Every place that names the struct as a type supplies exactly one argument per parameter, positionally, with bddo:hasArgument."@en .
:parameterType a owl:ObjectProperty ; rdfs:label "parameter type"@en ; rdfs:range :ParameterType ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "Restricts the kind of value a Parameter accepts to one HEL value type: bddo:IntegerParameter, bddo:FloatParameter (an Integer argument is converted to Float), bddo:StringParameter, bddo:BytesParameter or bddo:BooleanParameter. Absent, the parameter accepts any scalar value, Null included."@en ;
    skos:scopeNote "Use on a bddo:Parameter of a parameterised Struct. Not hexplain:parameterType, which types a codec contract's parameter (a hexplain:CodecParameterSpec) with a hexplain:CodecParameterType."@en .
:hasArgument a owl:ObjectProperty ; rdfs:label "has argument"@en ; rdfs:range rdf:List ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "Ordered rdf:List of HEL expression strings, the positional arguments for the parameterised Struct this resource names as a type: on a Field, for its bddo:dataType; on a DataTypeRule, for its bddo:ruleDataType; on a DispatchArm, for its bddo:armDataType. A bddo:dispatchDefault has nowhere to state arguments, so it never names a parameterised struct. Each is evaluated in the CALLER's context -- the struct containing the field -- at the point the field is read."@en .
:localExpression a owl:DatatypeProperty ; rdfs:label "local expression"@en ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The HEL expression giving a LocalBinding's value, evaluated with the containing struct as instance when the binding's position in the hasField list is reached."@en .
:endianness   a owl:ObjectProperty ; rdfs:label "endianness"@en ; rdfs:range :Endianness ;
    rdfs:comment "Byte order for a Struct, Field, or DataType."@en .
:hasConditionalEndianness a owl:ObjectProperty ; rdfs:label "has conditional endianness"@en ; rdfs:range rdf:List ;
    rdfs:comment "Ordered rdf:List of EndiannessRule. The first rule whose condition holds selects the byte order for this Struct or Field and, as with bddo:endianness, for its descendants unless they override it. Use for formats that declare their own byte order, such as TIFF's 4949h/4D4Dh marker. Mutually exclusive with bddo:endianness."@en .
:bitOrder     a owl:ObjectProperty ; rdfs:label "bit order"@en ; rdfs:range :BitOrder ;
    rdfs:comment "The order in which bits are consumed within each byte for sub-byte fields, on a Struct (for all of its bit-level fields) or on a Field (for that field alone, overriding its struct's). Field over struct; absent on both, bddo:MSBFirst. Independent of the byte order of a multi-byte value."@en .
:syncOnMarker a owl:DatatypeProperty ; rdfs:label "sync on marker"@en ; rdfs:range xsd:hexBinary .

# ---------- Field properties ----------
:dataType               a owl:ObjectProperty ; rdfs:label "data type"@en ; rdfs:range :DataTypeOrStruct .
:hasConditionalDataType a owl:ObjectProperty ; rdfs:label "has conditional data type"@en ; rdfs:range rdf:List .
:hasDispatchTable       a owl:ObjectProperty ; rdfs:label "has dispatch table"@en ; rdfs:range :DispatchTable ;
    rdfs:comment "The keyed DispatchTable that selects this Field's effective type. Mutually exclusive with hasConditionalDataType."@en .
:dispatchOnField        a owl:ObjectProperty ; rdfs:label "dispatch on field"@en ; rdfs:range :Field ;
    rdfs:comment "The sibling Field whose parsed value is the dispatch key."@en .
:dispatchOnExpression   a owl:DatatypeProperty ; rdfs:label "dispatch on expression"@en ; rdfs:range xsd:string ;
    rdfs:comment "A HEL expression whose value is the dispatch key, evaluated as a hasConditionalDataType condition is."@en .
:dispatchDefault        a owl:ObjectProperty ; rdfs:label "dispatch default"@en ; rdfs:range :DataTypeOrStruct ;
    rdfs:comment "The type selected when no arm's key equals the dispatch key. Absent means the Field's own dataType applies."@en .
:armTable               a owl:ObjectProperty ; rdfs:label "arm table"@en ; rdfs:range :DispatchTable ;
    rdfs:comment "The DispatchTable this DispatchArm contributes to. Declared on the arm so that any graph may add arms to a table defined elsewhere."@en .
:armKey                 a owl:DatatypeProperty ; rdfs:label "arm key"@en ;
    rdfs:comment "The key value this arm matches: an xsd:string compared by code points, or an xsd:integer compared numerically."@en .
:armDataType            a owl:ObjectProperty ; rdfs:label "arm data type"@en ; rdfs:range :DataTypeOrStruct ;
    rdfs:comment "The datatype or structure selected when this arm's key matches."@en .
:seekScope              a owl:ObjectProperty ; rdfs:label "seek scope"@en ; rdfs:range :SeekScope ;
    rdfs:comment "For an offset-addressed Field, whether the read may leave the innermost bounded region (streamScope) or is confined to it (regionScope, the default). The region bound is suspended only for that one read. Used where a table inside one length-delimited container locates payloads stored in another."@en .
:size                   a owl:DatatypeProperty ; rdfs:label "size (bytes)"@en ; rdfs:range xsd:positiveInteger .
:sizeFromField          a owl:ObjectProperty ; rdfs:label "size from field"@en ; rdfs:range :Field .
:sizeFromExpression     a owl:DatatypeProperty ; rdfs:label "size from expression"@en ; rdfs:range xsd:string .
:sizeToEndOfStream      a owl:DatatypeProperty ; rdfs:label "size to end of stream"@en ; rdfs:range xsd:boolean .
:terminator             a owl:DatatypeProperty ; rdfs:label "terminator"@en ; rdfs:range xsd:hexBinary .
:trimNull               a owl:DatatypeProperty ; rdfs:label "trim null"@en ; rdfs:range xsd:boolean ;
    rdfs:comment "For a fixed-size (padded) string field, the value is the bytes before the first NUL code unit of the field's encoding within its width (a 0x00 byte, or a 00 00 pair at an even offset in UTF-16), decoded; the NUL and the bytes after it are padding, neither decoded nor validated."@en .
:encoding               a owl:ObjectProperty ; rdfs:label "encoding"@en ; skos:altLabel "character encoding"@en ; rdfs:range :Encoding ;
    rdfs:comment "The character encoding applied when a textual field's bytes are decoded: one of the registered bddo:Encoding individuals, or a bddo:CustomEncoding a profile mints for a charset not registered here (accepted, and reported at sh:Warning). Absent, a string field is read as bddo:utf8."@en ;
    skos:scopeNote "Use at most once on a bddo:Field whose data type is textual. It names how BYTES become TEXT; the content encoding of a stream (aenc:codec, aenc:compression) and the codec of a pipeline step (hexplain:codec) are different things with different registers."@en .
:ianaCharset            a owl:DatatypeProperty ; rdfs:label "IANA charset"@en ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The name of the character set a bddo:Encoding denotes, as the IANA Character Sets registry spells it (its preferred MIME name or a registered alias, compared case-insensitively): \"UTF-8\", \"ISO-8859-2\", \"windows-1252\", \"IBM037\", \"Shift_JIS\". Required, exactly once, on a bddo:CustomEncoding, where it MUST name a character set that determines the byte order of its code units (\"UTF-16BE\", not \"UTF-16\" or \"ISO-10646-UCS-2\"): the name is all a processor has to decode the bytes with. Stated on the registered encodings too, so that a processor resolves every encoding the same way, except on bddo:ucs2le and bddo:ucs2be, whose registry name does not determine a byte order and whose byte order the term itself gives."@en .
:recordDelimiter        a owl:DatatypeProperty ; rdfs:label "record delimiter"@en ; rdfs:range xsd:hexBinary ;
    rdfs:comment "Byte sequence separating records. Default 0A (LF); a CR LF pair is also accepted when this is 0A."@en .
:fieldDelimiter         a owl:DatatypeProperty ; rdfs:label "field delimiter"@en ; rdfs:range xsd:hexBinary ;
    rdfs:comment "Byte sequence separating values within one record. When absent, a record is a single value."@en .
:keyValueSeparator      a owl:DatatypeProperty ; rdfs:label "key/value separator"@en ; rdfs:range xsd:hexBinary ;
    rdfs:comment "Byte sequence separating a key from its value within a record of a KeyValueHeader."@en .
:quoteChar              a owl:DatatypeProperty ; rdfs:label "quote character"@en ; rdfs:range xsd:hexBinary ;
    rdfs:comment "Byte that quotes a value, allowing it to contain the field or record delimiter. A doubled quote inside a quoted value denotes a literal quote."@en .
:escapeChar             a owl:DatatypeProperty ; rdfs:label "escape character"@en ; rdfs:range xsd:hexBinary ;
    rdfs:comment "Byte that escapes the following byte, suppressing its delimiter or quote meaning."@en .
:commentPrefix          a owl:DatatypeProperty ; rdfs:label "comment prefix"@en ; rdfs:range xsd:string ;
    rdfs:comment "A record beginning with this string (after optional whitespace) is ignored."@en .
:skipRecords            a owl:DatatypeProperty ; rdfs:label "skip records"@en ; rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Number of leading records to discard before parsing, e.g. a CSV column-name row. Default 0."@en .
:whitespaceSeparated    a owl:DatatypeProperty ; rdfs:label "whitespace separated"@en ; rdfs:range xsd:boolean ;
    rdfs:comment "If true, values are separated by a RUN of one or more whitespace bytes (space, tab, CR, LF) rather than by a fixed bddo:fieldDelimiter. A run of any length separates exactly two values, so consecutive whitespace never yields an empty value, and leading or trailing whitespace on a record is ignored. This is what column-aligned ASCII grids need -- 'ncols        100', or a row of numbers padded to line up -- which a fixed delimiter cannot express. Mutually exclusive with bddo:fieldDelimiter. When bddo:recordDelimiter is also absent the content is one flat stream of whitespace-separated values rather than rows, which is how an ASCII grid whose rows wrap across lines is read; the grid's shape then comes from the field's dlv:DataLayout or repeat count, not from line breaks."@en .
:trimWhitespace         a owl:DatatypeProperty ; rdfs:label "trim whitespace"@en ; rdfs:range xsd:boolean ;
    rdfs:comment "If true, leading and trailing whitespace is removed from every key and value. Default false."@en .
# ---------- Tree document properties ----------
:treeSyntax a owl:ObjectProperty ; rdfs:label "tree syntax"@en ; rdfs:range :TreeSyntax ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The grammar of a TreeDocument. Required, because it decides how every nodePath in the container is read."@en .
:xml a owl:NamedIndividual, :TreeSyntax ; rdfs:label "XML"@en ;
    rdfs:comment "Paths are ABBREVIATED XPATH: child steps, attribute steps (@name), and positional predicates ([n], 1-based). A deliberately small subset -- no axes, no functions, no comparison predicates -- because a description states where a value IS, and a path that can compute is a query engine's problem rather than a description's."@en .
:json a owl:NamedIndividual, :TreeSyntax ; rdfs:label "JSON"@en ;
    rdfs:comment "Paths are JSON POINTERS as defined by RFC 6901: /object/member, array indices as /list/0 (0-based). Adopted rather than invented, so its escaping rules for '/' and '~' inside a member name are already specified and already implemented."@en .

:nodePath a owl:DatatypeProperty ; rdfs:label "node path"@en ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "Locates the node supplying this field's value, read according to the container's treeSyntax. A path selecting no node leaves the field absent; a path selecting several is an error unless the field repeats, in which case the field's value is the selected nodes in document order."@en .
:hasNamespaceBinding a owl:ObjectProperty ; rdfs:label "has namespace binding"@en ; rdfs:range :NamespaceBinding ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "Binds the prefixes used in this document's paths. XML only, and not optional in practice: PDS4, DIMAP and SAFE are all namespaced, and an unprefixed path against a namespaced document silently matches nothing rather than failing."@en .
:namespacePrefix a owl:DatatypeProperty ; rdfs:label "namespace prefix"@en ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The prefix as used in this container's nodePath values. The empty string binds the DEFAULT namespace, which an XPath subset cannot otherwise reach."@en .
:namespaceIRI a owl:DatatypeProperty ; rdfs:label "namespace IRI"@en ; rdfs:range xsd:anyURI ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The namespace the prefix stands for, matched against the document's own declarations rather than against the prefix it happens to use -- a document may spell the same namespace with any prefix."@en .

# ---------- Nested records ----------
# The flat key/value model reaches ESRI .hdr, ENVI and their kin, but stops at the label formats
# that are otherwise the same shape: PVL/ODL (PDS, ISIS2, ISIS3, VICAR) nests with
# OBJECT = ... END_OBJECT, ERMapper with <Name> Begin ... <Name> End, and INI-style labels with
# bracketed section headers. Refusing to nest kept nine drivers at payload-only for want of a
# closing token.
#
# Three styles rather than one general grammar. Each is fully described by two tokens plus where
# the group's NAME comes from, and that is the whole of it -- a general nested-grammar surface
# would be a parser generator, and this is not one.
:hasGrouping a owl:ObjectProperty ; rdfs:label "has grouping"@en ; rdfs:range :RecordGrouping ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The nesting rule of a DelimitedRecords container. Absent means flat."@en .
:groupingStyle a owl:ObjectProperty ; rdfs:label "grouping style"@en ; rdfs:range :GroupingStyle ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> .
:groupOpenToken a owl:DatatypeProperty ; rdfs:label "group open token"@en ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The literal that marks a record as opening a group: the key OBJECT, the value Begin, or the bracket [ -- read according to groupingStyle."@en .
:groupCloseToken a owl:DatatypeProperty ; rdfs:label "group close token"@en ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The literal that closes a group: END_OBJECT, End, or the bracket ]. For sectionHeaded it is the closing bracket of the header rather than a separate record, since a section is ended by the next one."@en .

:keyedGroup a owl:NamedIndividual, :GroupingStyle ; rdfs:label "keyed group"@en ;
    rdfs:comment "A record whose KEY equals groupOpenToken opens a group, and its VALUE names it; a record whose key equals groupCloseToken closes the innermost open group. PVL/ODL: OBJECT = IMAGE ... END_OBJECT = IMAGE. The closing record MAY repeat the name; a description need not say so, because the name is already known from the opening record."@en .
:valuedGroup a owl:NamedIndividual, :GroupingStyle ; rdfs:label "valued group"@en ;
    rdfs:comment "The mirror image: a record whose VALUE equals groupOpenToken opens a group, and its KEY names it. ERMapper: CoordinateSpace Begin ... CoordinateSpace End."@en .
:sectionHeaded a owl:NamedIndividual, :GroupingStyle ; rdfs:label "section headed"@en ;
    rdfs:comment "A record consisting of groupOpenToken, a name, and groupCloseToken opens a group and implicitly closes the previous one; the last runs to the end of the container. INI-style [Section] headers. Nesting is therefore FLAT ONE DEEP -- sections do not contain sections -- which is what the style actually permits, not a limitation of this model."@en .

:keyPath a owl:DatatypeProperty ; rdfs:label "key path"@en ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "Locates a field inside nested groups, as group names and finally the key, joined by pathSeparator: 'IMAGE/BAND/NAME'. Mutually exclusive with bddo:key, which locates a field in a flat container -- a field cannot be found two ways, and a description that said both would leave a reader to guess which wins."@en .
:pathSeparator a owl:DatatypeProperty ; rdfs:label "path separator"@en ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The separator used in this container's keyPath values. Default '/'. Declared on the container rather than repeated per field, and needed because a format whose group names may contain '/' has to choose something else."@en .

:key                    a owl:DatatypeProperty ; rdfs:label "key"@en ; rdfs:range xsd:string ;
    rdfs:comment "The key naming this Field within a KeyValueHeader. Replaces positional location: the Field takes the value of whichever record carries this key. A field of a flat KeyValueHeader that declares no bddo:key is located by its simple key instead."@en .
:keyIsCaseInsensitive   a owl:DatatypeProperty ; rdfs:label "key is case insensitive"@en ; rdfs:range xsd:boolean ;
    rdfs:comment "If true, bddo:key matching ignores ASCII case. Default false."@en .
:numericBase            a owl:DatatypeProperty ; rdfs:label "numeric base"@en ; rdfs:range xsd:positiveInteger ;
    rdfs:comment "Radix used to read an :asciiInteger field: 8, 10 or 16. Default 10."@en .
:bitLength              a owl:DatatypeProperty ; rdfs:label "bit length"@en ; rdfs:range xsd:positiveInteger .
:repeatCount            a owl:DatatypeProperty ; rdfs:label "repeat count"@en ; rdfs:range xsd:nonNegativeInteger .
:repeatCountFromField   a owl:ObjectProperty ; rdfs:label "repeat count from field"@en ; rdfs:range :Field .
:repeatCountFromExpression a owl:DatatypeProperty ; rdfs:label "repeat count from expression"@en ; rdfs:range xsd:string .
:repeatUntil            a owl:DatatypeProperty ; rdfs:label "repeat until"@en ; rdfs:range xsd:string .
# Padding is the mirror image of alignment: alignment moves the START of a field or struct to a
# boundary, padding extends its END to one. Both are measured from the start of the current
# stream, or from the containing struct where bddo:alignmentOrigin says so (Processing Model,
# Alignment and padding). The fill byte is what the padding is expected to hold; a
# processor MAY verify it and MUST NOT require it to be stated.
:padTo                  a owl:DatatypeProperty ; rdfs:label "pad to"@en ; rdfs:range xsd:positiveInteger ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "After this Field's value (or, on a Struct, after its last member) is read, the parser skips forward to the next multiple of this many bytes from the start of the current stream, the same origin bddo:alignment uses (a bounded region does not move it), or from the start of the containing struct instance when bddo:alignmentOrigin is bddo:structOrigin; the skipped bytes are padding, part of the subject's extent but neither decoded nor lifted. On an offset-addressed Field the padding is applied at the field's target, after its value is read and its checks are made there and before the cursor is restored. A value of 1 pads nothing. Distinct from bddo:alignment, which positions where a field STARTS, and from bddo:size, which fixes an extent outright."@en .
:padByte                a owl:DatatypeProperty ; rdfs:label "pad byte"@en ; rdfs:range xsd:hexBinary ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The fill byte the padding introduced by bddo:padTo is expected to hold, as one hexBinary octet (\"00\", \"20\", \"FF\"). Informative: a processor MAY verify the padding against it and report a Validation error when it differs, and MUST accept padding when no fill byte is stated. A Writer writes it as the fill of that padding, and \"00\" when none is stated. Meaningful only beside bddo:padTo."@en .
:separatedBy            a owl:DatatypeProperty ; rdfs:label "separated by"@en ; rdfs:range xsd:string ;
    rdfs:comment "The element extent of a field -- repeated or scalar -- whose value is a number written as text, separated rather than sized or terminated: each element is preceded and followed by a run of separator bytes, and the run belongs to the element that owns it so the byte sequence can be rebuilt exactly. The only defined value is \"whitespace\" (space, tab, CR, LF). A separator is a RUN and a terminator is a SEQUENCE: between two delimiters of a delimited table an empty value is meaningful, whereas an empty run is not a value at all. Permitted only on a field whose data type is a number written as text. Because the LAST element's trailing run consumes every separator byte up to the field's own extent (or end of stream), a field declaring bddo:separatedBy must either be the last field read from its enclosing region, or be immediately followed by data that does not itself begin with a separator byte (space, tab, CR, LF) -- otherwise the trailing run consumes bytes that belong to the following field."@en .
:atOffset               a owl:DatatypeProperty ; rdfs:label "at offset"@en ; rdfs:range xsd:nonNegativeInteger .
:atOffsetFromField      a owl:ObjectProperty ; rdfs:label "at offset from field"@en ; rdfs:range :Field .
:atOffsetFromExpression a owl:DatatypeProperty ; rdfs:label "at offset from expression"@en ; rdfs:range xsd:string .
:offsetBase             a owl:ObjectProperty ; rdfs:label "offset base"@en ; rdfs:range :OffsetBase .
:offsetBaseField        a owl:ObjectProperty ; rdfs:label "offset base field"@en ; rdfs:range :Field ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The sibling Field whose first byte is the origin of this Field's offset when bddo:offsetBase is bddo:fieldStart. It is an earlier member of the same struct's bddo:hasField list. Required with bddo:fieldStart and meaningless with any other base."@en .
:alignment              a owl:DatatypeProperty ; rdfs:label "alignment"@en ; rdfs:range xsd:positiveInteger ;
    rdfs:comment "A byte boundary at which the subject starts, measured from the start of the current stream (the input stream, or a decoded sub-stream; a bounded region does not move the origin) unless bddo:alignmentOrigin selects the start of the containing struct instance (bddo:structOrigin): before a Field is read, or before each instance of a Struct is read, the parser skips forward to the next multiple of this many bytes. On a Struct it applies to every instance of the struct, wherever it is used; a Field that names the struct applies its own alignment first, then the struct's. A value of 1 aligns nothing. Positions a START; bddo:padTo extends an END."@en .
# Where alignment and padding boundaries are counted from. The stream is the default and what
# both properties meant before the selector existed. The struct is what formats mean when they
# align the members of a record to the record's own start (an ELF note, a RIFF chunk, a C struct
# written out whole): there the absolute position of the record is irrelevant, and a record
# embedded at an odd stream offset would be misread under the stream origin.
:alignmentOrigin        a owl:ObjectProperty ; rdfs:label "alignment origin"@en ; rdfs:range :AlignmentOrigin ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The position from which the boundaries of the subject's bddo:alignment and bddo:padTo are measured: bddo:streamOrigin (the default when absent), the start of the current stream, or bddo:structOrigin, the start of the containing struct instance. One value governs both properties of the subject. It is not inherited: a member without one uses the stream origin whatever its struct states."@en ;
    skos:scopeNote "Use at most once on a bddo:Field or bddo:Struct that states bddo:alignment or bddo:padTo; without either it selects nothing (bddo:AlignmentOriginShape)."@en .
:hasFixedValue          a owl:DatatypeProperty ; rdfs:label "has fixed value"@en ; rdfs:range rdfs:Literal ;
    rdfs:comment "The literal a parsed field is required to equal, such as a signature or a fixed discriminator: a numeric literal for a numeric field, a string for a text field, an xsd:hexBinary for bytes. A parsed value that differs is a Validation error. At most one; a field whose acceptable values are several states them with bddo:validIf instead."@en .
:isPresentIf            a owl:DatatypeProperty ; rdfs:label "is present if"@en ; rdfs:range xsd:string .
:valueFromExpression    a owl:DatatypeProperty ; rdfs:label "value from expression"@en ; rdfs:range xsd:string ;
    rdfs:comment "A HEL expression giving the value of a derived, zero-byte field. The field consumes no bytes; its computed value is placed in the parse context under the field's name so later sizing, offset, presence, mapping and validation expressions may reference it. A field with bddo:valueFromExpression declares no bddo:dataType and no sizing, offset or bit-length; the result's type is that of the HEL expression."@en .
:validIf                a owl:DatatypeProperty ; rdfs:label "valid if"@en ; rdfs:range xsd:string ;
    rdfs:comment "A HEL boolean expression that MUST hold once this field is parsed; if it evaluates false the parse fails with a validation error. Use for post-parse constraints such as a magic number or a bound on a count. Richer, graph-level constraints belong in SHACL at the semantic layer."@en .
:rootKeyFromField       a owl:ObjectProperty ; rdfs:label "root key from field"@en ; rdfs:range :Field ;
    rdfs:comment "After this Field is parsed, its value is also bound in the ROOT parsing context under the key given by the named sibling Field's parsed value, if that key is not already bound (first occurrence wins). Lets a later record address an earlier one through its discriminator -- `root.<key>.<field>` -- when the earlier record sits inside a repeated sequence that HEL cannot search. A neutral generalisation of the chunk-type aliasing that several chunked container formats need."@en .
:enumeration            a owl:ObjectProperty ; rdfs:label "enumeration"@en ; rdfs:range :Enumeration .
:checksum               a owl:ObjectProperty ; rdfs:label "checksum"@en ; rdfs:range :Checksum ;
    skos:scopeNote "Use on the bddo:Field that CARRIES a checksum, naming the bddo:Checksum declaration (algorithm and covered byte range) a processor verifies it against. Not aintg:checksum, which is the digest VALUE recorded about a resource after parsing, as an xsd:hexBinary."@en .
# ---------- Numeric representation ----------
# How the bits of a numeric field are read, beyond width, signedness and byte order. Stated on
# a Field, or on a DataType a profile mints so that every field of that type shares it.
:floatFormat            a owl:ObjectProperty ; rdfs:label "float format"@en ; rdfs:range :FloatFormat ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The bit layout of a floating-point Field or DataType: bddo:ieee754 (the default when absent), bddo:ibmHexadecimal, bddo:vaxF, bddo:vaxD, bddo:vaxG or bddo:bfloat16. Only meaningful where the data type's bddo:baseType is bddo:baseFloat; the width comes from the data type and the byte order from the endianness in force. Each format exists at particular widths only (bddo:FloatFormatWidthShape): bddo:bfloat16 at 16 bits, bddo:ibmHexadecimal at 32 or 64, bddo:vaxF at 32, bddo:vaxD and bddo:vaxG at 64."@en .
:fixedPointScale        a owl:DatatypeProperty ; rdfs:label "fixed-point scale"@en ; rdfs:range xsd:integer ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The binary scale exponent of a fixed-point integer Field or DataType: the value represented is the parsed integer times 2 raised to this power, so a Q16.16 number has scale -16 and a value stored in units of 4 has scale 2. Only meaningful where the data type's bddo:baseType is bddo:baseInteger; the parsed HEL value stays the raw integer, and the scaled value is what the field's semantic mapping emits. A decimal (power-of-ten) scale is not a representation of the bits and is written as a hexplain:valueExpression instead. A processor that applies the scale supports every exponent from -4096 to 4096 at least, and reports a Description error for one outside the range it supports; a description that stays within -4096..4096 is portable."@en .
:bcd                    a owl:DatatypeProperty ; rdfs:label "BCD"@en ; rdfs:range xsd:boolean ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "If true, the bytes of this integer Field or DataType are packed binary-coded decimal: two decimal digits per byte, the most significant digit in the high nibble, read in the byte order in force, and a nibble above 9 is a Validation error. The parsed HEL value is the decimal number the digits spell. Only meaningful where the data type's bddo:baseType is bddo:baseInteger, and only on an UNSIGNED fixed-width binary integer type (bddo:BcdShape): the packing defines no sign nibble, so a signed type has no reading; a variable-length integer (bddo:varuint, bddo:varint, bddo:sqliteVarint) and a number written as text (bddo:asciiInteger, bddo:asciiDecimal) are not sequences of BCD bytes; and a bit-level field (bddo:bitLength) is not a whole number of bytes. Default false."@en .

# ---------- DataType / Rule / Enum / Checksum properties ----------
:baseType      a owl:ObjectProperty ; rdfs:label "base type"@en ; rdfs:range :BaseType .
:bitWidth      a owl:DatatypeProperty ; rdfs:label "bit width"@en ; rdfs:range xsd:positiveInteger .
:isSigned      a owl:DatatypeProperty ; rdfs:label "is signed"@en ; rdfs:range xsd:boolean .
:xsdType       a owl:ObjectProperty ; rdfs:label "xsd type"@en ; rdfs:range rdfs:Datatype ;
    rdfs:comment "The RDF literal datatype produced when a value of this DataType is emitted."@en .
:condition     a owl:DatatypeProperty ; rdfs:label "parse condition"@en ; rdfs:range xsd:string ;
    # Not the same property as hexplain:condition: this one guards how BYTES are read, while
    # parsing; that one guards which RDF a parsed node is LIFTED to. They are evaluated at
    # different times, and a processor reads each only on its own rule classes.
    rdfs:seeAlso <https://hexplain.io/ns/core#condition> ;
    skos:scopeNote "Use exactly once on a bddo:DataTypeRule, bddo:EndiannessRule, dlv:CellDataTypeRule or dlv:DimensionOrderRule. Evaluated while the bytes are read; not hexplain:condition, the mapping condition evaluated after parsing on a hexplain:MappingRule or hexplain:ClassMappingRule."@en .
:ruleDataType  a owl:ObjectProperty ; rdfs:label "rule data type"@en ; rdfs:range :DataTypeOrStruct .
:ruleEndianness a owl:ObjectProperty ; rdfs:label "rule endianness"@en ; rdfs:range :Endianness ;
    rdfs:comment "The byte order selected by an EndiannessRule."@en .
:hasEnumValue  a owl:ObjectProperty ; rdfs:label "has enum value"@en ; rdfs:range :EnumValue .
:enumRawValue  a owl:DatatypeProperty ; rdfs:label "enum raw value"@en .
:enumSymbol    a owl:ObjectProperty ; rdfs:label "enum symbol"@en .
:enumIsFlags   a owl:DatatypeProperty ; rdfs:label "enum is flags"@en ; rdfs:range xsd:boolean ;
    rdfs:comment "If true, the Enumeration is a bit-flag set: each EnumValue's raw value is a bitmask, and every symbol whose bit(s) are set in the parsed value is emitted."@en .
:checksumAlgorithm a owl:ObjectProperty ; rdfs:label "checksum algorithm"@en ; rdfs:range :ChecksumAlgorithm ;
    skos:scopeNote "Use exactly once on a bddo:Checksum, naming a bddo:ChecksumAlgorithm individual or a bddo:CustomCrc that a processor COMPUTES over the covered bytes. Not aintg:checksumAlgorithm, which records on a parsed resource which register concept names the algorithm a digest was made with; the checksum register links the two with hexplain:correspondsTo."@en .
:coversFromField   a owl:ObjectProperty ; rdfs:label "covers from field"@en ; rdfs:range :Field .
:coversToField     a owl:ObjectProperty ; rdfs:label "covers to field"@en ; rdfs:range :Field .
# A single expression can only describe a range it computes whole, so a checksum whose start
# is a named field and whose end is computed had no way to say so -- it had to abandon the
# field reference and recompute that offset arithmetically too. Splitting coverage into two
# independent bounds removes that all-or-nothing choice; either end may be a field or an
# expression. Offsets are absolute byte positions in the same frame of reference a size or
# offset expression on this struct would see.
:coversFromExpression a owl:DatatypeProperty ; rdfs:label "covers from expression"@en ; rdfs:range xsd:string ;
    rdfs:comment "HEL expression evaluating to the covered range's START byte offset, inclusive. Alternative to coversFromField for the same bound."@en .
:coversToExpression a owl:DatatypeProperty ; rdfs:label "covers to expression"@en ; rdfs:range xsd:string ;
    rdfs:comment "HEL expression evaluating to the covered range's END byte offset, EXCLUSIVE (one past the last covered byte). Alternative to coversToField for the same bound -- note coversToField names a field whose last byte is included, so the two forms do not take the same number."@en .
:coversExpression  a owl:DatatypeProperty ; rdfs:label "covers expression"@en ; rdfs:range xsd:string ;
    owl:deprecated true ; dcterms:isReplacedBy :coversFromExpression , :coversToExpression ;
    rdfs:comment "Deprecated: a single expression yielding the whole [start,end) range. Superseded by the coversFromExpression/coversToExpression pair, which states each bound separately and so can mix field and expression ends. Retained for descriptions written against earlier BDDO."@en .
# The Rocksoft CRC model. Required on a bddo:CustomCrc; also stated on the named CRC individuals,
# where they record what the name means (tools/test_crc_catalogue.py recomputes each check value).
:crcWidth a owl:DatatypeProperty ; rdfs:label "CRC width"@en ; rdfs:range xsd:positiveInteger ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The width of a CRC in bits, 8 to 64: the degree of its generator polynomial and the width of its register and result."@en .
:crcPolynomial a owl:DatatypeProperty ; rdfs:label "CRC polynomial"@en ; rdfs:range xsd:nonNegativeInteger ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The generator polynomial of a CRC without its top (x^width) term, in normal (unreflected) form, as a non-negative integer below 2^width: CRC-32's is 0x04C11DB7 (79764919), not the reflected 0xEDB88320."@en .
:crcInit a owl:DatatypeProperty ; rdfs:label "CRC initial value"@en ; rdfs:range xsd:nonNegativeInteger ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The value the CRC register holds before the first byte is processed, unreflected, below 2^width."@en .
:crcReflectIn a owl:DatatypeProperty ; rdfs:label "CRC reflect input"@en ; rdfs:range xsd:boolean ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "If true, each input byte is processed least-significant bit first (reflected); if false, most-significant bit first."@en .
:crcReflectOut a owl:DatatypeProperty ; rdfs:label "CRC reflect output"@en ; rdfs:range xsd:boolean ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "If true, the final register is bit-reversed over its width before the final XOR."@en .
:crcXorOut a owl:DatatypeProperty ; rdfs:label "CRC final XOR"@en ; rdfs:range xsd:nonNegativeInteger ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The value XORed into the (possibly reflected) final register to give the CRC, below 2^width."@en .
:crcCheck a owl:DatatypeProperty ; rdfs:label "CRC check value"@en ; rdfs:range xsd:nonNegativeInteger ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The CRC of the nine ASCII bytes \"123456789\" under the algorithm's parameters: the catalogue check value that identifies a CRC variant. Informative on a named algorithm; never required, and never read by a processor."@en .

# ---------- HEL expressions ----------
# An expression is RDF text. Typing it bddo:HelExpression lets a reader -- a person, an editor, a
# linter -- tell an expression from a name or a label without knowing which property holds it.
# The literal's value is still the string, so every expression-valued property keeps its
# xsd:string range and an untyped expression stays valid: the shapes accept either datatype.
# It is declared here rather than in core because bddo is the lowest layer that holds
# expressions and must load without core.
:HelExpression a rdfs:Datatype ; rdfs:subClassOf xsd:string ;
    rdfs:label "HEL expression"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The datatype of a literal whose text is a HEL expression. Its lexical space is the text of HEL expressions as the HEL specification defines it, and a literal's value is that text as a string: the value space is a subset of xsd:string's, so a bddo:HelExpression literal is a value of every property whose range is xsd:string. Authoring tools SHOULD type expressions with it; an expression typed xsd:string remains valid. The datatype does not check the text: whether it parses is for the HEL evaluator to say."@en .
:HelExpressionValueShape a sh:NodeShape ;
    rdfs:label "HEL expression value shape"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "A HEL expression literal: typed xsd:string, as existing descriptions write it, or bddo:HelExpression. Every expression-valued property's shapes use it in place of sh:datatype xsd:string."@en ;
    sh:message "A HEL expression is an xsd:string or bddo:HelExpression literal." ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype :HelExpression ] ) .

# The HEL version a description's expressions are written against. HEL 1.x adds functions but
# never changes what a 1.0 expression means, so a marker lets an evaluator that implements 1.0
# notice a description written for 1.1 -- which may call a 1.1 function -- and say so.
:helVersion a owl:AnnotationProperty ; rdfs:range xsd:string ;
    rdfs:label "HEL version"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The HEL version, as major.minor (\"1.0\"), that the expressions of a format description are written against, stated at most once on the description's owl:Ontology. Optional: absent, it is the HEL version of the specification edition the description conforms to. An evaluator implementing an earlier minor version of the same major version can still evaluate every expression that calls no function it lacks; a description declaring a later version tells it why a function may be unknown."@en .
:HelVersionShape a sh:NodeShape ;
    rdfs:label "HEL version shape"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    sh:targetSubjectsOf :helVersion ;
    sh:property [ sh:path :helVersion ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:pattern "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" ;
        sh:message "bddo:helVersion is stated at most once, as an xsd:string major.minor version of two decimal numbers without leading zeros, such as \"1.0\"." ] .

# ---------- Deprecated pre-release terms ----------
# Profiles written before BDDO 1.0 still use these IRIs and conforming processors still read
# them, so they are declared rather than silently unknown. Each keeps its original meaning;
# new descriptions MUST use the replacement. They are never emitted by current tooling.
:hasEndianness a owl:ObjectProperty ; rdfs:label "has endianness (deprecated)"@en ; rdfs:range :Endianness ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    owl:deprecated true ; dcterms:isReplacedBy :endianness ;
    rdfs:comment "Deprecated pre-release spelling of bddo:endianness, with the same meaning. A processor reading a description that states both uses bddo:endianness."@en .
:usesStruct a owl:ObjectProperty ; rdfs:label "uses struct (deprecated)"@en ; rdfs:range :Struct ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    owl:deprecated true ;
    skos:historyNote "Deprecated before BDDO 1.0 without a replacement: splicing another struct's fields into this one's has no single equivalent. A description states the fields directly, or names the other struct as the bddo:dataType of a field, which nests its fields instead of splicing them."@en ;
    rdfs:comment "Deprecated pre-release template reference: the subject Struct's effective field list is the named Struct's fields followed by its own. There is no single replacement term; new descriptions state the fields directly, or compose with a Field whose bddo:dataType is the other Struct (which nests rather than splices)."@en .
:integer a owl:NamedIndividual, :BaseType ; rdfs:label "Base type Integer (deprecated)"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    owl:deprecated true ; dcterms:isReplacedBy :baseInteger ;
    rdfs:comment "Deprecated pre-release name of bddo:baseInteger, with the same meaning."@en .
:float a owl:NamedIndividual, :BaseType ; rdfs:label "Base type Float (deprecated)"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    owl:deprecated true ; dcterms:isReplacedBy :baseFloat ;
    rdfs:comment "Deprecated pre-release name of bddo:baseFloat, with the same meaning."@en .

# ---------- Enumerated individuals (typed with their controlled-vocabulary class) ----------
:BigEndian a owl:NamedIndividual, :Endianness ; rdfs:label "Big Endian"@en .
:LittleEndian a owl:NamedIndividual, :Endianness ; rdfs:label "Little Endian"@en .
:MSBFirst a owl:NamedIndividual, :BitOrder ; rdfs:label "MSB-first bit order"@en .
:LSBFirst a owl:NamedIndividual, :BitOrder ; rdfs:label "LSB-first bit order"@en .
:baseInteger a owl:NamedIndividual, :BaseType ; rdfs:label "Base type Integer"@en .
:baseFloat   a owl:NamedIndividual, :BaseType ; rdfs:label "Base type Float"@en .
:baseString  a owl:NamedIndividual, :BaseType ; rdfs:label "Base type String"@en .
:baseBytes   a owl:NamedIndividual, :BaseType ; rdfs:label "Base type Bytes"@en .
:streamOrigin a owl:NamedIndividual, :AlignmentOrigin ; rdfs:label "Alignment origin: stream"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "Alignment and padding boundaries are multiples counted from the start of the current stream (the input stream, or a decoded sub-stream; a bounded region does not move the origin). The default when bddo:alignmentOrigin is absent."@en .
:structOrigin a owl:NamedIndividual, :AlignmentOrigin ; rdfs:label "Alignment origin: containing struct"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "Alignment and padding boundaries are multiples counted from the first byte of the containing struct instance. For a Field that is the instance of the Struct whose member it is. For a Struct, bddo:padTo counts from the first byte of the instance being read, so that its extent becomes a multiple of the boundary, and bddo:alignment counts from the first byte of the instance of the struct containing the field it types; a root struct, which no struct contains, is not moved."@en .
:streamStart a owl:NamedIndividual, :OffsetBase ; rdfs:label "Offset base: stream start"@en .
:streamEnd   a owl:NamedIndividual, :OffsetBase ; rdfs:label "Offset base: stream end"@en .
:parentStart a owl:NamedIndividual, :OffsetBase ; rdfs:label "Offset base: parent start"@en .
:currentPosition a owl:NamedIndividual, :OffsetBase ; rdfs:label "Offset base: current position"@en .
# An offset counted from where a sibling begins: what a format means by "the data starts N bytes
# after the start of the header field" when the header is not the first member of its struct,
# so bddo:parentStart is the wrong origin and the distance between the two is not constant.
:fieldStart a owl:NamedIndividual, :OffsetBase ; rdfs:label "Offset base: field start"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The offset is measured from the first byte of the sibling field named by bddo:offsetBaseField: an earlier member of the same struct, whose start is known when the offset-addressed field is read. For a repeated base field the first byte of its first element; for an offset-addressed base field its target position. A base field that is absent (its bddo:isPresentIf is false) is a Description error."@en .
:regionScope a owl:NamedIndividual, :SeekScope ; rdfs:label "Seek scope: bounded region"@en ;
    rdfs:comment "The default: an offset-addressed read must stay within the innermost enclosing bounded region."@en .
:streamScope a owl:NamedIndividual, :SeekScope ; rdfs:label "Seek scope: whole stream"@en ;
    rdfs:comment "The read is resolved against the whole stream; the enclosing region bound does not apply to it."@en .
:utf8 a owl:NamedIndividual, :Encoding ; rdfs:label "UTF-8"@en ; :ianaCharset "UTF-8" .
:ascii a owl:NamedIndividual, :Encoding ; rdfs:label "US-ASCII"@en ; :ianaCharset "US-ASCII" .
:utf16le a owl:NamedIndividual, :Encoding ; rdfs:label "UTF-16 LE"@en ; :ianaCharset "UTF-16LE" .
:utf16be a owl:NamedIndividual, :Encoding ; rdfs:label "UTF-16 BE"@en ; :ianaCharset "UTF-16BE" .
:latin1 a owl:NamedIndividual, :Encoding ; rdfs:label "ISO-8859-1"@en ; :ianaCharset "ISO-8859-1" .
# Registered encodings beyond the original five. Named for the character set (the ISO 8859
# parts by part number, as bddo:iso8859_2); each states its IANA charset so that a processor and a profile's
# bddo:CustomEncoding resolve through the same registry. Byte order is part of a UTF-16/32
# encoding's name, never taken from the struct's endianness.
:utf32le a owl:NamedIndividual, :Encoding ; rdfs:label "UTF-32 LE"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ; :ianaCharset "UTF-32LE" ;
    rdfs:comment "UTF-32 character encoding with each 32-bit code unit stored in little-endian byte order; one code unit per Unicode scalar value, no byte-order mark."@en .
:utf32be a owl:NamedIndividual, :Encoding ; rdfs:label "UTF-32 BE"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ; :ianaCharset "UTF-32BE" ;
    rdfs:comment "UTF-32 character encoding with each 32-bit code unit stored in big-endian byte order; one code unit per Unicode scalar value, no byte-order mark."@en .
:ucs2le a owl:NamedIndividual, :Encoding ; rdfs:label "UCS-2 LE"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "UCS-2 character encoding, little-endian: one 16-bit unit per character of the Basic Multilingual Plane and no surrogate pairs, which is how pre-Unicode-2.0 formats and some SQLite and NTFS structures store text. A surrogate code unit is a Validation error, which is what distinguishes it from bddo:utf16le. It states no bddo:ianaCharset: the registry name of UCS-2, ISO-10646-UCS-2, does not determine a byte order, so the byte order is given by this term and by nothing else."@en .
:ucs2be a owl:NamedIndividual, :Encoding ; rdfs:label "UCS-2 BE"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "UCS-2 character encoding, big-endian: one 16-bit unit per character of the Basic Multilingual Plane and no surrogate pairs. A surrogate code unit is a Validation error, which is what distinguishes it from bddo:utf16be. It states no bddo:ianaCharset: the registry name of UCS-2, ISO-10646-UCS-2, does not determine a byte order, so the byte order is given by this term and by nothing else."@en .
:windows1252 a owl:NamedIndividual, :Encoding ; rdfs:label "Windows-1252"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ; :ianaCharset "windows-1252" ;
    rdfs:comment "The Windows-1252 single-byte encoding: ISO-8859-1 with printable characters (curly quotes, the euro sign, dashes) in the 0x80-0x9F range that Latin-1 leaves to C1 controls. What DBF, ESRI and most Windows-written text actually carries when a format says \"ANSI\"."@en .
:iso8859_2 a owl:NamedIndividual, :Encoding ; rdfs:label "ISO-8859-2"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ; :ianaCharset "ISO-8859-2" ;
    rdfs:comment "ISO-8859-2 (Latin-2) single-byte character encoding for Central European languages, mapping each byte to one character."@en .
:iso8859_5 a owl:NamedIndividual, :Encoding ; rdfs:label "ISO-8859-5"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ; :ianaCharset "ISO-8859-5" ;
    rdfs:comment "ISO-8859-5 (Latin/Cyrillic) single-byte character encoding, mapping each byte to one character."@en .
:iso8859_7 a owl:NamedIndividual, :Encoding ; rdfs:label "ISO-8859-7"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ; :ianaCharset "ISO-8859-7" ;
    rdfs:comment "ISO-8859-7 (Latin/Greek) single-byte character encoding, mapping each byte to one character."@en .
:iso8859_9 a owl:NamedIndividual, :Encoding ; rdfs:label "ISO-8859-9"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ; :ianaCharset "ISO-8859-9" ;
    rdfs:comment "ISO-8859-9 (Latin-5, Turkish) single-byte character encoding, mapping each byte to one character."@en .
:iso8859_15 a owl:NamedIndividual, :Encoding ; rdfs:label "ISO-8859-15"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ; :ianaCharset "ISO-8859-15" ;
    rdfs:comment "ISO-8859-15 (Latin-9) single-byte character encoding: Latin-1 with the euro sign and seven other characters replacing little-used ones."@en .
:ebcdic037 a owl:NamedIndividual, :Encoding ; rdfs:label "EBCDIC 037"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ; :ianaCharset "IBM037" ;
    rdfs:comment "EBCDIC code page 037 (US/Canada), the single-byte encoding of IBM mainframe-written text; digits, letters and space sit at code points unrelated to ASCII's, so a text field read with the wrong one is garbage rather than slightly off."@en .
:shiftJis a owl:NamedIndividual, :Encoding ; rdfs:label "Shift_JIS"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ; :ianaCharset "Shift_JIS" ;
    rdfs:comment "Shift_JIS, the variable-width (one or two bytes per character) Japanese encoding; a lead byte in 0x81-0x9F or 0xE0-0xEF is followed by one trail byte, and a truncated pair is a Validation error."@en .
# Float formats: the bit layouts a floating-point value may have (bddo:floatFormat).
:ieee754 a owl:NamedIndividual, :FloatFormat ; rdfs:label "IEEE 754"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "IEEE 754 binary interchange format of the data type's width: binary16, binary32 or binary64, sign bit first, biased exponent, then the significand. The default: what every primitive float datatype denotes when no bddo:floatFormat is stated."@en .
:ibmHexadecimal a owl:NamedIndividual, :FloatFormat ; rdfs:label "IBM hexadecimal"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "IBM System/360 hexadecimal floating point: a sign bit, a 7-bit base-16 exponent biased by 64, and a 24-bit (32-bit value) or 56-bit (64-bit value) hexadecimal fraction. Carried by GRIB edition 1, SEG-Y and mainframe-written scientific data; converted to the nearest IEEE 754 value of the same width when lifted."@en .
# The three VAX formats have a term each. bddo:vaxF used to cover two of them, selected by the
# width (F_floating at 32 bits, D_floating at 64), which left G_floating -- the other 64-bit
# format, and the one later VAX software wrote by default -- without a term and made the width
# decide the meaning. A 64-bit bddo:vaxF is still read as D_floating, so existing descriptions
# mean what they meant; it is reported at sh:Warning (bddo:DeprecatedVaxFWidthShape).
:vaxF a owl:NamedIndividual, :FloatFormat ; rdfs:label "VAX F_floating"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "DEC VAX F_floating, the 32-bit VAX format, in its PDP-11-derived middle-endian word order: a sign bit, an 8-bit exponent biased by 128 and a 23-bit fraction with a hidden leading bit, the value being 0.1f (binary) times 2 to the exponent. Carried by VICAR and older PDS products written on VAX systems. Deprecated use: on a 64-bit data type bddo:vaxF is read as D_floating, exactly as bddo:vaxD is, which is what it meant before the VAX formats had a term each; such a description is valid, is reported at sh:Warning, and should name bddo:vaxD."@en .
:vaxD a owl:NamedIndividual, :FloatFormat ; rdfs:label "VAX D_floating"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "DEC VAX D_floating, a 64-bit VAX format, in the same middle-endian word order as bddo:vaxF: a sign bit, an 8-bit exponent biased by 128 and a 55-bit fraction with a hidden leading bit. Its exponent range is that of F_floating; its precision exceeds IEEE 754 binary64 by three bits, so a value is converted to the nearest binary64 when lifted. Only meaningful for a 64-bit data type."@en .
:vaxG a owl:NamedIndividual, :FloatFormat ; rdfs:label "VAX G_floating"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "DEC VAX G_floating, a 64-bit VAX format, in the same middle-endian word order as bddo:vaxF: a sign bit, an 11-bit exponent biased by 1024 and a 52-bit fraction with a hidden leading bit. Its fields have the widths of IEEE 754 binary64; the bytes are ordered differently and the exponent is offset by two. Only meaningful for a 64-bit data type."@en .
:bfloat16 a owl:NamedIndividual, :FloatFormat ; rdfs:label "bfloat16"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The 16-bit brain floating-point format: the upper half of an IEEE 754 binary32 value (sign, 8-bit exponent, 7-bit fraction). Only meaningful for a 16-bit data type; distinct from binary16, which bddo:ieee754 denotes at that width."@en .
:crc16 a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "CRC-16"@en ;
    :crcWidth 16 ; :crcPolynomial 4129 ; :crcInit 65535 ; :crcReflectIn false ; :crcReflectOut false ; :crcXorOut 0 ; :crcCheck 10673 ;
    rdfs:comment "CRC-16/CCITT-FALSE (the catalogue's CRC-16/IBM-3740): polynomial 0x1021, initial value 0xFFFF, no input or output reflection, final XOR 0x0000; check value 0x29B1 over the ASCII bytes \"123456789\". No other CRC-16 variant is identified by this term: CRC-16/ARC, XMODEM, MODBUS and X-25 have terms of their own, and any other is a bddo:CustomCrc. HDL: crc16."@en .
:crc32 a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "CRC-32"@en ;
    :crcWidth 32 ; :crcPolynomial 79764919 ; :crcInit 4294967295 ; :crcReflectIn true ; :crcReflectOut true ; :crcXorOut 4294967295 ; :crcCheck 3421780262 ;
    rdfs:comment "CRC-32/ISO-HDLC (the zlib/PNG CRC): polynomial 0x04C11DB7 (0xEDB88320 reflected), initial value 0xFFFFFFFF, input and output reflected, final XOR 0xFFFFFFFF; check value 0xCBF43926 over the ASCII bytes \"123456789\". CRC-32C, BZIP2 and MPEG-2 have terms of their own. HDL: crc32."@en .
:adler32 a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "Adler-32"@en .
:md5 a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "MD5"@en .
:sha1 a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "SHA-1"@en .
:sha256 a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "SHA-256"@en .
# Named CRC variants (Rocksoft model; parameters and check values from the CRC catalogue,
# reveng.sourceforge.io/crc-catalogue). Integers are written in decimal; the comment gives hex.
:crc8Smbus a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "CRC-8/SMBUS"@en ;
    :crcWidth 8 ; :crcPolynomial 7 ; :crcInit 0 ; :crcReflectIn false ; :crcReflectOut false ; :crcXorOut 0 ; :crcCheck 244 ;
    rdfs:comment "CRC-8/SMBUS: width 8, polynomial 0x07, initial value 0x00, input not reflected, output not reflected, final XOR 0x00; check value 0xF4 over the ASCII bytes \"123456789\". HDL: crc8."@en .
:crc16Arc a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "CRC-16/ARC"@en ;
    :crcWidth 16 ; :crcPolynomial 32773 ; :crcInit 0 ; :crcReflectIn true ; :crcReflectOut true ; :crcXorOut 0 ; :crcCheck 47933 ;
    rdfs:comment "CRC-16/ARC: width 16, polynomial 0x8005, initial value 0x0000, input reflected, output reflected, final XOR 0x0000; check value 0xBB3D over the ASCII bytes \"123456789\". HDL: crc16arc."@en .
:crc16Xmodem a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "CRC-16/XMODEM"@en ;
    :crcWidth 16 ; :crcPolynomial 4129 ; :crcInit 0 ; :crcReflectIn false ; :crcReflectOut false ; :crcXorOut 0 ; :crcCheck 12739 ;
    rdfs:comment "CRC-16/XMODEM: width 16, polynomial 0x1021, initial value 0x0000, input not reflected, output not reflected, final XOR 0x0000; check value 0x31C3 over the ASCII bytes \"123456789\". HDL: crc16xmodem."@en .
:crc16Modbus a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "CRC-16/MODBUS"@en ;
    :crcWidth 16 ; :crcPolynomial 32773 ; :crcInit 65535 ; :crcReflectIn true ; :crcReflectOut true ; :crcXorOut 0 ; :crcCheck 19255 ;
    rdfs:comment "CRC-16/MODBUS: width 16, polynomial 0x8005, initial value 0xFFFF, input reflected, output reflected, final XOR 0x0000; check value 0x4B37 over the ASCII bytes \"123456789\". HDL: crc16modbus."@en .
:crc16X25 a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "CRC-16/X-25"@en ;
    :crcWidth 16 ; :crcPolynomial 4129 ; :crcInit 65535 ; :crcReflectIn true ; :crcReflectOut true ; :crcXorOut 65535 ; :crcCheck 36974 ;
    rdfs:comment "CRC-16/IBM-SDLC (X-25): width 16, polynomial 0x1021, initial value 0xFFFF, input reflected, output reflected, final XOR 0xFFFF; check value 0x906E over the ASCII bytes \"123456789\". HDL: crc16x25."@en .
:crc32c a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "CRC-32C"@en ;
    :crcWidth 32 ; :crcPolynomial 517762881 ; :crcInit 4294967295 ; :crcReflectIn true ; :crcReflectOut true ; :crcXorOut 4294967295 ; :crcCheck 3808858755 ;
    rdfs:comment "CRC-32/ISCSI (CRC-32C): width 32, polynomial 0x1EDC6F41, initial value 0xFFFFFFFF, input reflected, output reflected, final XOR 0xFFFFFFFF; check value 0xE3069283 over the ASCII bytes \"123456789\". HDL: crc32c."@en .
:crc32Bzip2 a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "CRC-32/BZIP2"@en ;
    :crcWidth 32 ; :crcPolynomial 79764919 ; :crcInit 4294967295 ; :crcReflectIn false ; :crcReflectOut false ; :crcXorOut 4294967295 ; :crcCheck 4236843288 ;
    rdfs:comment "CRC-32/BZIP2: width 32, polynomial 0x04C11DB7, initial value 0xFFFFFFFF, input not reflected, output not reflected, final XOR 0xFFFFFFFF; check value 0xFC891918 over the ASCII bytes \"123456789\". HDL: crc32bzip2."@en .
:crc32Mpeg2 a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "CRC-32/MPEG-2"@en ;
    :crcWidth 32 ; :crcPolynomial 79764919 ; :crcInit 4294967295 ; :crcReflectIn false ; :crcReflectOut false ; :crcXorOut 0 ; :crcCheck 58124007 ;
    rdfs:comment "CRC-32/MPEG-2: width 32, polynomial 0x04C11DB7, initial value 0xFFFFFFFF, input not reflected, output not reflected, final XOR 0x00000000; check value 0x0376E6E7 over the ASCII bytes \"123456789\". HDL: crc32mpeg2."@en .
:crc64Ecma182 a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "CRC-64/ECMA-182"@en ;
    :crcWidth 64 ; :crcPolynomial 4823603603198064275 ; :crcInit 0 ; :crcReflectIn false ; :crcReflectOut false ; :crcXorOut 0 ; :crcCheck 7800480153909949255 ;
    rdfs:comment "CRC-64/ECMA-182: width 64, polynomial 0x42F0E1EBA9EA3693, initial value 0x0000000000000000, input not reflected, output not reflected, final XOR 0x0000000000000000; check value 0x6C40DF5F0B497347 over the ASCII bytes \"123456789\". HDL: crc64ecma."@en .
:crc64Xz a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "CRC-64/XZ"@en ;
    :crcWidth 64 ; :crcPolynomial 4823603603198064275 ; :crcInit 18446744073709551615 ; :crcReflectIn true ; :crcReflectOut true ; :crcXorOut 18446744073709551615 ; :crcCheck 11051210869376104954 ;
    rdfs:comment "CRC-64/XZ: width 64, polynomial 0x42F0E1EBA9EA3693, initial value 0xFFFFFFFFFFFFFFFF, input reflected, output reflected, final XOR 0xFFFFFFFFFFFFFFFF; check value 0x995DC9BBDF1939FA over the ASCII bytes \"123456789\". HDL: crc64xz."@en .

# ---------- Core primitive DataType instances ----------
{{datatype:uint8}}
{{datatype:int8}}
{{datatype:uint16}}
{{datatype:uint16be}}
{{datatype:uint16le}}
{{datatype:uint24}}
{{datatype:uint24be}}
{{datatype:uint24le}}
{{datatype:uint32}}
{{datatype:uint32be}}
{{datatype:uint32le}}
{{datatype:uint64}}
{{datatype:uint64be}}
{{datatype:uint64le}}
{{datatype:int16}}
{{datatype:int16be}}
{{datatype:int16le}}
{{datatype:int24}}
{{datatype:int24be}}
{{datatype:int24le}}
{{datatype:int32}}
{{datatype:int32be}}
{{datatype:int32le}}
{{datatype:int64}}
{{datatype:int64be}}
{{datatype:int64le}}
{{datatype:float16}}
{{datatype:float16be}}
{{datatype:float16le}}
{{datatype:float32}}
{{datatype:float32be}}
{{datatype:float32le}}
{{datatype:float64}}
{{datatype:float64be}}
{{datatype:float64le}}
:bytes  a owl:NamedIndividual , :DataType ; rdfs:label "bytes"@en  ; :baseType :baseBytes  ; :xsdType xsd:hexBinary .
:bytes skos:scopeNote "The uninterpreted byte-sequence DATA TYPE of a field. Not hxf:bytes, the SPARQL function that returns the bytes of a lifted resource."@en .
:string a owl:NamedIndividual , :DataType ; rdfs:label "string"@en ; :baseType :baseString ; :xsdType xsd:string .

# ---------- ASCII-coded numeric types ----------
# Numbers written as text in a fixed-width field (NITF BCS-N, FITS card values,
# USGSDEM Fortran fields). The parsed HEL value is numeric, so these fields may
# drive sizing, offset and repeat expressions — which bddo:string cannot.
:asciiInteger a owl:NamedIndividual , :DataType ; rdfs:label "asciiInteger"@en ; :baseType :baseInteger ; :encoding :ascii ; :xsdType xsd:integer ;
    rdfs:comment "An integer written as text, occupying the field's declared width (bddo:size) or ending at its terminator. Surrounding space and a leading '+'/'-' are accepted. Radix is bddo:numericBase, default 10. Yields a HEL Integer."@en .
:asciiDecimal a owl:NamedIndividual , :DataType ; rdfs:label "asciiDecimal"@en ; :baseType :baseFloat ; :encoding :ascii ; :xsdType xsd:decimal ;
    rdfs:comment "A fixed- or floating-point number written as text, occupying the field's declared width or ending at its terminator. Accepts leading sign, decimal point and an exponent introduced by E, e, D or d -- Fortran writes a double-precision exponent with D, and formats written by Fortran (USGSDEM record A) use it. A value spelled 'nan' (any case, optional leading sign) reads as a not-a-number; an infinite value is not accepted. Yields a HEL Float."@en .

# ---------- Variable-length integers ----------
# A varint's width is neither intrinsic (as with uint32) nor declared (as with
# asciiInteger's bddo:size): it is DISCOVERED while reading, from the values of the bytes
# themselves. These are therefore the first data types with no width at all, and a field
# using one must not declare a size -- there is nothing for a size to mean, and stating one
# would contradict the bytes. sizeof() on such a field still yields the length actually
# consumed, once it is known.
#
# They are what modern container formats are built from: protobuf key/length prefixes (MVT,
# OSM PBF), the PMTiles directory, Parquet's Thrift-compact footer, FlatGeobuf and
# OpenFileGDB geometry. Framing those was already possible byte by byte; reconstructing the
# VALUE was not, which is what kept them out of reach.
:varuint a owl:NamedIndividual , :DataType ; rdfs:label "varuint"@en ; :baseType :baseInteger ; :isSigned false ; :xsdType xsd:nonNegativeInteger ;
    rdfs:comment "Unsigned base-128 varint (LEB128): 7 value bits per byte, little-endian, the high bit set on every byte but the last. Protobuf's plain varint."@en .
:varint a owl:NamedIndividual , :DataType ; rdfs:label "varint"@en ; :baseType :baseInteger ; :isSigned true ; :xsdType xsd:integer ;
    rdfs:comment "Signed base-128 varint: LEB128 carrying a zigzag-encoded value, so small negatives stay short -- n maps to (n << 1) XOR (n >> 63). Protobuf's sint32/sint64. Distinct from reading an unsigned varint and reinterpreting the bits, which is protobuf's int32 and sign-extends instead."@en .
:sqliteVarint a owl:NamedIndividual , :DataType ; rdfs:label "sqliteVarint"@en ; :baseType :baseInteger ; :isSigned true ; :xsdType xsd:integer ;
    rdfs:comment "SQLite's variable-length integer: one to nine BIG-endian bytes, high bit as continuation for the first eight, the ninth contributing all eight bits. A different scheme from LEB128, not a dialect of it; used by SQLite-backed formats (GeoPackage, MBTiles, Rasterlite)."@en .

# =========================================================
# SHACL shapes (domain + cardinality; refine the declared ranges)
# =========================================================
bddo:_prefixes sh:declare
    [ sh:prefix "bddo" ; sh:namespace "https://hexplain.io/ns/bddo#"^^xsd:anyURI ] ,
    [ sh:prefix "rdf" ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ,
    [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] .

bddo:StructShape a sh:NodeShape ;
    sh:targetClass bddo:Struct ;
    sh:property [ sh:path bddo:hasField ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "bddo:hasField must point to a single rdf:List." ] ;
    sh:property [ sh:path ( bddo:hasField [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:or ( [ sh:class bddo:Field ] [ sh:class bddo:LocalBinding ] ) ;
        sh:message "Every member of a Struct's hasField list must be a bddo:Field or a bddo:LocalBinding." ] ;
    sh:property {{constraint:pattern_123}} ;
    sh:property [ sh:path bddo:bitOrder ; sh:maxCount 1 ; sh:in ( bddo:MSBFirst bddo:LSBFirst ) ;
        sh:message "bddo:bitOrder takes at most one value; each is either bddo:MSBFirst or bddo:LSBFirst." ] ;
    sh:property [ sh:path bddo:syncOnMarker ; sh:maxCount 1 ; sh:datatype xsd:hexBinary ;
        sh:message "bddo:syncOnMarker takes at most one value; each is an xsd:hexBinary literal." ] ;
    # Struct-level alignment and padding: where each instance starts, and to what boundary it ends.
    sh:property [ sh:path bddo:alignment ; sh:minExclusive 0 ; sh:maxCount 1 ;
        sh:message "bddo:alignment takes at most one value; each is a number greater than 0." ] ;
    sh:property [ sh:path bddo:padTo ; sh:minExclusive 0 ; sh:maxCount 1 ;
        sh:message "bddo:padTo takes at most one value; each is a number greater than 0." ] ;
    sh:property [ sh:path bddo:padByte ; sh:datatype xsd:hexBinary ; sh:pattern "^[0-9A-Fa-f]{2}$" ; sh:maxCount 1 ;
        sh:message "bddo:padByte takes at most one value; each is one xsd:hexBinary octet (two hex digits)." ] ;
    # Struct-level size bounds the byte extent of the Struct (a bounded region for its children).
    sh:property {{constraint:pattern_158}} ;
    sh:property {{constraint:pattern_160}} ;
    sh:property {{constraint:pattern_159}} .

# At most one struct-sizing mechanism per Struct.
bddo:StructSizingShape a sh:NodeShape ;
    sh:targetClass bddo:Struct ;
    sh:sparql [ sh:message "A bddo:Struct must use at most one sizing mechanism (size / sizeFromField / sizeFromExpression)." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this ?p ?v .
            FILTER(?p IN (bddo:size, bddo:sizeFromField, bddo:sizeFromExpression))
        } GROUP BY $this HAVING (COUNT(DISTINCT ?p) > 1)""" ] .

bddo:FieldShape a sh:NodeShape ;
    sh:targetClass bddo:Field ;
    sh:message "A bddo:Field declares how it is typed: bddo:dataType, bddo:hasConditionalDataType, bddo:hasDispatchTable or bddo:valueFromExpression." ;
    sh:or (
        [ sh:property [ sh:path bddo:dataType ; sh:minCount 1 ] ]
        [ sh:property [ sh:path bddo:hasConditionalDataType ; sh:minCount 1 ] ]
        [ sh:property [ sh:path bddo:valueFromExpression ; sh:minCount 1 ] ]
        [ sh:property [ sh:path bddo:hasDispatchTable ; sh:minCount 1 ] ]
    ) ;
    sh:property [ sh:path bddo:dataType ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class bddo:DataType ] [ sh:class bddo:Struct ] ) ;
        sh:message "bddo:dataType takes at most one value; each is an IRI naming an instance of bddo:DataType or bddo:Struct." ] ;
    sh:property [ sh:path ( bddo:hasConditionalDataType [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:class bddo:DataTypeRule ;
        sh:message "Every member of a hasConditionalDataType list must be a bddo:DataTypeRule." ] ;
    sh:property [ sh:path bddo:hasDispatchTable ; sh:maxCount 1 ; sh:class bddo:DispatchTable ;
        sh:message "bddo:hasDispatchTable takes at most one value; each is an instance of bddo:DispatchTable." ] ;
    sh:property [ sh:path bddo:seekScope ; sh:maxCount 1 ; sh:in ( bddo:regionScope bddo:streamScope ) ;
        sh:message "bddo:seekScope takes at most one value; each is either bddo:regionScope or bddo:streamScope." ] ;
    sh:property {{constraint:pattern_158}} ;
    sh:property {{constraint:pattern_160}} ;
    sh:property {{constraint:pattern_159}} ;
    sh:property [ sh:path bddo:sizeToEndOfStream ; sh:datatype xsd:boolean ; sh:maxCount 1 ;
        sh:message "bddo:sizeToEndOfStream takes at most one value; each is an xsd:boolean literal." ] ;
    sh:property [ sh:path bddo:terminator ; sh:datatype xsd:hexBinary ; sh:maxCount 1 ;
        sh:message "bddo:terminator takes at most one value; each is an xsd:hexBinary literal." ] ;
    sh:property [ sh:path bddo:separatedBy ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:in ( "whitespace" ) ;
        sh:message "bddo:separatedBy takes at most one value; each is an xsd:string literal equal to \"whitespace\"." ] ;
    # What bddo:separatedBy excludes is bddo:SeparatedFieldExtentShape.
    sh:property [ sh:path bddo:trimNull ; sh:datatype xsd:boolean ; sh:maxCount 1 ;
        sh:message "bddo:trimNull takes at most one value; each is an xsd:boolean literal." ] ;
    # The encoding set is OPEN: a registered individual, or any bddo:Encoding (a profile's
    # bddo:CustomEncoding). The registered individuals are also accepted by name, so that a
    # description validates against these shapes alone, without the vocabulary loaded; anything
    # else must be typed. An unregistered encoding is then reported once more, as a warning.
    sh:property [ sh:path bddo:encoding ; sh:maxCount 1 ;
        sh:or ( [ sh:in ( {{constraint:registered_encodings}} ) ]
                [ sh:class bddo:Encoding ] ) ;
        sh:message "bddo:encoding takes at most one value; each is a registered bddo:Encoding individual or an instance of bddo:Encoding (a bddo:CustomEncoding a profile mints)." ] ;
    sh:property [ sh:path bddo:encoding ; sh:severity sh:Warning ;
        sh:in ( {{constraint:registered_encodings}} ) ;
        sh:message "bddo:encoding names an encoding outside the registered set (the bddo:Encoding individuals this vocabulary declares); a bddo:CustomEncoding is accepted, but only a processor that supports its bddo:ianaCharset can decode it." ] ;
    sh:property [ sh:path bddo:bitLength ; sh:minExclusive 0 ; sh:maxCount 1 ;
        sh:message "bddo:bitLength takes at most one value; each is a number greater than 0." ] ;
    # A field's bit order overrides its struct's (Processing Model, bit-level fields).
    sh:property [ sh:path bddo:bitOrder ; sh:maxCount 1 ; sh:in ( bddo:MSBFirst bddo:LSBFirst ) ;
        sh:message "bddo:bitOrder takes at most one value; each is either bddo:MSBFirst or bddo:LSBFirst." ] ;
    sh:property [ sh:path bddo:alignment ; sh:minExclusive 0 ; sh:maxCount 1 ;
        sh:message "bddo:alignment takes at most one value; each is a number greater than 0." ] ;
    sh:property [ sh:path bddo:padTo ; sh:minExclusive 0 ; sh:maxCount 1 ;
        sh:message "bddo:padTo takes at most one value; each is a number greater than 0." ] ;
    sh:property [ sh:path bddo:padByte ; sh:datatype xsd:hexBinary ; sh:pattern "^[0-9A-Fa-f]{2}$" ; sh:maxCount 1 ;
        sh:message "bddo:padByte takes at most one value; each is one xsd:hexBinary octet (two hex digits)." ] ;
    # A fixed value is one literal; a repetition is stated once, by one mechanism (the
    # mechanisms' exclusivity is bddo:FieldRepetitionShape).
    sh:property [ sh:path bddo:hasFixedValue ; sh:nodeKind sh:Literal ; sh:maxCount 1 ;
        sh:message "bddo:hasFixedValue takes at most one value; each is a literal." ] ;
    sh:property [ sh:path bddo:repeatCount ; sh:minInclusive 0 ; sh:maxCount 1 ;
        sh:message "bddo:repeatCount takes at most one value; each is a number at least 0." ] ;
    sh:property [ sh:path bddo:repeatCountFromField ; sh:class bddo:Field ; sh:maxCount 1 ;
        sh:message "bddo:repeatCountFromField takes at most one value; each is an instance of bddo:Field." ] ;
    sh:property [ sh:path bddo:repeatCountFromExpression ; sh:node bddo:HelExpressionValueShape ; sh:maxCount 1 ;
        sh:message "bddo:repeatCountFromExpression takes at most one value; each is a HEL expression (an xsd:string or bddo:HelExpression literal)." ] ;
    sh:property [ sh:path bddo:repeatUntil ; sh:node bddo:HelExpressionValueShape ; sh:maxCount 1 ;
        sh:message "bddo:repeatUntil takes at most one value; each is a HEL expression (an xsd:string or bddo:HelExpression literal)." ] ;
    # Numeric representation (bddo:NumericRepresentationShape says which base type each needs).
    sh:property {{constraint:float_format}} ;
    sh:property [ sh:path bddo:fixedPointScale ; sh:maxCount 1 ;
        sh:message "bddo:fixedPointScale takes at most one value." ] ;
    sh:property [ sh:path bddo:bcd ; sh:datatype xsd:boolean ; sh:maxCount 1 ;
        sh:message "bddo:bcd takes at most one value; each is an xsd:boolean literal." ] ;
    sh:property [ sh:path bddo:atOffset ; sh:minInclusive 0 ; sh:maxCount 1 ;
        sh:message "bddo:atOffset takes at most one value; each is a number at least 0." ] ;
    sh:property [ sh:path bddo:atOffsetFromField ; sh:class bddo:Field ; sh:maxCount 1 ;
        sh:message "bddo:atOffsetFromField takes at most one value; each is an instance of bddo:Field." ] ;
    sh:property [ sh:path bddo:atOffsetFromExpression ; sh:node bddo:HelExpressionValueShape ; sh:maxCount 1 ;
        sh:message "bddo:atOffsetFromExpression takes at most one value; each is a HEL expression (an xsd:string or bddo:HelExpression literal)." ] ;
    sh:property [ sh:path bddo:offsetBase ; sh:maxCount 1 ;
        sh:in ( bddo:streamStart bddo:streamEnd bddo:parentStart bddo:currentPosition bddo:fieldStart ) ;
        sh:message "bddo:offsetBase takes at most one value; each is one of bddo:streamStart, bddo:streamEnd, bddo:parentStart, bddo:currentPosition or bddo:fieldStart." ] ;
    sh:property [ sh:path bddo:offsetBaseField ; sh:class bddo:Field ; sh:maxCount 1 ;
        sh:message "bddo:offsetBaseField takes at most one value; each is an instance of bddo:Field." ] ;
    sh:property [ sh:path bddo:enumeration ; sh:class bddo:Enumeration ; sh:maxCount 1 ;
        sh:message "bddo:enumeration takes at most one value; each is an instance of bddo:Enumeration." ] ;
    sh:property [ sh:path bddo:checksum ; sh:class bddo:Checksum ; sh:maxCount 1 ;
        sh:message "bddo:checksum takes at most one value; each is an instance of bddo:Checksum." ] ;
    sh:property [ sh:path bddo:valueFromExpression ; sh:node bddo:HelExpressionValueShape ; sh:maxCount 1 ;
        sh:message "bddo:valueFromExpression takes at most one value; each is a HEL expression (an xsd:string or bddo:HelExpression literal)." ] ;
    sh:property [ sh:path bddo:validIf ; sh:node bddo:HelExpressionValueShape ; sh:maxCount 1 ;
        sh:message "bddo:validIf takes at most one value; each is a HEL expression (an xsd:string or bddo:HelExpression literal)." ] ;
    sh:property [ sh:path bddo:rootKeyFromField ; sh:class bddo:Field ; sh:maxCount 1 ;
        sh:message "bddo:rootKeyFromField takes at most one value; each is an instance of bddo:Field." ] ;
    sh:property [ sh:path bddo:isPresentIf ; sh:node bddo:HelExpressionValueShape ; sh:maxCount 1 ;
        sh:message "bddo:isPresentIf takes at most one value; each is a HEL expression (an xsd:string or bddo:HelExpression literal)." ] .

# bddo:separatedBy IS the field's extent, so it excludes every other way of stating one.
# All five, not just the two literal spellings: a separated field declaring
# sizeFromField/sizeFromExpression/sizeToEndOfStream would otherwise satisfy both bddo:FieldShape
# and bddo:AsciiNumericWidthShape while asserting a width the reader provably ignores
# (a conforming processor resolves bddo:separatedBy before any size declaration), which is a false
# statement that validates. One property shape per excluded mechanism, so that a result names
# the property that must go.
bddo:SeparatedFieldExtentShape a sh:NodeShape ; rdfs:label "Separated field extent shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "A field whose extent is its separator (bddo:separatedBy) states no other extent: no bddo:size, bddo:sizeFromField, bddo:sizeFromExpression, bddo:sizeToEndOfStream or bddo:terminator."@en ;
    sh:targetSubjectsOf bddo:separatedBy ;
    sh:property [ sh:path bddo:size ; sh:maxCount 0 ;
        sh:message "A field separated by bddo:separatedBy states no bddo:size: the separator is its extent." ] ;
    sh:property [ sh:path bddo:sizeFromField ; sh:maxCount 0 ;
        sh:message "A field separated by bddo:separatedBy states no bddo:sizeFromField: the separator is its extent." ] ;
    sh:property [ sh:path bddo:sizeFromExpression ; sh:maxCount 0 ;
        sh:message "A field separated by bddo:separatedBy states no bddo:sizeFromExpression: the separator is its extent." ] ;
    sh:property [ sh:path bddo:sizeToEndOfStream ; sh:maxCount 0 ;
        sh:message "A field separated by bddo:separatedBy states no bddo:sizeToEndOfStream: the separator is its extent." ] ;
    sh:property [ sh:path bddo:terminator ; sh:maxCount 0 ;
        sh:message "A field separated by bddo:separatedBy states no bddo:terminator: the separator is its extent." ] .

# At most one sizing mechanism per field.
bddo:FieldSizingShape a sh:NodeShape ;
    sh:targetClass bddo:Field ;
    sh:sparql [ sh:message "A bddo:Field must use at most one sizing/termination mechanism." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this ?p ?v .
            FILTER(?p IN (bddo:size, bddo:sizeFromField, bddo:sizeFromExpression,
                          bddo:sizeToEndOfStream, bddo:terminator))
        } GROUP BY $this HAVING (COUNT(DISTINCT ?p) > 1)""" ] .

# A variable-length field (bytes/string) MUST declare exactly one sizing/termination.
# Exempt: a field of a delimited-record container gets its extent from the container's
# recordDelimiter/fieldDelimiter, not from its own size or terminator.
bddo:VariableLengthFieldShape a sh:NodeShape ;
    sh:targetClass bddo:Field ;
    sh:sparql [ sh:message "A bddo:bytes or bddo:string field must declare a sizing or termination mechanism." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this bddo:dataType ?dt . FILTER(?dt IN (bddo:bytes, bddo:string))
            FILTER NOT EXISTS {
                $this ?p ?v .
                FILTER(?p IN (bddo:size, bddo:sizeFromField, bddo:sizeFromExpression,
                              bddo:sizeToEndOfStream, bddo:terminator))
            }
            FILTER NOT EXISTS {
                ?p bddo:hasField/rdf:rest*/rdf:first $this .
                ?p a ?c .
                # Every container form that determines a field's extent ITSELF -- a delimited
                # record ends at its delimiter, a tree node at its own boundary -- so a declared
                # width would be a second, contradictory answer. Enumerated rather than inferred
                # via rdfs:subClassOf, because these shapes run without inference; a new
                # container form has to be added here too.
                FILTER(?c IN (bddo:DelimitedRecords, bddo:KeyValueHeader, bddo:DelimitedTable,
                              bddo:TreeDocument))
            }
        }""" ] .

# At most one repetition mechanism per field.
bddo:FieldRepetitionShape a sh:NodeShape ;
    sh:targetClass bddo:Field ;
    sh:sparql [ sh:message "A bddo:Field must use at most one repetition mechanism." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this ?p ?v .
            FILTER(?p IN (bddo:repeatCount, bddo:repeatCountFromField,
                          bddo:repeatCountFromExpression, bddo:repeatUntil))
        } GROUP BY $this HAVING (COUNT(DISTINCT ?p) > 1)""" ] .

# At most one offset mechanism per field.
bddo:FieldOffsetShape a sh:NodeShape ;
    sh:targetClass bddo:Field ;
    sh:sparql [ sh:message "A bddo:Field must use at most one offset mechanism." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this ?p ?v .
            FILTER(?p IN (bddo:atOffset, bddo:atOffsetFromField, bddo:atOffsetFromExpression))
        } GROUP BY $this HAVING (COUNT(DISTINCT ?p) > 1)""" ] .

# A sibling-relative offset names its sibling, and only a sibling-relative offset does.
bddo:OffsetBaseFieldShape a sh:NodeShape ; rdfs:label "Offset base field shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "bddo:offsetBase bddo:fieldStart and bddo:offsetBaseField are stated together, and the base field is an earlier member of the struct that contains the offset-addressed field, so that its start is known when the offset is resolved."@en ;
    sh:targetSubjectsOf bddo:offsetBase , bddo:offsetBaseField ;
    sh:sparql [ sh:message "bddo:offsetBase bddo:fieldStart needs bddo:offsetBaseField: the sibling field whose start is the origin." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this bddo:offsetBase bddo:fieldStart .
            FILTER NOT EXISTS { $this bddo:offsetBaseField ?base }
        }""" ] ;
    sh:sparql [ sh:message "bddo:offsetBaseField is only meaningful with bddo:offsetBase bddo:fieldStart." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this bddo:offsetBaseField ?base .
            FILTER NOT EXISTS { $this bddo:offsetBase bddo:fieldStart }
        }""" ] ;
    sh:sparql [ sh:message "bddo:offsetBaseField names {?base}, which is not an earlier member of the struct containing this field: its start is not known when the offset is resolved." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this ?base WHERE {
            $this bddo:offsetBaseField ?base .
            ?struct bddo:hasField/rdf:rest*/rdf:first $this .
            FILTER NOT EXISTS {
                ?struct bddo:hasField/rdf:rest* ?node .
                ?node rdf:first ?base ; rdf:rest+/rdf:first $this .
            }
        }""" ] .

# An origin selects where boundaries are counted from, so it needs a boundary to count.
bddo:AlignmentOriginShape a sh:NodeShape ; rdfs:label "Alignment origin shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "bddo:alignmentOrigin is stated at most once, as bddo:streamOrigin or bddo:structOrigin, on a Field or Struct that states bddo:alignment or bddo:padTo."@en ;
    sh:targetSubjectsOf bddo:alignmentOrigin ;
    sh:message "bddo:alignmentOrigin is only meaningful beside bddo:alignment or bddo:padTo, whose boundaries it measures." ;
    sh:or ( [ sh:property [ sh:path bddo:alignment ; sh:minCount 1 ] ]
            [ sh:property [ sh:path bddo:padTo ; sh:minCount 1 ] ] ) ;
    sh:property [ sh:path bddo:alignmentOrigin ; sh:maxCount 1 ; sh:in ( bddo:streamOrigin bddo:structOrigin ) ;
        sh:message "bddo:alignmentOrigin takes at most one value; each is either bddo:streamOrigin or bddo:structOrigin." ] .

# A derived (zero-byte) field computes its value from an expression and MUST NOT
# also consume bytes via a data type, sizing, offset, bit-length or enumeration, nor move the
# cursor with an alignment or a padding: it has no start to align and no end to pad.
bddo:DerivedFieldShape a sh:NodeShape ;
    sh:targetClass bddo:Field ;
    sh:sparql [ sh:message "A bddo:valueFromExpression (derived) field must not also declare a byte-consuming or byte-positioning mechanism (dataType, hasConditionalDataType, size*, terminator, bitLength, atOffset*, enumeration, alignment or padTo): it occupies no bytes to type, size, place, align or pad." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this bddo:valueFromExpression ?e .
            $this ?p ?v .
            FILTER(?p IN (bddo:dataType, bddo:hasConditionalDataType, bddo:size,
                          bddo:sizeFromField, bddo:sizeFromExpression, bddo:sizeToEndOfStream,
                          bddo:terminator, bddo:bitLength, bddo:atOffset, bddo:atOffsetFromField,
                          bddo:atOffsetFromExpression, bddo:enumeration, bddo:alignment, bddo:padTo))
        }""" ] .

bddo:DataTypeShape a sh:NodeShape ;
    sh:targetClass bddo:DataType ;
    sh:property [ sh:path bddo:baseType ; sh:maxCount 1 ;
        sh:in ( bddo:baseInteger bddo:baseFloat bddo:baseString bddo:baseBytes ) ;
        sh:message "bddo:baseType takes at most one value; each is one of bddo:baseInteger, bddo:baseFloat, bddo:baseString or bddo:baseBytes." ] ;
    sh:property [ sh:path bddo:bitWidth ; sh:minExclusive 0 ; sh:maxCount 1 ;
        sh:message "bddo:bitWidth takes at most one value; each is a number greater than 0." ] ;
    sh:property [ sh:path bddo:isSigned ; sh:datatype xsd:boolean ; sh:maxCount 1 ;
        sh:message "bddo:isSigned takes at most one value; each is an xsd:boolean literal." ] ;
    sh:property {{constraint:pattern_123}} ;
    sh:property [ sh:path bddo:xsdType ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:message "bddo:xsdType takes at most one value; each is an IRI." ] ;
    # A profile's own datatype may fix its numeric representation for every field that uses it.
    sh:property {{constraint:float_format}} ;
    sh:property [ sh:path bddo:fixedPointScale ; sh:maxCount 1 ;
        sh:message "bddo:fixedPointScale takes at most one value." ] ;
    sh:property [ sh:path bddo:bcd ; sh:datatype xsd:boolean ; sh:maxCount 1 ;
        sh:message "bddo:bcd takes at most one value; each is an xsd:boolean literal." ] .

# A representation says how the bits of a NUMBER are read, so it needs the base type it is
# for: a float format on an integer field, or a BCD flag on a float, describes nothing. Checked
# only where the base type is known (a stated bddo:dataType with a bddo:baseType, or the subject's
# own bddo:baseType); a conditional or dispatched type is resolved by the processor.
bddo:NumericRepresentationShape a sh:NodeShape ;
    rdfs:comment "bddo:floatFormat applies to a floating-point Field or DataType (bddo:baseType bddo:baseFloat); bddo:fixedPointScale and bddo:bcd apply to an integer one (bddo:baseType bddo:baseInteger). Also, a BCD field is not scaled: bddo:bcd true and bddo:fixedPointScale are mutually exclusive, because the digits spell a decimal number, not a binary one."@en ;
    sh:targetSubjectsOf bddo:floatFormat , bddo:fixedPointScale , bddo:bcd ;
    sh:message "bddo:bcd true and bddo:fixedPointScale are mutually exclusive: BCD digits spell a decimal number, which no binary scale applies to." ;
    sh:not [ sh:and ( [ sh:property [ sh:path bddo:bcd ; sh:hasValue true ] ]
                      [ sh:property [ sh:path bddo:fixedPointScale ; sh:minCount 1 ] ] ) ] ;
    sh:sparql [ sh:message "bddo:floatFormat applies to a floating-point Field or DataType; {?base} is not bddo:baseFloat." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this ?base WHERE {
            $this bddo:floatFormat ?f .
            { $this bddo:dataType/bddo:baseType ?base } UNION { $this bddo:baseType ?base }
            FILTER(?base != bddo:baseFloat)
        }""" ] ;
    sh:sparql [ sh:message "{?p} applies to an integer Field or DataType; {?base} is not bddo:baseInteger." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this ?p ?base WHERE {
            $this ?p ?v .
            FILTER(?p IN (bddo:fixedPointScale, bddo:bcd))
            { $this bddo:dataType/bddo:baseType ?base } UNION { $this bddo:baseType ?base }
            FILTER(?base != bddo:baseInteger)
        }""" ] .

# A float format is a layout of a particular number of bits. Checked where the width is known
# (a stated bddo:dataType with a bddo:bitWidth, or the subject's own bddo:bitWidth); a
# conditional or dispatched type is resolved by the processor.
bddo:FloatFormatWidthShape a sh:NodeShape ; rdfs:label "Float format width shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "A bddo:floatFormat is used at a width it exists at: bddo:bfloat16 on a 16-bit float, bddo:ibmHexadecimal on a 32- or 64-bit float, bddo:vaxF on a 32-bit float (a 64-bit one is the deprecated spelling of bddo:vaxD, reported by bddo:DeprecatedVaxFWidthShape), bddo:vaxD and bddo:vaxG on a 64-bit float."@en ;
    sh:targetSubjectsOf bddo:floatFormat ;
    sh:sparql [ sh:message "{?format} does not exist at {?width} bits: bddo:bfloat16 is a 16-bit format, bddo:ibmHexadecimal and bddo:vaxF are 32- or 64-bit formats, and bddo:vaxD and bddo:vaxG are 64-bit formats." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this ?format ?width WHERE {
            $this bddo:floatFormat ?format .
            { $this bddo:dataType/bddo:bitWidth ?width } UNION { $this bddo:bitWidth ?width }
            FILTER((?format = bddo:bfloat16 && ?width != 16)
                || (?format IN (bddo:ibmHexadecimal, bddo:vaxF) && ?width NOT IN (32, 64))
                || (?format IN (bddo:vaxD, bddo:vaxG) && ?width != 64))
        }""" ] .

# The deprecated spelling keeps its meaning and is reported, so that descriptions migrate.
bddo:DeprecatedVaxFWidthShape a sh:NodeShape ; rdfs:label "Deprecated VAX F width shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "Advisory (sh:Warning): bddo:vaxF on a 64-bit float is the deprecated spelling of bddo:vaxD. It is read as D_floating and does not make the description invalid."@en ;
    sh:targetSubjectsOf bddo:floatFormat ;
    sh:severity sh:Warning ;
    sh:sparql [ sh:message "bddo:vaxF on a 64-bit float is deprecated: it is read as VAX D_floating; name bddo:vaxD (or bddo:vaxG for G_floating)." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this bddo:floatFormat bddo:vaxF .
            { $this bddo:dataType/bddo:bitWidth ?width } UNION { $this bddo:bitWidth ?width }
            FILTER(?width = 64)
        }""" ] .

# BCD is two decimal digits in each whole byte of an unsigned binary integer; nothing else has
# bytes to read that way. The flag false is the default and constrains nothing.
bddo:BcdShape a sh:NodeShape ; rdfs:label "BCD shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "bddo:bcd true is stated on an unsigned fixed-width binary integer Field or DataType: not beside bddo:bitLength, not on a variable-length integer or a number written as text, and not on a signed type."@en ;
    sh:targetSubjectsOf bddo:bcd ;
    sh:message "bddo:bcd true is not combined with bddo:bitLength: BCD packs two decimal digits into each whole byte." ;
    sh:not [ sh:and ( [ sh:property [ sh:path bddo:bcd ; sh:hasValue true ] ]
                      [ sh:property [ sh:path bddo:bitLength ; sh:minCount 1 ] ] ) ] ;
    sh:sparql [ sh:message "bddo:bcd true does not apply to {?type}: a variable-length integer or a number written as text is not a sequence of BCD bytes." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this ?type WHERE {
            $this bddo:bcd true ; bddo:dataType ?type .
            FILTER(?type IN (bddo:varuint, bddo:varint, bddo:sqliteVarint, bddo:asciiInteger, bddo:asciiDecimal))
        }""" ] ;
    sh:sparql [ sh:message "bddo:bcd true applies to an unsigned integer type: packed BCD has no sign nibble, so a signed type has no reading." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this bddo:bcd true .
            { $this bddo:dataType/bddo:isSigned true } UNION { $this bddo:isSigned true }
        }""" ] .

# The portable range of a binary scale (bddo:fixedPointScale): advice, since a processor may
# support more and reports a Description error for an exponent it does not.
bddo:FixedPointScaleRangeShape a sh:NodeShape ; rdfs:label "Fixed-point scale range shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "Advisory (sh:Warning): a bddo:fixedPointScale outside -4096..4096 is beyond the range every processor supports, so the description is not portable. It does not make the description invalid."@en ;
    sh:targetSubjectsOf bddo:fixedPointScale ;
    sh:property [ sh:path bddo:fixedPointScale ; sh:severity sh:Warning ; sh:minInclusive -4096 ; sh:maxInclusive 4096 ;
        sh:message "bddo:fixedPointScale is outside -4096..4096, the range every processor supports; a processor may report a Description error for it." ] .

# A fill byte describes padding, so it needs padding to describe.
bddo:PaddingShape a sh:NodeShape ;
    rdfs:comment "bddo:padByte states what the padding bddo:padTo introduces is expected to hold; without bddo:padTo there is no padding for it to describe."@en ;
    sh:targetSubjectsOf bddo:padByte ;
    sh:property [ sh:path bddo:padTo ; sh:minCount 1 ;
        sh:message "bddo:padByte is only meaningful beside bddo:padTo, which introduces the padding it describes." ] .

# A custom encoding is identified by its charset name, exactly once, and is accepted (with a
# warning from bddo:FieldShape) wherever a registered encoding is.
bddo:CustomEncodingShape a sh:NodeShape ;
    # Activated by the class and by the property, so that an encoding a profile forgot to type
    # is still checked. The registered encodings state bddo:ianaCharset too and are therefore
    # focus nodes; every constraint below holds for them. (bddo:ucs2le and bddo:ucs2be state
    # none and are not focus nodes: ISO-10646-UCS-2 names no byte order, which the two terms
    # give.) That a registered encoding is not re-typed as a custom one is
    # bddo:CustomEncodingIdentityShape; the charset names a custom encoding should not use are
    # bddo:CustomEncodingCharsetShape.
    sh:targetClass bddo:CustomEncoding ;
    sh:targetSubjectsOf bddo:ianaCharset ;
    sh:message "An encoding that states a bddo:ianaCharset is an IRI, so that the fields using it can name it." ;
    sh:nodeKind sh:IRI ;
    # IANA charset names: up to 40 characters from letters, digits and the punctuation the
    # registry permits, starting with a letter or digit.
    sh:property [ sh:path bddo:ianaCharset ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^[A-Za-z0-9][A-Za-z0-9._:()+-]{0,39}$" ;
        sh:message "An encoding states exactly one bddo:ianaCharset, an IANA Character Sets registry name (letters, digits and . _ : ( ) + -, at most 40 characters); a bddo:CustomEncoding must state it." ] .

# The registered encodings are this vocabulary's: a profile that types one of them
# bddo:CustomEncoding would be claiming to have minted it. Activated like
# bddo:CustomEncodingShape, by the class and by the property; the registered encodings are
# focus nodes through their own bddo:ianaCharset, and pass unless they are ALSO typed
# bddo:CustomEncoding.
bddo:CustomEncodingIdentityShape a sh:NodeShape ; rdfs:label "Custom encoding identity shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    sh:targetClass bddo:CustomEncoding ;
    sh:targetSubjectsOf bddo:ianaCharset ;
    sh:message "A registered encoding is never also typed bddo:CustomEncoding." ;
    sh:not [ sh:class bddo:CustomEncoding ; sh:in ( {{constraint:registered_encodings}} ) ] .

# Advice, not refusal: a custom encoding that only re-spells a registered one, or whose charset
# name leaves the byte order open, still names a charset a processor may know, so the
# description stays valid and its author is told. The first list is the bddo:ianaCharset of every
# registered encoding (tools/test_encoding_register.py keeps it equal to them); the second is the
# registry names that denote 16- or 32-bit code units without saying which byte comes first.
bddo:CustomEncodingCharsetShape a sh:NodeShape ; rdfs:label "Custom encoding charset shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "Advisory (sh:Warning) checks on the bddo:ianaCharset of a bddo:CustomEncoding: it should not name the charset of a registered encoding, which has a term of its own, nor a charset whose name does not determine the byte order of its code units (UTF-16, UTF-32, ISO-10646-UCS-2, UCS-2). Names are compared ignoring case. Neither result makes a description invalid."@en ;
    sh:targetClass bddo:CustomEncoding ;
    sh:property [ sh:path bddo:ianaCharset ; sh:severity sh:Warning ;
        sh:not [ sh:pattern "^({{constraint:registered_charsets}})$" ; sh:flags "i" ] ;
        sh:message "This bddo:CustomEncoding names the charset of a registered encoding; name the registered bddo:Encoding individual instead, so that every profile spells the encoding one way." ] ;
    sh:property [ sh:path bddo:ianaCharset ; sh:severity sh:Warning ;
        sh:not [ sh:pattern "^(UTF-16|UTF-32|ISO-10646-UCS-2|UCS-2)$" ; sh:flags "i" ] ;
        sh:message "This bddo:CustomEncoding names a charset that does not determine the byte order of its code units (UTF-16, UTF-32, ISO-10646-UCS-2 or UCS-2); name the byte-ordered charset (UTF-16LE, UTF-16BE, UTF-32LE, UTF-32BE), or use bddo:ucs2le or bddo:ucs2be." ] .

bddo:DataTypeRuleShape a sh:NodeShape ;
    sh:targetClass bddo:DataTypeRule ;
    sh:property {{constraint:pattern_106}} ;
    sh:property [ sh:path bddo:ruleDataType ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class bddo:DataType ] [ sh:class bddo:Struct ] ) ;
        sh:message "bddo:ruleDataType takes exactly one value, an IRI naming an instance of bddo:DataType or bddo:Struct." ] .

bddo:DispatchTableShape a sh:NodeShape ;
    sh:targetClass bddo:DispatchTable ;
    sh:message "A bddo:DispatchTable states its key exactly one way: bddo:dispatchOnField or bddo:dispatchOnExpression." ;
    sh:xone (
        [ sh:property [ sh:path bddo:dispatchOnField ; sh:minCount 1 ] ]
        [ sh:property [ sh:path bddo:dispatchOnExpression ; sh:minCount 1 ] ]
    ) ;
    sh:property [ sh:path bddo:dispatchOnField ; sh:maxCount 1 ; sh:class bddo:Field ;
        sh:message "bddo:dispatchOnField takes at most one value; each is an instance of bddo:Field." ] ;
    sh:property [ sh:path bddo:dispatchOnExpression ; sh:maxCount 1 ; sh:node bddo:HelExpressionValueShape ;
        sh:message "bddo:dispatchOnExpression takes at most one value; each is a HEL expression (an xsd:string or bddo:HelExpression literal)." ] ;
    sh:property [ sh:path bddo:dispatchDefault ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class bddo:DataType ] [ sh:class bddo:Struct ] ) ;
        sh:message "bddo:dispatchDefault takes at most one value; each is an IRI naming an instance of bddo:DataType or bddo:Struct." ] .

bddo:DispatchArmShape a sh:NodeShape ;
    sh:targetClass bddo:DispatchArm ;
    sh:targetSubjectsOf bddo:armTable , bddo:armKey , bddo:armDataType ;
    sh:property [ sh:path bddo:armTable ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bddo:DispatchTable ;
        sh:message "bddo:armTable takes exactly one value, an instance of bddo:DispatchTable." ] ;
    sh:property [ sh:path bddo:armKey ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype xsd:integer ] ) ;
        sh:message "bddo:armKey takes exactly one value, an xsd:string or xsd:integer literal." ] ;
    sh:property [ sh:path bddo:armDataType ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class bddo:DataType ] [ sh:class bddo:Struct ] ) ;
        sh:message "bddo:armDataType takes exactly one value, an IRI naming an instance of bddo:DataType or bddo:Struct." ] .

# Keys are unique per table across every contributing graph: two arms with one key would make
# the selection depend on graph order, which is exactly what a keyed table exists to rule out.
bddo:DispatchKeyUniquenessShape a sh:NodeShape ;
    sh:targetClass bddo:DispatchTable ;
    sh:sparql [ sh:message "Two DispatchArms of one DispatchTable declare the same armKey." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this ?key WHERE {
            ?a bddo:armTable $this ; bddo:armKey ?key .
            ?b bddo:armTable $this ; bddo:armKey ?key .
            FILTER(?a != ?b)
        }""" ] .

# A field selects its type one way: keyed (open, disjoint) or ordered predicates (closed).
bddo:TypeSelectionExclusivityShape a sh:NodeShape ;
    sh:targetClass bddo:Field ;
    sh:sparql [ sh:message "A bddo:Field must not declare both hasDispatchTable and hasConditionalDataType." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this bddo:hasDispatchTable ?t ; bddo:hasConditionalDataType ?c .
        }""" ] .

# seekScope describes an offset-addressed read; on a sequential field it describes nothing.
bddo:SeekScopeShape a sh:NodeShape ;
    sh:targetClass bddo:Field ;
    sh:sparql [ sh:message "bddo:seekScope is only meaningful on an offset-addressed Field (atOffset / atOffsetFromField / atOffsetFromExpression)." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this bddo:seekScope ?s .
            FILTER NOT EXISTS { $this ?p ?v . FILTER(?p IN (bddo:atOffset, bddo:atOffsetFromField, bddo:atOffsetFromExpression)) }
        }""" ] .

bddo:EnumerationShape a sh:NodeShape ;
    sh:targetClass bddo:Enumeration ;
    sh:property [ sh:path bddo:hasEnumValue ; sh:minCount 1 ; sh:class bddo:EnumValue ;
        sh:message "bddo:hasEnumValue takes at least one value; each is an instance of bddo:EnumValue." ] ;
    sh:property [ sh:path bddo:enumIsFlags ; sh:datatype xsd:boolean ; sh:maxCount 1 ;
        sh:message "bddo:enumIsFlags takes at most one value; each is an xsd:boolean literal." ] .

bddo:EnumValueShape a sh:NodeShape ;
    sh:targetClass bddo:EnumValue ;
    sh:property [ sh:path bddo:enumRawValue ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "bddo:enumRawValue takes exactly one value." ] ;
    sh:property [ sh:path bddo:enumSymbol ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:message "bddo:enumSymbol takes at most one value; each is an IRI." ] .

bddo:ChecksumShape a sh:NodeShape ;
    sh:targetClass bddo:Checksum ;
    sh:targetObjectsOf bddo:checksum ;
    rdfs:comment "A bddo:Checksum names its algorithm exactly once, as one of the named algorithms or a bddo:CustomCrc, and states each property that bounds the bytes it covers at most once: a bddo:Field for bddo:coversFromField and bddo:coversToField, a HEL expression for bddo:coversFromExpression, bddo:coversToExpression and the deprecated whole-range bddo:coversExpression. That the range has exactly one start and exactly one end is bddo:ChecksumRangeStartShape and bddo:ChecksumRangeEndShape: a checksum with an algorithm and no bounds covers nothing a processor could verify, so it is rejected rather than read as covering everything."@en ;
    # The bounds of the covered range are bddo:ChecksumRangeStartShape and bddo:ChecksumRangeEndShape.
    sh:property [ sh:path bddo:checksumAlgorithm ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:or ( [ sh:in ( bddo:crc16 bddo:crc32 bddo:adler32 bddo:md5 bddo:sha1 bddo:sha256 bddo:crc8Smbus bddo:crc16Arc bddo:crc16Xmodem bddo:crc16Modbus bddo:crc16X25 bddo:crc32c bddo:crc32Bzip2 bddo:crc32Mpeg2 bddo:crc64Ecma182 bddo:crc64Xz ) ]
                [ sh:class bddo:CustomCrc ] ) ;
        sh:message "bddo:checksumAlgorithm is one of the named algorithms or a bddo:CustomCrc." ] ;
    sh:property [ sh:path bddo:coversFromField ; sh:class bddo:Field ; sh:maxCount 1 ;
        sh:message "bddo:coversFromField takes at most one value; each is an instance of bddo:Field." ] ;
    sh:property [ sh:path bddo:coversToField ; sh:class bddo:Field ; sh:maxCount 1 ;
        sh:message "bddo:coversToField takes at most one value; each is an instance of bddo:Field." ] ;
    sh:property [ sh:path bddo:coversExpression ; sh:node bddo:HelExpressionValueShape ; sh:maxCount 1 ;
        sh:message "bddo:coversExpression takes at most one value; each is a HEL expression (an xsd:string or bddo:HelExpression literal)." ] ;
    sh:property [ sh:path bddo:coversFromExpression ; sh:node bddo:HelExpressionValueShape ; sh:maxCount 1 ;
        sh:message "bddo:coversFromExpression takes at most one value; each is a HEL expression (an xsd:string or bddo:HelExpression literal)." ] ;
    sh:property [ sh:path bddo:coversToExpression ; sh:node bddo:HelExpressionValueShape ; sh:maxCount 1 ;
        sh:message "bddo:coversToExpression takes at most one value; each is a HEL expression (an xsd:string or bddo:HelExpression literal)." ] .

# Each bound of a checksum's covered range, stated exactly once. The deprecated whole-range form
# counts as both bounds, so pairing it with a per-bound property states that bound twice and
# fails the same way as a field and an expression for one bound would: the two forms do not even
# agree on whether the end byte is included, so which wins would change the bytes hashed. One
# shape per bound, so that a result says which bound is missing or doubled.
bddo:ChecksumRangeStartShape a sh:NodeShape ; rdfs:label "Checksum range start shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    sh:targetClass bddo:Checksum ;
    sh:targetObjectsOf bddo:checksum ;
    sh:message "A bddo:Checksum states exactly one start of its covered range: bddo:coversFromField, bddo:coversFromExpression, or the deprecated whole-range bddo:coversExpression." ;
    sh:xone ( [ sh:property {{constraint:pattern_112}} ]
              [ sh:property {{constraint:pattern_110}} ]
              [ sh:property [ sh:path bddo:coversExpression ; sh:minCount 1 ] ] ) .
bddo:ChecksumRangeEndShape a sh:NodeShape ; rdfs:label "Checksum range end shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    sh:targetClass bddo:Checksum ;
    sh:targetObjectsOf bddo:checksum ;
    sh:message "A bddo:Checksum states exactly one end of its covered range: bddo:coversToField, bddo:coversToExpression, or the deprecated whole-range bddo:coversExpression." ;
    sh:xone ( [ sh:property {{constraint:pattern_116}} ]
              [ sh:property {{constraint:pattern_114}} ]
              [ sh:property [ sh:path bddo:coversExpression ; sh:minCount 1 ] ] ) .

# ---------- Custom CRC ----------
bddo:CustomCrcShape a sh:NodeShape ;
    sh:targetClass bddo:CustomCrc ;
    # Datatypes and non-negativity come from bddo:RangeDatatypeShape, which applies wherever the
    # properties are used; this shape adds presence, uniqueness and the width's bounds.
    sh:property [ sh:path bddo:crcWidth ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 8 ; sh:maxInclusive 64 ;
        sh:message "A bddo:CustomCrc states exactly one bddo:crcWidth, an integer from 8 to 64." ] ;
    sh:property [ sh:path bddo:crcPolynomial ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A bddo:CustomCrc states exactly one bddo:crcPolynomial." ] ;
    sh:property [ sh:path bddo:crcInit ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A bddo:CustomCrc states exactly one bddo:crcInit." ] ;
    sh:property [ sh:path bddo:crcXorOut ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A bddo:CustomCrc states exactly one bddo:crcXorOut." ] ;
    sh:property [ sh:path bddo:crcReflectIn ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A bddo:CustomCrc states exactly one bddo:crcReflectIn." ] ;
    sh:property [ sh:path bddo:crcReflectOut ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A bddo:CustomCrc states exactly one bddo:crcReflectOut." ] ;
    # Each register value fits the register: below 2^width. SPARQL has neither a power function
    # nor, in a SHACL constraint, a VALUES table, so 2^width is 256^k * 2^r for width = 8k + r.
    sh:sparql [ sh:message "{?p} {?v} does not fit a {?w}-bit CRC: it must be below 2^{?w}." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this ?p ?v ?w WHERE {
            $this bddo:crcWidth ?w ; ?p ?v .
            FILTER(?p IN (bddo:crcPolynomial, bddo:crcInit, bddo:crcXorOut))
            FILTER(isNumeric(?w) && isNumeric(?v) && ?w >= 8 && ?w <= 64)
            BIND(FLOOR(?w / 8) AS ?k)
            BIND(?w - 8 * ?k AS ?r)
            BIND(IF(?k = 1, 256, IF(?k = 2, 65536, IF(?k = 3, 16777216, IF(?k = 4, 4294967296,
                 IF(?k = 5, 1099511627776, IF(?k = 6, 281474976710656, IF(?k = 7, 72057594037927936,
                 18446744073709551616))))))) AS ?bytes)
            BIND(IF(?r = 0, 1, IF(?r = 1, 2, IF(?r = 2, 4, IF(?r = 3, 8, IF(?r = 4, 16, IF(?r = 5, 32,
                 IF(?r = 6, 64, 128))))))) AS ?bits)
            FILTER(?v >= ?bytes * ?bits)
        }""" ] .

# ---------- Parameterised structs ----------
bddo:ParameterisedStructShape a sh:NodeShape ;
    sh:targetSubjectsOf bddo:hasParameter ;
    sh:property [ sh:path bddo:hasParameter ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "bddo:hasParameter must point to a single rdf:List." ] ;
    sh:property [ sh:path ( bddo:hasParameter [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:class bddo:Parameter ; sh:nodeKind sh:IRI ;
        sh:message "Every member of a hasParameter list is a bddo:Parameter named by its IRI." ] ;
    # sh:class rather than a hasValue on rdf:type: a DelimitedTable or TreeDocument is a Struct
    # by rdfs:subClassOf, and sh:class follows that in the data graph where rdf:type does not.
    sh:class bddo:Struct ;
    sh:message "bddo:hasParameter is declared on a bddo:Struct (or a subclass of it)." .

bddo:ParameterShape a sh:NodeShape ;
    sh:targetClass bddo:Parameter ;
    sh:targetSubjectsOf bddo:parameterType ;
    sh:property [ sh:path bddo:parameterType ; sh:maxCount 1 ;
        sh:in ( bddo:IntegerParameter bddo:FloatParameter bddo:StringParameter bddo:BytesParameter bddo:BooleanParameter ) ;
        sh:message "bddo:parameterType is one of bddo:IntegerParameter, bddo:FloatParameter, bddo:StringParameter, bddo:BytesParameter and bddo:BooleanParameter." ] ;
    sh:message "A bddo:Parameter is not a bddo:Field: it consumes no bytes and is not a member of the parsed tree." ;
    sh:not [ sh:class bddo:Field ] .

bddo:ArgumentListShape a sh:NodeShape ;
    sh:targetSubjectsOf bddo:hasArgument ;
    sh:property [ sh:path bddo:hasArgument ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "bddo:hasArgument must point to a single rdf:List." ] ;
    sh:property [ sh:path ( bddo:hasArgument [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:node bddo:HelExpressionValueShape ;
        sh:message "Every member of a hasArgument list is a HEL expression, an xsd:string or bddo:HelExpression literal." ] .

# Arity: every place that names a struct as a type supplies one argument per parameter. List
# NODES are counted, not members, so two equal argument strings still count twice.
bddo:ArgumentArityShape a sh:NodeShape ;
    rdfs:comment "Wherever a bddo:Struct that declares parameters is named as a type (by bddo:dataType, bddo:ruleDataType or bddo:armDataType), the naming node supplies exactly one bddo:hasArgument list member per parameter. List nodes are counted, so two equal argument strings count twice."@en ;
    sh:targetSubjectsOf bddo:dataType , bddo:ruleDataType , bddo:armDataType ;
    sh:sparql [ sh:message "{?s} declares {?np} parameter(s), but {?na} argument(s) are supplied for it." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this ?s (COUNT(DISTINCT ?pn) AS ?np) (COUNT(DISTINCT ?an) AS ?na) WHERE {
            $this ?tp ?s .
            FILTER(?tp IN (bddo:dataType, bddo:ruleDataType, bddo:armDataType))
            ?s a bddo:Struct .
            OPTIONAL { ?s bddo:hasParameter/rdf:rest* ?pn . FILTER(?pn != rdf:nil) }
            OPTIONAL { $this bddo:hasArgument/rdf:rest* ?an . FILTER(?an != rdf:nil) }
        } GROUP BY $this ?s HAVING (COUNT(DISTINCT ?pn) != COUNT(DISTINCT ?an))""" ] .

# ---------- Local bindings ----------
bddo:LocalBindingShape a sh:NodeShape ;
    sh:targetClass bddo:LocalBinding ;
    sh:targetSubjectsOf bddo:localExpression ;
    sh:message "A bddo:LocalBinding is an IRI: its name is the simple key of its IRI." ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:path bddo:localExpression ; sh:minCount 1 ; sh:maxCount 1 ; sh:node bddo:HelExpressionValueShape ;
        sh:message "A bddo:LocalBinding states exactly one bddo:localExpression." ] ;
    # A text container locates its fields by delimiter, key or path rather than by list order,
    # so a binding in one would have no position to be evaluated at.
    sh:sparql [ sh:message "A bddo:LocalBinding is a member of a binary struct; {?container} is a delimited or tree container." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this ?container WHERE {
            ?container bddo:hasField/rdf:rest*/rdf:first $this ; a ?c .
            FILTER(?c IN (bddo:DelimitedRecords, bddo:KeyValueHeader, bddo:DelimitedTable, bddo:TreeDocument))
        }""" ] .

# A binding consumes no bytes and a field does, so no member of a struct is both.
bddo:LocalBindingKindShape a sh:NodeShape ; rdfs:label "Local binding kind shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    sh:targetClass bddo:LocalBinding ;
    sh:targetSubjectsOf bddo:localExpression ;
    sh:message "A bddo:LocalBinding is not also a bddo:Field: a binding names a computed value and consumes no bytes." ;
    sh:not [ sh:class bddo:Field ] .

# An ASCII-coded numeric field must have a width, a terminator or a separator, or it cannot be
# read. bddo:separatedBy is an extent mechanism in its own right -- the element is bounded by the
# runs of separator bytes either side of it -- and it is the ONLY one such a field may combine
# with none of the others: see bddo:SeparatedFieldExtentShape, which forbids pairing it with any size or with a
# terminator, because two answers to "where does this value end" is one too many.
# Exempt: a field of a delimited-record container gets its extent from the container's
# recordDelimiter/fieldDelimiter, not from its own size, terminator or separator.
bddo:AsciiNumericWidthShape a sh:NodeShape ;
    sh:targetClass bddo:Field ;
    sh:sparql [ sh:message "A bddo:asciiInteger / bddo:asciiDecimal field must declare a width (size / sizeFromField / sizeFromExpression), a terminator, or bddo:separatedBy." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this bddo:dataType ?dt .
            FILTER(?dt IN (bddo:asciiInteger, bddo:asciiDecimal))
            FILTER NOT EXISTS { $this bddo:size ?s }
            FILTER NOT EXISTS { $this bddo:sizeFromField ?f }
            FILTER NOT EXISTS { $this bddo:sizeFromExpression ?e }
            FILTER NOT EXISTS { $this bddo:terminator ?t }
            FILTER NOT EXISTS { $this bddo:separatedBy ?sep }
            FILTER NOT EXISTS {
                ?p bddo:hasField/rdf:rest*/rdf:first $this .
                ?p a ?c .
                # Same exemption as bddo:VariableLengthFieldShape, and it must be kept in step
                # with it: both ask "does the container decide this field's extent?", and a new
                # container form has to be listed in both or a description conforms to one shape
                # and not the other.
                FILTER(?c IN (bddo:DelimitedRecords, bddo:KeyValueHeader, bddo:DelimitedTable,
                              bddo:TreeDocument))
            }
        }""" ] .

# numericBase is meaningful only for :asciiInteger.
bddo:NumericBaseShape a sh:NodeShape ;
    sh:targetSubjectsOf bddo:numericBase ;
    sh:property [ sh:path bddo:numericBase ; sh:maxCount 1 ; sh:in ( 8 10 16 ) ;
        sh:message "bddo:numericBase must be 8, 10 or 16." ] ;
    sh:property [ sh:path bddo:dataType ; sh:hasValue bddo:asciiInteger ;
        sh:message "bddo:numericBase applies only to a field whose bddo:dataType is bddo:asciiInteger." ] .

bddo:EndiannessRuleShape a sh:NodeShape ;
    sh:targetClass bddo:EndiannessRule ;
    sh:property {{constraint:pattern_106}} ;
    sh:property [ sh:path bddo:ruleEndianness ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( bddo:BigEndian bddo:LittleEndian ) ;
        sh:message "bddo:ruleEndianness must be bddo:BigEndian or bddo:LittleEndian." ] .

bddo:ConditionalEndiannessShape a sh:NodeShape ;
    sh:targetSubjectsOf bddo:hasConditionalEndianness ;
    sh:property [ sh:path bddo:hasConditionalEndianness ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "bddo:hasConditionalEndianness must point to a single rdf:List." ] ;
    sh:property [ sh:path bddo:endianness ; sh:maxCount 0 ;
        sh:message "bddo:endianness and bddo:hasConditionalEndianness are mutually exclusive." ] ;
    sh:property [ sh:path ( bddo:hasConditionalEndianness [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:class bddo:EndiannessRule ;
        sh:message "Every member of a hasConditionalEndianness list must be a bddo:EndiannessRule." ] .

bddo:DelimitedRecordsShape a sh:NodeShape ;
    sh:targetClass bddo:DelimitedRecords ;
    sh:message "A bddo:DelimitedRecords separates values by a fixed bddo:fieldDelimiter or by runs of whitespace (bddo:whitespaceSeparated true), never both." ;
    sh:property [ sh:path bddo:recordDelimiter ; sh:datatype xsd:hexBinary ; sh:maxCount 1 ;
        sh:message "bddo:recordDelimiter takes at most one value; each is an xsd:hexBinary literal." ] ;
    sh:property [ sh:path bddo:fieldDelimiter ; sh:datatype xsd:hexBinary ; sh:maxCount 1 ;
        sh:message "bddo:fieldDelimiter takes at most one value; each is an xsd:hexBinary literal." ] ;
    sh:property [ sh:path bddo:whitespaceSeparated ; sh:datatype xsd:boolean ; sh:maxCount 1 ;
        sh:message "bddo:whitespaceSeparated takes at most one value; each is an xsd:boolean literal." ] ;
    # A run of whitespace and a fixed delimiter are two different separation rules.
    sh:not [ sh:and ( [ sh:property {{constraint:pattern_130}} ]
                      [ sh:property {{constraint:pattern_172}} ] ) ] ;
    sh:property [ sh:path bddo:keyValueSeparator ; sh:datatype xsd:hexBinary ; sh:maxCount 1 ;
        sh:message "bddo:keyValueSeparator takes at most one value; each is an xsd:hexBinary literal." ] ;
    sh:property [ sh:path bddo:quoteChar ; sh:datatype xsd:hexBinary ; sh:maxCount 1 ;
        sh:message "bddo:quoteChar takes at most one value; each is an xsd:hexBinary literal." ] ;
    sh:property [ sh:path bddo:escapeChar ; sh:datatype xsd:hexBinary ; sh:maxCount 1 ;
        sh:message "bddo:escapeChar takes at most one value; each is an xsd:hexBinary literal." ] ;
    sh:property [ sh:path bddo:commentPrefix ; sh:datatype xsd:string ; sh:maxCount 1 ;
        sh:message "bddo:commentPrefix takes at most one value; each is an xsd:string literal." ] ;
    sh:property [ sh:path bddo:skipRecords ; sh:minInclusive 0 ; sh:maxCount 1 ;
        sh:message "bddo:skipRecords takes at most one value; each is a number at least 0." ] ;
    sh:property [ sh:path bddo:trimWhitespace ; sh:datatype xsd:boolean ; sh:maxCount 1 ;
        sh:message "bddo:trimWhitespace takes at most one value; each is an xsd:boolean literal." ] ;
    sh:property [ sh:path bddo:hasField ; sh:minCount 1 ;
        sh:message "A bddo:DelimitedRecords must declare at least one field." ] .

# A KeyValueHeader needs a separator, and each of its fields is located at most one way. A field
# with neither locator is located by its simple key (Processing Model, key/value headers), which
# is what an HDL compiler emits for an unquoted header field name.
bddo:KeyValueHeaderShape a sh:NodeShape ;
    sh:targetClass bddo:KeyValueHeader ;
    sh:property [ sh:path bddo:keyValueSeparator ; sh:minCount 1 ;
        sh:message "A bddo:KeyValueHeader must declare bddo:keyValueSeparator." ] ;
    # At most one locator per field: bddo:key in a flat header, bddo:keyPath in a nested one, or
    # neither, when the field is located by its simple key.
    sh:property [ sh:path ( bddo:hasField [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:node [ sh:xone (
            [ sh:property [ sh:path bddo:key ; sh:minCount 1 ; sh:maxCount 1 ] ;
              sh:property {{constraint:pattern_144}} ]
            [ sh:property [ sh:path bddo:keyPath ; sh:minCount 1 ; sh:maxCount 1 ] ;
              sh:property {{constraint:pattern_141}} ]
            [ sh:property {{constraint:pattern_141}} ;
              sh:property {{constraint:pattern_144}} ] ) ;
          sh:message "Every field of a bddo:KeyValueHeader declares at most one bddo:key (flat) or one bddo:keyPath (nested), never both; a field with neither is located by its simple key." ] ;
        sh:message "Every field of a bddo:KeyValueHeader declares at most one bddo:key (flat) or one bddo:keyPath (nested), never both; a field with neither is located by its simple key." ] .

# ---------- Tree documents ----------
bddo:TreeDocumentShape a sh:NodeShape ;
    sh:targetClass bddo:TreeDocument ;
    sh:property [ sh:path bddo:treeSyntax ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( bddo:xml bddo:json ) ;
        sh:message "A bddo:TreeDocument must declare exactly one bddo:treeSyntax: bddo:xml or bddo:json." ] ;
    sh:property [ sh:path bddo:hasNamespaceBinding ; sh:class bddo:NamespaceBinding ;
        sh:message "Each value of bddo:hasNamespaceBinding is an instance of bddo:NamespaceBinding." ] ;
    sh:property [ sh:path bddo:hasField ; sh:minCount 1 ;
        sh:message "A bddo:TreeDocument must declare at least one field." ] ;
    # Every field is located by a path, and by nothing else. A byte offset or a record key in a
    # tree document is a leftover from another container form and would address nothing.
    sh:property [ sh:path ( bddo:hasField [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:node [
            sh:property [ sh:path bddo:nodePath ; sh:minCount 1 ; sh:maxCount 1 ] ;
            sh:property {{constraint:pattern_141}} ;
            sh:property {{constraint:pattern_144}} ;
            sh:property [ sh:path bddo:atOffset ; sh:maxCount 0 ] ;
            sh:message "Every field of a bddo:TreeDocument is located by exactly one bddo:nodePath, and not by a key, a key path or a byte offset." ] ;
        sh:message "Every field of a bddo:TreeDocument is located by exactly one bddo:nodePath, and not by a key, a key path or a byte offset." ] ;
    # Namespaces bind prefixes in XPath. JSON Pointer has no prefixes to bind, so a binding on a
    # JSON document is a misunderstanding worth catching rather than ignoring.
    sh:sparql [ sh:message "bddo:hasNamespaceBinding applies to an XML tree document; JSON Pointer has no namespace prefixes." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this bddo:treeSyntax bddo:json .
            $this bddo:hasNamespaceBinding ?b .
        }""" ] .

bddo:NamespaceBindingShape a sh:NodeShape ;
    sh:targetClass bddo:NamespaceBinding ;
    sh:targetObjectsOf bddo:hasNamespaceBinding ;
    sh:targetSubjectsOf bddo:namespacePrefix , bddo:namespaceIRI ;
    # The prefix MAY be the empty string -- that is how a default namespace is bound -- so
    # minCount rather than a non-blank check.
    sh:property [ sh:path bddo:namespacePrefix ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "bddo:namespacePrefix takes exactly one value, an xsd:string literal." ] ;
    sh:property [ sh:path bddo:namespaceIRI ; sh:datatype xsd:anyURI ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A namespace binding needs the IRI it binds to; a prefix alone names nothing." ] ;
    # XML Namespaces: a namespace name is an absolute IRI (a relative one is deprecated and
    # compares as a string, so two documents could disagree about it).
    sh:property [ sh:path bddo:namespaceIRI ; sh:pattern "^[A-Za-z][A-Za-z0-9+.-]*:" ;
        sh:message "bddo:namespaceIRI must be an absolute IRI (it begins with a scheme)." ] .

# The prefixes a tree document's XML paths use: each bound once, and every one used is bound.
bddo:TreePrefixBindingShape a sh:NodeShape ;
    rdfs:comment "An XML tree document binds each namespace prefix at most once, and every prefix its fields' bddo:nodePath values use is bound by one of its bddo:hasNamespaceBinding entries; only xml is predeclared."@en ;
    sh:targetClass bddo:TreeDocument ;
    sh:targetSubjectsOf bddo:hasNamespaceBinding ;
    sh:sparql [ sh:message "Two bddo:hasNamespaceBinding entries of one tree document bind the prefix '{?px}'; a prefix is bound at most once." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this ?px WHERE {
            $this bddo:hasNamespaceBinding ?a , ?b .
            ?a bddo:namespacePrefix ?px . ?b bddo:namespacePrefix ?px .
            FILTER(!sameTerm(?a, ?b))
        }""" ] ;
    sh:sparql [ sh:message "A bddo:nodePath of this XML tree document ({?p}) uses a prefix that no bddo:hasNamespaceBinding binds (only xml is predeclared)." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this ?p WHERE {
            { SELECT $this (GROUP_CONCAT(?px; separator="|") AS ?alts) WHERE {
                $this bddo:treeSyntax bddo:xml .
                OPTIONAL { $this bddo:hasNamespaceBinding/bddo:namespacePrefix ?px . FILTER(?px != "") }
            } GROUP BY $this }
            $this bddo:hasField/rdf:rest*/rdf:first ?f .
            ?f bddo:nodePath ?p .
            # Each bound prefix is matched literally: an NCName may hold '.' and '-', which a
            # regular expression reads as metacharacters, so each is put in a class of its own.
            BIND(REPLACE(?alts, "([.-])", "[$1]") AS ?quoted)
            BIND(REPLACE(?p, CONCAT("(^|[/@])(", IF(?quoted != "", CONCAT(?quoted, "|"), ""), "xml):"), "$1") AS ?rest)
            FILTER(REGEX(?rest, "(^|[/@])[^/@:]+:"))
        }""" ] .

# A path outside a tree document addresses nothing.
bddo:NodePathShape a sh:NodeShape ;
    sh:targetClass bddo:Field ;
    sh:targetSubjectsOf bddo:nodePath ;
    sh:property [ sh:path bddo:nodePath ; sh:datatype xsd:string ; sh:maxCount 1 ;
        sh:message "bddo:nodePath takes at most one value; each is an xsd:string literal." ] ;
    # Path syntax by the container's tree syntax: a JSON Pointer (RFC 6901), or the abbreviated
    # XPath of the Processing Model (child steps, 1-based positional predicates, one final
    # attribute step). Names are any run of characters that are not path punctuation, so every
    # XML name matches; what a name means is resolved at load time.
    sh:sparql [ sh:message "This bddo:nodePath ({?p}) is not a JSON Pointer (RFC 6901): it must be empty or a sequence of /-prefixed reference tokens, with ~ only in ~0 or ~1." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this ?p WHERE {
            $this bddo:nodePath ?p .
            ?container bddo:hasField/rdf:rest*/rdf:first $this ; bddo:treeSyntax bddo:json .
            FILTER(!REGEX(?p, "^(/([^~/]|~[01])*)*$"))
        }""" ] ;
    sh:sparql [ sh:message "This bddo:nodePath ({?p}) is not an abbreviated XPath of child steps, optional [n] positions (n >= 1) and at most one final @attribute step." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this ?p WHERE {
            $this bddo:nodePath ?p .
            ?container bddo:hasField/rdf:rest*/rdf:first $this ; bddo:treeSyntax bddo:xml .
            FILTER(!REGEX(?p, "^(/?([^/@\\\\[\\\\]:\\\\s]+:)?[^/@\\\\[\\\\]:\\\\s]+(\\\\[[1-9][0-9]*\\\\])?(/([^/@\\\\[\\\\]:\\\\s]+:)?[^/@\\\\[\\\\]:\\\\s]+(\\\\[[1-9][0-9]*\\\\])?)*(/@([^/@\\\\[\\\\]:\\\\s]+:)?[^/@\\\\[\\\\]:\\\\s]+)?|@([^/@\\\\[\\\\]:\\\\s]+:)?[^/@\\\\[\\\\]:\\\\s]+)$"))
        }""" ] ;
    # Every container, not just one: a field shared by a tree document and a binary struct would
    # otherwise pass, and the struct would read a field it cannot locate.
    sh:sparql [ sh:message "bddo:nodePath locates a node in a parsed tree, so every container of the field must be a bddo:TreeDocument ({?container} is not, or there is none)." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this ?container WHERE {
            $this bddo:nodePath ?p .
            {
                FILTER NOT EXISTS { ?any bddo:hasField/rdf:rest*/rdf:first $this }
            } UNION {
                ?container bddo:hasField/rdf:rest*/rdf:first $this .
                FILTER NOT EXISTS { ?container a bddo:TreeDocument }
            }
        }""" ] .

# ---------- Nested records ----------
bddo:RecordGroupingShape a sh:NodeShape ;
    sh:targetClass bddo:RecordGrouping ;
    sh:property [ sh:path bddo:groupingStyle ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( bddo:keyedGroup bddo:valuedGroup bddo:sectionHeaded ) ;
        sh:message "A bddo:RecordGrouping must name exactly one style: keyedGroup, valuedGroup or sectionHeaded." ] ;
    # Both tokens, always. A grouping that says where a group starts and not where it ends
    # cannot be read: every record after the first group would be inside it.
    sh:property [ sh:path bddo:groupOpenToken ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "bddo:groupOpenToken takes exactly one value, an xsd:string literal." ] ;
    sh:property [ sh:path bddo:groupCloseToken ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "bddo:groupCloseToken takes exactly one value, an xsd:string literal." ] .

bddo:GroupedRecordsShape a sh:NodeShape ;
    sh:targetClass bddo:DelimitedRecords ;
    sh:property [ sh:path bddo:hasGrouping ; sh:class bddo:RecordGrouping ; sh:maxCount 1 ;
        sh:message "bddo:hasGrouping takes at most one value; each is an instance of bddo:RecordGrouping." ] ;
    sh:property [ sh:path bddo:pathSeparator ; sh:datatype xsd:string ; sh:maxCount 1 ;
        sh:message "bddo:pathSeparator takes at most one value; each is an xsd:string literal." ] .

# A path has nothing to traverse unless its container nests.
bddo:KeyPathShape a sh:NodeShape ;
    sh:targetClass bddo:Field ;
    sh:property [ sh:path bddo:keyPath ; sh:datatype xsd:string ; sh:maxCount 1 ;
        sh:message "bddo:keyPath takes at most one value; each is an xsd:string literal." ] ;
    sh:sparql [ sh:message "bddo:keyPath locates a field inside nested groups, so its container must declare bddo:hasGrouping; without one the container is flat and the path addresses nothing." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this bddo:keyPath ?path .
            FILTER NOT EXISTS {
                ?container bddo:hasField/rdf:rest*/rdf:first $this .
                ?container bddo:hasGrouping ?g .
            }
        }""" ] .

# bddo:key is meaningful only inside a KeyValueHeader; a table's columns are positional.
bddo:DelimitedTableShape a sh:NodeShape ;
    sh:targetClass bddo:DelimitedTable ;
    sh:message "A bddo:DelimitedTable declares how its columns are separated: a bddo:fieldDelimiter or bddo:whitespaceSeparated true." ;
    sh:or ( [ sh:property {{constraint:pattern_130}} ]
            [ sh:property {{constraint:pattern_172}} ] ) ;
    sh:property [ sh:path bddo:keyValueSeparator ; sh:maxCount 0 ;
        sh:message "bddo:keyValueSeparator applies to a KeyValueHeader, not a DelimitedTable." ] ;
    sh:property [ sh:path ( bddo:hasField [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:node [ sh:property [ sh:path bddo:key ; sh:maxCount 0 ;
            sh:message "bddo:key applies to a field of a KeyValueHeader; a DelimitedTable's columns are located by position." ] ] ;
        sh:message "No field of a bddo:DelimitedTable states bddo:key: a table's columns are located by position, and bddo:key applies to a field of a KeyValueHeader." ] .

# A varint's length comes from the data, so declaring a width contradicts it.
bddo:VarintWidthShape a sh:NodeShape ;
    sh:targetClass bddo:Field ;
    sh:sparql [ sh:message "A variable-length integer field (bddo:varuint, bddo:varint, bddo:sqliteVarint) must not declare a width or terminator: its length is discovered from the bytes." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this bddo:dataType ?dt .
            FILTER(?dt IN (bddo:varuint, bddo:varint, bddo:sqliteVarint))
            $this ?p ?v .
            FILTER(?p IN (bddo:size, bddo:sizeFromField, bddo:sizeFromExpression,
                          bddo:sizeToEndOfStream, bddo:terminator, bddo:bitLength))
        }""" ] .

# ---------- Range datatype shapes ----------
# Each XSD rdfs:range above, enforced wherever the property is used: activation is by
# subjects-of, so an untyped subject is checked too (tools/test_range_datatypes.py).
# Integer ranges accept any XSD integer-family datatype within the range's bounds.
bddo:IntegerValueShape a sh:NodeShape ; rdfs:label "Integer value shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    sh:message "An integer value is a literal of an XSD integer-family datatype (xsd:integer, xsd:positiveInteger, xsd:nonNegativeInteger, xsd:int, xsd:long, xsd:unsignedInt, xsd:unsignedLong, xsd:short, xsd:unsignedShort, xsd:byte or xsd:unsignedByte)." ;
    {{constraint:pattern_237}} .
