# Hexplain Audio Vocabulary (ADV) 1.2 — vocabulary + SHACL shapes
@prefix :       <https://hexplain.io/ns/audio#> .
@prefix adv:    <https://hexplain.io/ns/audio#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix ma:     <http://www.w3.org/ns/ma-ont#> .
@prefix atime:  <https://hexplain.io/ns/aspect/time#> .
@prefix aenc:   <https://hexplain.io/ns/aspect/encoding#> .
@prefix asamp:  <https://hexplain.io/ns/aspect/sampling#> .
@prefix asig:   <https://hexplain.io/ns/aspect/signal#> .
@prefix dlv:    <https://hexplain.io/ns/dlv#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .

<https://hexplain.io/ns/audio> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/audio/1.2> ; owl:versionInfo "1.2" ;
    owl:priorVersion <https://hexplain.io/ns/audio/1.1> ;
    dcterms:modified "2026-09-27"^^xsd:date ;
    owl:imports <https://hexplain.io/ns/aspect/time> , <https://hexplain.io/ns/aspect/encoding> , <https://hexplain.io/ns/aspect/sampling> , <https://hexplain.io/ns/aspect/signal> , <https://hexplain.io/ns/dlv> ;
    rdfs:label "Hexplain Audio Vocabulary (ADV)"@en ;
    rdfs:comment "Semantic vocabulary for audio stream and tag properties."@en ;
    dcterms:created "2025-08-16"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "adv" ; vann:preferredNamespaceUri "https://hexplain.io/ns/audio#" .

:AudioContainer a owl:Class ; rdfs:label "Audio Container"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/audio> ; rdfs:seeAlso ma:MediaResource .
:AudioStream a owl:Class ; rdfs:label "Audio Stream"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/audio> ; rdfs:seeAlso ma:AudioTrack .
:MetadataTag a owl:Class ; rdfs:label "Metadata Tag"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/audio> .

# sampleRate is the signal aspect (asig:sampleRate); audioChannels is the sampling aspect
# (asamp:componentCount); bitDepth is asamp:bitDepth (shared with image) — all imported.
# duration (atime), bitrate + codec (aenc) are imported from the aspect layer.
:artist a owl:DatatypeProperty ; rdfs:label "artist"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/audio> ; rdfs:seeAlso dcterms:creator ; rdfs:range xsd:string .
:album a owl:DatatypeProperty ; rdfs:label "album"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/audio> ; rdfs:range xsd:string .
:trackTitle a owl:DatatypeProperty ; rdfs:label "track title"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/audio> ; rdfs:seeAlso dcterms:title ; rdfs:range xsd:string .
:trackNumber a owl:DatatypeProperty ; rdfs:label "track number"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/audio> ; rdfs:range xsd:positiveInteger .
:genre a owl:DatatypeProperty ; rdfs:label "genre"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/audio> ; rdfs:range xsd:string .

:axisSample a owl:NamedIndividual , dlv:Axis ; rdfs:label "Sample Axis (deprecated)"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/audio> ;
    owl:deprecated true ; dcterms:isReplacedBy dlv:axisTime ;
    rdfs:comment "Deprecated duplicate of dlv:axisTime. Successive audio samples are the time axis of the layout. Layouts use dlv:axisTime; this IRI is retained so existing descriptions still resolve and denotes the same axis."@en .
:axisChannel a owl:NamedIndividual , dlv:Axis ; rdfs:label "Channel Axis (deprecated)"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/audio> ;
    owl:deprecated true ; dcterms:isReplacedBy dlv:axisBand ;
    rdfs:comment "Deprecated duplicate of dlv:axisBand. dlv:axisBand is the band/channel axis for every media type. Layouts use dlv:axisBand; this IRI is retained so existing descriptions still resolve and denotes the same axis."@en .

# ---------- SHACL ----------
adv:StreamShape a sh:NodeShape ; sh:targetClass adv:AudioStream ; sh:targetSubjectsOf asig:sampleRate ;
    sh:property [ sh:path asig:sampleRate ; sh:minExclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path asamp:componentCount ; sh:minExclusive 0 ; sh:maxCount 1 ] ;
    sh:property {{constraint:pattern_073}} ;
    sh:property [ sh:path atime:duration ; sh:nodeKind sh:Literal ; sh:maxCount 1 ] ;
    sh:property {{constraint:pattern_053}} ;
    sh:property {{constraint:pattern_054}} .
adv:TagShape a sh:NodeShape ; sh:targetClass adv:MetadataTag ;
    sh:targetSubjectsOf adv:artist, adv:album, adv:trackTitle, adv:trackNumber ;
    sh:property [ sh:path adv:artist ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path adv:album ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path adv:trackTitle ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path adv:trackNumber ; sh:minExclusive 0 ; sh:maxCount 1 ] .

# ---------- Range datatype shapes ----------
# Each XSD rdfs:range above, enforced wherever the property is used: activation is by
# subjects-of, so an untyped subject is checked too (tools/test_range_datatypes.py).
# Integer ranges accept any XSD integer-family datatype within the range's bounds.
adv:IntegerValueShape a sh:NodeShape ; rdfs:label "Integer value shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/audio> ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:short ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedByte ] ) .
adv:RangeDatatypeShape a sh:NodeShape ; rdfs:label "Range datatype shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/audio> ;
    sh:targetSubjectsOf adv:genre ,
        adv:trackNumber ;
    sh:property [ sh:path adv:genre ; sh:datatype xsd:string ;
        sh:message "adv:genre takes an xsd:string literal (rdfs:range xsd:string)." ] ;
    sh:property [ sh:path adv:trackNumber ; sh:node adv:IntegerValueShape ; sh:minInclusive 1 ;
        sh:message "adv:trackNumber takes a positive integer (rdfs:range xsd:positiveInteger)." ] .

