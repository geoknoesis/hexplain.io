# Hexplain SPARQL function library (hxf) 0.1
# One IRI per function. Pure functions carry a SHACL-AF body any SHACL-AF engine can run;
# native functions need the Hexplain engine (io.hexplain.query) behind the query.
@prefix :        <https://hexplain.io/ns/fn#> .
@prefix hxf:     <https://hexplain.io/ns/fn#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix dlv:     <https://hexplain.io/ns/dlv#> .
@prefix araster: <https://hexplain.io/ns/aspect/raster#> .
@prefix asref:   <https://hexplain.io/ns/aspect/spatialref#> .
@prefix asig:    <https://hexplain.io/ns/aspect/signal#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://hexplain.io/ns/fn> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/fn/0.1> ; owl:versionInfo "0.1" ;
    # Every vocabulary whose terms the functions read (hxf:reads) or name in their bodies.
    owl:imports <https://hexplain.io/ns/core> , <https://hexplain.io/ns/dlv> ,
        <https://hexplain.io/ns/aspect/raster> , <https://hexplain.io/ns/aspect/spatialref> ,
        <https://hexplain.io/ns/aspect/signal> ;
    rdfs:label "Hexplain SPARQL function library (hxf)" ;
    rdfs:comment "Custom SPARQL functions that reach the bytes, parsed values, array cells and aspect coordinates of a file described by a Hexplain profile. Functions bind to the description vocabularies, never to a format." ;
    dcterms:created "2026-09-09"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    vann:preferredNamespacePrefix "hxf" ; vann:preferredNamespaceUri "https://hexplain.io/ns/fn#" ;
    sh:declare [ sh:prefix "xsd" ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] ,
               [ sh:prefix "araster" ; sh:namespace "https://hexplain.io/ns/aspect/raster#"^^xsd:anyURI ] ,
               [ sh:prefix "asref" ; sh:namespace "https://hexplain.io/ns/aspect/spatialref#"^^xsd:anyURI ] .

# ---------- Failure contract ----------
# What a function does when it cannot answer. Stated once, because it is the same for all of
# them and because a caller that does not know it will read an unbound result as "no such thing"
# rather than "something went wrong".

:failureContract a owl:DatatypeProperty ; rdfs:label "failure contract" ; rdfs:isDefinedBy <https://hexplain.io/ns/fn> ;
    rdfs:range rdf:langString ;
    rdfs:comment "How this library reports an argument it cannot resolve or bytes it cannot read." .

:total a owl:DatatypeProperty ; rdfs:label "total" ; rdfs:isDefinedBy <https://hexplain.io/ns/fn> ;
    rdfs:range xsd:boolean ;
    rdfs:comment "True when this function always answers, so an unbound result from it would be a defect rather than a described outcome. Only hxf:explain claims this: it reports what went wrong, and a diagnostic that can itself go missing is of no use at the moment you need it." .

:unboundWhen a owl:DatatypeProperty ; rdfs:label "unbound when" ; rdfs:isDefinedBy <https://hexplain.io/ns/fn> ;
    rdfs:range rdf:langString ;
    rdfs:comment "A condition under which this function yields no value rather than a wrong one. Repeatable. Absence does not mean the function is total: the library-wide failure contract still applies." .

<https://hexplain.io/ns/fn> :failureContract "A function that cannot answer yields an UNBOUND result rather than an error, and records the reason against its first IRI argument, where hxf:explain retrieves it. Failure records are scoped to ONE query execution: a reason recorded while a query executes is visible only to hxf:explain calls evaluated within that same execution, and every record is discarded when the execution ends. A record never reaches another query, whether concurrent or later, so no function call has an effect that outlives the query that made it, and the same query over the same data explains the same failures however many queries ran before it. A SPARQL expression that projects an unbound value simply has no binding for that variable, so a query over a mixed corpus returns rows for the assets it could read instead of failing wholesale. Two things are deliberately NOT unbound: a cancelled or timed-out query, which must reach the caller, and a malformed call -- wrong argument count -- which is a query error raised when the query is built. An unbound result therefore means \"this function could not answer here\", never \"this query is wrong\"; distinguishing the two is what hxf:explain is for."@en .

:Function a owl:Class ; rdfs:label "Function" ; rdfs:isDefinedBy <https://hexplain.io/ns/fn> ;
    rdfs:comment "A SPARQL extension function of this library." .
:Kind a owl:Class ; rdfs:label "Function kind" ; rdfs:isDefinedBy <https://hexplain.io/ns/fn> ;
    rdfs:comment "Whether a function's body is published SPARQL (:Pure) or needs the Hexplain engine (:Native)." .
:Pure a :Kind ; rdfs:label "pure" ; rdfs:comment "Computes over values already in the graph; published as a SHACL-AF sh:SPARQLFunction body." .
:Native a :Kind ; rdfs:label "native" ; rdfs:comment "Needs the bytes of the asset; implemented against the Hexplain engine." .
:kind a owl:ObjectProperty ; rdfs:range :Kind ; rdfs:isDefinedBy <https://hexplain.io/ns/fn> ;
    rdfs:comment "The function's kind: :Pure or :Native." .
:signature a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://hexplain.io/ns/fn> ;
    rdfs:comment "Argument list and result, in the notation name(arg: type, ...) -> type. A trailing ? marks an optional argument." .
:reads a owl:ObjectProperty ; rdfs:isDefinedBy <https://hexplain.io/ns/fn> ;
    rdfs:comment "A vocabulary term the function reads from the graph." .
:layer a owl:DatatypeProperty ; rdfs:range xsd:integer ; rdfs:isDefinedBy <https://hexplain.io/ns/fn> ;
    rdfs:comment "0 bytes, 1 parsed values, 2 arrays, 3 aspect coordinates, 9 diagnostics." .

# ---------- Resource limits ----------
# Hard caps every native function enforces. A runtime may configure other values; these are the
# defaults when it states none. A call that would exceed a limit is unbound (failure contract).
:maxBytesPerCall a owl:DatatypeProperty ; rdfs:label "max bytes per call" ; rdfs:isDefinedBy <https://hexplain.io/ns/fn> ;
    rdfs:range xsd:positiveInteger ;
    rdfs:comment "Largest byte value, in bytes, a single function call may read, decode or return (hxf:bytes, hxf:decodedBytes, hxf:value, hxf:hel). Default 1048576 (1 MiB). A call that would exceed it yields an unbound result and records the reason for hxf:explain." .
:maxCellsPerWindow a owl:DatatypeProperty ; rdfs:label "max cells per window" ; rdfs:isDefinedBy <https://hexplain.io/ns/fn> ;
    rdfs:range xsd:positiveInteger ;
    rdfs:comment "Largest number of array cells one windowed call may visit (hxf:stat over a window or a whole array, hxf:window). Default 1000000. A window above it is refused: hxf:stat is unbound and hxf:window yields no rows." .

# Parameters of pure functions, shared across bodies.
:arg1 a rdfs:Resource ; rdfs:comment "The first positional parameter of a pure function's sh:SPARQLFunction body; sh:parameter binds its meaning per function." .
:arg2 a rdfs:Resource ; rdfs:comment "The second positional parameter of a pure function's sh:SPARQLFunction body; sh:parameter binds its meaning per function." .
:arg3 a rdfs:Resource ; rdfs:comment "The third positional parameter of a pure function's sh:SPARQLFunction body; sh:parameter binds its meaning per function." .

# ---- Layer 0: assets and bytes ----
:bytes a :Function ; :kind :Native ; :layer 0 ; rdfs:label "bytes" ;
    :signature "bytes(node: IRI) -> xsd:hexBinary | bytes(node: IRI, offset: integer, length: integer) -> xsd:hexBinary" ;
    :reads hexplain:byteOffset, hexplain:byteLength ;
    rdfs:comment "The node's bytes as they sit in the file, whole or a slice relative to the node. Unbound when the slice leaves the node or exceeds hxf:maxBytesPerCall." ;
    :unboundWhen "The node has no recorded byte range, or the requested window lies outside the asset."@en .
:decodedBytes a :Function ; :kind :Native ; :layer 0 ; rdfs:label "decoded bytes" ;
    :signature "decodedBytes(node: IRI) -> xsd:hexBinary" ;
    :reads hexplain:isEncodedWith, hexplain:hasEncodingStep ;
    rdfs:comment "The node's bytes after the codec chain the profile declares has been inverted." ;
    :unboundWhen "The node carries no encoding, or decoding fails."@en .
:digest a :Function ; :kind :Native ; :layer 0 ; rdfs:label "digest" ;
    :signature "digest(node: IRI, algorithm: IRI | string) -> xsd:string" ;
    :reads hexplain:byteOffset, hexplain:byteLength ;
    rdfs:comment "Lower-case hex digest of the node's raw bytes. The algorithm is a checksum-register concept (rck:SHA256, rck:CRC32, ...) or a name." ;
    :unboundWhen "The algorithm is not one the runtime implements."@en .

# ---- Layer 1: parsed values ----
:value a :Function ; :kind :Native ; :layer 1 ; rdfs:label "value" ;
    :signature "value(node: IRI) -> literal" ;
    rdfs:comment "The node's parsed scalar, mapped by the profile or not. Unbound for structs, lists and arrays." ;
    :unboundWhen "The node has no parsed value in the bound asset."@en .
:hel a :Function ; :kind :Native ; :layer 1 ; rdfs:label "HEL" ;
    :signature "hel(node: IRI, expression: string) -> literal" ;
    rdfs:comment "A HEL expression evaluated with the node's struct as instance, its container as parent and the file as root." ;
    :unboundWhen "The expression does not parse, or evaluates against a context the node does not provide."@en .
:decode a :Function ; :kind :Native ; :layer 1 ; rdfs:label "decode" ;
    :signature "decode(bytes: xsd:hexBinary, type: bddo:DataType) -> literal" ;
    rdfs:comment "One scalar decoded from bytes by a BDDO primitive datatype." ;
    :unboundWhen "The bytes are not a well-formed value of the named datatype."@en .

# ---- Layer 2: arrays (DLV) ----
:rank a :Function ; :kind :Native ; :layer 2 ; rdfs:label "rank" ; :signature "rank(array: IRI) -> xsd:integer" ;
    :reads dlv:hasDimension ; rdfs:comment "Number of dimensions of the array." ;
    :unboundWhen "No array can be resolved for the node."@en .
:extent a :Function ; :kind :Native ; :layer 2 ; rdfs:label "extent" ;
    :signature "extent(array: IRI, dimension: integer | dlv:Axis) -> xsd:integer" ;
    :reads dlv:hasAxis, dlv:dimensionSize ; rdfs:comment "Size of one dimension, named by zero-based position or by axis." ;
    :unboundWhen "The named dimension does not exist on the array."@en .
:cell a :Function ; :kind :Native ; :layer 2 ; rdfs:label "cell" ;
    :signature "cell(array: IRI, i1: integer, ..., in: integer) -> literal" ;
    rdfs:comment "The cell at zero-based indices given in the layout's dimension order. Typed by the cell datatype." ;
    :unboundWhen "The index tuple is outside the array extent, or its arity does not match the array rank."@en .
:stat a :Function ; :kind :Native ; :layer 2 ; rdfs:label "statistic" ;
    :signature "stat(array: IRI, kind: string) -> literal | stat(array: IRI, kind: string, lo1, hi1, ..., lon, hin: integer) -> literal" ;
    rdfs:comment "min, max, sum, mean or count over the whole array or a half-open window. Refused above hxf:maxCellsPerWindow." ;
    :unboundWhen "The named statistic is not one this library computes, or the window is outside the array."@en .
:window a :Function ; :kind :Native ; :layer 2 ; rdfs:label "window" ;
    :signature "(array: IRI, lo1, hi1, ..., lon, hin: integer) hxf:window (i1, ..., in, value)" ;
    rdfs:comment "Property function enumerating every cell of a half-open window, row-major, binding its indices and value. Refused above hxf:maxCellsPerWindow. NON-PORTABLE: this is an Apache Jena ARQ property function (a magic predicate in a triple pattern), not a SPARQL 1.1 filter function nor a SHACL-AF function, so it runs only on Jena/ARQ with the Hexplain engine registered; other SPARQL processors read it as an ordinary triple pattern that matches nothing." ;
    :unboundWhen "The window bounds lie outside the array or their arity does not match its rank; the property function then yields no rows at all rather than partial ones."@en .
:layout a :Function ; :kind :Native ; :layer 2 ; rdfs:label "layout" ; :signature "layout(array: IRI) -> xsd:string" ;
    rdfs:comment "The resolved layout: axes, extents, strides and cell type." ;
    :unboundWhen "No array can be resolved for the node."@en .

# ---- Layer 3: raster ----
:sampleAt a :Function ; :kind :Native ; :layer 3 ; rdfs:label "sample at" ;
    :signature "sampleAt(grid: IRI, x: integer, y: integer, band?: IRI | integer) -> literal" ;
    :reads araster:hasArray, araster:hasBand, araster:bandIndex, dlv:axisX, dlv:axisY, dlv:axisBand ;
    rdfs:comment "Raw sample at column x, row y. The array is the band's araster:hasArray, else the grid's, else the grid struct's single array field. A band is a RasterBand IRI or a one-based index and is applied along dlv:axisBand when the array has one." ;
    :unboundWhen "The requested cell lies outside the array extent, or no array can be resolved for the grid or band."@en .
:calibrate a :Function , sh:SPARQLFunction ; :kind :Pure ; :layer 3 ; rdfs:label "calibrate" ;
    :signature "calibrate(band: IRI, raw: number) -> xsd:double" ;
    :reads araster:sampleScale, araster:sampleOffset ;
    rdfs:comment "raw * araster:sampleScale + araster:sampleOffset; identity when neither is asserted. Deterministic: exactly one answer or none, never one per matching triple." ;
    :unboundWhen "The band carries more than one distinct araster:sampleScale, or more than one distinct araster:sampleOffset: which one applies is undefined, so no value is returned rather than an arbitrary one."@en ;
    sh:parameter [ sh:path :arg1 ; sh:order 0 ; sh:description "band" ] , [ sh:path :arg2 ; sh:order 1 ; sh:description "raw" ] ;
    sh:returnType xsd:double ;
    sh:prefixes <https://hexplain.io/ns/fn> ;
    sh:select """SELECT ?result WHERE {
  FILTER NOT EXISTS { $arg1 <https://hexplain.io/ns/aspect/raster#sampleScale> ?s1 , ?s2 . FILTER ( !sameTerm(?s1, ?s2) ) }
  FILTER NOT EXISTS { $arg1 <https://hexplain.io/ns/aspect/raster#sampleOffset> ?o1 , ?o2 . FILTER ( !sameTerm(?o1, ?o2) ) }
  OPTIONAL { $arg1 <https://hexplain.io/ns/aspect/raster#sampleScale> ?scale }
  OPTIONAL { $arg1 <https://hexplain.io/ns/aspect/raster#sampleOffset> ?offset }
  BIND ( xsd:double($arg2) * COALESCE(xsd:double(?scale), 1.0) + COALESCE(xsd:double(?offset), 0.0) AS ?result )
}""" .
:isNoData a :Function , sh:SPARQLFunction ; :kind :Pure ; :layer 3 ; rdfs:label "is no-data" ;
    :signature "isNoData(band: IRI, value: number) -> xsd:boolean" ;
    :reads araster:noDataValue, araster:hasBand ;
    rdfs:comment "True when value equals the no-data value in effect: the band's own araster:noDataValue, else that of the grid that has the band (araster:hasBand). Compared as xsd:double; a NaN no-data value matches a NaN value, although NaN never equals itself numerically. False when no no-data value is in effect. Deterministic: exactly one answer or none." ;
    :unboundWhen "The band carries more than one distinct araster:noDataValue, or it has none and the grids having it carry more than one distinct one between them: which applies is undefined, so no value is returned rather than an arbitrary one."@en ;
    sh:parameter [ sh:path :arg1 ; sh:order 0 ; sh:description "band" ] , [ sh:path :arg2 ; sh:order 1 ; sh:description "value" ] ;
    sh:returnType xsd:boolean ;
    sh:prefixes <https://hexplain.io/ns/fn> ;
    sh:select """SELECT ?result WHERE {
  BIND ( EXISTS { $arg1 <https://hexplain.io/ns/aspect/raster#noDataValue> ?any } AS ?hasOwn )
  FILTER NOT EXISTS { $arg1 <https://hexplain.io/ns/aspect/raster#noDataValue> ?a , ?b . FILTER ( !sameTerm(?a, ?b) ) }
  FILTER ( ?hasOwn || NOT EXISTS {
    ?g <https://hexplain.io/ns/aspect/raster#hasBand> $arg1 ; <https://hexplain.io/ns/aspect/raster#noDataValue> ?a .
    ?h <https://hexplain.io/ns/aspect/raster#hasBand> $arg1 ; <https://hexplain.io/ns/aspect/raster#noDataValue> ?b .
    FILTER ( !sameTerm(?a, ?b) ) } )
  BIND ( IF(?hasOwn,
    EXISTS { $arg1 <https://hexplain.io/ns/aspect/raster#noDataValue> ?nd .
             FILTER ( xsd:double(?nd) = xsd:double($arg2) || ( xsd:double(?nd) != xsd:double(?nd) && xsd:double($arg2) != xsd:double($arg2) ) ) },
    EXISTS { ?grid <https://hexplain.io/ns/aspect/raster#hasBand> $arg1 ; <https://hexplain.io/ns/aspect/raster#noDataValue> ?nd .
             FILTER ( xsd:double(?nd) = xsd:double($arg2) || ( xsd:double(?nd) != xsd:double(?nd) && xsd:double($arg2) != xsd:double($arg2) ) ) } )
    AS ?result )
}""" .
:physicalAt a :Function ; :kind :Native ; :layer 3 ; rdfs:label "physical value at" ;
    :signature "physicalAt(grid: IRI, x: integer, y: integer, band?: IRI | integer) -> xsd:double" ;
    :reads araster:sampleScale, araster:sampleOffset, araster:noDataValue ;
    rdfs:comment "calibrate(sampleAt(...)); unbound when the raw sample is no-data." ;
    :unboundWhen "The raw sample equals the band's (or the grid's) araster:noDataValue: a no-data cell has no physical value, and returning the raw code as though it were one would be a wrong answer rather than a missing one."@en .

# ---- Layer 3: spatial reference (affine asref:GeoTransform) ----
# worldX = originX + col*scaleX + row*skewX ; worldY = originY + col*skewY + row*scaleY.
# Inverse: det = scaleX*scaleY - skewX*skewY ; c = (scaleY*(wx-originX) - skewX*(wy-originY))/det ;
# r = (-skewY*(wx-originX) + scaleX*(wy-originY))/det ; floor(c) for PixelCorner, floor(c+0.5) for PixelCenter.
:worldX a :Function , sh:SPARQLFunction ; :kind :Pure ; :layer 3 ; rdfs:label "world X" ;
    :signature "worldX(transform: IRI, col: number, row: number) -> xsd:double" ;
    :reads asref:originX, asref:scaleX, asref:skewX ;
    rdfs:comment "World X of grid position (col, row) under an affine geotransform; a missing skew reads as 0." ;
    sh:parameter [ sh:path :arg1 ; sh:order 0 ] , [ sh:path :arg2 ; sh:order 1 ] , [ sh:path :arg3 ; sh:order 2 ] ;
    sh:returnType xsd:double ;
    sh:prefixes <https://hexplain.io/ns/fn> ;
    sh:select """SELECT ?result WHERE {
  $arg1 <https://hexplain.io/ns/aspect/spatialref#originX> ?ox ; <https://hexplain.io/ns/aspect/spatialref#scaleX> ?sx .
  OPTIONAL { $arg1 <https://hexplain.io/ns/aspect/spatialref#skewX> ?kx }
  BIND ( xsd:double(?ox) + xsd:double($arg2) * xsd:double(?sx) + xsd:double($arg3) * COALESCE(xsd:double(?kx), 0.0) AS ?result )
}""" .
:worldY a :Function , sh:SPARQLFunction ; :kind :Pure ; :layer 3 ; rdfs:label "world Y" ;
    :signature "worldY(transform: IRI, col: number, row: number) -> xsd:double" ;
    :reads asref:originY, asref:scaleY, asref:skewY ;
    rdfs:comment "World Y of grid position (col, row) under an affine geotransform; a missing skew reads as 0." ;
    sh:parameter [ sh:path :arg1 ; sh:order 0 ] , [ sh:path :arg2 ; sh:order 1 ] , [ sh:path :arg3 ; sh:order 2 ] ;
    sh:returnType xsd:double ;
    sh:prefixes <https://hexplain.io/ns/fn> ;
    sh:select """SELECT ?result WHERE {
  $arg1 <https://hexplain.io/ns/aspect/spatialref#originY> ?oy ; <https://hexplain.io/ns/aspect/spatialref#scaleY> ?sy .
  OPTIONAL { $arg1 <https://hexplain.io/ns/aspect/spatialref#skewY> ?ky }
  BIND ( xsd:double(?oy) + xsd:double($arg2) * COALESCE(xsd:double(?ky), 0.0) + xsd:double($arg3) * xsd:double(?sy) AS ?result )
}""" .
:column a :Function , sh:SPARQLFunction ; :kind :Pure ; :layer 3 ; rdfs:label "column" ;
    :signature "column(transform: IRI, wx: number, wy: number) -> xsd:integer" ;
    :reads asref:originX, asref:originY, asref:scaleX, asref:scaleY, asref:skewX, asref:skewY, asref:pixelRegistration ;
    rdfs:comment "Column of the cell containing world point (wx, wy): floor for asref:PixelCorner (default), nearest centre for asref:PixelCenter." ;
    sh:parameter [ sh:path :arg1 ; sh:order 0 ] , [ sh:path :arg2 ; sh:order 1 ] , [ sh:path :arg3 ; sh:order 2 ] ;
    sh:returnType xsd:integer ;
    sh:prefixes <https://hexplain.io/ns/fn> ;
    sh:select """SELECT ?result WHERE {
  $arg1 <https://hexplain.io/ns/aspect/spatialref#originX> ?ox ; <https://hexplain.io/ns/aspect/spatialref#originY> ?oy ;
        <https://hexplain.io/ns/aspect/spatialref#scaleX> ?sx ; <https://hexplain.io/ns/aspect/spatialref#scaleY> ?sy .
  OPTIONAL { $arg1 <https://hexplain.io/ns/aspect/spatialref#skewX> ?kx }
  OPTIONAL { $arg1 <https://hexplain.io/ns/aspect/spatialref#skewY> ?ky }
  OPTIONAL { $arg1 <https://hexplain.io/ns/aspect/spatialref#pixelRegistration> ?reg }
  BIND ( COALESCE(xsd:double(?kx), 0.0) AS ?kxv ) BIND ( COALESCE(xsd:double(?ky), 0.0) AS ?kyv )
  BIND ( xsd:double(?sx) * xsd:double(?sy) - ?kxv * ?kyv AS ?det )
  FILTER ( ?det != 0.0 )
  BIND ( ( xsd:double(?sy) * (xsd:double($arg2) - xsd:double(?ox)) - ?kxv * (xsd:double($arg3) - xsd:double(?oy)) ) / ?det AS ?c )
  BIND ( xsd:integer(FLOOR(IF(BOUND(?reg) && ?reg = <https://hexplain.io/ns/aspect/spatialref#PixelCenter>, ?c + 0.5, ?c))) AS ?result )
}""" .
:row a :Function , sh:SPARQLFunction ; :kind :Pure ; :layer 3 ; rdfs:label "row" ;
    :signature "row(transform: IRI, wx: number, wy: number) -> xsd:integer" ;
    :reads asref:originX, asref:originY, asref:scaleX, asref:scaleY, asref:skewX, asref:skewY, asref:pixelRegistration ;
    rdfs:comment "Row of the cell containing world point (wx, wy): floor for asref:PixelCorner (default), nearest centre for asref:PixelCenter." ;
    sh:parameter [ sh:path :arg1 ; sh:order 0 ] , [ sh:path :arg2 ; sh:order 1 ] , [ sh:path :arg3 ; sh:order 2 ] ;
    sh:returnType xsd:integer ;
    sh:prefixes <https://hexplain.io/ns/fn> ;
    sh:select """SELECT ?result WHERE {
  $arg1 <https://hexplain.io/ns/aspect/spatialref#originX> ?ox ; <https://hexplain.io/ns/aspect/spatialref#originY> ?oy ;
        <https://hexplain.io/ns/aspect/spatialref#scaleX> ?sx ; <https://hexplain.io/ns/aspect/spatialref#scaleY> ?sy .
  OPTIONAL { $arg1 <https://hexplain.io/ns/aspect/spatialref#skewX> ?kx }
  OPTIONAL { $arg1 <https://hexplain.io/ns/aspect/spatialref#skewY> ?ky }
  OPTIONAL { $arg1 <https://hexplain.io/ns/aspect/spatialref#pixelRegistration> ?reg }
  BIND ( COALESCE(xsd:double(?kx), 0.0) AS ?kxv ) BIND ( COALESCE(xsd:double(?ky), 0.0) AS ?kyv )
  BIND ( xsd:double(?sx) * xsd:double(?sy) - ?kxv * ?kyv AS ?det )
  FILTER ( ?det != 0.0 )
  BIND ( ( - ?kyv * (xsd:double($arg2) - xsd:double(?ox)) + xsd:double(?sx) * (xsd:double($arg3) - xsd:double(?oy)) ) / ?det AS ?r )
  BIND ( xsd:integer(FLOOR(IF(BOUND(?reg) && ?reg = <https://hexplain.io/ns/aspect/spatialref#PixelCenter>, ?r + 0.5, ?r))) AS ?result )
}""" .
:sampleAtWorld a :Function ; :kind :Native ; :layer 3 ; rdfs:label "sample at world point" ;
    :signature "sampleAtWorld(dataset: IRI, wx: number, wy: number, band?: IRI | integer) -> literal" ;
    :reads asref:hasGeoTransform ;
    rdfs:comment "sampleAt at (column(t, wx, wy), row(t, wx, wy)) where t is the dataset's asref:hasGeoTransform." ;
    :unboundWhen "The world coordinate falls outside the raster, or no georeferencing transform is available."@en .

# ---- Layer 3: geometry and signal ----
:wkt a :Function ; :kind :Native ; :layer 3 ; rdfs:label "WKT" ;
    :signature "wkt(node: IRI) -> geo:wktLiteral" ;
    :reads asref:hasCRS, asref:epsgCode ;
    rdfs:comment "A GeoSPARQL WKT literal from a WKB or GeoPackage payload. The CRS is the GeoPackage SRS id, else asref:hasCRS/asref:epsgCode on the node or the nearest ancestor." ;
    :unboundWhen "The node carries no geometry this library can express as WKT."@en .
:sampleAtTime a :Function ; :kind :Native ; :layer 3 ; rdfs:label "sample at time" ;
    :signature "sampleAtTime(signal: IRI, seconds: number, channel?: integer) -> literal" ;
    :reads asig:sampleRate, araster:hasArray, dlv:axisTime, dlv:axisBand ;
    rdfs:comment "The cell at round(seconds * asig:sampleRate) along dlv:axisTime; the one-based channel is applied along dlv:axisBand." ;
    :unboundWhen "The requested instant lies outside the signal, or the channel does not exist."@en .

# ---- Diagnostics ----
:explain a :Function ; :kind :Native ; :layer 9 ; rdfs:label "explain" ; :signature "explain(node: IRI) -> xsd:string" ;
    rdfs:comment "How the runtime resolves the node (asset, profile, path, kind, byte range, layout) and why the last call on it failed within the same query execution (failure records do not survive the execution that made them). Never unbound." ;
    :total true .

# ---------- Shapes ----------

:NativeFunctionShape a sh:NodeShape ; rdfs:label "Native function contract" ;
    skos:definition "A native function reaches the bytes of an asset, so it can fail to answer in ways a pure function cannot, and a caller reading an unbound result needs to know which outcomes are described and which are defects. Every native function must therefore either state a condition under which it yields no value or declare itself total. This does not narrow the library-wide failure contract, which still applies to all of them."@en ;
    sh:targetClass :Function ;
    sh:or (
        [ sh:property [ sh:path :kind ; sh:hasValue :Pure ] ]
        [ sh:property [ sh:path :unboundWhen ; sh:minCount 1 ] ]
        [ sh:property [ sh:path :total ; sh:hasValue true ] ] ) ;
    sh:message "A native function must declare an hxf:unboundWhen condition or hxf:total true." .

# ---------- Range datatype shapes ----------
# Each XSD rdfs:range above, enforced wherever the property is used: activation is by
# subjects-of, so an untyped subject is checked too (tools/test_range_datatypes.py).
# Integer ranges accept any XSD integer-family datatype within the range's bounds.
hxf:IntegerValueShape a sh:NodeShape ; rdfs:label "Integer value shape" ;
    rdfs:isDefinedBy <https://hexplain.io/ns/fn> ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:short ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedByte ] ) .
hxf:RangeDatatypeShape a sh:NodeShape ; rdfs:label "Range datatype shape" ;
    rdfs:isDefinedBy <https://hexplain.io/ns/fn> ;
    sh:targetSubjectsOf hxf:layer ,
        hxf:maxBytesPerCall ,
        hxf:maxCellsPerWindow ,
        hxf:signature ,
        hxf:total ;
    sh:property [ sh:path hxf:layer ; sh:node hxf:IntegerValueShape ;
        sh:message "hxf:layer takes an integer (rdfs:range xsd:integer)." ] ;
    sh:property [ sh:path hxf:maxBytesPerCall ; sh:node hxf:IntegerValueShape ; sh:minInclusive 1 ;
        sh:message "hxf:maxBytesPerCall takes a positive integer (rdfs:range xsd:positiveInteger)." ] ;
    sh:property [ sh:path hxf:maxCellsPerWindow ; sh:node hxf:IntegerValueShape ; sh:minInclusive 1 ;
        sh:message "hxf:maxCellsPerWindow takes a positive integer (rdfs:range xsd:positiveInteger)." ] ;
    sh:property [ sh:path hxf:signature ; sh:datatype xsd:string ;
        sh:message "hxf:signature takes an xsd:string literal (rdfs:range xsd:string)." ] ;
    sh:property [ sh:path hxf:total ; sh:datatype xsd:boolean ;
        sh:message "hxf:total takes an xsd:boolean literal (rdfs:range xsd:boolean)." ] .

