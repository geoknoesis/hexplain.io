# An EPSG code is positive; a pixel registration is one of the two individuals.
# expect: ex:dataset gv:CrsShape sh:MinExclusiveConstraintComponent
# expect: ex:dataset gv:PixelRegistrationShape sh:InConstraintComponent
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix gv:    <https://hexplain.io/ns/geo#> .
@prefix asref: <https://hexplain.io/ns/aspect/spatialref#> .
@prefix ex:    <https://hexplain.io/test/geo-invalid#> .

ex:dataset a gv:RasterDataset ; asref:epsgCode 0 ; asref:pixelRegistration ex:Edge .
