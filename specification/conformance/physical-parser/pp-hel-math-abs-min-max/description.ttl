@prefix bddo: <https://hexplain.io/ns/bddo#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix dlv: <https://hexplain.io/ns/dlv#> .
@prefix menc: <https://hexplain.io/ns/register/media-encoding#> .
@prefix abnd: <https://hexplain.io/ns/aspect/bundle#> .
@prefix conf: <https://hexplain.io/ns/conf#> .
@prefix req: <https://hexplain.io/ns/req#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/pp-hel-math-abs-min-max#> .

ex:Root a bddo:Struct ; bddo:hasField ( ex:n ex:ai ex:af ex:lo ex:hi ex:first ex:firstf ex:three ex:single ) .
ex:n a bddo:Field ; bddo:dataType bddo:int8 .
ex:ai a bddo:Field ; bddo:valueFromExpression "abs(n)" .
ex:af a bddo:Field ; bddo:valueFromExpression "abs(-2.5)" .
ex:lo a bddo:Field ; bddo:valueFromExpression "min(2, 2.5)" .
ex:hi a bddo:Field ; bddo:valueFromExpression "max(2, 2.5)" .
ex:first a bddo:Field ; bddo:valueFromExpression "min(1, 1.0)" .
ex:firstf a bddo:Field ; bddo:valueFromExpression "min(1.0, 1)" .
ex:three a bddo:Field ; bddo:valueFromExpression "max(n, 0, 7)" .
ex:single a bddo:Field ; bddo:valueFromExpression "min(n)" .
