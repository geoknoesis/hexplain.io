@prefix bddo: <https://hexplain.io/ns/bddo#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix dlv: <https://hexplain.io/ns/dlv#> .
@prefix menc: <https://hexplain.io/ns/register/media-encoding#> .
@prefix abnd: <https://hexplain.io/ns/aspect/bundle#> .
@prefix conf: <https://hexplain.io/ns/conf#> .
@prefix req: <https://hexplain.io/ns/req#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/pp-hel-text-group#> .

ex:Root a bddo:Struct ; bddo:hasField ( ex:partial ex:whole ex:starts ex:clamped ) .
ex:partial a bddo:Field ; bddo:valueFromExpression "matches('IHDR', 'IH')" .
ex:whole a bddo:Field ; bddo:valueFromExpression "matches('IHDR', 'I.*')" .
ex:starts a bddo:Field ; bddo:valueFromExpression "startsWith('IHDR', 'IH')" .
ex:clamped a bddo:Field ; bddo:valueFromExpression "substr('abc', 1, 10)" .
