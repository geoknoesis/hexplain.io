@prefix bddo: <https://hexplain.io/ns/bddo#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix dlv: <https://hexplain.io/ns/dlv#> .
@prefix menc: <https://hexplain.io/ns/register/media-encoding#> .
@prefix abnd: <https://hexplain.io/ns/aspect/bundle#> .
@prefix conf: <https://hexplain.io/ns/conf#> .
@prefix req: <https://hexplain.io/ns/req#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/pp-hel-precedence-and-comparisons#> .

ex:Root a bddo:Struct ; bddo:hasField ( ex:flags ex:bit ex:order ex:nan ex:nanEq ex:nanNe ex:nanLt ) .
ex:flags a bddo:Field ; bddo:dataType bddo:uint8 .
ex:bit a bddo:Field ; bddo:valueFromExpression "flags & 1 == 1" .
ex:order a bddo:Field ; bddo:valueFromExpression "'B' < 'a'" .
ex:nan a bddo:Field ; bddo:valueFromExpression "(1e308 * 10.0) - (1e308 * 10.0)" .
ex:nanEq a bddo:Field ; bddo:valueFromExpression "nan == nan" .
ex:nanNe a bddo:Field ; bddo:valueFromExpression "nan != nan" .
ex:nanLt a bddo:Field ; bddo:valueFromExpression "nan < 1" .
