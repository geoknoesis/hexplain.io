@prefix bddo: <https://hexplain.io/ns/bddo#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix dlv: <https://hexplain.io/ns/dlv#> .
@prefix menc: <https://hexplain.io/ns/register/media-encoding#> .
@prefix abnd: <https://hexplain.io/ns/aspect/bundle#> .
@prefix conf: <https://hexplain.io/ns/conf#> .
@prefix req: <https://hexplain.io/ns/req#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/pp-layout-dimension-order-first-reverse#> .

ex:Root a bddo:Struct; bddo:hasField (ex:pixels).
ex:pixels a bddo:Field; bddo:dataType bddo:bytes; bddo:size 6; hexplain:hasDataLayout ex:Layout.
ex:Y a dlv:Dimension; dlv:hasAxis dlv:axisY; dlv:dimensionSize 2; dlv:dimensionStride 3.
ex:X a dlv:Dimension; dlv:hasAxis dlv:axisX; dlv:dimensionSize 3; dlv:dimensionStride 1.
ex:Layout a dlv:DataLayout; dlv:cellDataType bddo:uint8; dlv:hasConditionalDimensionOrder ([ a dlv:DimensionOrderRule; bddo:condition "true"; dlv:ruleDimensionOrder (ex:X ex:Y) ] [ a dlv:DimensionOrderRule; bddo:condition "true"; dlv:ruleDimensionOrder (ex:Y ex:X) ]).
