@prefix bddo: <https://hexplain.io/ns/bddo#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix dlv: <https://hexplain.io/ns/dlv#> .
@prefix menc: <https://hexplain.io/ns/register/media-encoding#> .
@prefix abnd: <https://hexplain.io/ns/aspect/bundle#> .
@prefix conf: <https://hexplain.io/ns/conf#> .
@prefix req: <https://hexplain.io/ns/req#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/pp-hel-math-unsigned-64#> .

ex:Root a bddo:Struct ; bddo:hasField ( ex:big ex:fl ex:ce ex:tr ex:ro ex:ab ex:mx ex:mn ex:text ) .
ex:big a bddo:Field ; bddo:dataType bddo:uint64 .
ex:fl a bddo:Field ; bddo:valueFromExpression "floor(big)" .
ex:ce a bddo:Field ; bddo:valueFromExpression "ceil(big)" .
ex:tr a bddo:Field ; bddo:valueFromExpression "trunc(big)" .
ex:ro a bddo:Field ; bddo:valueFromExpression "round(big)" .
ex:ab a bddo:Field ; bddo:valueFromExpression "abs(big)" .
ex:mx a bddo:Field ; bddo:valueFromExpression "max(1, big)" .
ex:mn a bddo:Field ; bddo:valueFromExpression "min(big, 1)" .
ex:text a bddo:Field ; bddo:valueFromExpression "toString(big)" .
