@prefix bddo: <https://hexplain.io/ns/bddo#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix dlv: <https://hexplain.io/ns/dlv#> .
@prefix menc: <https://hexplain.io/ns/register/media-encoding#> .
@prefix abnd: <https://hexplain.io/ns/aspect/bundle#> .
@prefix conf: <https://hexplain.io/ns/conf#> .
@prefix req: <https://hexplain.io/ns/req#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/pp-hel-integer-division#> .

ex:Root a bddo:Struct ; bddo:hasField ( ex:n ex:m ex:q ex:r ex:f ex:s ) .
ex:n a bddo:Field ; bddo:dataType bddo:int8 .
ex:m a bddo:Field ; bddo:dataType bddo:int8 .
ex:q a bddo:Field ; bddo:valueFromExpression "n / 2" .
ex:r a bddo:Field ; bddo:valueFromExpression "n % 2" .
ex:f a bddo:Field ; bddo:valueFromExpression "5 / 2.0" .
ex:s a bddo:Field ; bddo:valueFromExpression "m >> 1" .
