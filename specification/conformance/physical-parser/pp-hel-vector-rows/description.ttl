@prefix bddo: <https://hexplain.io/ns/bddo#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix dlv: <https://hexplain.io/ns/dlv#> .
@prefix menc: <https://hexplain.io/ns/register/media-encoding#> .
@prefix abnd: <https://hexplain.io/ns/aspect/bundle#> .
@prefix conf: <https://hexplain.io/ns/conf#> .
@prefix req: <https://hexplain.io/ns/req#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/pp-hel-vector-rows#> .

ex:Root a bddo:Struct ; bddo:hasField ( ex:a ex:b ex:big ex:f ex:neg ex:r1 ex:r2 ex:r3 ex:r4 ex:r5 ex:r6 ex:r7 ex:r8 ) .
ex:a a bddo:Field ; bddo:dataType bddo:uint8 .
ex:b a bddo:Field ; bddo:dataType bddo:uint8 .
ex:big a bddo:Field ; bddo:dataType bddo:uint32 .
ex:f a bddo:Field ; bddo:dataType bddo:float64 .
ex:neg a bddo:Field ; bddo:dataType bddo:int8 .
ex:r1 a bddo:Field ; bddo:valueFromExpression "a + b" .
ex:r2 a bddo:Field ; bddo:valueFromExpression "a / b" .
ex:r3 a bddo:Field ; bddo:valueFromExpression "neg / b" .
ex:r4 a bddo:Field ; bddo:valueFromExpression "f / b" .
ex:r5 a bddo:Field ; bddo:valueFromExpression "~a" .
ex:r6 a bddo:Field ; bddo:valueFromExpression "neg >> 1" .
ex:r7 a bddo:Field ; bddo:valueFromExpression "9007199254740993 > 9007199254740992.0" .
ex:r8 a bddo:Field ; bddo:valueFromExpression "false ? 1 : true ? 2 : 3" .
