@prefix bddo: <https://hexplain.io/ns/bddo#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix dlv: <https://hexplain.io/ns/dlv#> .
@prefix menc: <https://hexplain.io/ns/register/media-encoding#> .
@prefix abnd: <https://hexplain.io/ns/aspect/bundle#> .
@prefix conf: <https://hexplain.io/ns/conf#> .
@prefix req: <https://hexplain.io/ns/req#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/pp-hel-ternary-guard#> .

ex:Root a bddo:Struct ; bddo:hasField ( ex:items ex:guard ex:nested ) .
ex:items a bddo:Field ; bddo:dataType ex:Item ; bddo:repeatCount 2 .
ex:guard a bddo:Field ; bddo:valueFromExpression "len(items) > 5 ? items[5].v == 1 : false" .
ex:nested a bddo:Field ; bddo:valueFromExpression "len(items) == 1 ? 10 : len(items) == 2 ? 20 : 30" .
ex:Item a bddo:Struct ; bddo:hasField ( ex:v ) .
ex:v a bddo:Field ; bddo:dataType bddo:uint8 .
