@prefix bddo: <https://hexplain.io/ns/bddo#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix dlv: <https://hexplain.io/ns/dlv#> .
@prefix menc: <https://hexplain.io/ns/register/media-encoding#> .
@prefix abnd: <https://hexplain.io/ns/aspect/bundle#> .
@prefix conf: <https://hexplain.io/ns/conf#> .
@prefix req: <https://hexplain.io/ns/req#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/pp-hel-float-remainder#> .

ex:Root a bddo:Struct ; bddo:hasField ( ex:n ex:pp ex:np ex:pn ex:nn ex:mixed ex:inf ) .
ex:n a bddo:Field ; bddo:dataType bddo:int8 .
ex:pp a bddo:Field ; bddo:valueFromExpression "5.5 % 2.0" .
ex:np a bddo:Field ; bddo:valueFromExpression "-5.5 % 2.0" .
ex:pn a bddo:Field ; bddo:valueFromExpression "5.5 % -2.0" .
ex:nn a bddo:Field ; bddo:valueFromExpression "-5.5 % -2.0" .
ex:mixed a bddo:Field ; bddo:valueFromExpression "7.5 % n" .
ex:inf a bddo:Field ; bddo:valueFromExpression "3.5 % (1e308 * 10.0)" .
