@prefix bddo: <https://hexplain.io/ns/bddo#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix dlv: <https://hexplain.io/ns/dlv#> .
@prefix menc: <https://hexplain.io/ns/register/media-encoding#> .
@prefix abnd: <https://hexplain.io/ns/aspect/bundle#> .
@prefix conf: <https://hexplain.io/ns/conf#> .
@prefix req: <https://hexplain.io/ns/req#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/pp-int24-negative#> .

ex:Root a bddo:Struct ; bddo:hasField ( ex:a ex:b ex:c ex:d ) .
ex:a a bddo:Field ; bddo:dataType bddo:int24 .
ex:b a bddo:Field ; bddo:dataType bddo:int24le .
ex:c a bddo:Field ; bddo:dataType bddo:int24be .
ex:d a bddo:Field ; bddo:dataType bddo:int24le .
