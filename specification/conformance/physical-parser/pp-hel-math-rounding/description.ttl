@prefix bddo: <https://hexplain.io/ns/bddo#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix dlv: <https://hexplain.io/ns/dlv#> .
@prefix menc: <https://hexplain.io/ns/register/media-encoding#> .
@prefix abnd: <https://hexplain.io/ns/aspect/bundle#> .
@prefix conf: <https://hexplain.io/ns/conf#> .
@prefix req: <https://hexplain.io/ns/req#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/pp-hel-math-rounding#> .

ex:Root a bddo:Struct ; bddo:hasField ( ex:n ex:fl ex:fn ex:ce ex:cn ex:tn ex:ru ex:rn ex:rz ex:same ex:half ) .
ex:n a bddo:Field ; bddo:dataType bddo:int8 .
ex:fl a bddo:Field ; bddo:valueFromExpression "floor(2.7)" .
ex:fn a bddo:Field ; bddo:valueFromExpression "floor(-2.5)" .
ex:ce a bddo:Field ; bddo:valueFromExpression "ceil(2.1)" .
ex:cn a bddo:Field ; bddo:valueFromExpression "ceil(-2.5)" .
ex:tn a bddo:Field ; bddo:valueFromExpression "trunc(-2.7)" .
ex:ru a bddo:Field ; bddo:valueFromExpression "round(2.5)" .
ex:rn a bddo:Field ; bddo:valueFromExpression "round(-2.5)" .
ex:rz a bddo:Field ; bddo:valueFromExpression "round(-0.4)" .
ex:same a bddo:Field ; bddo:valueFromExpression "floor(n)" .
ex:half a bddo:Field ; bddo:valueFromExpression "ceil(n / 2.0)" .
