@prefix bddo: <https://hexplain.io/ns/bddo#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix dlv: <https://hexplain.io/ns/dlv#> .
@prefix menc: <https://hexplain.io/ns/register/media-encoding#> .
@prefix abnd: <https://hexplain.io/ns/aspect/bundle#> .
@prefix conf: <https://hexplain.io/ns/conf#> .
@prefix req: <https://hexplain.io/ns/req#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/pp-hel-exact-mixed-comparison#> .

ex:Root a bddo:Struct ; bddo:hasField ( ex:v ex:eq ex:gt ) .
ex:v a bddo:Field ; bddo:dataType bddo:uint64 .
ex:eq a bddo:Field ; bddo:valueFromExpression "v == 9007199254740992.0" .
ex:gt a bddo:Field ; bddo:valueFromExpression "v > 9007199254740992.0" .
