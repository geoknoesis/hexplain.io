@prefix bddo: <https://hexplain.io/ns/bddo#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix dlv: <https://hexplain.io/ns/dlv#> .
@prefix menc: <https://hexplain.io/ns/register/media-encoding#> .
@prefix abnd: <https://hexplain.io/ns/aspect/bundle#> .
@prefix conf: <https://hexplain.io/ns/conf#> .
@prefix req: <https://hexplain.io/ns/req#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/pp-hel-geometry-self-intersecting#> .

ex:Root a bddo:Struct ; bddo:hasField ( ex:ax ex:ay ex:bx ex:by ex:bowtie ex:square ) .
ex:ax a bddo:Field ; bddo:dataType bddo:int8 ; bddo:repeatCount 4 .
ex:ay a bddo:Field ; bddo:dataType bddo:int8 ; bddo:repeatCount 4 .
ex:bx a bddo:Field ; bddo:dataType bddo:int8 ; bddo:repeatCount 4 .
ex:by a bddo:Field ; bddo:dataType bddo:int8 ; bddo:repeatCount 4 .
ex:bowtie a bddo:Field ; bddo:valueFromExpression "isSelfIntersecting(ax, ay)" .
ex:square a bddo:Field ; bddo:valueFromExpression "isSelfIntersecting(bx, by)" .
