@prefix bddo: <https://hexplain.io/ns/bddo#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix dlv: <https://hexplain.io/ns/dlv#> .
@prefix menc: <https://hexplain.io/ns/register/media-encoding#> .
@prefix abnd: <https://hexplain.io/ns/aspect/bundle#> .
@prefix conf: <https://hexplain.io/ns/conf#> .
@prefix req: <https://hexplain.io/ns/req#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/pp-hel-math-tostring#> .

ex:Root a bddo:Struct ; bddo:hasField ( ex:n ex:neg ex:two ex:sum ex:big ex:below ex:milli ex:small ex:tiny ex:huge ex:minus ex:cat ) .
ex:n a bddo:Field ; bddo:dataType bddo:int8 .
ex:neg a bddo:Field ; bddo:valueFromExpression "toString(-42)" .
ex:two a bddo:Field ; bddo:valueFromExpression "toString(2.0)" .
ex:sum a bddo:Field ; bddo:valueFromExpression "toString(0.1 + 0.2)" .
ex:big a bddo:Field ; bddo:valueFromExpression "toString(1e7)" .
ex:below a bddo:Field ; bddo:valueFromExpression "toString(1234567.0)" .
ex:milli a bddo:Field ; bddo:valueFromExpression "toString(0.001)" .
ex:small a bddo:Field ; bddo:valueFromExpression "toString(1e-4)" .
ex:tiny a bddo:Field ; bddo:valueFromExpression "toString(4.9e-324)" .
ex:huge a bddo:Field ; bddo:valueFromExpression "toString(1.7976931348623157e308)" .
ex:minus a bddo:Field ; bddo:valueFromExpression "toString(-1.5e-5)" .
ex:cat a bddo:Field ; bddo:valueFromExpression "concat('n=', toString(n))" .
