@prefix bddo: <https://hexplain.io/ns/bddo#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix dlv: <https://hexplain.io/ns/dlv#> .
@prefix menc: <https://hexplain.io/ns/register/media-encoding#> .
@prefix abnd: <https://hexplain.io/ns/aspect/bundle#> .
@prefix conf: <https://hexplain.io/ns/conf#> .
@prefix req: <https://hexplain.io/ns/req#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/pp-table-csv#> .

ex:Root a bddo:DelimitedTable ; bddo:fieldDelimiter "2C"^^xsd:hexBinary ; bddo:quoteChar "22"^^xsd:hexBinary ;
    bddo:skipRecords 1 ; bddo:hasField ( ex:Root.name ex:Root.qty ) .
ex:Root.name a bddo:Field ; bddo:dataType bddo:string .
ex:Root.qty a bddo:Field ; bddo:dataType bddo:asciiInteger .
