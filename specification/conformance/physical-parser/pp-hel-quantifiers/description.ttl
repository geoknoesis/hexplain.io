@prefix bddo: <https://hexplain.io/ns/bddo#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix dlv: <https://hexplain.io/ns/dlv#> .
@prefix menc: <https://hexplain.io/ns/register/media-encoding#> .
@prefix abnd: <https://hexplain.io/ns/aspect/bundle#> .
@prefix conf: <https://hexplain.io/ns/conf#> .
@prefix req: <https://hexplain.io/ns/req#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/pp-hel-quantifiers#> .

ex:Root a bddo:Struct ; bddo:hasField ( ex:items ex:vals ex:none ex:allPos ex:anyBig ex:scalars ex:emptyAll ex:emptyAny ) .
ex:items a bddo:Field ; bddo:dataType ex:Item ; bddo:repeatCount 2 .
ex:vals a bddo:Field ; bddo:dataType bddo:uint8 ; bddo:repeatCount 2 .
ex:none a bddo:Field ; bddo:dataType bddo:uint8 ; bddo:repeatCount 0 .
ex:allPos a bddo:Field ; bddo:valueFromExpression "all(items, v > 0)" .
ex:anyBig a bddo:Field ; bddo:valueFromExpression "any(items, v > 5)" .
ex:scalars a bddo:Field ; bddo:valueFromExpression "all(vals, self < 10)" .
ex:emptyAll a bddo:Field ; bddo:valueFromExpression "all(none, false)" .
ex:emptyAny a bddo:Field ; bddo:valueFromExpression "any(none, true)" .
ex:Item a bddo:Struct ; bddo:hasField ( ex:v ) .
ex:v a bddo:Field ; bddo:dataType bddo:uint8 .
