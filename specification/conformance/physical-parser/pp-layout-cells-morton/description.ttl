@prefix bddo: <https://hexplain.io/ns/bddo#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix dlv: <https://hexplain.io/ns/dlv#> .
@prefix menc: <https://hexplain.io/ns/register/media-encoding#> .
@prefix abnd: <https://hexplain.io/ns/aspect/bundle#> .
@prefix conf: <https://hexplain.io/ns/conf#> .
@prefix req: <https://hexplain.io/ns/req#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/pp-layout-cells-morton#> .

ex:Root a bddo:Struct ; bddo:hasField ( ex:offsets ex:pixels ) .
ex:offsets a bddo:Field ; bddo:dataType bddo:uint8 ; bddo:repeatCount 9 .
ex:pixels a bddo:Field ; bddo:dataType bddo:bytes ; bddo:sizeToEndOfStream true ; hexplain:hasDataLayout ex:Layout .
ex:Layout a dlv:DataLayout ; dlv:cellDataType bddo:uint8 ; dlv:chunkOffsetsFromField ex:offsets ;
    dlv:chunkOffsetBase bddo:streamStart ; dlv:chunkOrder dlv:morton ; dlv:hasDimension ( ex:DimY ex:DimX ) .
ex:DimY a dlv:Dimension ; dlv:hasAxis dlv:axisY ; dlv:dimensionSize 3 ; dlv:chunkSize 1 .
ex:DimX a dlv:Dimension ; dlv:hasAxis dlv:axisX ; dlv:dimensionSize 6 ; dlv:chunkSize 2 .
