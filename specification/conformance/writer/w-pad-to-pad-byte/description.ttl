@prefix bddo: <https://hexplain.io/ns/bddo#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix dlv: <https://hexplain.io/ns/dlv#> .
@prefix menc: <https://hexplain.io/ns/register/media-encoding#> .
@prefix abnd: <https://hexplain.io/ns/aspect/bundle#> .
@prefix conf: <https://hexplain.io/ns/conf#> .
@prefix req: <https://hexplain.io/ns/req#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/w-pad-to-pad-byte#> .

ex:Root a bddo:Struct ; bddo:hasField ( ex:a ex:rec ex:tail ) .
ex:a a bddo:Field ; bddo:dataType bddo:uint8 ; bddo:padTo 4 ; bddo:padByte "2A"^^xsd:hexBinary .
ex:rec a bddo:Field ; bddo:dataType ex:Rec .
ex:Rec a bddo:Struct ; bddo:padTo 4 ; bddo:hasField ( ex:b ) .
ex:b a bddo:Field ; bddo:dataType bddo:uint8 .
ex:tail a bddo:Field ; bddo:dataType bddo:uint8 .
