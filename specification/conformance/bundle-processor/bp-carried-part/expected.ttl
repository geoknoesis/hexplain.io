@prefix bddo: <https://hexplain.io/ns/bddo#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix dlv: <https://hexplain.io/ns/dlv#> .
@prefix menc: <https://hexplain.io/ns/register/media-encoding#> .
@prefix abnd: <https://hexplain.io/ns/aspect/bundle#> .
@prefix conf: <https://hexplain.io/ns/conf#> .
@prefix req: <https://hexplain.io/ns/req#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/bp-carried-part#> .

@prefix rpr: <https://hexplain.io/ns/register/part-role#> .

   <urn:example:asset> a abnd:Asset ; dcterms:conformsTo ex:Profile ; abnd:hasPart <urn:example:asset/a.dat#root> , <urn:example:asset/a.prj#root> .
   <urn:example:asset/a.dat#root> a abnd:Part , ex:GridClass ; abnd:partRole rpr:Payload ; ex:value "5"^^xsd:unsignedByte .
   <urn:example:asset/a.prj#root> a abnd:Part ; abnd:partRole rpr:SpatialReference .
