{
  "id": "bp-carried-part",
  "class": "bundle-processor",
  "title": "A part whose spec has no abnd:describedBy is carried but not parsed",
  "description": "The .prj part is linked and typed but contributes no content.",
  "requirements": [
    "req-pm-multi-part-assets-1"
  ],
  "sections": [
    "processing#multi-part-assets"
  ],
  "bundleProfile": "https://example.org/bp-carried-part#Profile",
  "asset": "urn:example:asset",
  "parts": [
    {
      "path": "a.dat",
      "file": "part-1.bin",
      "iri": "urn:example:asset/a.dat"
    },
    {
      "path": "a.prj",
      "file": "part-2.bin",
      "iri": "urn:example:asset/a.prj"
    }
  ]
}
