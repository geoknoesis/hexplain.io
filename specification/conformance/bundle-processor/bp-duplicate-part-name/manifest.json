{
  "id": "bp-duplicate-part-name",
  "class": "bundle-processor",
  "title": "Two part specs described by structs with one local name are a description error",
  "description": "Both structs are named Header, so asset.Header would be ambiguous.",
  "requirements": [
    "req-pm-errors-8"
  ],
  "sections": [
    "processing#multi-part-assets",
    "processing#errors"
  ],
  "bundleProfile": "https://example.org/bp-duplicate-part-name#Profile",
  "asset": "urn:example:asset",
  "parts": [
    {
      "path": "a.hdr",
      "file": "part-1.bin",
      "iri": "urn:example:asset/a.hdr"
    },
    {
      "path": "a.dat",
      "file": "part-2.bin",
      "iri": "urn:example:asset/a.dat"
    }
  ]
}
