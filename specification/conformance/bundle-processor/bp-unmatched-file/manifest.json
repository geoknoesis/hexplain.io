{
  "id": "bp-unmatched-file",
  "class": "bundle-processor",
  "title": "A file that matches no part spec is a validation error",
  "description": "a.txt matches neither .hdr nor .dat.",
  "requirements": [
    "req-pm-errors-4"
  ],
  "sections": [
    "processing#multi-part-assets",
    "processing#errors"
  ],
  "bundleProfile": "https://example.org/bp-unmatched-file#Profile",
  "asset": "urn:example:asset",
  "parts": [
    {
      "path": "a.hdr",
      "file": "part-1.bin",
      "iri": "urn:example:asset/a.hdr"
    },
    {
      "path": "a.dat",
      "file": "part-2.bin",
      "iri": "urn:example:asset/a.dat"
    },
    {
      "path": "a.txt",
      "file": "part-3.bin",
      "iri": "urn:example:asset/a.txt"
    }
  ]
}
