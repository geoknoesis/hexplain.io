{
  "id": "ce-report-rdf-truncated",
  "class": "conformance-evaluator",
  "title": "The RDF report of a run stopped by the findings limit is marked truncated and non-conformant",
  "description": "Three elements fail under a findings limit of 1; R3, cited by nothing, is NotReached. An evaluator may instead fail with a ResourceLimit error.",
  "requirements": [
    "req-ce-conf-conformance-1",
    "req-ce-conf-conformance-10",
    "req-pm-conformance-evaluation-7",
    "req-pm-conformance-evaluation-8",
    "req-pm-conformance-evaluation-6",
    "req-ce-conf-conformance-9"
  ],
  "sections": [
    "processing#conformance-evaluation"
  ],
  "root": "https://example.org/ce-report-rdf-truncated#Root",
  "input": "input.bin",
  "rules": "rules.ttl",
  "parseMode": "lenient",
  "reportForm": "rdf",
  "reportConformsToShapes": true,
  "limits": {
    "maxFindings": 1
  },
  "orError": "ResourceLimit"
}
