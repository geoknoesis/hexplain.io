@prefix bddo: <https://hexplain.io/ns/bddo#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix dlv: <https://hexplain.io/ns/dlv#> .
@prefix menc: <https://hexplain.io/ns/register/media-encoding#> .
@prefix abnd: <https://hexplain.io/ns/aspect/bundle#> .
@prefix conf: <https://hexplain.io/ns/conf#> .
@prefix req: <https://hexplain.io/ns/req#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/ce-duplicate-requirement-identity-blank#> .

ex:C1 a conf:Constraint ; conf:scope ex:Header ; conf:assertion "magic == 'HXPL'" ;
    conf:satisfies [ a req:Requirement ; req:requirementId "R1" ; req:fromStandard "Example Format 1" ;
                     req:statement "R1 holds." ; req:discrepancyType req:Syntactic ] ,
                   [ a req:Requirement ; req:requirementId "R1" ; req:fromStandard "EXAMPLE FORMAT 1  " ;
                     req:statement "R1 holds again." ; req:discrepancyType req:Syntactic ] ;
    conf:message "failed at {field}" .
