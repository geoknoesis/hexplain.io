@prefix bddo: <https://hexplain.io/ns/bddo#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix dlv: <https://hexplain.io/ns/dlv#> .
@prefix menc: <https://hexplain.io/ns/register/media-encoding#> .
@prefix abnd: <https://hexplain.io/ns/aspect/bundle#> .
@prefix conf: <https://hexplain.io/ns/conf#> .
@prefix req: <https://hexplain.io/ns/req#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/ce-register-in-register#> .

ex:Root a bddo:Struct ; bddo:hasField ( ex:code1 ex:code2 ) .
ex:code1 a bddo:Field ; bddo:dataType bddo:string ; bddo:size 3 ; bddo:encoding bddo:ascii .
ex:code2 a bddo:Field ; bddo:dataType bddo:string ; bddo:size 3 ; bddo:encoding bddo:ascii .
ex:Scheme a <http://www.w3.org/2004/02/skos/core#ConceptScheme> .
ex:abc a <http://www.w3.org/2004/02/skos/core#Concept> ; <http://www.w3.org/2004/02/skos/core#inScheme> ex:Scheme ; <http://www.w3.org/2004/02/skos/core#notation> "ABC" .
