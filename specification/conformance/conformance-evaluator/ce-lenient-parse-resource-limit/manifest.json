{
  "id": "ce-lenient-parse-resource-limit",
  "class": "conformance-evaluator",
  "title": "A lenient parse does not continue past a ResourceLimit",
  "description": "The input exceeds a 4-byte maxInputBytes: the run fails with a ResourceLimit error, or returns a report marked truncated; it never records the limit as a finding and carries on.",
  "requirements": [
    "req-ce-conf-conformance-1",
    "req-ce-conf-conformance-10",
    "req-pm-recovery-5",
    "req-pm-errors-14",
    "req-pm-conformance-evaluation-6",
    "req-pm-resource-limits-3"
  ],
  "sections": [
    "processing#conformance-evaluation",
    "processing#errors",
    "processing#resource-limits"
  ],
  "root": "https://example.org/ce-lenient-parse-resource-limit#Root",
  "input": "input.bin",
  "rules": "rules.ttl",
  "parseMode": "lenient",
  "limits": {
    "maxInputBytes": 4
  },
  "orError": "ResourceLimit"
}
