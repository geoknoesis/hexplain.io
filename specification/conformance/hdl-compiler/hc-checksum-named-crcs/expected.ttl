ex:Root.c8 a bddo:Field ; bddo:dataType bddo:uint8 ; bddo:checksum [ a bddo:Checksum ; bddo:checksumAlgorithm bddo:crc8Smbus ; bddo:coversFromField ex:Root.text ; bddo:coversToField ex:Root.text ] .
