ex:Root.c32b a bddo:Field ; bddo:dataType bddo:uint32 ; bddo:checksum [ a bddo:Checksum ; bddo:checksumAlgorithm bddo:crc32Bzip2 ; bddo:coversFromField ex:Root.text ; bddo:coversToField ex:Root.text ] .
