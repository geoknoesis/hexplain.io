ex:Root a bddo:Struct ; bddo:hasField ( ex:Root.text ex:Root.c8 ex:Root.c16a ex:Root.c16x ex:Root.c16m ex:Root.c16s ex:Root.c32c ex:Root.c32b ex:Root.c32m ex:Root.c64e ex:Root.c64x ) .
