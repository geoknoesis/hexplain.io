@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix axv:   <https://hexplain.io/ns/archive#> .
@prefix apkg:  <https://hexplain.io/ns/aspect/packaging#> .
@prefix afs:   <https://hexplain.io/ns/aspect/fsmeta#> .
@prefix ex:    <https://hexplain.io/test/archive#> .

ex:zip a axv:Archive ; apkg:hasEntry ex:entry .
ex:entry a axv:ArchiveEntry ; afs:fileName "data.bin" ; afs:fileSize 4096 ; axv:compressedSize 1200 ; axv:entryComment "built nightly" .
