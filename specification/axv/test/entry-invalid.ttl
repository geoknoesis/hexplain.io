# A compressed size is not negative; an archive's members are archive entries.
# expect: ex:entry axv:EntryShape sh:MinInclusiveConstraintComponent
# expect: ex:zip axv:ArchiveShape sh:ClassConstraintComponent
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix axv:   <https://hexplain.io/ns/archive#> .
@prefix apkg:  <https://hexplain.io/ns/aspect/packaging#> .
@prefix ex:    <https://hexplain.io/test/archive-invalid#> .

ex:zip a axv:Archive ; apkg:hasEntry ex:untyped .
ex:entry a axv:ArchiveEntry ; axv:compressedSize -1 .
