# Hexplain Archive Vocabulary (AXV) 1.0 — vocabulary + SHACL shapes
@prefix :       <https://hexplain.io/ns/archive#> .
@prefix axv:    <https://hexplain.io/ns/archive#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix apkg:   <https://hexplain.io/ns/aspect/packaging#> .
@prefix afs:    <https://hexplain.io/ns/aspect/fsmeta#> .
@prefix aintg:  <https://hexplain.io/ns/aspect/integrity#> .
@prefix aenc:   <https://hexplain.io/ns/aspect/encoding#> .
@prefix menc:   <https://hexplain.io/ns/register/media-encoding#> .

<https://hexplain.io/ns/archive> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/archive/1.1> ; owl:versionInfo "1.1" ;
    owl:imports <https://hexplain.io/ns/aspect/packaging> , <https://hexplain.io/ns/aspect/fsmeta> , <https://hexplain.io/ns/aspect/integrity> , <https://hexplain.io/ns/aspect/encoding> ;
    rdfs:label "Hexplain Archive Vocabulary (AXV)" ;
    rdfs:comment "Semantic vocabulary for archive and container file properties." ;
    dcterms:created "2025-08-16"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "axv" ; vann:preferredNamespaceUri "https://hexplain.io/ns/archive#" .

:Archive a owl:Class ; rdfs:label "Archive" ; rdfs:subClassOf apkg:Container ; rdfs:isDefinedBy <https://hexplain.io/ns/archive> .
:ArchiveEntry a owl:Class ; rdfs:label "Archive Entry" ; rdfs:subClassOf apkg:Entry ; rdfs:isDefinedBy <https://hexplain.io/ns/archive> .
:CentralDirectory a owl:Class ; rdfs:label "Central Directory" ; rdfs:isDefinedBy <https://hexplain.io/ns/archive> .

# Cross-cutting properties come from the imported aspect layer:
#   apkg:hasEntry          (hx-packaging)
#   afs:fileName           (hx-fsmeta)
#   afs:fileSize           (hx-fsmeta)
#   afs:modificationTime   (hx-fsmeta)
#   afs:isDirectory        (hx-fsmeta)
#   aintg:checksum         (hx-integrity)
#   aenc:compression       (hx-encoding; an ObjectProperty valued by a skos:Concept such as menc:Deflate)
# Archive-specific properties are defined below.
:compressedSize a owl:DatatypeProperty ; rdfs:label "compressed size" ; rdfs:isDefinedBy <https://hexplain.io/ns/archive> ; rdfs:range xsd:unsignedLong .
:entryComment a owl:DatatypeProperty ; rdfs:label "entry comment" ; rdfs:isDefinedBy <https://hexplain.io/ns/archive> ; rdfs:range xsd:string .

# ---------- SHACL ----------
axv:ArchiveShape a sh:NodeShape ; sh:targetClass axv:Archive ;
    sh:property [ sh:path apkg:hasEntry ; sh:class axv:ArchiveEntry ] .
axv:EntryShape a sh:NodeShape ; sh:targetClass axv:ArchiveEntry ;
    sh:targetSubjectsOf axv:compressedSize, axv:entryComment ;
    sh:property [ sh:path afs:fileName ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path afs:fileSize ; sh:minInclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path axv:compressedSize ; sh:minInclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path aintg:checksum ; sh:datatype xsd:hexBinary ; sh:maxCount 1 ] ;
    sh:property [ sh:path afs:modificationTime ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
    sh:property [ sh:path afs:isDirectory ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ;
    sh:property [ sh:path aenc:compression ; sh:class skos:Concept ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] .

