# Hexplain Archive Vocabulary (AXV) 1.3 — vocabulary + SHACL shapes
@prefix :       <https://hexplain.io/ns/archive#> .
@prefix axv:    <https://hexplain.io/ns/archive#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix apkg:   <https://hexplain.io/ns/aspect/packaging#> .
@prefix afs:    <https://hexplain.io/ns/aspect/fsmeta#> .
@prefix aintg:  <https://hexplain.io/ns/aspect/integrity#> .
@prefix aenc:   <https://hexplain.io/ns/aspect/encoding#> .
@prefix menc:   <https://hexplain.io/ns/register/media-encoding#> .

<https://hexplain.io/ns/archive> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/archive/1.3> ; owl:versionInfo "1.3" ;
    owl:priorVersion <https://hexplain.io/ns/archive/1.2> ;
    dcterms:modified "2026-09-27"^^xsd:date ;
    owl:imports <https://hexplain.io/ns/aspect/packaging> , <https://hexplain.io/ns/aspect/fsmeta> , <https://hexplain.io/ns/aspect/integrity> , <https://hexplain.io/ns/aspect/encoding> ;
    rdfs:label "Hexplain Archive Vocabulary (AXV)" ;
    rdfs:comment "Semantic vocabulary for archive and container file properties." ;
    dcterms:created "2025-08-16"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "axv" ; vann:preferredNamespaceUri "https://hexplain.io/ns/archive#" .

:Archive a owl:Class ; rdfs:label "Archive" ; rdfs:subClassOf apkg:Container ; rdfs:isDefinedBy <https://hexplain.io/ns/archive> .
:ArchiveEntry a owl:Class ; rdfs:label "Archive Entry" ; rdfs:subClassOf apkg:Entry ; rdfs:isDefinedBy <https://hexplain.io/ns/archive> .
:CentralDirectory a owl:Class ; rdfs:label "Central Directory" ; rdfs:isDefinedBy <https://hexplain.io/ns/archive> .

# Cross-cutting properties come from the imported aspect layer:
#   apkg:hasEntry          (hx-packaging)
#   afs:fileName           (hx-fsmeta)
#   afs:fileSize           (hx-fsmeta)
#   afs:modificationTime   (hx-fsmeta)
#   afs:isDirectory        (hx-fsmeta)
#   aintg:checksum         (hx-integrity)
#   aenc:compression       (hx-encoding; an ObjectProperty valued by a skos:Concept such as menc:Deflate)
# Archive-specific properties are defined below.
:compressedSize a owl:DatatypeProperty ; rdfs:label "compressed size" ; rdfs:isDefinedBy <https://hexplain.io/ns/archive> ; rdfs:range xsd:unsignedLong .
:entryComment a owl:DatatypeProperty ; rdfs:label "entry comment" ; rdfs:isDefinedBy <https://hexplain.io/ns/archive> ; rdfs:range xsd:string .

# ---------- SHACL ----------
axv:ArchiveShape a sh:NodeShape ; sh:targetClass axv:Archive ;
    sh:property [ sh:path apkg:hasEntry ; sh:class axv:ArchiveEntry ] .
axv:EntryShape a sh:NodeShape ; sh:targetClass axv:ArchiveEntry ;
    sh:targetSubjectsOf axv:compressedSize, axv:entryComment ;
    sh:property [ sh:path afs:fileName ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path afs:fileSize ; sh:minInclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path axv:compressedSize ; sh:minInclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path aintg:checksum ; sh:datatype xsd:hexBinary ; sh:maxCount 1 ] ;
    sh:property [ sh:path afs:modificationTime ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
    sh:property [ sh:path afs:isDirectory ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ;
    sh:property [ sh:path aenc:compression ; sh:class skos:Concept ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] .

# ---------- Range datatype shapes ----------
# Each XSD rdfs:range above, enforced wherever the property is used: activation is by
# subjects-of, so an untyped subject is checked too (tools/test_range_datatypes.py).
# Integer ranges accept any XSD integer-family datatype within the range's bounds.
axv:IntegerValueShape a sh:NodeShape ; rdfs:label "Integer value shape" ;
    rdfs:isDefinedBy <https://hexplain.io/ns/archive> ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:short ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedByte ] ) .
axv:RangeDatatypeShape a sh:NodeShape ; rdfs:label "Range datatype shape" ;
    rdfs:isDefinedBy <https://hexplain.io/ns/archive> ;
    sh:targetSubjectsOf axv:compressedSize ,
        axv:entryComment ;
    sh:property [ sh:path axv:compressedSize ; sh:node axv:IntegerValueShape ; sh:minInclusive 0 ; sh:maxInclusive 18446744073709551615 ;
        sh:message "axv:compressedSize takes an integer within the xsd:unsignedLong value space (rdfs:range xsd:unsignedLong)." ] ;
    sh:property [ sh:path axv:entryComment ; sh:datatype xsd:string ;
        sh:message "axv:entryComment takes an xsd:string literal (rdfs:range xsd:string)." ] .

# BEGIN GENERATED TERM DOCUMENTATION
# Editorial annotations only; OWL axioms and SHACL constraints above are unchanged.
@prefix axv: <https://hexplain.io/ns/archive#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://hexplain.io/ns/archive> skos:scopeNote "Use for archive resources and member entries. Distinguish stored compressed bytes from logical member content."@en .
axv:Archive skos:definition "A container resource packaging independently identifiable member entries."@en .
axv:ArchiveEntry skos:definition "One member of an archive, including its payload and associated entry metadata."@en .
axv:ArchiveShape rdfs:label "Archive Shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/archive> ;
    skos:definition "Applies to instances of axv:Archive. Each value of apkg:hasEntry is an instance of axv:ArchiveEntry."@en .
axv:CentralDirectory skos:definition "An index component describing archive entries and the information needed to locate them."@en .
axv:EntryShape rdfs:label "Entry Shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/archive> ;
    skos:definition "Applies to instances of axv:ArchiveEntry; subjects using axv:compressedSize, axv:entryComment. axv:compressedSize takes at most one value; each is a number at least 0. aenc:compression takes at most one value; each is an IRI naming an instance of skos:Concept. afs:fileName takes at most one value; each is an xsd:string literal. afs:fileSize takes at most one value; each is a number at least 0. afs:isDirectory takes at most one value; each is an xsd:boolean literal. afs:modificationTime takes at most one value; each is an xsd:dateTime literal. aintg:checksum takes at most one value; each is an xsd:hexBinary literal."@en .
axv:IntegerValueShape skos:definition "Applied through references from other shapes. A conforming value is an integer (of any XSD integer datatype)."@en .
axv:RangeDatatypeShape skos:definition "Applies to subjects using axv:compressedSize, axv:entryComment. axv:compressedSize takes an integer within the xsd:unsignedLong value space (rdfs:range xsd:unsignedLong). axv:entryComment takes an xsd:string literal (rdfs:range xsd:string)."@en .
axv:compressedSize skos:definition "The number of bytes occupied by an archive entry's compressed representation, distinct from its logical uncompressed size."@en .
axv:entryComment skos:definition "Free-text commentary associated with an individual archive entry."@en .
