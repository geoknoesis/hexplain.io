# A frame rate is positive; a scan type is one of the two individuals; an aspect ratio is w:h.
# expect: ex:stream vdv:StreamShape sh:MinExclusiveConstraintComponent
# expect: ex:stream vdv:StreamShape sh:InConstraintComponent
# expect: ex:stream vdv:StreamShape sh:PatternConstraintComponent
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix vdv:   <https://hexplain.io/ns/video#> .
@prefix ex:    <https://hexplain.io/test/video-invalid#> .

ex:stream a vdv:VideoStream ; vdv:frameRate 0 ; vdv:scanType ex:Mixed ; vdv:aspectRatio "widescreen" .
