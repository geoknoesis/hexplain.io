# Hexplain Video Vocabulary (VDV) 1.0 — vocabulary + SHACL shapes
@prefix :       <https://hexplain.io/ns/video#> .
@prefix vdv:    <https://hexplain.io/ns/video#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix ma:     <http://www.w3.org/ns/ma-ont#> .
@prefix dlv:    <https://hexplain.io/ns/dlv#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .

<https://hexplain.io/ns/video> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/video/1.0> ; owl:versionInfo "1.0" ;
    rdfs:label "Hexplain Video Vocabulary (VDV)" ;
    rdfs:comment "Semantic vocabulary for video stream and container properties." ;
    dcterms:created "2025-08-16"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "vdv" ; vann:preferredNamespaceUri "https://hexplain.io/ns/video#" .

:VideoContainer a owl:Class ; rdfs:label "Video Container" ; rdfs:isDefinedBy <https://hexplain.io/ns/video> ; skos:closeMatch ma:MediaResource .
:VideoStream a owl:Class ; rdfs:label "Video Stream" ; rdfs:isDefinedBy <https://hexplain.io/ns/video> ; skos:closeMatch ma:VideoTrack .
:VideoTrack a owl:Class ; rdfs:label "Video Track" ; rdfs:isDefinedBy <https://hexplain.io/ns/video> .

:frameWidth a owl:DatatypeProperty ; rdfs:label "frame width" ; rdfs:isDefinedBy <https://hexplain.io/ns/video> ; skos:closeMatch ma:frameWidth ; rdfs:range xsd:positiveInteger .
:frameHeight a owl:DatatypeProperty ; rdfs:label "frame height" ; rdfs:isDefinedBy <https://hexplain.io/ns/video> ; skos:closeMatch ma:frameHeight ; rdfs:range xsd:positiveInteger .
:frameRate a owl:DatatypeProperty ; rdfs:label "frame rate" ; rdfs:isDefinedBy <https://hexplain.io/ns/video> ; skos:closeMatch ma:frameRate ; rdfs:range xsd:decimal .
:duration a owl:DatatypeProperty ; rdfs:label "duration" ; rdfs:isDefinedBy <https://hexplain.io/ns/video> ; skos:closeMatch ma:duration ; rdfs:range xsd:decimal .
:bitrate a owl:DatatypeProperty ; rdfs:label "bitrate" ; rdfs:isDefinedBy <https://hexplain.io/ns/video> ; skos:closeMatch ma:averageBitRate ; rdfs:range xsd:positiveInteger .
:codecIdentifier a owl:DatatypeProperty ; rdfs:label "codec identifier" ; rdfs:isDefinedBy <https://hexplain.io/ns/video> ; skos:closeMatch ma:hasFormat ; rdfs:range xsd:string .
:aspectRatio a owl:DatatypeProperty ; rdfs:label "aspect ratio" ; rdfs:isDefinedBy <https://hexplain.io/ns/video> ; rdfs:range xsd:string .
:colorSpace a owl:DatatypeProperty ; rdfs:label "color space" ; rdfs:isDefinedBy <https://hexplain.io/ns/video> ; rdfs:range xsd:string .
:scanType a owl:ObjectProperty ; rdfs:label "scan type" ; rdfs:isDefinedBy <https://hexplain.io/ns/video> .
:frameCount a owl:DatatypeProperty ; rdfs:label "frame count" ; rdfs:isDefinedBy <https://hexplain.io/ns/video> ; rdfs:range xsd:unsignedLong .
:audioChannels a owl:DatatypeProperty ; rdfs:label "audio channels" ; rdfs:isDefinedBy <https://hexplain.io/ns/video> ; rdfs:range xsd:positiveInteger .

:Progressive a owl:NamedIndividual ; rdfs:label "Progressive scan" .
:Interlaced a owl:NamedIndividual ; rdfs:label "Interlaced scan" .
:axisFrame a dlv:Axis ; rdfs:label "Frame Axis" ; rdfs:seeAlso dlv:axisTime .

# ---------- SHACL ----------
vdv:StreamShape a sh:NodeShape ; sh:targetSubjectsOf vdv:frameRate ;
    sh:property [ sh:path vdv:frameWidth ; sh:minExclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path vdv:frameHeight ; sh:minExclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path vdv:frameRate ; sh:nodeKind sh:Literal ; sh:maxCount 1 ] ;
    sh:property [ sh:path vdv:duration ; sh:nodeKind sh:Literal ; sh:maxCount 1 ] ;
    sh:property [ sh:path vdv:bitrate ; sh:minExclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path vdv:scanType ; sh:maxCount 1 ; sh:in ( vdv:Progressive vdv:Interlaced ) ] .
