# Hexplain Video Vocabulary (VDV) 1.2 — vocabulary + SHACL shapes
@prefix :       <https://hexplain.io/ns/video#> .
@prefix vdv:    <https://hexplain.io/ns/video#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix ma:     <http://www.w3.org/ns/ma-ont#> .
@prefix qudt:   <http://qudt.org/schema/qudt/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix unit:   <http://qudt.org/vocab/unit/> .
@prefix atime:  <https://hexplain.io/ns/aspect/time#> .
@prefix aenc:   <https://hexplain.io/ns/aspect/encoding#> .
@prefix acolor: <https://hexplain.io/ns/aspect/color#> .
@prefix araster:<https://hexplain.io/ns/aspect/raster#> .
@prefix dlv:    <https://hexplain.io/ns/dlv#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .

<https://hexplain.io/ns/video> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/video/1.2> ; owl:versionInfo "1.2" ;
    owl:priorVersion <https://hexplain.io/ns/video/1.1> ;
    dcterms:modified "2026-09-27"^^xsd:date ;
    owl:imports <https://hexplain.io/ns/aspect/time> , <https://hexplain.io/ns/aspect/encoding> , <https://hexplain.io/ns/aspect/color> , <https://hexplain.io/ns/aspect/raster> , <https://hexplain.io/ns/dlv> ;
    rdfs:label "Hexplain Video Vocabulary (VDV)" ;
    rdfs:comment "Semantic vocabulary for video stream and container properties." ;
    dcterms:created "2025-08-16"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "vdv" ; vann:preferredNamespaceUri "https://hexplain.io/ns/video#" .

:VideoContainer a owl:Class ; rdfs:label "Video Container" ; rdfs:isDefinedBy <https://hexplain.io/ns/video> ; rdfs:seeAlso ma:MediaResource .
:VideoStream a owl:Class ; rdfs:label "Video Stream" ; rdfs:isDefinedBy <https://hexplain.io/ns/video> ; rdfs:seeAlso ma:VideoTrack .
:VideoTrack a owl:Class ; rdfs:label "Video Track" ; rdfs:isDefinedBy <https://hexplain.io/ns/video> .

:frameRate a owl:DatatypeProperty ; rdfs:label "frame rate" ; rdfs:isDefinedBy <https://hexplain.io/ns/video> ; rdfs:seeAlso ma:frameRate ; rdfs:range xsd:decimal ; qudt:hasQuantityKind quantitykind:Frequency ; qudt:hasUnit unit:HZ .
# Frame dimensions come from the raster aspect: araster:width / araster:height.
# duration (atime), bitrate + codec (aenc), colorSpace (acolor) are imported from the aspect layer.
:aspectRatio a owl:DatatypeProperty ; rdfs:label "aspect ratio" ; rdfs:isDefinedBy <https://hexplain.io/ns/video> ; rdfs:range xsd:string ; rdfs:comment "Display aspect ratio as a W:H string, e.g. \"16:9\"." .
:scanType a owl:ObjectProperty ; rdfs:label "scan type" ; rdfs:isDefinedBy <https://hexplain.io/ns/video> .
:frameCount a owl:DatatypeProperty ; rdfs:label "frame count" ; rdfs:isDefinedBy <https://hexplain.io/ns/video> ; rdfs:range xsd:unsignedLong .
:audioChannels a owl:DatatypeProperty ; rdfs:label "audio channels" ; rdfs:isDefinedBy <https://hexplain.io/ns/video> ; rdfs:range xsd:positiveInteger .

:Progressive a owl:NamedIndividual ; rdfs:label "Progressive scan" .
:Interlaced a owl:NamedIndividual ; rdfs:label "Interlaced scan" .
:axisFrame a dlv:Axis ; rdfs:label "Frame Axis (deprecated)" ; rdfs:isDefinedBy <https://hexplain.io/ns/video> ;
    owl:deprecated true ; dcterms:isReplacedBy dlv:axisTime ;
    rdfs:comment "Deprecated duplicate of dlv:axisTime. Successive frames are the time axis of the layout. Layouts use dlv:axisTime; this IRI is retained so existing descriptions still resolve and denotes the same axis." .

# ---------- SHACL ----------
vdv:StreamShape a sh:NodeShape ; sh:targetClass vdv:VideoStream, vdv:VideoTrack ;
    sh:targetSubjectsOf vdv:frameRate, vdv:frameCount, vdv:aspectRatio, vdv:scanType, vdv:audioChannels, vdv:frameRateNumerator, vdv:frameRateDenominator ;
    sh:property [ sh:path araster:width ; sh:minExclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path araster:height ; sh:minExclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path vdv:frameRate ; sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] ) ; sh:minExclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path atime:duration ; sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] ) ; sh:minInclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path aenc:bitrate ; sh:minExclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path vdv:frameCount ; sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:unsignedLong ] ) ; sh:minInclusive 0 ; sh:maxInclusive 18446744073709551615 ; sh:maxCount 1 ] ;
    sh:property [ sh:path vdv:audioChannels ; sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:positiveInteger ] ) ; sh:minExclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path vdv:scanType ; sh:maxCount 1 ; sh:in ( vdv:Progressive vdv:Interlaced ) ] ;
    sh:property [ sh:path aenc:codec ; sh:class skos:Concept ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ;
    sh:property [ sh:path acolor:colorSpace ; sh:class skos:Concept ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ;
    sh:property [ sh:path vdv:aspectRatio ; sh:datatype xsd:string ; sh:pattern "^[0-9]+(\\.[0-9]+)?:[0-9]+(\\.[0-9]+)?$" ; sh:maxCount 1 ] .

# Exact nominal rate. For variable-rate streams this does not imply duration = count/rate.
:frameRateNumerator a owl:DatatypeProperty ; rdfs:label "frame rate numerator" ; rdfs:isDefinedBy <https://hexplain.io/ns/video> ; rdfs:range xsd:positiveInteger ; rdfs:comment "Numerator of the exact nominal frame rate in frames per second; used with frameRateDenominator. A decimal frameRate is a display approximation." .
:frameRateDenominator a owl:DatatypeProperty ; rdfs:label "frame rate denominator" ; rdfs:isDefinedBy <https://hexplain.io/ns/video> ; rdfs:range xsd:positiveInteger ; rdfs:comment "Positive denominator of the exact nominal frame rate, for example 1001 with numerator 30000. Both components must be supplied together." .
:RateShape a sh:NodeShape ; sh:targetSubjectsOf :frameRateNumerator, :frameRateDenominator ;
    sh:property [ sh:path :frameRateNumerator ; sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:positiveInteger ] ) ; sh:minExclusive 0 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :frameRateDenominator ; sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:positiveInteger ] ) ; sh:minExclusive 0 ; sh:minCount 1 ; sh:maxCount 1 ] .
:PositiveAspectRatioShape a sh:NodeShape ; sh:targetSubjectsOf :aspectRatio ;
    sh:sparql [ sh:message "Both aspect-ratio components must be positive." ; sh:select """
        PREFIX v: <https://hexplain.io/ns/video#>
        PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
        SELECT $this WHERE {
            $this v:aspectRatio ?ratio .
            FILTER(xsd:decimal(STRBEFORE(STR(?ratio), ":")) <= 0 || xsd:decimal(STRAFTER(STR(?ratio), ":")) <= 0)
        }
    """ ] .

# BEGIN GENERATED TERM DOCUMENTATION
# Editorial annotations only; OWL axioms and SHACL constraints above are unchanged.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vdv: <https://hexplain.io/ns/video#> .

<https://hexplain.io/ns/video> skos:scopeNote "Use for video containers, streams, tracks and timing metadata. Nominal rate must not be used as an exact variable-rate timeline."@en .
vdv:Interlaced rdfs:isDefinedBy <https://hexplain.io/ns/video> ;
    skos:definition "Scanning convention in which successive fields carry different line subsets of an image frame."@en .
vdv:PositiveAspectRatioShape rdfs:label "Positive Aspect Ratio Shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/video> ;
    skos:definition "Applies to subjects using vdv:aspectRatio. Both aspect-ratio components must be positive."@en .
vdv:Progressive rdfs:isDefinedBy <https://hexplain.io/ns/video> ;
    skos:definition "Scanning convention in which a frame represents a full image rather than alternating interlaced fields."@en .
vdv:RateShape rdfs:label "Rate Shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/video> ;
    skos:definition "Applies to subjects using vdv:frameRateDenominator, vdv:frameRateNumerator. vdv:frameRateDenominator takes exactly one value, an xsd:integer or xsd:positiveInteger literal greater than 0. vdv:frameRateNumerator takes exactly one value, an xsd:integer or xsd:positiveInteger literal greater than 0."@en .
vdv:StreamShape rdfs:label "Stream Shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/video> ;
    skos:definition "Applies to instances of vdv:VideoStream, vdv:VideoTrack; subjects using vdv:aspectRatio, vdv:audioChannels, vdv:frameCount, vdv:frameRate, vdv:frameRateDenominator, vdv:frameRateNumerator, vdv:scanType. acolor:colorSpace takes at most one value; each is an IRI naming an instance of skos:Concept. aenc:bitrate takes at most one value; each is a number greater than 0. aenc:codec takes at most one value; each is an IRI naming an instance of skos:Concept. araster:height takes at most one value; each is a number greater than 0. araster:width takes at most one value; each is a number greater than 0. atime:duration takes at most one value; each is an xsd:decimal or xsd:integer literal at least 0. vdv:aspectRatio takes at most one value; each is an xsd:string literal matching the regular expression ^[0-9]+(\\.[0-9]+)?:[0-9]+(\\.[0-9]+)?$. vdv:audioChannels takes at most one value; each is an xsd:integer or xsd:positiveInteger literal greater than 0. vdv:frameCount takes at most one value; each is an xsd:integer or xsd:unsignedLong literal at least 0, at most 18446744073709551615. vdv:frameRate takes at most one value; each is an xsd:decimal or xsd:integer literal greater than 0. vdv:scanType takes at most one value; each is one of vdv:Progressive or vdv:Interlaced."@en .
vdv:VideoContainer skos:definition "A containing resource for one or more video streams and associated tracks or metadata."@en .
vdv:VideoStream skos:definition "An ordered video sequence with timing and display properties independent of its container encoding."@en .
vdv:VideoTrack skos:definition "A container-level track carrying a video sequence; track identity is distinct from individual frames."@en .
vdv:audioChannels skos:definition "The declared number of audio channels associated with the video resource."@en .
vdv:axisFrame skos:definition "Deprecated duplicate of dlv:axisTime for successive video frames, kept so existing descriptions resolve."@en .
vdv:frameCount skos:definition "The declared number of frames in a video sequence; it does not by itself establish duration for variable-rate material."@en .
vdv:frameRate skos:definition "The nominal number of frames per second expressed as a decimal or integer value. Exact non-terminating rational rates require the numerator/denominator properties."@en .
vdv:scanType skos:definition "The scanning convention used to organize image lines into frames or fields."@en .
