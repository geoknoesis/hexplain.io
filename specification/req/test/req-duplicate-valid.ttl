@prefix req: <https://hexplain.io/ns/req#> .
@prefix ex:  <https://example.org/nitf-req-dup-ok#> .

# The same requirement id in two different standards is two requirements.
ex:FHDR-2500C a req:Requirement ;
    req:requirementId "A1-FHDR" ;
    req:fromStandard "MIL-STD-2500C, 01 May 2006 (unique-pair fixture)" ;
    req:statement "FHDR shall contain the value NITF." ;
    req:discrepancyType req:Syntactic .

ex:FHDR-4545 a req:Requirement ;
    req:requirementId "A1-FHDR" ;
    req:fromStandard "STANAG 4545 Ed. 2 (unique-pair fixture)" ;
    req:statement "FHDR shall contain the value NSIF." ;
    req:discrepancyType req:Syntactic .
