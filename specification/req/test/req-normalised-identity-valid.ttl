@prefix req: <https://hexplain.io/ns/req#> .
@prefix ex:  <https://example.org/req-normalised-ok#> .

# The identifier's case is significant: NF-001 and nf-001 of one standard are two
# requirements, even though the standard is compared ignoring case.
ex:Upper a req:Requirement ;
    req:requirementId "NF-001" ;
    req:fromStandard "Normalisation Standard, Edition 3" ;
    req:statement "The header shall be present." ;
    req:discrepancyType req:Syntactic .
ex:Lower a req:Requirement ;
    req:requirementId "nf-001" ;
    req:fromStandard "NORMALISATION STANDARD, EDITION 3" ;
    req:statement "The footer shall be present." ;
    req:discrepancyType req:Syntactic .
