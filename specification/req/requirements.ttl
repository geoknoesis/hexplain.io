    req:statement "Applies to subjects using aprov:acquisitionTime, aprov:platformName, aprov:sensorType. aprov:acquisitionTime takes at most one value; each is an xsd:dateTime literal. Each value of aprov:platformName is an xsd:string literal. Each value of aprov:sensorType is an xsd:string literal."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references gv:AcquisitionShape .
