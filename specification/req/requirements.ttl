    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:Checksum; objects of bddo:checksum. A bddo:Checksum states exactly one start of its covered range: bddo:coversFromField, bddo:coversFromExpression, or the deprecated whole-range bddo:coversExpression. Each focus node is a node that states exactly one of: bddo:coversFromField; bddo:coversFromExpression; bddo:coversExpression."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references bddo:ChecksumRangeStartShape .
reqs:req-shape-bddo-ChecksumShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:ChecksumShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:ChecksumShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-ChecksumShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "A bddo:Checksum names its algorithm exactly once, as one of the named algorithms or a bddo:CustomCrc, and states each property that bounds the bytes it covers at most once: a bddo:Field for bddo:coversFromField and bddo:coversToField, a HEL expression for bddo:coversFromExpression, bddo:coversToExpression and the deprecated whole-range bddo:coversExpression. That the range has exactly one start and exactly one end is bddo:ChecksumRangeStartShape and bddo:ChecksumRangeEndShape: a checksum with an algorithm and no bounds covers nothing a processor could verify, so it is rejected rather than read as covering everything."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references bddo:ChecksumShape .
reqs:req-shape-bddo-ConditionalEndiannessShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:ConditionalEndiannessShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:ConditionalEndiannessShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-ConditionalEndiannessShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to subjects using bddo:hasConditionalEndianness. bddo:endianness and bddo:hasConditionalEndianness are mutually exclusive. bddo:hasConditionalEndianness must point to a single rdf:List. Every member of a hasConditionalEndianness list must be a bddo:EndiannessRule."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references bddo:ConditionalEndiannessShape .
reqs:req-shape-bddo-CustomCrcShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:CustomCrcShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:CustomCrcShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-CustomCrcShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:CustomCrc. A bddo:CustomCrc states exactly one bddo:crcInit. A bddo:CustomCrc states exactly one bddo:crcPolynomial. A bddo:CustomCrc states exactly one bddo:crcReflectIn. A bddo:CustomCrc states exactly one bddo:crcReflectOut. A bddo:CustomCrc states exactly one bddo:crcWidth, an integer from 8 to 64. A bddo:CustomCrc states exactly one bddo:crcXorOut."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references bddo:CustomCrcShape .
reqs:req-shape-bddo-CustomEncodingCharsetShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:CustomEncodingCharsetShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:CustomEncodingCharsetShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-CustomEncodingCharsetShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Advisory (sh:Warning) checks on the bddo:ianaCharset of a bddo:CustomEncoding: it should not name the charset of a registered encoding, which has a term of its own, nor a charset whose name does not determine the byte order of its code units (UTF-16, UTF-32, ISO-10646-UCS-2, UCS-2). Names are compared ignoring case. Neither result makes a description invalid."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references bddo:CustomEncodingCharsetShape .
reqs:req-shape-bddo-CustomEncodingIdentityShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:CustomEncodingIdentityShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:CustomEncodingIdentityShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-CustomEncodingIdentityShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:CustomEncoding; subjects using bddo:ianaCharset. A registered encoding is never also typed bddo:CustomEncoding. Each focus node is not both an instance of bddo:CustomEncoding and one of bddo:utf8, bddo:ascii, bddo:utf16le, bddo:utf16be, bddo:latin1, bddo:utf32le, bddo:utf32be, bddo:ucs2le, bddo:ucs2be, bddo:windows1252, bddo:iso8859_2, bddo:iso8859_5, bddo:iso8859_7, bddo:iso8859_9, bddo:iso8859_15, bddo:ebcdic037 or bddo:shiftJis."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references bddo:CustomEncodingIdentityShape .
reqs:req-shape-bddo-CustomEncodingShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:CustomEncodingShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:CustomEncodingShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-CustomEncodingShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:CustomEncoding; subjects using bddo:ianaCharset. An encoding that states a bddo:ianaCharset is an IRI, so that the fields using it can name it. Each focus node is an IRI. An encoding states exactly one bddo:ianaCharset, an IANA Character Sets registry name (letters, digits and . _ : ( ) + -, at most 40 characters); a bddo:CustomEncoding must state it."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references bddo:CustomEncodingShape .
reqs:req-shape-bddo-DataTypeRuleShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:DataTypeRuleShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:DataTypeRuleShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-DataTypeRuleShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:DataTypeRule. bddo:condition takes exactly one value, a HEL expression (an xsd:string or bddo:HelExpression literal). bddo:ruleDataType takes exactly one value, an IRI naming an instance of bddo:DataType or bddo:Struct."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references bddo:DataTypeRuleShape .
reqs:req-shape-bddo-DataTypeShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:DataTypeShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:DataTypeShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-DataTypeShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:DataType. bddo:baseType takes at most one value; each is one of bddo:baseInteger, bddo:baseFloat, bddo:baseString or bddo:baseBytes. bddo:bcd takes at most one value; each is an xsd:boolean literal. bddo:bitWidth takes at most one value; each is a number greater than 0. bddo:endianness takes at most one value; each is either bddo:BigEndian or bddo:LittleEndian. bddo:fixedPointScale takes at most one value. bddo:floatFormat takes at most one value; each is one of bddo:ieee754, bddo:ibmHexadecimal, bddo:vaxF, bddo:vaxD, bddo:vaxG or bddo:bfloat16. bddo:isSigned takes at most one value; each is an xsd:boolean literal. bddo:xsdType takes at most one value; each is an IRI."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references bddo:DataTypeShape .
reqs:req-shape-bddo-DelimitedRecordsShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:DelimitedRecordsShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:DelimitedRecordsShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-DelimitedRecordsShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:DelimitedRecords. A bddo:DelimitedRecords separates values by a fixed bddo:fieldDelimiter or by runs of whitespace (bddo:whitespaceSeparated true), never both. Each focus node is a node that does not state both bddo:fieldDelimiter and bddo:whitespaceSeparated true. bddo:commentPrefix takes at most one value; each is an xsd:string literal. bddo:escapeChar takes at most one value; each is an xsd:hexBinary literal. bddo:fieldDelimiter takes at most one value; each is an xsd:hexBinary literal. A bddo:DelimitedRecords must declare at least one field. bddo:keyValueSeparator takes at most one value; each is an xsd:hexBinary literal. bddo:quoteChar takes at most one value; each is an xsd:hexBinary literal. bddo:recordDelimiter takes at most one value; each is an xsd:hexBinary literal. bddo:skipRecords takes at most one value; each is a number at least 0. bddo:trimWhitespace takes at most one value; each is an xsd:boolean literal. bddo:whitespaceSeparated takes at most one value; each is an xsd:boolean literal."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references bddo:DelimitedRecordsShape .
reqs:req-shape-bddo-DelimitedTableShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:DelimitedTableShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:DelimitedTableShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-DelimitedTableShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:DelimitedTable. A bddo:DelimitedTable declares how its columns are separated: a bddo:fieldDelimiter or bddo:whitespaceSeparated true. Each focus node is either a node that states bddo:fieldDelimiter or a node that states bddo:whitespaceSeparated true. bddo:keyValueSeparator applies to a KeyValueHeader, not a DelimitedTable. No field of a bddo:DelimitedTable states bddo:key: a table's columns are located by position, and bddo:key applies to a field of a KeyValueHeader."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references bddo:DelimitedTableShape .
reqs:req-shape-bddo-DeprecatedVaxFWidthShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:DeprecatedVaxFWidthShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:DeprecatedVaxFWidthShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-DeprecatedVaxFWidthShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Advisory (sh:Warning): bddo:vaxF on a 64-bit float is the deprecated spelling of bddo:vaxD. It is read as D_floating and does not make the description invalid."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references bddo:DeprecatedVaxFWidthShape .
reqs:req-shape-bddo-DerivedFieldShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:DerivedFieldShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:DerivedFieldShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-DerivedFieldShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:Field. A bddo:valueFromExpression (derived) field must not also declare a byte-consuming or byte-positioning mechanism (dataType, hasConditionalDataType, size*, terminator, bitLength, atOffset*, enumeration, alignment or padTo): it occupies no bytes to type, size, place, align or pad."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references bddo:DerivedFieldShape .
reqs:req-shape-bddo-DisjointKindsShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:DisjointKindsShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:DisjointKindsShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-DisjointKindsShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "A node is at most one of bddo:Struct, bddo:Field and bddo:DataType (subclasses included), as the owl:AllDisjointClasses axiom states."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references bddo:DisjointKindsShape .
reqs:req-shape-bddo-DispatchArmShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:DispatchArmShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:DispatchArmShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-DispatchArmShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:DispatchArm; subjects using bddo:armDataType, bddo:armKey, bddo:armTable. bddo:armDataType takes exactly one value, an IRI naming an instance of bddo:DataType or bddo:Struct. bddo:armKey takes exactly one value, an xsd:string or xsd:integer literal. bddo:armTable takes exactly one value, an instance of bddo:DispatchTable."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references bddo:DispatchArmShape .
reqs:req-shape-bddo-DispatchKeyUniquenessShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:DispatchKeyUniquenessShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:DispatchKeyUniquenessShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-DispatchKeyUniquenessShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:DispatchTable. Two DispatchArms of one DispatchTable declare the same armKey."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references bddo:DispatchKeyUniquenessShape .
reqs:req-shape-bddo-DispatchTableShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:DispatchTableShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:DispatchTableShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-DispatchTableShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:DispatchTable. A bddo:DispatchTable states its key exactly one way: bddo:dispatchOnField or bddo:dispatchOnExpression. Each focus node is a node that states exactly one of: bddo:dispatchOnField; bddo:dispatchOnExpression. bddo:dispatchDefault takes at most one value; each is an IRI naming an instance of bddo:DataType or bddo:Struct. bddo:dispatchOnExpression takes at most one value; each is a HEL expression (an xsd:string or bddo:HelExpression literal). bddo:dispatchOnField takes at most one value; each is an instance of bddo:Field."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references bddo:DispatchTableShape .
reqs:req-shape-bddo-EndiannessRuleShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:EndiannessRuleShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:EndiannessRuleShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-EndiannessRuleShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:EndiannessRule. bddo:condition takes exactly one value, a HEL expression (an xsd:string or bddo:HelExpression literal). bddo:ruleEndianness must be bddo:BigEndian or bddo:LittleEndian."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references bddo:EndiannessRuleShape .
reqs:req-shape-bddo-EnumValueShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:EnumValueShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:EnumValueShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-EnumValueShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:EnumValue. bddo:enumRawValue takes exactly one value. bddo:enumSymbol takes at most one value; each is an IRI."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references bddo:EnumValueShape .
reqs:req-shape-bddo-EnumerationShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:EnumerationShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:EnumerationShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-EnumerationShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:Enumeration. bddo:enumIsFlags takes at most one value; each is an xsd:boolean literal. bddo:hasEnumValue takes at least one value; each is an instance of bddo:EnumValue."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references bddo:EnumerationShape .
reqs:req-shape-bddo-FieldOffsetShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:FieldOffsetShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:FieldOffsetShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-FieldOffsetShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:Field. A bddo:Field must use at most one offset mechanism."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references bddo:FieldOffsetShape .
reqs:req-shape-bddo-FieldRepetitionShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:FieldRepetitionShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:FieldRepetitionShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-FieldRepetitionShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:Field. A bddo:Field must use at most one repetition mechanism."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references bddo:FieldRepetitionShape .
reqs:req-shape-bddo-FieldShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:FieldShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:FieldShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-FieldShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:Field. A bddo:Field declares how it is typed: bddo:dataType, bddo:hasConditionalDataType, bddo:hasDispatchTable or bddo:valueFromExpression. Each focus node is either a node that states bddo:dataType, a node that states bddo:hasConditionalDataType, a node that states bddo:valueFromExpression or a node that states bddo:hasDispatchTable. bddo:alignment takes at most one value; each is a number greater than 0. bddo:atOffset takes at most one value; each is a number at least 0. bddo:atOffsetFromExpression takes at most one value; each is a HEL expression (an xsd:string or bddo:HelExpression literal). bddo:atOffsetFromField takes at most one value; each is an instance of bddo:Field. bddo:bcd takes at most one value; each is an xsd:boolean literal. bddo:bitLength takes at most one value; each is a number greater than 0. bddo:bitOrder takes at most one value; each is either bddo:MSBFirst or bddo:LSBFirst. bddo:checksum takes at most one value; each is an instance of bddo:Checksum. bddo:dataType takes at most one value; each is an IRI naming an instance of bddo:DataType or bddo:Struct. bddo:encoding takes at most one value; each is a registered bddo:Encoding individual or an instance of bddo:Encoding (a bddo:CustomEncoding a profile mints). bddo:encoding names an encoding outside the registered set (the bddo:Encoding individuals this vocabulary declares); a bddo:CustomEncoding is accepted, but only a processor that supports its bddo:ianaCharset can decode it. bddo:enumeration takes at most one value; each is an instance of bddo:Enumeration. bddo:fixedPointScale takes at most one value. bddo:floatFormat takes at most one value; each is one of bddo:ieee754, bddo:ibmHexadecimal, bddo:vaxF, bddo:vaxD, bddo:vaxG or bddo:bfloat16. bddo:hasDispatchTable takes at most one value; each is an instance of bddo:DispatchTable. bddo:hasFixedValue takes at most one value; each is a literal. bddo:isPresentIf takes at most one value; each is a HEL expression (an xsd:string or bddo:HelExpression literal). bddo:offsetBase takes at most one value; each is one of bddo:streamStart, bddo:streamEnd, bddo:parentStart, bddo:currentPosition or bddo:fieldStart. bddo:offsetBaseField takes at most one value; each is an instance of bddo:Field. bddo:padByte takes at most one value; each is one xsd:hexBinary octet (two hex digits). bddo:padTo takes at most one value; each is a number greater than 0. bddo:repeatCount takes at most one value; each is a number at least 0. bddo:repeatCountFromExpression takes at most one value; each is a HEL expression (an xsd:string or bddo:HelExpression literal). bddo:repeatCountFromField takes at most one value; each is an instance of bddo:Field. bddo:repeatUntil takes at most one value; each is a HEL expression (an xsd:string or bddo:HelExpression literal). bddo:rootKeyFromField takes at most one value; each is an instance of bddo:Field. bddo:seekScope takes at most one value; each is either bddo:regionScope or bddo:streamScope. bddo:separatedBy takes at most one value; each is an xsd:string literal equal to \"whitespace\". bddo:size takes at most one value; each is a number greater than 0. bddo:sizeFromExpression takes at most one value; each is a HEL expression (an xsd:string or bddo:HelExpression literal). bddo:sizeFromField takes at most one value; each is an instance of bddo:Field. bddo:sizeToEndOfStream takes at most one value; each is an xsd:boolean literal. bddo:terminator takes at most one value; each is an xsd:hexBinary literal. bddo:trimNull takes at most one value; each is an xsd:boolean literal. bddo:validIf takes at most one value; each is a HEL expression (an xsd:string or bddo:HelExpression literal). bddo:valueFromExpression takes at most one value; each is a HEL expression (an xsd:string or bddo:HelExpression literal). Every member of a hasConditionalDataType list must be a bddo:DataTypeRule."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references bddo:FieldShape .
reqs:req-shape-bddo-FieldSizingShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:FieldSizingShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:FieldSizingShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-FieldSizingShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:Field. A bddo:Field must use at most one sizing/termination mechanism."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references bddo:FieldSizingShape .
reqs:req-shape-bddo-FixedPointScaleRangeShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:FixedPointScaleRangeShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:FixedPointScaleRangeShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-FixedPointScaleRangeShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Advisory (sh:Warning): a bddo:fixedPointScale outside -4096..4096 is beyond the range every processor supports, so the description is not portable. It does not make the description invalid."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references bddo:FixedPointScaleRangeShape .
reqs:req-shape-bddo-FloatFormatWidthShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:FloatFormatWidthShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:FloatFormatWidthShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-FloatFormatWidthShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "A bddo:floatFormat is used at a width it exists at: bddo:bfloat16 on a 16-bit float, bddo:ibmHexadecimal on a 32- or 64-bit float, bddo:vaxF on a 32-bit float (a 64-bit one is the deprecated spelling of bddo:vaxD, reported by bddo:DeprecatedVaxFWidthShape), bddo:vaxD and bddo:vaxG on a 64-bit float."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references bddo:FloatFormatWidthShape .
reqs:req-shape-bddo-GroupedRecordsShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:GroupedRecordsShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:GroupedRecordsShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-GroupedRecordsShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:DelimitedRecords. bddo:hasGrouping takes at most one value; each is an instance of bddo:RecordGrouping. bddo:pathSeparator takes at most one value; each is an xsd:string literal."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references bddo:GroupedRecordsShape .
reqs:req-shape-bddo-HelExpressionValueShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:HelExpressionValueShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:HelExpressionValueShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-HelExpressionValueShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "A HEL expression literal: typed xsd:string, as existing descriptions write it, or bddo:HelExpression. Every expression-valued property's shapes use it in place of sh:datatype xsd:string."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references bddo:HelExpressionValueShape .
reqs:req-shape-bddo-HelVersionShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:HelVersionShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:HelVersionShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-HelVersionShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to subjects using bddo:helVersion. bddo:helVersion is stated at most once, as an xsd:string major.minor version of two decimal numbers without leading zeros, such as \"1.0\"."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references bddo:HelVersionShape .
reqs:req-shape-bddo-IntegerValueShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:IntegerValueShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:IntegerValueShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-IntegerValueShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applied through references from other shapes. An integer value is a literal of an XSD integer-family datatype (xsd:integer, xsd:positiveInteger, xsd:nonNegativeInteger, xsd:int, xsd:long, xsd:unsignedInt, xsd:unsignedLong, xsd:short, xsd:unsignedShort, xsd:byte or xsd:unsignedByte). A conforming value is an integer (of any XSD integer datatype)."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references bddo:IntegerValueShape .
reqs:req-shape-bddo-KeyPathShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:KeyPathShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:KeyPathShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-KeyPathShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:Field. bddo:keyPath takes at most one value; each is an xsd:string literal. bddo:keyPath locates a field inside nested groups, so its container must declare bddo:hasGrouping; without one the container is flat and the path addresses nothing."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references bddo:KeyPathShape .
reqs:req-shape-bddo-KeyValueHeaderShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:KeyValueHeaderShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:KeyValueHeaderShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-KeyValueHeaderShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:KeyValueHeader. A bddo:KeyValueHeader must declare bddo:keyValueSeparator. Every field of a bddo:KeyValueHeader declares at most one bddo:key (flat) or one bddo:keyPath (nested), never both; a field with neither is located by its simple key."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references bddo:KeyValueHeaderShape .
reqs:req-shape-bddo-LocalBindingKindShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:LocalBindingKindShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:LocalBindingKindShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-LocalBindingKindShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:LocalBinding; subjects using bddo:localExpression. A bddo:LocalBinding is not also a bddo:Field: a binding names a computed value and consumes no bytes. Each focus node is not an instance of bddo:Field."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references bddo:LocalBindingKindShape .
reqs:req-shape-bddo-LocalBindingShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:LocalBindingShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:LocalBindingShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-LocalBindingShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:LocalBinding; subjects using bddo:localExpression. A bddo:LocalBinding is an IRI: its name is the simple key of its IRI. Each focus node is an IRI. A bddo:LocalBinding states exactly one bddo:localExpression."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references bddo:LocalBindingShape .
reqs:req-shape-bddo-NamespaceBindingShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:NamespaceBindingShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:NamespaceBindingShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-NamespaceBindingShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:NamespaceBinding; subjects using bddo:namespaceIRI, bddo:namespacePrefix; objects of bddo:hasNamespaceBinding. A namespace binding needs the IRI it binds to; a prefix alone names nothing. bddo:namespaceIRI must be an absolute IRI (it begins with a scheme). bddo:namespacePrefix takes exactly one value, an xsd:string literal."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references bddo:NamespaceBindingShape .
reqs:req-shape-bddo-NodePathShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:NodePathShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:NodePathShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-NodePathShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:Field; subjects using bddo:nodePath. bddo:nodePath takes at most one value; each is an xsd:string literal."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references bddo:NodePathShape .
reqs:req-shape-bddo-NumericBaseShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:NumericBaseShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:NumericBaseShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-NumericBaseShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to subjects using bddo:numericBase. bddo:numericBase applies only to a field whose bddo:dataType is bddo:asciiInteger. bddo:numericBase must be 8, 10 or 16."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references bddo:NumericBaseShape .
reqs:req-shape-bddo-NumericRepresentationShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:NumericRepresentationShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:NumericRepresentationShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-NumericRepresentationShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "bddo:floatFormat applies to a floating-point Field or DataType (bddo:baseType bddo:baseFloat); bddo:fixedPointScale and bddo:bcd apply to an integer one (bddo:baseType bddo:baseInteger). Also, a BCD field is not scaled: bddo:bcd true and bddo:fixedPointScale are mutually exclusive, because the digits spell a decimal number, not a binary one."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references bddo:NumericRepresentationShape .
reqs:req-shape-bddo-OffsetBaseFieldShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:OffsetBaseFieldShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:OffsetBaseFieldShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-OffsetBaseFieldShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "bddo:offsetBase bddo:fieldStart and bddo:offsetBaseField are stated together, and the base field is an earlier member of the struct that contains the offset-addressed field, so that its start is known when the offset is resolved."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references bddo:OffsetBaseFieldShape .
reqs:req-shape-bddo-PaddingShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:PaddingShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:PaddingShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-PaddingShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "bddo:padByte states what the padding bddo:padTo introduces is expected to hold; without bddo:padTo there is no padding for it to describe."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references bddo:PaddingShape .
reqs:req-shape-bddo-ParameterShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:ParameterShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:ParameterShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-ParameterShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:Parameter; subjects using bddo:parameterType. A bddo:Parameter is not a bddo:Field: it consumes no bytes and is not a member of the parsed tree. Each focus node is not an instance of bddo:Field. bddo:parameterType is one of bddo:IntegerParameter, bddo:FloatParameter, bddo:StringParameter, bddo:BytesParameter and bddo:BooleanParameter."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references bddo:ParameterShape .
reqs:req-shape-bddo-ParameterisedStructShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:ParameterisedStructShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:ParameterisedStructShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-ParameterisedStructShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to subjects using bddo:hasParameter. bddo:hasParameter is declared on a bddo:Struct (or a subclass of it). Each focus node is an instance of bddo:Struct. bddo:hasParameter must point to a single rdf:List. Every member of a hasParameter list is a bddo:Parameter named by its IRI."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references bddo:ParameterisedStructShape .
reqs:req-shape-bddo-RangeDatatypeShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:RangeDatatypeShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:RangeDatatypeShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-RangeDatatypeShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to subjects using bddo:alignment, bddo:atOffset, bddo:atOffsetFromExpression, bddo:bcd, bddo:bitLength, bddo:bitWidth, bddo:commentPrefix, bddo:condition, bddo:coversExpression, bddo:coversFromExpression, bddo:coversToExpression, bddo:crcCheck, bddo:crcInit, bddo:crcPolynomial, bddo:crcReflectIn, bddo:crcReflectOut, bddo:crcWidth, bddo:crcXorOut, bddo:dispatchOnExpression, bddo:enumIsFlags, bddo:escapeChar, bddo:fieldDelimiter, bddo:fixedPointScale, bddo:groupCloseToken, bddo:groupOpenToken, bddo:ianaCharset, bddo:isPresentIf, bddo:isSigned, bddo:key, bddo:keyIsCaseInsensitive, bddo:keyPath, bddo:keyValueSeparator, bddo:localExpression, bddo:namespaceIRI, bddo:namespacePrefix, bddo:nodePath, bddo:numericBase, bddo:padByte, bddo:padTo, bddo:pathSeparator, bddo:quoteChar, bddo:recordDelimiter, bddo:repeatCount, bddo:repeatCountFromExpression, bddo:repeatUntil, bddo:separatedBy, bddo:size, bddo:sizeFromExpression, bddo:sizeToEndOfStream, bddo:skipRecords, bddo:syncOnMarker, bddo:terminator, bddo:trimNull, bddo:trimWhitespace, bddo:validIf, bddo:valueFromExpression, bddo:whitespaceSeparated. bddo:alignment takes a positive integer (rdfs:range xsd:positiveInteger). bddo:atOffset takes a non-negative integer (rdfs:range xsd:nonNegativeInteger). bddo:atOffsetFromExpression takes a HEL expression, an xsd:string or bddo:HelExpression literal (rdfs:range xsd:string). bddo:bcd takes an xsd:boolean literal (rdfs:range xsd:boolean). bddo:bitLength takes a positive integer (rdfs:range xsd:positiveInteger). bddo:bitWidth takes a positive integer (rdfs:range xsd:positiveInteger). bddo:commentPrefix takes an xsd:string literal (rdfs:range xsd:string). bddo:condition takes a HEL expression, an xsd:string or bddo:HelExpression literal (rdfs:range xsd:string). bddo:coversExpression takes a HEL expression, an xsd:string or bddo:HelExpression literal (rdfs:range xsd:string). bddo:coversFromExpression takes a HEL expression, an xsd:string or bddo:HelExpression literal (rdfs:range xsd:string). bddo:coversToExpression takes a HEL expression, an xsd:string or bddo:HelExpression literal (rdfs:range xsd:string). bddo:crcCheck takes a non-negative integer (rdfs:range xsd:nonNegativeInteger). bddo:crcInit takes a non-negative integer (rdfs:range xsd:nonNegativeInteger). bddo:crcPolynomial takes a non-negative integer (rdfs:range xsd:nonNegativeInteger). bddo:crcReflectIn takes an xsd:boolean literal (rdfs:range xsd:boolean). bddo:crcReflectOut takes an xsd:boolean literal (rdfs:range xsd:boolean). bddo:crcWidth takes a positive integer (rdfs:range xsd:positiveInteger). bddo:crcXorOut takes a non-negative integer (rdfs:range xsd:nonNegativeInteger). bddo:dispatchOnExpression takes a HEL expression, an xsd:string or bddo:HelExpression literal (rdfs:range xsd:string). bddo:enumIsFlags takes an xsd:boolean literal (rdfs:range xsd:boolean). bddo:escapeChar takes an xsd:hexBinary literal (rdfs:range xsd:hexBinary). bddo:fieldDelimiter takes an xsd:hexBinary literal (rdfs:range xsd:hexBinary). bddo:fixedPointScale takes an integer (rdfs:range xsd:integer). bddo:groupCloseToken takes an xsd:string literal (rdfs:range xsd:string). bddo:groupOpenToken takes an xsd:string literal (rdfs:range xsd:string). bddo:ianaCharset takes an xsd:string literal (rdfs:range xsd:string). bddo:isPresentIf takes a HEL expression, an xsd:string or bddo:HelExpression literal (rdfs:range xsd:string). bddo:isSigned takes an xsd:boolean literal (rdfs:range xsd:boolean). bddo:key takes an xsd:string literal (rdfs:range xsd:string). bddo:keyIsCaseInsensitive takes an xsd:boolean literal (rdfs:range xsd:boolean). bddo:keyPath takes an xsd:string literal (rdfs:range xsd:string). bddo:keyValueSeparator takes an xsd:hexBinary literal (rdfs:range xsd:hexBinary). bddo:localExpression takes a HEL expression, an xsd:string or bddo:HelExpression literal (rdfs:range xsd:string). bddo:namespaceIRI takes an xsd:anyURI literal (rdfs:range xsd:anyURI). bddo:namespacePrefix takes an xsd:string literal (rdfs:range xsd:string). bddo:nodePath takes an xsd:string literal (rdfs:range xsd:string). bddo:numericBase takes a positive integer (rdfs:range xsd:positiveInteger). bddo:padByte takes an xsd:hexBinary literal (rdfs:range xsd:hexBinary). bddo:padTo takes a positive integer (rdfs:range xsd:positiveInteger). bddo:pathSeparator takes an xsd:string literal (rdfs:range xsd:string). bddo:quoteChar takes an xsd:hexBinary literal (rdfs:range xsd:hexBinary). bddo:recordDelimiter takes an xsd:hexBinary literal (rdfs:range xsd:hexBinary). bddo:repeatCount takes a non-negative integer (rdfs:range xsd:nonNegativeInteger). bddo:repeatCountFromExpression takes a HEL expression, an xsd:string or bddo:HelExpression literal (rdfs:range xsd:string). bddo:repeatUntil takes a HEL expression, an xsd:string or bddo:HelExpression literal (rdfs:range xsd:string). bddo:separatedBy takes an xsd:string literal (rdfs:range xsd:string). bddo:size takes a positive integer (rdfs:range xsd:positiveInteger). bddo:sizeFromExpression takes a HEL expression, an xsd:string or bddo:HelExpression literal (rdfs:range xsd:string). bddo:sizeToEndOfStream takes an xsd:boolean literal (rdfs:range xsd:boolean). bddo:skipRecords takes a non-negative integer (rdfs:range xsd:nonNegativeInteger). bddo:syncOnMarker takes an xsd:hexBinary literal (rdfs:range xsd:hexBinary). bddo:terminator takes an xsd:hexBinary literal (rdfs:range xsd:hexBinary). bddo:trimNull takes an xsd:boolean literal (rdfs:range xsd:boolean). bddo:trimWhitespace takes an xsd:boolean literal (rdfs:range xsd:boolean). bddo:validIf takes a HEL expression, an xsd:string or bddo:HelExpression literal (rdfs:range xsd:string). bddo:valueFromExpression takes a HEL expression, an xsd:string or bddo:HelExpression literal (rdfs:range xsd:string). bddo:whitespaceSeparated takes an xsd:boolean literal (rdfs:range xsd:boolean)."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references bddo:RangeDatatypeShape .
reqs:req-shape-bddo-RecordGroupingShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:RecordGroupingShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:RecordGroupingShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-RecordGroupingShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:RecordGrouping. bddo:groupCloseToken takes exactly one value, an xsd:string literal. bddo:groupOpenToken takes exactly one value, an xsd:string literal. A bddo:RecordGrouping must name exactly one style: keyedGroup, valuedGroup or sectionHeaded."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references bddo:RecordGroupingShape .
reqs:req-shape-bddo-SeekScopeShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:SeekScopeShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:SeekScopeShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-SeekScopeShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:Field. bddo:seekScope is only meaningful on an offset-addressed Field (atOffset / atOffsetFromField / atOffsetFromExpression)."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references bddo:SeekScopeShape .
reqs:req-shape-bddo-SeparatedFieldExtentShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:SeparatedFieldExtentShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:SeparatedFieldExtentShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-SeparatedFieldExtentShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "A field whose extent is its separator (bddo:separatedBy) states no other extent: no bddo:size, bddo:sizeFromField, bddo:sizeFromExpression, bddo:sizeToEndOfStream or bddo:terminator."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references bddo:SeparatedFieldExtentShape .
reqs:req-shape-bddo-StructShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:StructShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:StructShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-StructShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:Struct. bddo:alignment takes at most one value; each is a number greater than 0. bddo:bitOrder takes at most one value; each is either bddo:MSBFirst or bddo:LSBFirst. bddo:endianness takes at most one value; each is either bddo:BigEndian or bddo:LittleEndian. bddo:hasField must point to a single rdf:List. bddo:padByte takes at most one value; each is one xsd:hexBinary octet (two hex digits). bddo:padTo takes at most one value; each is a number greater than 0. bddo:size takes at most one value; each is a number greater than 0. bddo:sizeFromExpression takes at most one value; each is a HEL expression (an xsd:string or bddo:HelExpression literal). bddo:sizeFromField takes at most one value; each is an instance of bddo:Field. bddo:syncOnMarker takes at most one value; each is an xsd:hexBinary literal. Every member of a Struct's hasField list must be a bddo:Field or a bddo:LocalBinding."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references bddo:StructShape .
reqs:req-shape-bddo-StructSizingShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:StructSizingShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:StructSizingShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-StructSizingShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:Struct. A bddo:Struct must use at most one sizing mechanism (size / sizeFromField / sizeFromExpression)."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references bddo:StructSizingShape .
reqs:req-shape-bddo-TreeDocumentShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:TreeDocumentShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:TreeDocumentShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-TreeDocumentShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:TreeDocument. A bddo:TreeDocument must declare at least one field. Each value of bddo:hasNamespaceBinding is an instance of bddo:NamespaceBinding. A bddo:TreeDocument must declare exactly one bddo:treeSyntax: bddo:xml or bddo:json. Every field of a bddo:TreeDocument is located by exactly one bddo:nodePath, and not by a key, a key path or a byte offset. bddo:hasNamespaceBinding applies to an XML tree document; JSON Pointer has no namespace prefixes."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references bddo:TreeDocumentShape .
reqs:req-shape-bddo-TreePrefixBindingShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:TreePrefixBindingShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:TreePrefixBindingShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-TreePrefixBindingShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "An XML tree document binds each namespace prefix at most once, and every prefix its fields' bddo:nodePath values use is bound by one of its bddo:hasNamespaceBinding entries; only xml is predeclared."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references bddo:TreePrefixBindingShape .
reqs:req-shape-bddo-TypeSelectionExclusivityShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:TypeSelectionExclusivityShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:TypeSelectionExclusivityShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-TypeSelectionExclusivityShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:Field. A bddo:Field must not declare both hasDispatchTable and hasConditionalDataType."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references bddo:TypeSelectionExclusivityShape .
reqs:req-shape-bddo-VariableLengthFieldShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:VariableLengthFieldShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:VariableLengthFieldShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-VariableLengthFieldShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:Field. A bddo:bytes or bddo:string field must declare a sizing or termination mechanism."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references bddo:VariableLengthFieldShape .
reqs:req-shape-bddo-VarintWidthShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of bddo:VarintWidthShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement bddo:VarintWidthShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-bddo-VarintWidthShape" ;
    req:fromStandard "Binary Data Description Ontology (BDDO)" ;
    req:statement "Applies to instances of bddo:Field. A variable-length integer field (bddo:varuint, bddo:varint, bddo:sqliteVarint) must not declare a width or terminator: its length is discovered from the bytes."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references bddo:VarintWidthShape .
reqs:req-shape-conf-ConstraintShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of conf:ConstraintShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement conf:ConstraintShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-conf-ConstraintShape" ;
    req:fromStandard "Hexplain Conformance Shapes" ;
    req:statement "Applies to instances of conf:Constraint; subjects using conf:assertion, conf:message, conf:scope; objects of conf:findingConstraint. A Constraint needs exactly one non-empty conf:assertion HEL expression. A Constraint needs exactly one non-empty conf:message finding template. A Constraint must cite at least one req:Requirement; an unattributed rule cannot be reported. A Constraint needs exactly one conf:scope IRI naming the bddo:Struct or bddo:Field it applies to. A Constraint states at most one conf:severity: sh:Violation, sh:Warning or sh:Info (absent means sh:Violation)."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references conf:ConstraintShape .
reqs:req-shape-conf-DisjointKindsShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of conf:DisjointKindsShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement conf:DisjointKindsShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-conf-DisjointKindsShape" ;
    req:fromStandard "Hexplain Conformance Shapes" ;
    req:statement "conf:Finding, conf:Run, conf:Constraint, conf:ParseAttribution and req:Requirement are pairwise disjoint: a node is an instance of exactly one of them."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references conf:DisjointKindsShape .
reqs:req-shape-conf-ErrorCategoryUseShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of conf:ErrorCategoryUseShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement conf:ErrorCategoryUseShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-conf-ErrorCategoryUseShape" ;
    req:fromStandard "Hexplain Conformance Shapes" ;
    req:statement "conf:errorCategory is stated only on a conf:ParseAttribution or a conf:Parse finding: never on a constraint, a run, a requirement or a constraint finding."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references conf:ErrorCategoryUseShape .
reqs:req-shape-conf-FindingAttributionShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of conf:FindingAttributionShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement conf:FindingAttributionShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-conf-FindingAttributionShape" ;
    req:fromStandard "Hexplain Conformance Shapes" ;
    req:statement "A constraint finding is attributed only to requirements its constraint cites: its conf:findingRequirement values are a subset of the constraint's conf:satisfies values."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references conf:FindingAttributionShape .
reqs:req-shape-conf-FindingSeverityShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of conf:FindingSeverityShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement conf:FindingSeverityShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-conf-FindingSeverityShape" ;
    req:fromStandard "Hexplain Conformance Shapes" ;
    req:statement "A conf:Violation finding reports at its constraint's conf:severity (sh:Violation when the constraint states none); a conf:RuleError or conf:Parse finding always reports at sh:Violation. An absent finding severity reads as sh:Violation."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references conf:FindingSeverityShape .
reqs:req-shape-conf-FindingShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of conf:FindingShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement conf:FindingShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-conf-FindingShape" ;
    req:fromStandard "Hexplain Conformance Shapes" ;
    req:statement "A conformance finding: its kind, the requirements it is attributed to, the rendered text, and at most one constraint, focus node, byte range and run. A constraint finding (conf:Violation, conf:RuleError) names exactly one constraint and cites at least one requirement, every one of which that constraint cites, and states no error category; a conf:Parse finding names no constraint, states its error category, and may cite no requirement."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references conf:FindingShape .
reqs:req-shape-conf-OutcomeShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of conf:OutcomeShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement conf:OutcomeShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-conf-OutcomeShape" ;
    req:fromStandard "Hexplain Conformance Shapes" ;
    req:statement "An outcome node names exactly one requirement and exactly one of the five evaluation outcomes."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references conf:OutcomeShape .
reqs:req-shape-conf-ParseAttributionShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of conf:ParseAttributionShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement conf:ParseAttributionShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-conf-ParseAttributionShape" ;
    req:fromStandard "Hexplain Conformance Shapes" ;
    req:statement "A parse attribution, and a conf:Parse finding, names exactly one Processing Model error category: a conf:ErrorCategory individual, or (deprecated) its skos:notation string. ResourceLimit is not a category: a resource limit is never a finding, and a parse attribution naming it is a description error."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references conf:ParseAttributionShape .
reqs:req-shape-conf-ParseAttributionTargetShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of conf:ParseAttributionTargetShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement conf:ParseAttributionTargetShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-conf-ParseAttributionTargetShape" ;
    req:fromStandard "Hexplain Conformance Shapes" ;
    req:statement "A parse attribution cites exactly one requirement, and no other attribution of the graph governs the same category; a category IRI and its notation string are the same category."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references conf:ParseAttributionTargetShape .
reqs:req-shape-conf-ParseFindingAttributionShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of conf:ParseFindingAttributionShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement conf:ParseFindingAttributionShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-conf-ParseFindingAttributionShape" ;
    req:fromStandard "Hexplain Conformance Shapes" ;
    req:statement "A conf:Parse finding cites exactly the requirement of the conf:ParseAttribution for its error category, or no requirement when no attribution names that category."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references conf:ParseFindingAttributionShape .
reqs:req-shape-conf-RangeDatatypeShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of conf:RangeDatatypeShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement conf:RangeDatatypeShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-conf-RangeDatatypeShape" ;
    req:fromStandard "Hexplain Conformance Shapes" ;
    req:statement "Applies to subjects using conf:assertion, conf:fileVersion, conf:findingMessage, conf:message, conf:truncated, conf:truncationReason, conf:versionScopingApplied. conf:assertion takes a HEL expression, an xsd:string or bddo:HelExpression literal (rdfs:range xsd:string). conf:fileVersion takes an xsd:string literal (rdfs:range xsd:string). conf:findingMessage takes an xsd:string literal (rdfs:range xsd:string). conf:message takes an xsd:string literal (rdfs:range xsd:string). conf:truncated takes an xsd:boolean literal (rdfs:range xsd:boolean). conf:truncationReason takes an xsd:string literal (rdfs:range xsd:string). conf:versionScopingApplied takes an xsd:boolean literal (rdfs:range xsd:boolean)."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references conf:RangeDatatypeShape .
reqs:req-shape-conf-RunShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of conf:RunShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement conf:RunShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-conf-RunShape" ;
    req:fromStandard "Hexplain Conformance Shapes" ;
    req:statement "A run report states exactly one verdict and one truncated flag, links its findings with conf:finding, reports at most one outcome per requirement and one for every requirement in the graph, and is internally consistent: a truncated run is non-conformant, the verdict follows from the findings, outcomes and conf:failOn, and conf:NotApplicable arises only from version scoping."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references conf:RunShape .
reqs:req-shape-conf-UntypedParseAttributionShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of conf:UntypedParseAttributionShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement conf:UntypedParseAttributionShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-conf-UntypedParseAttributionShape" ;
    req:fromStandard "Hexplain Conformance Shapes" ;
    req:statement "A node stating conf:errorCategory that is neither a finding, a run, a constraint, a requirement nor a typed conf:ParseAttribution is an untyped parse attribution: it cites exactly one requirement, and its category is attributed once."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references conf:UntypedParseAttributionShape .
reqs:req-shape-dfv-DocumentShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of dfv:DocumentShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement dfv:DocumentShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-dfv-DocumentShape" ;
    req:fromStandard "Hexplain Document & Font Vocabulary (DFV)" ;
    req:statement "Applies to instances of dfv:Document; subjects using dfv:pageCount. dcterms:created takes at most one value; each is an xsd:dateTime literal. dcterms:creator of a document is a string name or an agent IRI or blank node. dcterms:modified takes at most one value; each is an xsd:dateTime literal. dcterms:title takes at most one value; each is an xsd:string literal. dfv:pageCount takes at most one value; each is a number greater than 0."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references dfv:DocumentShape .
reqs:req-shape-dfv-FontShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of dfv:FontShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement dfv:FontShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-dfv-FontShape" ;
    req:fromStandard "Hexplain Document & Font Vocabulary (DFV)" ;
    req:statement "Applies to instances of dfv:Font; subjects using dfv:fontFamily, dfv:fontStyle, dfv:glyphCount. dfv:fontFamily takes at most one value; each is an xsd:string literal. dfv:fontStyle takes at most one value; each is an xsd:string literal. dfv:glyphCount takes at most one value; each is a number greater than 0."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references dfv:FontShape .
reqs:req-shape-dfv-IntegerValueShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of dfv:IntegerValueShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement dfv:IntegerValueShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-dfv-IntegerValueShape" ;
    req:fromStandard "Hexplain Document & Font Vocabulary (DFV)" ;
    req:statement "Applied through references from other shapes. An integer value is a literal of an XSD integer-family datatype (xsd:integer, xsd:positiveInteger, xsd:nonNegativeInteger, xsd:int, xsd:long, xsd:unsignedInt, xsd:unsignedLong, xsd:short, xsd:unsignedShort, xsd:byte or xsd:unsignedByte). A conforming value is an integer (of any XSD integer datatype)."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references dfv:IntegerValueShape .
reqs:req-shape-dfv-PageShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of dfv:PageShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement dfv:PageShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-dfv-PageShape" ;
    req:fromStandard "Hexplain Document & Font Vocabulary (DFV)" ;
    req:statement "Applies to subjects using dfv:hasBoundingBox. Each value of dfv:hasBoundingBox is an instance of dfv:BoundingBox."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references dfv:PageShape .
reqs:req-shape-dfv-RangeDatatypeShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of dfv:RangeDatatypeShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement dfv:RangeDatatypeShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-dfv-RangeDatatypeShape" ;
    req:fromStandard "Hexplain Document & Font Vocabulary (DFV)" ;
    req:statement "Applies to subjects using dfv:boxType, dfv:characterEncoding, dfv:creatorTool, dfv:glyphCount, dfv:pageCount, dfv:producerTool, dfv:unicodeCodePoint. dfv:boxType takes an xsd:string literal (rdfs:range xsd:string). dfv:characterEncoding takes an xsd:string literal (rdfs:range xsd:string). dfv:creatorTool takes an xsd:string literal (rdfs:range xsd:string). dfv:glyphCount takes a positive integer (rdfs:range xsd:positiveInteger). dfv:pageCount takes a positive integer (rdfs:range xsd:positiveInteger). dfv:producerTool takes an xsd:string literal (rdfs:range xsd:string). dfv:unicodeCodePoint takes an xsd:hexBinary literal (rdfs:range xsd:hexBinary)."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references dfv:RangeDatatypeShape .
reqs:req-shape-dlv-CellDataTypeRuleShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of dlv:CellDataTypeRuleShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement dlv:CellDataTypeRuleShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-dlv-CellDataTypeRuleShape" ;
    req:fromStandard "Hexplain Data Layout Vocabulary (DLV)" ;
    req:statement "Applies to instances of dlv:CellDataTypeRule. bddo:condition takes exactly one value, a HEL expression (an xsd:string or bddo:HelExpression literal). dlv:ruleCellDataType takes exactly one value, an instance of bddo:DataType."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references dlv:CellDataTypeRuleShape .
reqs:req-shape-dlv-CellTypeChoiceShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of dlv:CellTypeChoiceShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement dlv:CellTypeChoiceShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-dlv-CellTypeChoiceShape" ;
    req:fromStandard "Hexplain Data Layout Vocabulary (DLV)" ;
    req:statement "Applies to instances of dlv:DataLayout. A dlv:DataLayout fixes its cell type (dlv:cellDataType) or chooses it (dlv:hasConditionalCellDataType): exactly one of the two. Each focus node is a node that states exactly one of: dlv:cellDataType and no dlv:hasConditionalCellDataType; dlv:hasConditionalCellDataType and no dlv:cellDataType."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references dlv:CellTypeChoiceShape .
reqs:req-shape-dlv-ChunkedLayoutShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of dlv:ChunkedLayoutShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement dlv:ChunkedLayoutShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-dlv-ChunkedLayoutShape" ;
    req:fromStandard "Hexplain Data Layout Vocabulary (DLV)" ;
    req:statement "Applies to instances of dlv:DataLayout. dlv:chunkLengthsFromField takes at most one value; each is an instance of bddo:Field. dlv:chunkOffsetBase takes at most one value; each is one of bddo:streamStart, bddo:streamEnd, bddo:parentStart or bddo:currentPosition. dlv:chunkOffsetsFromField takes at most one value; each is an instance of bddo:Field. dlv:chunkOrder takes at most one value; each is an instance of dlv:ChunkOrder. A chunked dlv:DataLayout (any Dimension declaring dlv:chunkSize, dlv:chunkSizeFromField or dlv:chunkSizeFromExpression) must declare dlv:chunkOffsetsFromField."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references dlv:ChunkedLayoutShape .
reqs:req-shape-dlv-DataLayoutShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of dlv:DataLayoutShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement dlv:DataLayoutShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-dlv-DataLayoutShape" ;
    req:fromStandard "Hexplain Data Layout Vocabulary (DLV)" ;
    req:statement "Applies to instances of dlv:DataLayout. dlv:cellBitWidth takes at most one value; each is an integer (of any XSD integer datatype) greater than 0. dlv:cellBitWidthFromExpression takes at most one value; each is a HEL expression (an xsd:string or bddo:HelExpression literal). dlv:cellBitWidthFromField takes at most one value; each is an instance of bddo:Field. dlv:cellDataType takes at most one value; each is an instance of bddo:DataType. dlv:cellPackingOrder takes at most one value; each is either bddo:MSBFirst or bddo:LSBFirst. dlv:hasConditionalCellDataType takes at most one value; each is a resource (an IRI or a blank node). dlv:hasConditionalDimensionOrder takes at most one value; each is a resource (an IRI or a blank node). dlv:hasDimension takes at most one value; each is a resource (an IRI or a blank node). Every member of a hasConditionalCellDataType list must be a dlv:CellDataTypeRule. Every member of a hasConditionalDimensionOrder list must be a dlv:DimensionOrderRule. Each member of the dlv:hasDimension list is an instance of dlv:Dimension. A dlv:DataLayout must use at most one packed-width mechanism (cellBitWidth / cellBitWidthFromField / cellBitWidthFromExpression). dlv:cellPackingOrder is only meaningful with dlv:cellBitWidth, dlv:cellBitWidthFromField or dlv:cellBitWidthFromExpression."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references dlv:DataLayoutShape .
reqs:req-shape-dlv-DimensionChunkExtentShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of dlv:DimensionChunkExtentShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
