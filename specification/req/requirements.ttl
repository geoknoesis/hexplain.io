# Hexplain Specification Requirements 1.0 -- the requirements the family's own node shapes enforce
# Generated by tools/_build_shape_requirements.py --write; do not edit. One reqs:ShapeRequirement
# per named node shape of every family module, derived from the shape: its statement is the
# shape's documented definition, its identifier req-shape-<prefix>-<ShapeLocalName>, its source
# the module's label without a version. tools/test_shape_requirements.py keeps the two in step.
@prefix abnd: <https://hexplain.io/ns/aspect/bundle#> .
@prefix adv: <https://hexplain.io/ns/audio#> .
@prefix aenc: <https://hexplain.io/ns/aspect/encoding#> .
@prefix afs: <https://hexplain.io/ns/aspect/fsmeta#> .
@prefix ageom: <https://hexplain.io/ns/aspect/geometry#> .
@prefix aintg: <https://hexplain.io/ns/aspect/integrity#> .
@prefix anet: <https://hexplain.io/ns/aspect/networkflow#> .
@prefix apc: <https://hexplain.io/ns/aspect/pointcloud#> .
@prefix apkg: <https://hexplain.io/ns/aspect/packaging#> .
@prefix aprot: <https://hexplain.io/ns/aspect/protection#> .
@prefix aprov: <https://hexplain.io/ns/aspect/provenance#> .
@prefix araster: <https://hexplain.io/ns/aspect/raster#> .
@prefix asamp: <https://hexplain.io/ns/aspect/sampling#> .
@prefix asec: <https://hexplain.io/ns/aspect/security#> .
@prefix asig: <https://hexplain.io/ns/aspect/signal#> .
@prefix asref: <https://hexplain.io/ns/aspect/spatialref#> .
@prefix atab: <https://hexplain.io/ns/aspect/tabular#> .
@prefix atime: <https://hexplain.io/ns/aspect/time#> .
@prefix axv: <https://hexplain.io/ns/archive#> .
@prefix bddo: <https://hexplain.io/ns/bddo#> .
@prefix conf: <https://hexplain.io/ns/conf#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dfv: <https://hexplain.io/ns/docfont#> .
@prefix dlv: <https://hexplain.io/ns/dlv#> .
@prefix gv: <https://hexplain.io/ns/geo#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix hxf: <https://hexplain.io/ns/fn#> .
@prefix img: <https://hexplain.io/ns/image#> .
@prefix npv: <https://hexplain.io/ns/net#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix req: <https://hexplain.io/ns/req#> .
@prefix reqs: <https://hexplain.io/ns/req/requirements#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix vdv: <https://hexplain.io/ns/video#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://hexplain.io/ns/req/requirements> a owl:Ontology ;
    rdfs:seeAlso <https://hexplain.io/specification/req/requirements-doc.ttl> ;
    owl:versionIRI <https://hexplain.io/ns/req/requirements/1.0> ; owl:versionInfo "1.0" ;
    dcterms:modified "2026-10-13"^^xsd:date ; dcterms:created "2026-10-12"^^xsd:date ;
    dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    # req supplies the requirement vocabulary; every module that publishes a node shape is
    # imported because a requirement names its shape. The link runs from the requirement to
    # the shape because the layering runs the other way: bddo cannot import a module above it.
    owl:imports <https://hexplain.io/ns/archive> ,
        <https://hexplain.io/ns/aspect/bundle> ,
        <https://hexplain.io/ns/aspect/encoding> ,
        <https://hexplain.io/ns/aspect/fsmeta> ,
        <https://hexplain.io/ns/aspect/geometry> ,
        <https://hexplain.io/ns/aspect/integrity> ,
        <https://hexplain.io/ns/aspect/networkflow> ,
        <https://hexplain.io/ns/aspect/packaging> ,
        <https://hexplain.io/ns/aspect/pointcloud> ,
        <https://hexplain.io/ns/aspect/protection> ,
        <https://hexplain.io/ns/aspect/provenance> ,
        <https://hexplain.io/ns/aspect/raster> ,
        <https://hexplain.io/ns/aspect/sampling> ,
        <https://hexplain.io/ns/aspect/security> ,
        <https://hexplain.io/ns/aspect/signal> ,
        <https://hexplain.io/ns/aspect/spatialref> ,
        <https://hexplain.io/ns/aspect/tabular> ,
        <https://hexplain.io/ns/aspect/time> ,
        <https://hexplain.io/ns/audio> ,
        <https://hexplain.io/ns/bddo> ,
        <https://hexplain.io/ns/conf/shapes> ,
        <https://hexplain.io/ns/core> ,
        <https://hexplain.io/ns/dlv> ,
        <https://hexplain.io/ns/docfont> ,
        <https://hexplain.io/ns/fn> ,
        <https://hexplain.io/ns/geo> ,
        <https://hexplain.io/ns/image> ,
        <https://hexplain.io/ns/net> ,
        <https://hexplain.io/ns/req> ,
        <https://hexplain.io/ns/req/shapes> ,
        <https://hexplain.io/ns/video> ;
    vann:preferredNamespacePrefix "reqs" ; vann:preferredNamespaceUri "https://hexplain.io/ns/req/requirements#" ;
    rdfs:label "Hexplain Specification Requirements"@en ;
    rdfs:comment "The normative requirements that the specification's own SHACL node shapes enforce on a description, each a req:Requirement citing its shape with dcterms:references: one for every named node shape of every module of the family. The source document of a requirement is the vocabulary module that publishes the shape, named without its version; its identifier is req-shape-<prefix>-<ShapeLocalName>. The pair therefore survives a new version of the module and never changes meaning (tools/_requirement_ids.py states the same rule for prose requirements). A conformance profile may cite these requirements with conf:satisfies exactly as it cites a format standard's."@en ;
    skos:scopeNote "Load with a conformance profile that attributes a description-level finding to the shape requirement it breaks, or to read which requirement a shape stands for. It mints no shapes and no new constraints: every statement restates a shape's documented definition, and the file is regenerated when a shape changes."@en .

# A requirement of the specification itself, as opposed to one a conformance profile declares
# for a format standard. A subclass, and the individuals are typed with it alone: conf:RunShape
# demands an outcome for every resource typed req:Requirement in the graph it validates (a run
# report with its rule set), and the family's own requirements are not part of any rule set.
# Under RDFS entailment each is a req:Requirement; req:RequirementShape still validates each
# through its activation by req:requirementId and the other requirement properties.
reqs:ShapeRequirement a owl:Class ; rdfs:subClassOf req:Requirement ; rdfs:label "Shape Requirement"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "A req:Requirement that one of the specification's own SHACL node shapes enforces on a description, named by dcterms:references. Its req:fromStandard is the label of the vocabulary module publishing the shape, without a version, and its req:requirementId is req-shape-<prefix>-<ShapeLocalName>. Its req:discrepancyType is derived from the shape: req:Syntactic when every constraint checks one property's values on their own (datatype, node kind, class, enumeration, pattern, bounds, cardinality), req:Semantic when a constraint relates properties or nodes to one another (a logical combination of property constraints, a property pair, a qualified count or a SPARQL constraint), so that each value may be well formed while the description as a whole is not."@en ;
    skos:scopeNote "Assert on the family's own requirements only; a conformance profile's requirements for a format standard are plain req:Requirement resources. A conf:Constraint may cite a shape requirement with conf:satisfies like any other."@en .

reqs:req-shape-abnd-AssetShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of abnd:AssetShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement abnd:AssetShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-abnd-AssetShape" ;
    req:fromStandard "Hexplain Aspect — Bundle (hx-bundle)" ;
    req:statement "Applies to instances of abnd:Asset; subjects using abnd:boundBy, abnd:primaryPart. abnd:boundBy must be one of the four BindingKind individuals. Each value of abnd:hasPart is an instance of abnd:Part. An Asset has at most one primaryPart."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references abnd:AssetShape .
reqs:req-shape-abnd-BundleProfileShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of abnd:BundleProfileShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement abnd:BundleProfileShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-abnd-BundleProfileShape" ;
    req:fromStandard "Hexplain Aspect — Bundle (hx-bundle)" ;
    req:statement "A bundle profile has at most one primary part spec, and no two of its part specs are described by structs sharing a local name."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references abnd:BundleProfileShape .
reqs:req-shape-abnd-IntegerValueShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of abnd:IntegerValueShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement abnd:IntegerValueShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-abnd-IntegerValueShape" ;
    req:fromStandard "Hexplain Aspect — Bundle (hx-bundle)" ;
    req:statement "Applied through references from other shapes. An integer value is a literal of an XSD integer-family datatype (xsd:integer, xsd:positiveInteger, xsd:nonNegativeInteger, xsd:int, xsd:long, xsd:unsignedInt, xsd:unsignedLong, xsd:short, xsd:unsignedShort, xsd:byte or xsd:unsignedByte). A conforming value is an integer (of any XSD integer datatype)."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references abnd:IntegerValueShape .
reqs:req-shape-abnd-LiftByCarriedAspectRule a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of abnd:LiftByCarriedAspectRule"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement abnd:LiftByCarriedAspectRule enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-abnd-LiftByCarriedAspectRule" ;
    req:fromStandard "Hexplain Aspect — Bundle (hx-bundle)" ;
    req:statement "A SHACL rule-bearing shape that derives additional triples for its selected focus nodes. Its rule is an inference operation, not a validation constraint; see the executable rule and activation scope below."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references abnd:LiftByCarriedAspectRule .
reqs:req-shape-abnd-PartShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of abnd:PartShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement abnd:PartShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-abnd-PartShape" ;
    req:fromStandard "Hexplain Aspect — Bundle (hx-bundle)" ;
    req:statement "Applies to instances of abnd:Part; objects of abnd:primaryPart. abnd:partRole must be a skos:Concept."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references abnd:PartShape .
reqs:req-shape-abnd-PartSpecShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of abnd:PartSpecShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement abnd:PartSpecShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-abnd-PartSpecShape" ;
    req:fromStandard "Hexplain Aspect — Bundle (hx-bundle)" ;
    req:statement "Applies to instances of abnd:PartSpec; objects of abnd:partSpec. A part spec is located exactly one way, by abnd:extension or by abnd:pathPattern: with neither it matches no file, and it never states both. Each focus node is a node that states exactly one of: abnd:extension; abnd:pathPattern. An abnd:extension is a dot followed by one or more non-empty, dot-separated steps (\".dbf\", \".tar.gz\") with no '/', '\\' or ':'; without the dot it would also match a longer suffix such as roads_dbf. abnd:liftsProperty names a property by IRI. abnd:maxParts takes at most one value; each is an integer (of any XSD integer datatype) at least 0. abnd:minParts takes at most one value; each is an integer (of any XSD integer datatype) at least 0. abnd:maxParts must not be less than abnd:minParts. abnd:nestedProfile takes at most one value; each is an instance of abnd:BundleProfile. abnd:partRole names a skos:Concept of the bound part-role register. Each value of abnd:pathPattern is an xsd:string literal. An abnd:pathPattern is a relative path inside the asset root: '/'-separated, non-empty segments, none '.' or '..', with no backslash, no drive letter or other ':', and no leading '/'. A required part spec must not declare abnd:minParts 0 or abnd:maxParts 0 -- the two contradict."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references abnd:PartSpecShape .
reqs:req-shape-abnd-RangeDatatypeShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of abnd:RangeDatatypeShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement abnd:RangeDatatypeShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-abnd-RangeDatatypeShape" ;
    req:fromStandard "Hexplain Aspect — Bundle (hx-bundle)" ;
    req:statement "Applies to subjects using abnd:extension, abnd:maxParts, abnd:minParts, abnd:partIndex, abnd:pathPattern, abnd:primary, abnd:required, abnd:stem. abnd:extension takes an xsd:string literal (rdfs:range xsd:string). abnd:maxParts takes a non-negative integer (rdfs:range xsd:nonNegativeInteger). abnd:minParts takes a non-negative integer (rdfs:range xsd:nonNegativeInteger). abnd:partIndex takes a non-negative integer (rdfs:range xsd:nonNegativeInteger). abnd:pathPattern takes an xsd:string literal (rdfs:range xsd:string). abnd:primary takes an xsd:boolean literal (rdfs:range xsd:boolean). abnd:required takes an xsd:boolean literal (rdfs:range xsd:boolean). abnd:stem takes an xsd:string literal (rdfs:range xsd:string)."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references abnd:RangeDatatypeShape .
reqs:req-shape-abnd-RequiredPartsShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of abnd:RequiredPartsShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement abnd:RequiredPartsShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-abnd-RequiredPartsShape" ;
    req:fromStandard "Hexplain Aspect — Bundle (hx-bundle)" ;
    req:statement "Applies to instances of abnd:Asset. A required part role declared by the conformed profile is missing."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references abnd:RequiredPartsShape .
reqs:req-shape-adv-IntegerValueShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of adv:IntegerValueShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement adv:IntegerValueShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-adv-IntegerValueShape" ;
    req:fromStandard "Hexplain Audio Vocabulary (ADV)" ;
    req:statement "Applied through references from other shapes. An integer value is a literal of an XSD integer-family datatype (xsd:integer, xsd:positiveInteger, xsd:nonNegativeInteger, xsd:int, xsd:long, xsd:unsignedInt, xsd:unsignedLong, xsd:short, xsd:unsignedShort, xsd:byte or xsd:unsignedByte). A conforming value is an integer (of any XSD integer datatype)."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references adv:IntegerValueShape .
reqs:req-shape-adv-RangeDatatypeShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of adv:RangeDatatypeShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement adv:RangeDatatypeShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-adv-RangeDatatypeShape" ;
    req:fromStandard "Hexplain Audio Vocabulary (ADV)" ;
    req:statement "Applies to subjects using adv:genre, adv:trackNumber. adv:genre takes an xsd:string literal (rdfs:range xsd:string). adv:trackNumber takes a positive integer (rdfs:range xsd:positiveInteger)."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references adv:RangeDatatypeShape .
reqs:req-shape-adv-StreamShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of adv:StreamShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement adv:StreamShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-adv-StreamShape" ;
    req:fromStandard "Hexplain Audio Vocabulary (ADV)" ;
    req:statement "Applies to instances of adv:AudioStream; subjects using asig:sampleRate. aenc:bitrate takes at most one value; each is a number greater than 0. aenc:codec takes at most one value; each is an IRI naming an instance of skos:Concept. asamp:bitDepth takes at most one value; each is a number greater than 0. asamp:componentCount takes at most one value; each is a number greater than 0. asig:sampleRate takes at most one value; each is a number greater than 0. atime:duration takes at most one value; each is a literal."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references adv:StreamShape .
reqs:req-shape-adv-TagShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of adv:TagShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement adv:TagShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-adv-TagShape" ;
    req:fromStandard "Hexplain Audio Vocabulary (ADV)" ;
    req:statement "Applies to instances of adv:MetadataTag; subjects using adv:album, adv:artist, adv:trackNumber, adv:trackTitle. adv:album takes at most one value; each is an xsd:string literal. adv:artist takes at most one value; each is an xsd:string literal. adv:trackNumber takes at most one value; each is a number greater than 0. adv:trackTitle takes at most one value; each is an xsd:string literal."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references adv:TagShape .
reqs:req-shape-aenc-IntegerValueShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of aenc:IntegerValueShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement aenc:IntegerValueShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-aenc-IntegerValueShape" ;
    req:fromStandard "Hexplain Aspect — Encoding (hx-encoding)" ;
    req:statement "Applied through references from other shapes. An integer value is a literal of an XSD integer-family datatype (xsd:integer, xsd:positiveInteger, xsd:nonNegativeInteger, xsd:int, xsd:long, xsd:unsignedInt, xsd:unsignedLong, xsd:short, xsd:unsignedShort, xsd:byte or xsd:unsignedByte). A conforming value is an integer (of any XSD integer datatype)."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references aenc:IntegerValueShape .
reqs:req-shape-aenc-RangeDatatypeShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of aenc:RangeDatatypeShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement aenc:RangeDatatypeShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-aenc-RangeDatatypeShape" ;
    req:fromStandard "Hexplain Aspect — Encoding (hx-encoding)" ;
    req:statement "Applies to subjects using aenc:bitrate. aenc:bitrate takes a positive integer (rdfs:range xsd:positiveInteger)."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references aenc:RangeDatatypeShape .
reqs:req-shape-afs-IntegerValueShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of afs:IntegerValueShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement afs:IntegerValueShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-afs-IntegerValueShape" ;
    req:fromStandard "Hexplain Aspect — Filesystem Metadata (hx-fsmeta)" ;
    req:statement "Applied through references from other shapes. An integer value is a literal of an XSD integer-family datatype (xsd:integer, xsd:positiveInteger, xsd:nonNegativeInteger, xsd:int, xsd:long, xsd:unsignedInt, xsd:unsignedLong, xsd:short, xsd:unsignedShort, xsd:byte or xsd:unsignedByte). A conforming value is an integer (of any XSD integer datatype)."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references afs:IntegerValueShape .
reqs:req-shape-afs-RangeDatatypeShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of afs:RangeDatatypeShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement afs:RangeDatatypeShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-afs-RangeDatatypeShape" ;
    req:fromStandard "Hexplain Aspect — Filesystem Metadata (hx-fsmeta)" ;
    req:statement "Applies to subjects using afs:creationTime, afs:fileName, afs:fileSize, afs:isDirectory, afs:modificationTime. afs:creationTime takes an xsd:dateTime literal (rdfs:range xsd:dateTime). afs:fileName takes an xsd:string literal (rdfs:range xsd:string). afs:fileSize takes an integer within the xsd:unsignedLong value space (rdfs:range xsd:unsignedLong). afs:isDirectory takes an xsd:boolean literal (rdfs:range xsd:boolean). afs:modificationTime takes an xsd:dateTime literal (rdfs:range xsd:dateTime)."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references afs:RangeDatatypeShape .
reqs:req-shape-ageom-IntegerValueShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of ageom:IntegerValueShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement ageom:IntegerValueShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-ageom-IntegerValueShape" ;
    req:fromStandard "Hexplain Aspect — Geometry (hx-geometry)" ;
    req:statement "Applied through references from other shapes. An integer value is a literal of an XSD integer-family datatype (xsd:integer, xsd:positiveInteger, xsd:nonNegativeInteger, xsd:int, xsd:long, xsd:unsignedInt, xsd:unsignedLong, xsd:short, xsd:unsignedShort, xsd:byte or xsd:unsignedByte). A conforming value is an integer (of any XSD integer datatype)."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references ageom:IntegerValueShape .
reqs:req-shape-ageom-OrdinateShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of ageom:OrdinateShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement ageom:OrdinateShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-ageom-OrdinateShape" ;
    req:fromStandard "Hexplain Aspect — Geometry (hx-geometry)" ;
    req:statement "Applies to subjects using ageom:dimensionality, ageom:geometryType, ageom:hasM, ageom:hasZ. ageom:dimensionality takes at most one value; each is an integer (of any XSD integer datatype) greater than 0. Each value of ageom:geometryType is an IRI naming an instance of skos:Concept. ageom:hasM takes at most one value; each is an xsd:boolean literal. ageom:hasZ takes at most one value; each is an xsd:boolean literal."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references ageom:OrdinateShape .
reqs:req-shape-ageom-RangeDatatypeShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of ageom:RangeDatatypeShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement ageom:RangeDatatypeShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-ageom-RangeDatatypeShape" ;
    req:fromStandard "Hexplain Aspect — Geometry (hx-geometry)" ;
    req:statement "Applies to subjects using ageom:coordinatePrecision. ageom:coordinatePrecision takes an integer (rdfs:range xsd:integer)."@en ;
    req:discrepancyType req:Syntactic ;
