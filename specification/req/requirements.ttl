    req:statement "Applies to instances of hexplain:ClassMappingRule. hexplain:condition takes exactly one value, a HEL expression (an xsd:string or bddo:HelExpression literal). hexplain:semanticClass takes exactly one value, an IRI naming an instance of owl:Class or rdfs:Class."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references hexplain:ClassMappingRuleShape .
reqs:req-shape-hexplain-CodecContractBindingShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of hexplain:CodecContractBindingShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement hexplain:CodecContractBindingShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-hexplain-CodecContractBindingShape" ;
    req:fromStandard "Hexplain Core Ontology" ;
    req:statement "Applies to subjects using hexplain:codecContract. hexplain:codecContract is declared on a register concept (a skos:Concept). Each focus node is an instance of skos:Concept. A register concept states at most one hexplain:codecContract, and it is a hexplain:CodecContract."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references hexplain:CodecContractBindingShape .
reqs:req-shape-hexplain-CodecContractShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of hexplain:CodecContractShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement hexplain:CodecContractShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-hexplain-CodecContractShape" ;
    req:fromStandard "Hexplain Core Ontology" ;
    req:statement "Applies to instances of hexplain:CodecContract; subjects using hexplain:codecKind, hexplain:contractVersion, hexplain:declaresParameter, hexplain:encodes, hexplain:keepsSession, hexplain:raisesCategory, hexplain:vectorSuiteVersion. A codec contract states exactly one hexplain:codecKind. A codec contract states exactly one hexplain:contractVersion, a positive integer. Every hexplain:declaresParameter value is a hexplain:CodecParameterSpec. A codec contract states hexplain:encodes once, as a boolean: true when it covers encoding, false when it is decode-only. A codec contract states hexplain:keepsSession once, as a boolean. hexplain:raisesCategory is one of Validation, Checksum, Unsupported, ResourceLimit and Description. A codec contract states exactly one hexplain:vectorSuiteVersion, a positive integer."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references hexplain:CodecContractShape .
reqs:req-shape-hexplain-CodecParameterShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of hexplain:CodecParameterShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement hexplain:CodecParameterShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-hexplain-CodecParameterShape" ;
    req:fromStandard "Hexplain Core Ontology" ;
    req:statement "Applies to instances of hexplain:CodecParameter; subjects using hexplain:parameterExpression, hexplain:parameterName, hexplain:parameterValue; objects of hexplain:codecParameter. A codec parameter states its value exactly one way: hexplain:parameterValue or hexplain:parameterExpression. Each focus node is a node that states exactly one of: hexplain:parameterValue; hexplain:parameterExpression. hexplain:parameterExpression takes at most one value, a HEL expression, an xsd:string or bddo:HelExpression literal. hexplain:parameterName takes exactly one value, an xsd:string literal. hexplain:parameterValue takes at most one value; a parameter states exactly one of hexplain:parameterValue and hexplain:parameterExpression."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references hexplain:CodecParameterShape .
reqs:req-shape-hexplain-CodecParameterSpecShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of hexplain:CodecParameterSpecShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement hexplain:CodecParameterSpecShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-hexplain-CodecParameterSpecShape" ;
    req:fromStandard "Hexplain Core Ontology" ;
    req:statement "Applies to instances of hexplain:CodecParameterSpec; subjects using hexplain:allowedValue, hexplain:defaultValue, hexplain:listLength, hexplain:listValued, hexplain:maximumValue, hexplain:minimumValue, hexplain:parameterKey, hexplain:parameterType, hexplain:requiredParameter. Each value of hexplain:allowedValue is a literal. hexplain:defaultValue takes at most one value, a literal. hexplain:listLength takes at most one value, an xsd:integer of at least 1. hexplain:listValued takes at most one value, an xsd:boolean literal. hexplain:maximumValue takes at most one value, a literal. hexplain:minimumValue takes at most one value, a literal. A codec parameter spec states exactly one hexplain:parameterKey, an xsd:string literal. A codec parameter spec states exactly one hexplain:parameterType, one of the six hexplain:CodecParameterType individuals. hexplain:requiredParameter takes at most one value, an xsd:boolean literal."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references hexplain:CodecParameterSpecShape .
reqs:req-shape-hexplain-CodecSelectionShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of hexplain:CodecSelectionShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement hexplain:CodecSelectionShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-hexplain-CodecSelectionShape" ;
    req:fromStandard "Hexplain Core Ontology" ;
    req:statement "Applies to subjects using hexplain:codecCandidates, hexplain:codecFromExpression. A step that selects its codec at run time lists its candidates in one hexplain:codecCandidates list. hexplain:codecFromExpression takes at most one value, a HEL expression, an xsd:string or bddo:HelExpression literal. A step that selects its codec at run time carries no hexplain:codecParameter; parameters belong to the candidate steps. Every candidate is a hexplain:EncodingStep."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references hexplain:CodecSelectionShape .
reqs:req-shape-hexplain-CodecSessionScopeShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of hexplain:CodecSessionScopeShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement hexplain:CodecSessionScopeShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-hexplain-CodecSessionScopeShape" ;
    req:fromStandard "Hexplain Core Ontology" ;
    req:statement "Applies to subjects using hexplain:codecSessionScope. hexplain:codecSessionScope is declared on a bddo:Field. Each focus node is an instance of bddo:Field. hexplain:codecSessionScope is bddo:PerInstance or bddo:PerLayout, at most once."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references hexplain:CodecSessionScopeShape .
reqs:req-shape-hexplain-EncodingPipelineShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of hexplain:EncodingPipelineShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement hexplain:EncodingPipelineShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-hexplain-EncodingPipelineShape" ;
    req:fromStandard "Hexplain Core Ontology" ;
    req:statement "Applies to subjects using hexplain:hasEncodingStep. hexplain:hasEncodingStep must point to a single rdf:List. Every member of a hasEncodingStep list must be a hexplain:EncodingStep."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references hexplain:EncodingPipelineShape .
reqs:req-shape-hexplain-EncodingStepShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of hexplain:EncodingStepShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement hexplain:EncodingStepShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-hexplain-EncodingStepShape" ;
    req:fromStandard "Hexplain Core Ontology" ;
    req:statement "Applies to instances of hexplain:EncodingStep; subjects using hexplain:codec, hexplain:codecFromExpression, hexplain:codecParameter. An encoding step names its codec with hexplain:codec or selects one with hexplain:codecFromExpression, never both and never neither. Each focus node is a node that states exactly one of: hexplain:codec; hexplain:codecFromExpression. An encoding step names at most one codec, a skos:Concept IRI; it names one with hexplain:codec or selects one with hexplain:codecFromExpression, never both and never neither. Each value of hexplain:codecParameter is an instance of hexplain:CodecParameter."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references hexplain:EncodingStepShape .
reqs:req-shape-hexplain-HasConditionalClassMappingShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of hexplain:HasConditionalClassMappingShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement hexplain:HasConditionalClassMappingShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-hexplain-HasConditionalClassMappingShape" ;
    req:fromStandard "Hexplain Core Ontology" ;
    req:statement "Applies to subjects using hexplain:hasConditionalClassMapping. hexplain:hasConditionalClassMapping is declared on a bddo:Struct. Each focus node is an instance of bddo:Struct. hexplain:mapsToClass and hexplain:hasConditionalClassMapping are mutually exclusive. Every member of a hasConditionalClassMapping list must be a hexplain:ClassMappingRule."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references hexplain:HasConditionalClassMappingShape .
reqs:req-shape-hexplain-HasConditionalMappingShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of hexplain:HasConditionalMappingShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement hexplain:HasConditionalMappingShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-hexplain-HasConditionalMappingShape" ;
    req:fromStandard "Hexplain Core Ontology" ;
    req:statement "Applies to subjects using hexplain:hasConditionalMapping. hexplain:hasConditionalMapping is declared on a bddo:Field. Each focus node is an instance of bddo:Field. Every member of a hasConditionalMapping list must be a hexplain:MappingRule."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references hexplain:HasConditionalMappingShape .
reqs:req-shape-hexplain-HasDataLayoutShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of hexplain:HasDataLayoutShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement hexplain:HasDataLayoutShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-hexplain-HasDataLayoutShape" ;
