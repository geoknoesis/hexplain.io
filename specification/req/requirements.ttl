    req:requirementId "req-shape-req-RequirementShape" ;
    req:fromStandard "Hexplain Requirements Shapes" ;
    req:statement "Applies to instances of req:Requirement; subjects using req:appliesToVersion, req:discrepancyType, req:fromStandard, req:requirementId, req:statement. req:appliesToVersion values are non-empty strings; omit the property to mean every version. A Requirement needs exactly one req:discrepancyType from the controlled set. A Requirement needs exactly one non-blank req:fromStandard. White space, no-break and zero-width spaces alone are blank. A Requirement needs exactly one non-blank req:requirementId. White space, no-break and zero-width spaces alone are blank. A Requirement needs exactly one non-blank req:statement quoting the source text: a plain or language-tagged string."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references req:RequirementShape .
reqs:req-shape-vdv-IntegerValueShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of vdv:IntegerValueShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement vdv:IntegerValueShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-vdv-IntegerValueShape" ;
    req:fromStandard "Hexplain Video Vocabulary (VDV)" ;
    req:statement "Applied through references from other shapes. An integer value is a literal of an XSD integer-family datatype (xsd:integer, xsd:positiveInteger, xsd:nonNegativeInteger, xsd:int, xsd:long, xsd:unsignedInt, xsd:unsignedLong, xsd:short, xsd:unsignedShort, xsd:byte or xsd:unsignedByte). A conforming value is an integer (of any XSD integer datatype)."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references vdv:IntegerValueShape .
reqs:req-shape-vdv-PositiveAspectRatioShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of vdv:PositiveAspectRatioShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement vdv:PositiveAspectRatioShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-vdv-PositiveAspectRatioShape" ;
    req:fromStandard "Hexplain Video Vocabulary (VDV)" ;
    req:statement "Applies to subjects using vdv:aspectRatio. Both aspect-ratio components must be positive."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references vdv:PositiveAspectRatioShape .
reqs:req-shape-vdv-RateShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of vdv:RateShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement vdv:RateShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-vdv-RateShape" ;
    req:fromStandard "Hexplain Video Vocabulary (VDV)" ;
    req:statement "Applies to subjects using vdv:frameRateDenominator, vdv:frameRateNumerator. vdv:frameRateDenominator takes exactly one value, an integer (of any XSD integer datatype) greater than 0. vdv:frameRateNumerator takes exactly one value, an integer (of any XSD integer datatype) greater than 0."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references vdv:RateShape .
reqs:req-shape-vdv-StreamShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of vdv:StreamShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement vdv:StreamShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-vdv-StreamShape" ;
    req:fromStandard "Hexplain Video Vocabulary (VDV)" ;
    req:statement "Applies to instances of vdv:VideoStream, vdv:VideoTrack; subjects using vdv:aspectRatio, vdv:audioChannels, vdv:frameCount, vdv:frameRate, vdv:frameRateDenominator, vdv:frameRateNumerator, vdv:scanType. acolor:colorSpace takes at most one value; each is an IRI naming an instance of skos:Concept. aenc:bitrate takes at most one value; each is a number greater than 0. aenc:codec takes at most one value; each is an IRI naming an instance of skos:Concept. araster:height takes at most one value; each is a number greater than 0. araster:width takes at most one value; each is a number greater than 0. atime:duration takes at most one value; each is an xsd:decimal or xsd:integer literal at least 0. vdv:aspectRatio takes at most one value; each is an xsd:string literal matching the regular expression ^[0-9]+(\\.[0-9]+)?:[0-9]+(\\.[0-9]+)?$. vdv:audioChannels takes at most one value; each is an integer (of any XSD integer datatype) greater than 0. vdv:frameCount takes at most one value; each is an integer (of any XSD integer datatype) at least 0, at most 18446744073709551615. vdv:frameRate takes at most one value; each is an xsd:decimal or xsd:integer literal greater than 0. vdv:scanType takes at most one value; each is either vdv:Progressive or vdv:Interlaced."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references vdv:StreamShape .
