    req:requirementId "req-shape-dlv-DimensionExtentShape" ;
    req:fromStandard "Hexplain Data Layout Vocabulary (DLV)" ;
    req:statement "Applies to instances of dlv:Dimension. A dlv:Dimension states its extent exactly one way: dlv:dimensionSize, dlv:dimensionSizeFromField or dlv:dimensionSizeFromExpression. Each focus node is a node that states exactly one of: dlv:dimensionSize (an integer (of any XSD integer datatype)), no dlv:dimensionSizeFromField and no dlv:dimensionSizeFromExpression; dlv:dimensionSizeFromField, no dlv:dimensionSize and no dlv:dimensionSizeFromExpression; dlv:dimensionSizeFromExpression, no dlv:dimensionSize and no dlv:dimensionSizeFromField."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references dlv:DimensionExtentShape .
reqs:req-shape-dlv-DimensionOrderChoiceShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of dlv:DimensionOrderChoiceShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement dlv:DimensionOrderChoiceShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-dlv-DimensionOrderChoiceShape" ;
    req:fromStandard "Hexplain Data Layout Vocabulary (DLV)" ;
    req:statement "Applies to instances of dlv:DataLayout. A dlv:DataLayout fixes its dimension order (dlv:hasDimension) or chooses it (dlv:hasConditionalDimensionOrder): exactly one of the two. Each focus node is a node that states exactly one of: dlv:hasDimension and no dlv:hasConditionalDimensionOrder; dlv:hasConditionalDimensionOrder and no dlv:hasDimension."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references dlv:DimensionOrderChoiceShape .
reqs:req-shape-dlv-DimensionOrderRuleShape a owl:NamedIndividual , reqs:ShapeRequirement ;
