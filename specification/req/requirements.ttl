    req:statement "Applies to subjects using araster:hasBand. Each value of araster:hasBand is a value conforming to araster:RasterBandShape. Band indexes must be unique within one grid and may not exceed its declared count. Described bands exceed the declared total."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references araster:BandMembershipShape .
reqs:req-shape-araster-ExtentShape a owl:NamedIndividual , reqs:ShapeRequirement ;
