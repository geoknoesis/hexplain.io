    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement araster:ArrayDimensionShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-araster-ArrayDimensionShape" ;
    req:fromStandard "Hexplain Aspect — Raster (hx-raster)" ;
    req:statement "Applies to instances of araster:ArrayDimension. An array dimension is a resource (an IRI or a blank node), not a literal. Each focus node is a resource (an IRI or a blank node). araster:coordinateArray takes at most one value; each is a resource (an IRI or a blank node). araster:dimensionExtent takes exactly one value, a value conforming to araster:ExtentShape. araster:dimensionKind takes at most one value; each is an IRI. araster:dimensionName takes at most one value; each is an xsd:string literal at least 1 character long."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references araster:ArrayDimensionShape .
reqs:req-shape-araster-BandMembershipShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of araster:BandMembershipShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement araster:BandMembershipShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-araster-BandMembershipShape" ;
