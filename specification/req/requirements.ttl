    req:statement "Applies to instances of dlv:Dimension. A dlv:Dimension states its chunk extent at most one way: dlv:chunkSize, dlv:chunkSizeFromField or dlv:chunkSizeFromExpression. Each focus node is a node that states exactly one of: no dlv:chunkSize, no dlv:chunkSizeFromField and no dlv:chunkSizeFromExpression; dlv:chunkSize (an integer (of any XSD integer datatype)), no dlv:chunkSizeFromField and no dlv:chunkSizeFromExpression; dlv:chunkSizeFromField, no dlv:chunkSize and no dlv:chunkSizeFromExpression; dlv:chunkSizeFromExpression, no dlv:chunkSize and no dlv:chunkSizeFromField."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references dlv:DimensionChunkExtentShape .
reqs:req-shape-dlv-DimensionExtentShape a owl:NamedIndividual , reqs:ShapeRequirement ;
