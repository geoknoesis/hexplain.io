    req:statement "Applies to subjects using req:appliesToVersion, req:fromStandard, req:requirementId. req:appliesToVersion takes an xsd:string literal (rdfs:range xsd:string). req:fromStandard takes an xsd:string literal (rdfs:range xsd:string). req:requirementId takes an xsd:string literal (rdfs:range xsd:string)."@en ;
