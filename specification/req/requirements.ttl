    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement araster:PositiveCountShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-araster-PositiveCountShape" ;
    req:fromStandard "Hexplain Aspect — Raster (hx-raster)" ;
    req:statement "Applied through references from other shapes. A count is a positive integer literal (an XSD integer-family datatype, greater than 0). A conforming value is an integer (of any XSD integer datatype) greater than 0."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references araster:PositiveCountShape .
reqs:req-shape-araster-RangeDatatypeShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of araster:RangeDatatypeShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement araster:RangeDatatypeShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-araster-RangeDatatypeShape" ;
    req:fromStandard "Hexplain Aspect — Raster (hx-raster)" ;
    req:statement "Applies to subjects using araster:dimensionExtent, araster:dimensionName. araster:dimensionExtent takes a non-negative integer (rdfs:range xsd:nonNegativeInteger). araster:dimensionName takes an xsd:string literal (rdfs:range xsd:string)."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references araster:RangeDatatypeShape .
reqs:req-shape-araster-RasterBandShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of araster:RasterBandShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement araster:RasterBandShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-araster-RasterBandShape" ;
    req:fromStandard "Hexplain Aspect — Raster (hx-raster)" ;
    req:statement "Applies to instances of araster:RasterBand; subjects using araster:bandIndex, araster:noDataValue, araster:sampleOffset, araster:sampleScale, araster:sampleUnit; objects of araster:hasBand, araster:hasMask. A raster band is a resource (an IRI or a blank node), not a literal. Each focus node is a resource (an IRI or a blank node). araster:bandIndex takes at most one value; each is a value conforming to araster:PositiveCountShape. araster:noDataValue is at most one numeric literal (xsd:double/float, including NaN; xsd:decimal; or an integer-family datatype). araster:sampleOffset takes at most one value; each is an xsd:double literal that is finite (not NaN or infinite). araster:sampleScale takes at most one value; each is an xsd:double literal that is finite (not NaN or infinite). araster:sampleUnit takes at most one value; each is an IRI. A band belongs to at most one grid (araster:hasBand): no-data inheritance and band indexing need a single owning grid."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references araster:RasterBandShape .
reqs:req-shape-araster-RasterSizeShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of araster:RasterSizeShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement araster:RasterSizeShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-araster-RasterSizeShape" ;
    req:fromStandard "Hexplain Aspect — Raster (hx-raster)" ;
    req:statement "Applies to subjects using araster:bandCount, araster:height, araster:width. araster:bandCount takes at most one value; each is a value conforming to araster:PositiveCountShape. araster:height takes at most one value; each is a value conforming to araster:PositiveCountShape. araster:width takes at most one value; each is a value conforming to araster:PositiveCountShape."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references araster:RasterSizeShape .
reqs:req-shape-araster-SampleArrayShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of araster:SampleArrayShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement araster:SampleArrayShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-araster-SampleArrayShape" ;
    req:fromStandard "Hexplain Aspect — Raster (hx-raster)" ;
    req:statement "Applies to instances of araster:SampleArray; subjects using araster:dimensions; objects of araster:coordinateArray, araster:hasArray. araster:dimensions takes exactly one value, a resource (an IRI or a blank node). Each member of the araster:dimensions list is a value conforming to araster:ArrayDimensionShape. Dimension lists must terminate in rdf:nil, contain exactly one first/rest per cell, and contain no cycles."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references araster:SampleArrayShape .
reqs:req-shape-asamp-IntegerValueShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of asamp:IntegerValueShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement asamp:IntegerValueShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-asamp-IntegerValueShape" ;
    req:fromStandard "Hexplain Aspect — Sampling (hx-sampling)" ;
    req:statement "Applied through references from other shapes. An integer value is a literal of an XSD integer-family datatype (xsd:integer, xsd:positiveInteger, xsd:nonNegativeInteger, xsd:int, xsd:long, xsd:unsignedInt, xsd:unsignedLong, xsd:short, xsd:unsignedShort, xsd:byte or xsd:unsignedByte). A conforming value is an integer (of any XSD integer datatype)."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references asamp:IntegerValueShape .
reqs:req-shape-asamp-PositiveIntegerShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of asamp:PositiveIntegerShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement asamp:PositiveIntegerShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-asamp-PositiveIntegerShape" ;
    req:fromStandard "Hexplain Aspect — Sampling (hx-sampling)" ;
    req:statement "A positive integral quantity using an XML Schema integer-family datatype. Fractional values and numeric strings are not counts."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references asamp:PositiveIntegerShape .
reqs:req-shape-asamp-SamplingShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of asamp:SamplingShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement asamp:SamplingShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-asamp-SamplingShape" ;
    req:fromStandard "Hexplain Aspect — Sampling (hx-sampling)" ;
    req:statement "Validates optional sample precision, component count and numeric interpretation wherever those sampling properties occur."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references asamp:SamplingShape .
reqs:req-shape-asec-LevelChangeShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of asec:LevelChangeShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement asec:LevelChangeShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-asec-LevelChangeShape" ;
    req:fromStandard "Hexplain Aspect — Security Marking (hx-security)" ;
    req:statement "A declared level change must say when it takes effect. asec:levelChangeDate is defined as the date asec:levelChangesTo takes effect, so a change with no date states an obligation nobody can discharge: a reader cannot tell whether the resource is still at the old level or already at the new one. The converse is not required -- a date with no change is a review date, which asec:expiresOn already expresses."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references asec:LevelChangeShape .
reqs:req-shape-asec-MarkingShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of asec:MarkingShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement asec:MarkingShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-asec-MarkingShape" ;
    req:fromStandard "Hexplain Aspect — Security Marking (hx-security)" ;
    req:statement "Shape of each marking value wherever the marking spine occurs: the verbatim parts are strings, the decision dates are calendar dates rather than instants, and the register-bound parts are concepts. Deliberately says nothing about how many values a property may carry -- a resource marked under two systems at once carries two of most of them."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references asec:MarkingShape .
reqs:req-shape-asec-VerbatimLevelShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of asec:VerbatimLevelShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement asec:VerbatimLevelShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-asec-VerbatimLevelShape" ;
    req:fromStandard "Hexplain Aspect — Security Marking (hx-security)" ;
    req:statement "Advisory, not an error: a resolved asec:sensitivityLevel without the asec:sensitivityLevelText it was resolved from is valid and readable, but it has dropped the bytes the file actually carried. This aspect treats a marking as a legal artefact whose written form matters independently of what it resolves to -- a register revised later must not silently rewrite what a file said -- and once the text is gone that check is no longer possible. Reported at sh:Warning because the marking is correct as far as it goes."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references asec:VerbatimLevelShape .
reqs:req-shape-asig-SampleRateShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of asig:SampleRateShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement asig:SampleRateShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-asig-SampleRateShape" ;
    req:fromStandard "Hexplain Aspect — Signal (hx-signal)" ;
    req:statement "A stated sample rate is a single positive decimal or integer-family value in hertz. Decimal rates admit exact finite fractional rates such as 0.5 Hz; binary floating-point literals and rounded rational approximations must be converted explicitly by the profile."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references asig:SampleRateShape .
reqs:req-shape-asref-CRSShape a owl:NamedIndividual , reqs:ShapeRequirement ;
