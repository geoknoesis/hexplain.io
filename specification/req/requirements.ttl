    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement dlv:DimensionOrderRuleShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-dlv-DimensionOrderRuleShape" ;
    req:fromStandard "Hexplain Data Layout Vocabulary (DLV)" ;
    req:statement "Applies to instances of dlv:DimensionOrderRule. bddo:condition takes exactly one value, a HEL expression (an xsd:string or bddo:HelExpression literal). dlv:ruleDimensionOrder takes exactly one value, a resource (an IRI or a blank node). Every member of a ruleDimensionOrder list must be a dlv:Dimension."@en ;
    req:discrepancyType req:Syntactic ;
    dcterms:references dlv:DimensionOrderRuleShape .
reqs:req-shape-dlv-DimensionShape a owl:NamedIndividual , reqs:ShapeRequirement ;
    rdfs:label "Requirement of dlv:DimensionShape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/req/requirements> ;
    rdfs:comment "The requirement dlv:DimensionShape enforces on a description; a description that this shape reports does not satisfy it."@en ;
    req:requirementId "req-shape-dlv-DimensionShape" ;
    req:fromStandard "Hexplain Data Layout Vocabulary (DLV)" ;
    req:statement "Applies to instances of dlv:Dimension. dlv:chunkSize takes at most one value; each is an integer (of any XSD integer datatype) greater than 0. dlv:chunkSizeFromExpression takes at most one value; each is a HEL expression (an xsd:string or bddo:HelExpression literal). dlv:chunkSizeFromField takes at most one value; each is an instance of bddo:Field. dlv:dimensionSize takes at most one value; each is an integer (of any XSD integer datatype) greater than 0. dlv:dimensionSizeFromExpression takes at most one value; each is a HEL expression (an xsd:string or bddo:HelExpression literal). dlv:dimensionSizeFromField takes at most one value; each is an instance of bddo:Field. dlv:dimensionStride takes at most one value; each is an integer (of any XSD integer datatype) greater than 0. dlv:dimensionStrideFromExpression takes at most one value; each is a HEL expression (an xsd:string or bddo:HelExpression literal). dlv:dimensionStrideFromField takes at most one value; each is an instance of bddo:Field. dlv:hasAxis takes exactly one value, an IRI naming an instance of dlv:Axis. A dlv:Dimension must use at most one stride mechanism (dimensionStride / dimensionStrideFromField / dimensionStrideFromExpression)."@en ;
    req:discrepancyType req:Semantic ;
    dcterms:references dlv:DimensionShape .
reqs:req-shape-dlv-IntegerValueShape a owl:NamedIndividual , reqs:ShapeRequirement ;
