# Editorial annotations only; OWL axioms and SHACL constraints above are unchanged.
@prefix atime: <https://hexplain.io/ns/aspect/time#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://hexplain.io/ns/aspect/time> skos:scopeNote "Use for temporal metadata of content. Numeric durations and frame/sample counts are not interchangeable without a timing model."@en .
atime:DurationShape rdfs:label "Duration Shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/aspect/time> ;
    skos:definition "Applies to subjects using atime:duration. atime:duration takes at most one value; each is an xsd:decimal or xsd:integer literal at least 0."@en .
atime:duration skos:definition "The elapsed playing time of content expressed in seconds. It is a temporal extent, distinct from a timestamp or a count of frames or samples."@en .
