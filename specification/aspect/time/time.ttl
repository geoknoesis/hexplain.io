# Hexplain Aspect — Time (hx-time) 1.0
# Orthogonal aspect: temporal extent and structure of data.
# Imports nothing; imported by any domain whose data has a timeline (audio, video, animation).
@prefix :       <https://hexplain.io/ns/aspect/time#> .
@prefix atime:  <https://hexplain.io/ns/aspect/time#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix ma:     <http://www.w3.org/ns/ma-ont#> .
@prefix qudt:   <http://qudt.org/schema/qudt/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix unit:   <http://qudt.org/vocab/unit/> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .

<https://hexplain.io/ns/aspect/time> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/aspect/time/1.0> ; owl:versionInfo "1.0" ;
    rdfs:label "Hexplain Aspect — Time (hx-time)" ;
    rdfs:comment "Orthogonal aspect for the temporal extent and structure of data (duration, and — as the aspect grows — timebase, frame count, timecode). Imported by any domain whose data has a timeline." ;
    dcterms:created "2026-07-22"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "atime" ; vann:preferredNamespaceUri "https://hexplain.io/ns/aspect/time#" .

:duration a owl:DatatypeProperty ; rdfs:label "duration" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/time> ; skos:closeMatch ma:duration ; rdfs:range xsd:decimal ; qudt:hasQuantityKind quantitykind:Time ; qudt:hasUnit unit:SEC ; rdfs:comment "Playing time in seconds." .
