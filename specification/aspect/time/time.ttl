# Hexplain Aspect — Time (hx-time) 1.1
# Orthogonal aspect: temporal extent and structure of data.
# Imports nothing; imported by any domain whose data has a timeline (audio, video, animation).
@prefix :       <https://hexplain.io/ns/aspect/time#> .
@prefix atime:  <https://hexplain.io/ns/aspect/time#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix ma:     <http://www.w3.org/ns/ma-ont#> .
@prefix time:   <http://www.w3.org/2006/time#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix unit:   <http://qudt.org/vocab/unit/> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .

<https://hexplain.io/ns/aspect/time> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/aspect/time/1.1> ; owl:versionInfo "1.1" ;
    owl:priorVersion <https://hexplain.io/ns/aspect/time/1.0> ;
    dcterms:modified "2026-09-27"^^xsd:date ;
    rdfs:label "Hexplain Aspect — Time (hx-time)"@en ;
    rdfs:comment "Orthogonal aspect for the temporal extent and structure of data (duration, and — as the aspect grows — timebase, frame count, timecode). Imported by any domain whose data has a timeline."@en ;
    dcterms:created "2026-07-22"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "atime" ; vann:preferredNamespaceUri "https://hexplain.io/ns/aspect/time#" .

# OWL-Time: atime:duration is linked, not subsumed. time:hasDuration relates a temporal entity to
# a time:Duration resource, and time:numericDuration gives a time:Duration its number with a
# separate time:unitType; atime:duration relates CONTENT (not a temporal entity) straight to a
# number of seconds, so asserting either as its superproperty would type content as a
# time:TemporalEntity or a time:Duration, which it is not.
# Units: qudt:hasUnit and qudt:hasQuantityKind describe a quantity, not a property, so they are
# not asserted on the property; its unit is in its definition and linked with rdfs:seeAlso.
:duration a owl:DatatypeProperty ; rdfs:label "duration"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/time> ; rdfs:seeAlso ma:duration , time:hasDuration , time:numericDuration ; rdfs:range xsd:decimal ; rdfs:seeAlso unit:SEC , quantitykind:Time ; rdfs:comment "Playing time in seconds."@en .

@prefix sh: <http://www.w3.org/ns/shacl#> .
:DurationShape a sh:NodeShape ; sh:targetSubjectsOf :duration ;
    sh:property [ sh:path :duration ; sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] ) ; sh:minInclusive 0 ; sh:maxCount 1 ;
        sh:message "atime:duration takes at most one value; each is an xsd:decimal or xsd:integer literal at least 0." ] .

