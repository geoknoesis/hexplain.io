# A duration is a non-negative decimal or integer, stated once.
# expect: ex:clip atime:DurationShape sh:MinInclusiveConstraintComponent
# expect: ex:text atime:DurationShape sh:OrConstraintComponent
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix atime: <https://hexplain.io/ns/aspect/time#> .
@prefix ex:    <https://hexplain.io/test/time-invalid#> .

ex:clip atime:duration -1 .
ex:text atime:duration "PT12S" .
