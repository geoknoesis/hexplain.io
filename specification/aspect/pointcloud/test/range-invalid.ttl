# A point count is a non-negative integer.
# expect: ex:cloud apc:RangeDatatypeShape sh:MinInclusiveConstraintComponent
# expect: ex:text apc:RangeDatatypeShape sh:NodeConstraintComponent
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix apc: <https://hexplain.io/ns/aspect/pointcloud#> .
@prefix ex:  <https://hexplain.io/test/pointcloud-invalid#> .

ex:cloud apc:pointCount -1 .
ex:text apc:pointCount "many" .
