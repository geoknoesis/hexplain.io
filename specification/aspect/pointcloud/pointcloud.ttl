# Hexplain Aspect — Point Cloud (hx-pointcloud) 1.2
# Content-representation aspect: an unstructured set of sampled points. Sibling of raster and
# geometry. Imports BDDO for the per-point record layout; per-point attribute precision uses the
# sampling aspect's properties, which a profile imports alongside when it states them.
@prefix :       <https://hexplain.io/ns/aspect/pointcloud#> .
@prefix apc:    <https://hexplain.io/ns/aspect/pointcloud#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix bddo:   <https://hexplain.io/ns/bddo#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<https://hexplain.io/ns/aspect/pointcloud> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/aspect/pointcloud/1.2> ; owl:versionInfo "1.2" ;
    owl:priorVersion <https://hexplain.io/ns/aspect/pointcloud/1.1> ;
    dcterms:modified "2026-09-27"^^xsd:date ;
    owl:imports <https://hexplain.io/ns/bddo> ;
    rdfs:label "Hexplain Aspect — Point Cloud (hx-pointcloud)"@en ;
    rdfs:comment "Aspect for an unstructured set of sampled points (point count, per-point data layout). Per-point attribute precision is stated with hx-sampling properties."@en ;
    dcterms:created "2026-07-22"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "apc" ; vann:preferredNamespaceUri "https://hexplain.io/ns/aspect/pointcloud#" .

:pointCount a owl:DatatypeProperty ; rdfs:label "point count"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/pointcloud> ; rdfs:range xsd:unsignedLong .
:pointDataLayout a owl:ObjectProperty ; rdfs:label "point data layout"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/pointcloud> ; rdfs:range bddo:Struct ; rdfs:comment "The per-point record structure (BDDO struct)."@en .

# ---------- Range datatype shapes ----------
# Each XSD rdfs:range above, enforced wherever the property is used: activation is by
# subjects-of, so an untyped subject is checked too (tools/test_range_datatypes.py).
# Integer ranges accept any XSD integer-family datatype within the range's bounds.
apc:IntegerValueShape a sh:NodeShape ; rdfs:label "Integer value shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/aspect/pointcloud> ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:short ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedByte ] ) .
apc:RangeDatatypeShape a sh:NodeShape ; rdfs:label "Range datatype shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/aspect/pointcloud> ;
    sh:targetSubjectsOf apc:pointCount ;
    sh:property [ sh:path apc:pointCount ; sh:node apc:IntegerValueShape ; sh:minInclusive 0 ; sh:maxInclusive 18446744073709551615 ;
        sh:message "apc:pointCount takes an integer within the xsd:unsignedLong value space (rdfs:range xsd:unsignedLong)." ] .

# BEGIN GENERATED TERM DOCUMENTATION
# Editorial annotations only; OWL axioms and SHACL constraints above are unchanged.
@prefix apc: <https://hexplain.io/ns/aspect/pointcloud#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://hexplain.io/ns/aspect/pointcloud> skos:scopeNote "Use for unstructured sampled-point collections and their per-point record descriptions; no regular grid topology is implied."@en .
apc:IntegerValueShape skos:definition "Applied through references from other shapes. A conforming value is an integer (of any XSD integer datatype)."@en .
apc:RangeDatatypeShape skos:definition "Applies to subjects using apc:pointCount. apc:pointCount takes an integer within the xsd:unsignedLong value space (rdfs:range xsd:unsignedLong)."@en .
apc:pointCount skos:definition "The declared number of points in an unstructured point collection, including zero for an empty collection."@en .
