# Hexplain Aspect — Point Cloud (hx-pointcloud) 1.0
# Content-representation aspect: an unstructured set of sampled points. Sibling of raster and
# geometry. Imports the sampling base (per-point attribute precision) and references BDDO layout.
@prefix :       <https://hexplain.io/ns/aspect/pointcloud#> .
@prefix apc:    <https://hexplain.io/ns/aspect/pointcloud#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix bddo:   <https://hexplain.io/ns/bddo#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .

<https://hexplain.io/ns/aspect/pointcloud> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/aspect/pointcloud/1.0> ; owl:versionInfo "1.0" ;
    owl:imports <https://hexplain.io/ns/aspect/sampling> ;
    rdfs:label "Hexplain Aspect — Point Cloud (hx-pointcloud)" ;
    rdfs:comment "Aspect for an unstructured set of sampled points (point count, per-point data layout). Per-point attribute precision comes from hx-sampling." ;
    dcterms:created "2026-07-22"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "apc" ; vann:preferredNamespaceUri "https://hexplain.io/ns/aspect/pointcloud#" .

:pointCount a owl:DatatypeProperty ; rdfs:label "point count" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/pointcloud> ; rdfs:range xsd:unsignedLong .
:pointDataLayout a owl:ObjectProperty ; rdfs:label "point data layout" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/pointcloud> ; rdfs:range bddo:Struct ; rdfs:comment "The per-point record structure (BDDO struct)." .

