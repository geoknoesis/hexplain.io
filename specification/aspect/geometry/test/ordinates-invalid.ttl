# Ordinate flags are booleans; a dimensionality is an integer; a geometry type is a concept IRI.
# expect: ex:feature ageom:OrdinateShape sh:DatatypeConstraintComponent
# expect: ex:feature ageom:OrdinateShape sh:ClassConstraintComponent
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix ageom: <https://hexplain.io/ns/aspect/geometry#> .
@prefix ex:    <https://hexplain.io/test/geometry-invalid#> .

ex:feature ageom:geometryType ex:Untyped ; ageom:hasZ "yes" ; ageom:dimensionality 2.5 .
