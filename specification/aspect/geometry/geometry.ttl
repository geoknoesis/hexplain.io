# Hexplain Aspect — Geometry (hx-geometry) 1.4
# Content-representation aspect: explicit geometry (vector). Sibling of hx-raster; neither
# imports the other. Shared by vector graphics, geospatial vector, and font glyph outlines.
@prefix :        <https://hexplain.io/ns/aspect/geometry#> .
@prefix ageom:   <https://hexplain.io/ns/aspect/geometry#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .

<https://hexplain.io/ns/aspect/geometry> a owl:Ontology ;
    rdfs:seeAlso <https://hexplain.io/specification/aspect/geometry/geometry-doc.ttl> ;
    owl:versionIRI <https://hexplain.io/ns/aspect/geometry/1.4> ; owl:versionInfo "1.4" ;
    <http://schema.org/creativeWorkStatus> "working draft" ;
    owl:priorVersion <https://hexplain.io/ns/aspect/geometry/1.3> ;
    dcterms:modified "2026-10-14"^^xsd:date ;
    rdfs:label "Hexplain Aspect — Geometry (hx-geometry)"@en ;
    rdfs:comment "Aspect for explicit (vector) geometry: geometry type, dimensionality, coordinate precision. Sibling of hx-raster. Shared by vector graphics, geospatial vector, and font glyphs."@en ;
    dcterms:created "2026-07-22"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "ageom" ; vann:preferredNamespaceUri "https://hexplain.io/ns/aspect/geometry#" .

:Geometry a owl:Class ; rdfs:label "Geometry"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/geometry> ;
    rdfs:comment "One encoded geometric object: a single geometry of one geometry type (ageom:geometryType) and one ordinate set (ageom:dimensionality, ageom:hasZ, ageom:hasM). A multi-geometry or a geometry collection is one geometry whose parts are its members (ageom:hasMember)."@en ;
    rdfs:seeAlso <http://www.opengis.net/ont/geosparql#Geometry> ;
    skos:scopeNote "Map the struct that encodes one geometry value, at every nesting level: a collection member is a geometry in its own right. The geometry-type and ordinate properties are not restricted to it: a dataset or layer may state them of the geometries it holds."@en .
:GeometryRecord a owl:Class ; rdfs:label "Geometry record"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/geometry> ;
    rdfs:comment "A stored geometry value with the framing its container adds: a header that may state a spatial reference, an envelope or an emptiness flag, around exactly one encoded geometry (ageom:hasGeometry)."@en ;
    skos:scopeNote "Map the struct that wraps an encoded geometry with header fields of its own. A struct that is only the geometry's encoding maps to ageom:Geometry instead; the record's header facts (a spatial reference, for example) are stated of the record, its geometry's type and ordinates of the geometry."@en .
:hasGeometry a owl:ObjectProperty ; rdfs:label "has geometry"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/geometry> ; rdfs:range :Geometry ;
    rdfs:comment "Links a geometry record to the one geometry it encodes."@en ;
    skos:scopeNote "Use on an ageom:GeometryRecord, exactly once. A geometry is held by at most one record."@en .
:hasMember a owl:ObjectProperty ; rdfs:label "has member geometry"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/geometry> ; rdfs:range :Geometry ;
    rdfs:comment "Links a multi-geometry or geometry collection to one of its member geometries, a part that belongs to that collection alone. Member order is not conveyed by this property."@en ;
    skos:scopeNote "Use on an ageom:Geometry whose type is a multi-geometry or a geometry collection, once per member. Membership is acyclic: no geometry is a member of itself, directly or through other members."@en .
:geometryType a owl:ObjectProperty ; rdfs:label "geometry type"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/geometry> ; rdfs:range skos:Concept ; rdfs:comment "Kind of geometry, from a geometry-type register bound by the profile."@en .
:dimensionality a owl:DatatypeProperty ; rdfs:label "dimensionality"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/geometry> ; rdfs:range xsd:positiveInteger ; rdfs:comment "Coordinate dimensionality (2 for XY, 3 for XYZ)."@en .
:coordinatePrecision a owl:DatatypeProperty ; rdfs:label "coordinate precision"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/geometry> ; rdfs:range xsd:integer ; rdfs:comment "Number of decimal places retained per coordinate."@en .

:hasZ a owl:DatatypeProperty ; rdfs:range xsd:boolean ; rdfs:label "has elevation ordinate"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/geometry> ; rdfs:comment "Whether a geometry contains a Z ordinate. Independent of a measure ordinate; missing means unknown, not false."@en .
:hasM a owl:DatatypeProperty ; rdfs:range xsd:boolean ; rdfs:label "has measure ordinate"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/geometry> ; rdfs:comment "Whether a geometry contains an M measure ordinate. A measure is not implicitly elevation or time. XYM and XYZ are distinct despite having three ordinates."@en .
:OrdinateShape a sh:NodeShape ; sh:targetSubjectsOf :hasZ, :hasM, :dimensionality, :geometryType ;
    sh:property [ sh:path :dimensionality ; sh:node ageom:IntegerValueShape ; sh:minExclusive 0 ; sh:maxCount 1 ;
        sh:message "ageom:dimensionality takes at most one value; each is an integer (of any XSD integer datatype) greater than 0." ] ;
    sh:property [ sh:path :geometryType ; sh:nodeKind sh:IRI ; sh:class skos:Concept ;
        sh:message "Each value of ageom:geometryType is an IRI naming an instance of skos:Concept." ] ;
    sh:property [ sh:path :hasZ ; sh:datatype xsd:boolean ; sh:maxCount 1 ;
        sh:message "ageom:hasZ takes at most one value; each is an xsd:boolean literal." ] ;
    sh:property [ sh:path :hasM ; sh:datatype xsd:boolean ; sh:maxCount 1 ;
        sh:message "ageom:hasM takes at most one value; each is an xsd:boolean literal." ] .

# ---------- Geometries, members and records ----------
# No rdfs:domain (scoped SHACL instead): a shape is activated by the class and by the properties
# that only a geometry or a record carries, so an untyped geometry is checked too.
:GeometryShape a sh:NodeShape ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/geometry> ;
    sh:targetClass :Geometry ; sh:targetObjectsOf :hasGeometry, :hasMember ;
    sh:message "A geometry is a resource (an IRI or a blank node), not a literal." ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [ sh:path [ sh:inversePath :hasMember ] ; sh:maxCount 1 ;
        sh:message "A geometry is a member (ageom:hasMember) of at most one collection." ] ;
    sh:property [ sh:path [ sh:inversePath :hasGeometry ] ; sh:maxCount 1 ;
        sh:message "A geometry is held (ageom:hasGeometry) by at most one geometry record." ] .
:GeometryMembershipShape a sh:NodeShape ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/geometry> ;
    sh:targetSubjectsOf :hasMember ;
    sh:property [ sh:path :hasMember ; sh:node :GeometryShape ;
        sh:message "Each value of ageom:hasMember is a value conforming to ageom:GeometryShape." ] ;
    sh:sparql [ sh:message "Geometry membership (ageom:hasMember) must be acyclic." ; sh:select """
      PREFIX ageom: <https://hexplain.io/ns/aspect/geometry#>
      SELECT $this WHERE { $this ageom:hasMember+ $this }
    """ ] .
:GeometryRecordShape a sh:NodeShape ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/geometry> ;
    sh:targetClass :GeometryRecord ; sh:targetSubjectsOf :hasGeometry ;
    sh:property [ sh:path :hasGeometry ; sh:minCount 1 ; sh:maxCount 1 ; sh:node :GeometryShape ;
        sh:message "A geometry record holds exactly one ageom:hasGeometry, a value conforming to ageom:GeometryShape." ] .

# ---------- Range datatype shapes ----------
# Each XSD rdfs:range above, enforced wherever the property is used: activation is by
# subjects-of, so an untyped subject is checked too (tools/test_range_datatypes.py).
# Integer ranges accept any XSD integer-family datatype within the range's bounds.
# One copy per module, byte-identical to bddo:IntegerValueShape (the master; template in
# specification/shared-patterns/integer-value-shape.ttl.template): shapes are validated module by
# module, and a sh:node into another module's graph is silently satisfied when that module is not loaded.
ageom:IntegerValueShape a sh:NodeShape ; rdfs:label "Integer value shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/aspect/geometry> ;
    sh:message "An integer value is a literal of an XSD integer-family datatype (xsd:integer, xsd:positiveInteger, xsd:nonNegativeInteger, xsd:int, xsd:long, xsd:unsignedInt, xsd:unsignedLong, xsd:short, xsd:unsignedShort, xsd:byte or xsd:unsignedByte)." ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:short ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedByte ] ) .
ageom:RangeDatatypeShape a sh:NodeShape ; rdfs:label "Range datatype shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/aspect/geometry> ;
    sh:targetSubjectsOf ageom:coordinatePrecision ;
    sh:property [ sh:path ageom:coordinatePrecision ; sh:node ageom:IntegerValueShape ;
        sh:message "ageom:coordinatePrecision takes an integer (rdfs:range xsd:integer)." ] .

# ---------- Term ownership ----------
# rdfs:isDefinedBy for the terms whose declaration above does not state it. A new term states
# its own; tools/test_term_reference.py requires it of every term this file defines.
:OrdinateShape rdfs:isDefinedBy <https://hexplain.io/ns/aspect/geometry> .
