# Hexplain Aspect — Geometry (hx-geometry) 1.0
# Content-representation aspect: explicit geometry (vector). Sibling of hx-raster; neither
# imports the other. Shared by vector graphics, geospatial vector, and font glyph outlines.
@prefix :        <https://hexplain.io/ns/aspect/geometry#> .
@prefix ageom:   <https://hexplain.io/ns/aspect/geometry#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .

<https://hexplain.io/ns/aspect/geometry> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/aspect/geometry/1.2> ; owl:versionInfo "1.2 working draft" ; owl:priorVersion <https://hexplain.io/ns/aspect/geometry/1.1> ; dcterms:modified "2026-09-05"^^xsd:date ;
    rdfs:label "Hexplain Aspect — Geometry (hx-geometry)" ;
    rdfs:comment "Aspect for explicit (vector) geometry: geometry type, dimensionality, coordinate precision. Sibling of hx-raster. Shared by vector graphics, geospatial vector, and font glyphs." ;
    dcterms:created "2026-07-22"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "ageom" ; vann:preferredNamespaceUri "https://hexplain.io/ns/aspect/geometry#" .

:geometryType a owl:ObjectProperty ; rdfs:label "geometry type" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/geometry> ; rdfs:range skos:Concept ; rdfs:comment "Kind of geometry, from a geometry-type register bound by the profile." .
:dimensionality a owl:DatatypeProperty ; rdfs:label "dimensionality" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/geometry> ; rdfs:range xsd:positiveInteger ; rdfs:comment "Coordinate dimensionality (2 for XY, 3 for XYZ)." .
:coordinatePrecision a owl:DatatypeProperty ; rdfs:label "coordinate precision" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/geometry> ; rdfs:range xsd:integer ; rdfs:comment "Number of decimal places retained per coordinate." .

:hasZ a owl:DatatypeProperty ; rdfs:range xsd:boolean ; rdfs:label "has elevation ordinate" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/geometry> ; rdfs:comment "Whether a geometry contains a Z ordinate. Independent of a measure ordinate; missing means unknown, not false." .
:hasM a owl:DatatypeProperty ; rdfs:range xsd:boolean ; rdfs:label "has measure ordinate" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/geometry> ; rdfs:comment "Whether a geometry contains an M measure ordinate. A measure is not implicitly elevation or time. XYM and XYZ are distinct despite having three ordinates." .
:OrdinateShape a sh:NodeShape ; sh:targetSubjectsOf :hasZ, :hasM, :dimensionality, :geometryType ;
    sh:property [ sh:path :dimensionality ; sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:short ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedByte ] ) ; sh:minExclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :geometryType ; sh:nodeKind sh:IRI ; sh:class skos:Concept ] ;
    sh:property [ sh:path :hasZ ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ;
    sh:property [ sh:path :hasM ; sh:datatype xsd:boolean ; sh:maxCount 1 ] .

