# Hexplain Aspect — Security Marking (hx-security) 1.1
# Governance aspect: classification / handling markings. Cross-cutting across any dataset;
# it does not belong to any one domain (it was wrongly trapped in the Geospatial vocabulary).
# 1.1 adds full marking coverage (NITF security-block parity). Controlled values now come from
# an external register chosen per profile via hexplain:usesRegister; this aspect names no
# particular register.
@prefix :       <https://hexplain.io/ns/aspect/security#> .
@prefix asec:   <https://hexplain.io/ns/aspect/security#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .

<https://hexplain.io/ns/aspect/security> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/aspect/security/1.1> ; owl:versionInfo "1.1" ;
    rdfs:label "Hexplain Aspect — Security Marking (hx-security)" ;
    rdfs:comment "Aspect for classification and handling markings: classification level, system, compartments/codewords, control-and-handling, releasability, declassification/downgrade instructions, and classification authority. Cross-cutting across any classified dataset. Controlled values (classification level, markings, declassification/authority/reason codes) come from an external register bound by the profile, not from a scheme hosted in this aspect; raw wire codes are not retained in vocabulary at all — they live only in that profile's HDL enum." ;
    rdfs:seeAlso <https://www.dni.gov/index.php/who-we-are/organizations/ic-cio/ic-cio-related-menus/ic-cio-related-links/ic-technical-specifications/information-security-marking-metadata> ,
        <https://www.esd.whs.mil/Directives/issuances/dodm/> ;
    dcterms:created "2026-07-22"^^xsd:date ; dcterms:modified "2026-07-27"^^xsd:date ;
    dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "asec" ; vann:preferredNamespaceUri "https://hexplain.io/ns/aspect/security#" .

# =========================================================
# Marking properties (flat, composable; align to IC ISM)
# =========================================================
:classification a owl:ObjectProperty ; rdfs:label "classification" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/security> ;
    rdfs:range skos:Concept ; skos:note "Value drawn from the classification-level register bound by the profile." ;
    rdfs:comment "Resolved classification level of the resource — the interoperable (concept) companion to asec:classificationLevel (verbatim string)." .
:classificationLevel a owl:DatatypeProperty ; rdfs:label "classification level" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/security> ;
    rdfs:range xsd:string ; rdfs:comment "Security classification of the resource as a verbatim marking string. Retained from 1.0; asec:classification carries the resolved register concept." .
:classificationSystem a owl:DatatypeProperty ; rdfs:label "classification system" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/security> ;
    rdfs:range xsd:string ; rdfs:comment "National or multinational security system used to classify the resource (FIPS 10-4 country code, or 'XN' for NATO marking guidance). NITF FSCLSY/ISCLSY." .
:compartment a owl:ObjectProperty ; rdfs:label "compartment" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/security> ;
    rdfs:range skos:Concept ; skos:note "Value drawn from the security-marking register bound by the profile; repeatable." ;
    rdfs:comment "A security compartment or codeword associated with the resource (repeatable). NITF FSCODE codewords." .
:controlAndHandling a owl:ObjectProperty ; rdfs:label "control and handling" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/security> ;
    rdfs:range skos:Concept ; skos:note "Value drawn from the security-marking register bound by the profile; repeatable." ;
    rdfs:comment "Additional security control and/or handling caveat associated with the resource (repeatable). NITF FSCTLH." .
:releasableTo a owl:DatatypeProperty ; rdfs:label "releasable to" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/security> ;
    rdfs:range xsd:string ; rdfs:comment "Country or multilateral-entity code to which the resource is authorized for release (repeatable; FIPS 10-4). NITF FSREL. A controlled country register is future work." .
:declassificationType a owl:ObjectProperty ; rdfs:label "declassification type" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/security> ;
    rdfs:range skos:Concept ; skos:note "Value drawn from the declassification-type register bound by the profile." ;
    rdfs:comment "Type of security declassification or downgrading instruction that applies to the resource. NITF FSDCTP." .
:declassificationDate a owl:DatatypeProperty ; rdfs:label "declassification date" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/security> ;
    rdfs:range xsd:date ; rdfs:comment "Date on which the resource is to be declassified (when declassificationType is DeclassifyOnDate). NITF FSDCDT." .
:declassificationExemption a owl:ObjectProperty ; rdfs:label "declassification exemption" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/security> ;
    rdfs:range skos:Concept ; skos:note "Value drawn from the declassification-exemption register bound by the profile." ;
    rdfs:comment "Reason the resource is exempt from automatic declassification (when declassificationType is ExemptFromAutomatic). NITF FSDCXM." .
:downgradeTo a owl:ObjectProperty ; rdfs:label "downgrade to" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/security> ;
    rdfs:range skos:Concept ; skos:note "Value drawn from the classification-level register bound by the profile." ;
    rdfs:comment "Classification level to which the resource is to be downgraded. NITF FSDG." .
:downgradeDate a owl:DatatypeProperty ; rdfs:label "downgrade date" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/security> ;
    rdfs:range xsd:date ; rdfs:comment "Date on which the resource is to be downgraded (when declassificationType is DowngradeOnDate). NITF FSDGDT." .
:classificationText a owl:DatatypeProperty ; rdfs:label "classification text" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/security> ;
    rdfs:range xsd:string ; rdfs:comment "Free-text additional information about the classification (e.g. declassification/downgrading event, multiple sources). NITF FSCLTX." .
:classificationAuthorityType a owl:ObjectProperty ; rdfs:label "classification authority type" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/security> ;
    rdfs:range skos:Concept ; skos:note "Value drawn from the classification-authority-type register bound by the profile." ;
    rdfs:comment "Type of authority used to classify the resource. NITF FSCATP." .
:classificationAuthority a owl:DatatypeProperty ; rdfs:label "classification authority" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/security> ;
    rdfs:range xsd:string ; rdfs:comment "Identity of the classification authority (name/position, source document, or 'Derive-Multiple'). NITF FSCAUT." .
:classificationReason a owl:ObjectProperty ; rdfs:label "classification reason" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/security> ;
    rdfs:range skos:Concept ; skos:note "Value drawn from the classification-reason register bound by the profile." ;
    rdfs:comment "Reason for classifying the resource. NITF FSCRSN." .
:securitySourceDate a owl:DatatypeProperty ; rdfs:label "security source date" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/security> ;
    rdfs:range xsd:date ; rdfs:comment "Date of the source used to derive the classification of the resource. NITF FSSRDT." .
:securityControlNumber a owl:DatatypeProperty ; rdfs:label "security control number" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/security> ;
    rdfs:range xsd:string ; rdfs:comment "Security control number associated with the resource. NITF FSCTLN." .
