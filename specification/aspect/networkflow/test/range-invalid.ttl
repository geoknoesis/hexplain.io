# An EtherType is two bytes, written as xsd:hexBinary, not a plain string.
# expect: ex:frame anet:RangeDatatypeShape sh:DatatypeConstraintComponent
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix anet: <https://hexplain.io/ns/aspect/networkflow#> .
@prefix ex:   <https://hexplain.io/test/networkflow-invalid#> .

ex:frame anet:etherType "0800" .
