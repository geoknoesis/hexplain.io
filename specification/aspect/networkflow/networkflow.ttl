# Hexplain Aspect — Network Flow (hx-networkflow) 1.2
# System aspect: protocol addressing and flow control. Currently consumed by NPV; factored
# out as its own aspect so future protocol vocabularies reuse one set of terms.
@prefix :       <https://hexplain.io/ns/aspect/networkflow#> .
@prefix anet:   <https://hexplain.io/ns/aspect/networkflow#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<https://hexplain.io/ns/aspect/networkflow> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/aspect/networkflow/1.2> ; owl:versionInfo "1.2" ;
    owl:priorVersion <https://hexplain.io/ns/aspect/networkflow/1.1> ;
    dcterms:modified "2026-09-23"^^xsd:date ;
    rdfs:label "Hexplain Aspect — Network Flow (hx-networkflow)" ;
    rdfs:comment "Aspect for protocol addressing and flow: endpoints, ports, protocol numbers, and TCP flow control." ;
    dcterms:created "2026-07-22"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "anet" ; vann:preferredNamespaceUri "https://hexplain.io/ns/aspect/networkflow#" .

:sourceAddress a owl:DatatypeProperty ; rdfs:label "source address" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/networkflow> ; rdfs:range xsd:string .
:destinationAddress a owl:DatatypeProperty ; rdfs:label "destination address" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/networkflow> ; rdfs:range xsd:string .
:sourcePort a owl:DatatypeProperty ; rdfs:label "source port" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/networkflow> ; rdfs:range xsd:unsignedShort .
:destinationPort a owl:DatatypeProperty ; rdfs:label "destination port" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/networkflow> ; rdfs:range xsd:unsignedShort .
:protocolNumber a owl:DatatypeProperty ; rdfs:label "protocol number" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/networkflow> ; rdfs:range xsd:integer .
:etherType a owl:DatatypeProperty ; rdfs:label "EtherType" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/networkflow> ; rdfs:range xsd:hexBinary .
:sequenceNumber a owl:DatatypeProperty ; rdfs:label "sequence number" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/networkflow> ; rdfs:range xsd:unsignedInt .
:acknowledgmentNumber a owl:DatatypeProperty ; rdfs:label "acknowledgment number" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/networkflow> ; rdfs:range xsd:unsignedInt .
:tcpFlags a owl:DatatypeProperty ; rdfs:label "TCP flags" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/networkflow> ; rdfs:range xsd:hexBinary .

# ---------- Range datatype shapes ----------
# Each XSD rdfs:range above, enforced wherever the property is used: activation is by
# subjects-of, so an untyped subject is checked too (tools/test_range_datatypes.py).
# Integer ranges accept any XSD integer-family datatype within the range's bounds.
anet:IntegerValueShape a sh:NodeShape ; rdfs:label "Integer value shape" ;
    rdfs:isDefinedBy <https://hexplain.io/ns/aspect/networkflow> ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:short ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedByte ] ) .
anet:RangeDatatypeShape a sh:NodeShape ; rdfs:label "Range datatype shape" ;
    rdfs:isDefinedBy <https://hexplain.io/ns/aspect/networkflow> ;
    sh:targetSubjectsOf anet:etherType ,
        anet:protocolNumber ;
    sh:property [ sh:path anet:etherType ; sh:datatype xsd:hexBinary ;
        sh:message "anet:etherType takes an xsd:hexBinary literal (rdfs:range xsd:hexBinary)." ] ;
    sh:property [ sh:path anet:protocolNumber ; sh:node anet:IntegerValueShape ;
        sh:message "anet:protocolNumber takes an integer (rdfs:range xsd:integer)." ] .

