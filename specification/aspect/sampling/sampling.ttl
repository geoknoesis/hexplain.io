# Hexplain Aspect — Sampling (hx-sampling) 1.2
# Base aspect: quantised sample values. Shared by any sampled representation
# (raster pixels, audio samples, point-cloud attributes). Imports nothing.
@prefix :       <https://hexplain.io/ns/aspect/sampling#> .
@prefix asamp:  <https://hexplain.io/ns/aspect/sampling#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix unit:   <http://qudt.org/vocab/unit/> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .

<https://hexplain.io/ns/aspect/sampling> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/aspect/sampling/1.2> ; owl:versionInfo "1.2" ;
    dcterms:modified "2026-09-27"^^xsd:date ;
    owl:priorVersion <https://hexplain.io/ns/aspect/sampling/1.1> ;
    rdfs:label "Hexplain Aspect — Sampling (hx-sampling)"@en ;
    rdfs:comment "Base aspect for quantised sample values (bit depth, component count, sample format). Shared by raster, signal, and point-cloud representations."@en ;
    dcterms:created "2026-07-22"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "asamp" ; vann:preferredNamespaceUri "https://hexplain.io/ns/aspect/sampling#" .

# Units: qudt:hasUnit and qudt:hasQuantityKind describe a quantity, not a property, so they are
# not asserted on the property; its unit is in its definition and linked with rdfs:seeAlso.
:bitDepth a owl:DatatypeProperty ; rdfs:label "bit depth"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/sampling> ; rdfs:range xsd:positiveInteger ; rdfs:seeAlso unit:BIT , quantitykind:InformationEntropy ; rdfs:comment "Bits per component/sample of the quantised data (e.g. 8, 16, 24)."@en .
:componentCount a owl:DatatypeProperty ; rdfs:label "component count"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/sampling> ; rdfs:range xsd:positiveInteger ; rdfs:comment "Number of components per sample — colour channels/bands for raster, channels for signal."@en .
:sampleFormat a owl:ObjectProperty ; rdfs:label "sample format"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/sampling> ; rdfs:comment "Numeric interpretation of each stored sample."@en .

:SignedInteger a owl:NamedIndividual ; rdfs:label "Signed integer"@en .
:UnsignedInteger a owl:NamedIndividual ; rdfs:label "Unsigned integer"@en .
:Float a owl:NamedIndividual ; rdfs:label "Floating point"@en .

@prefix sh: <http://www.w3.org/ns/shacl#> .
# Optional properties: declaring one activates value checks, not a completeness requirement.
:PositiveIntegerShape a sh:NodeShape ; rdfs:label "Positive sample count"@en ;
    skos:definition "A positive integral quantity using an XML Schema integer-family datatype. Fractional values and numeric strings are not counts."@en ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:short ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedByte ] ) ; sh:minExclusive 0 .
:SamplingShape a sh:NodeShape ; rdfs:label "Sampling values"@en ;
    skos:definition "Validates optional sample precision, component count and numeric interpretation wherever those sampling properties occur."@en ;
    sh:targetSubjectsOf :bitDepth, :componentCount, :sampleFormat ;
    sh:property [ sh:path :bitDepth ; sh:node :PositiveIntegerShape ; sh:maxCount 1 ;
        sh:message "asamp:bitDepth takes at most one value; each is a value conforming to asamp:PositiveIntegerShape." ] ;
    sh:property [ sh:path :componentCount ; sh:node :PositiveIntegerShape ; sh:maxCount 1 ;
        sh:message "asamp:componentCount takes at most one value; each is a value conforming to asamp:PositiveIntegerShape." ] ;
    sh:property [ sh:path :sampleFormat ; sh:in ( :SignedInteger :UnsignedInteger :Float ) ; sh:maxCount 1 ;
        sh:message "asamp:sampleFormat takes at most one value; each is one of asamp:SignedInteger, asamp:UnsignedInteger or asamp:Float." ] .

