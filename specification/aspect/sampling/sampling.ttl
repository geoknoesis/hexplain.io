# Editorial annotations only; OWL axioms and SHACL constraints above are unchanged.
@prefix asamp: <https://hexplain.io/ns/aspect/sampling#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://hexplain.io/ns/aspect/sampling> skos:scopeNote "Use for quantized sample interpretation shared by raster, signal and point-cloud data. Precision, component organization and numeric interpretation are separate declarations."@en .
asamp:Float rdfs:isDefinedBy <https://hexplain.io/ns/aspect/sampling> ;
    skos:definition "Sample interpretation using floating-point numeric values rather than integer quantization codes."@en .
asamp:PositiveIntegerShape rdfs:isDefinedBy <https://hexplain.io/ns/aspect/sampling> .
asamp:SamplingShape rdfs:isDefinedBy <https://hexplain.io/ns/aspect/sampling> .
asamp:SignedInteger rdfs:isDefinedBy <https://hexplain.io/ns/aspect/sampling> ;
    skos:definition "Sample interpretation admitting negative and nonnegative integral values; precision is stated separately."@en .
asamp:UnsignedInteger rdfs:isDefinedBy <https://hexplain.io/ns/aspect/sampling> ;
    skos:definition "Sample interpretation admitting only nonnegative integral values; precision is stated separately."@en .
