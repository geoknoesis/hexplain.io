# A bit depth is a positive integer; a sample format is one of the three individuals.
# expect: ex:band asamp:SamplingShape sh:NodeConstraintComponent
# expect: ex:band asamp:SamplingShape sh:InConstraintComponent
# expect: ex:two asamp:SamplingShape sh:MaxCountConstraintComponent
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix asamp: <https://hexplain.io/ns/aspect/sampling#> .
@prefix ex:    <https://hexplain.io/test/sampling-invalid#> .

ex:band asamp:bitDepth 0 ; asamp:sampleFormat ex:Complex .
ex:two asamp:componentCount 3 , 4 .
