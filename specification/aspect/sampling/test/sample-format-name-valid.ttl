# A sample format stated as a literal token, alone and beside the agreeing individual.
@prefix asamp: <https://hexplain.io/ns/aspect/sampling#> .
@prefix ex:    <https://hexplain.io/test/sample-format-name-valid#> .

ex:alone asamp:sampleFormatName "signedInteger" .
ex:both asamp:sampleFormatName "float" ; asamp:sampleFormat asamp:Float .
