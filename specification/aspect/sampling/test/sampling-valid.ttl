@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix asamp: <https://hexplain.io/ns/aspect/sampling#> .
@prefix ex:    <https://hexplain.io/test/sampling#> .

ex:band asamp:bitDepth 12 ; asamp:componentCount 3 ; asamp:sampleFormat asamp:UnsignedInteger .
ex:wide asamp:bitDepth "16"^^xsd:unsignedByte ; asamp:sampleFormat asamp:Float .
