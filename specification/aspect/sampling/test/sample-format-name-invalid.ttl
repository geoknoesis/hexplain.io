# An unknown token, and a token that contradicts the individual stated beside it.
# expect: ex:unknown asamp:SamplingShape sh:InConstraintComponent
# expect: ex:contradicts asamp:SampleFormatAgreementShape sh:SPARQLConstraintComponent
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix asamp: <https://hexplain.io/ns/aspect/sampling#> .
@prefix ex:    <https://hexplain.io/test/sample-format-name-invalid#> .

ex:unknown asamp:sampleFormatName "int16" .
ex:contradicts asamp:sampleFormatName "unsignedInteger" ; asamp:sampleFormat asamp:SignedInteger .
