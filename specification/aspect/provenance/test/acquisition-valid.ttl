# An acquisition record links the platform and sensor model it used as resources.
@prefix ex:    <https://hexplain.io/test/acquisition-valid#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix aprov: <https://hexplain.io/ns/aspect/provenance#> .

ex:Acquisition a aprov:AcquisitionInfo ;
    aprov:hasPlatform ex:Landsat8 ; aprov:hasSensorModel ex:OLI ;
    aprov:acquisitionTime "2026-06-01T18:21:04Z"^^xsd:dateTime .
ex:Landsat8 a aprov:Platform ; aprov:platformName "Landsat 8" .
ex:OLI a aprov:SensorModel ; aprov:sensorType "Operational Land Imager" .
