# Hexplain Aspect — Provenance & Acquisition (hx-provenance) 1.3
# Governance aspect: how data was observed/acquired. Relates to PROV and SOSA/SSN: the one
# reviewed logical alignment is aprov:Platform rdfs:subClassOf sosa:Platform (a platform hosts
# sensors); the other links are rdfs:seeAlso, because aprov:AcquisitionInfo is a record ABOUT an
# acquisition (not the prov:Activity itself) and aprov:SensorModel describes a kind of sensor
# (not the sosa:Sensor device).
# Cross-cutting (geospatial sensing, camera EXIF, scientific instruments).
@prefix :       <https://hexplain.io/ns/aspect/provenance#> .
@prefix aprov:  <https://hexplain.io/ns/aspect/provenance#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa:   <http://www.w3.org/ns/sosa/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<https://hexplain.io/ns/aspect/provenance> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/aspect/provenance/1.3> ; owl:versionInfo "1.3" ;
    owl:priorVersion <https://hexplain.io/ns/aspect/provenance/1.2> ;
    dcterms:modified "2026-09-27"^^xsd:date ;
    rdfs:label "Hexplain Aspect — Provenance & Acquisition (hx-provenance)" ;
    rdfs:comment "Aspect for acquisition provenance: sensor, platform, acquisition time. Relates to PROV and SOSA/SSN by rdfs:seeAlso, with one reviewed subclass alignment (aprov:Platform is a sosa:Platform). Cross-cutting across sensed data." ;
    dcterms:created "2026-07-22"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "aprov" ; vann:preferredNamespaceUri "https://hexplain.io/ns/aspect/provenance#" .

:AcquisitionInfo a owl:Class ; rdfs:label "Acquisition Info" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/provenance> ; rdfs:seeAlso prov:Activity .
:SensorModel a owl:Class ; rdfs:label "Sensor Model" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/provenance> ; rdfs:seeAlso sosa:Sensor .
:Platform a owl:Class ; rdfs:label "Platform" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/provenance> ; rdfs:subClassOf sosa:Platform .

:acquisitionTime a owl:DatatypeProperty ; rdfs:label "acquisition time" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/provenance> ; rdfs:seeAlso prov:endedAtTime ; rdfs:range xsd:dateTime .
:platformName a owl:DatatypeProperty ; rdfs:label "platform name" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/provenance> ; rdfs:range xsd:string .
:sensorType a owl:DatatypeProperty ; rdfs:label "sensor type" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/provenance> ; rdfs:range xsd:string .

# BEGIN GENERATED TERM DOCUMENTATION
# Editorial annotations only; OWL axioms and SHACL constraints above are unchanged.
@prefix aprov: <https://hexplain.io/ns/aspect/provenance#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://hexplain.io/ns/aspect/provenance> skos:scopeNote "Use for acquisition and observing-equipment metadata. Keep observation time distinct from file timestamps and reference-frame epochs."@en .
aprov:AcquisitionInfo skos:definition "A metadata resource describing the acquisition of data, including its time and observing equipment."@en .
aprov:Platform skos:definition "A resource identifying the carrier or platform on which an observing sensor operates."@en .
aprov:SensorModel skos:definition "A resource identifying or describing the instrument or sensor model responsible for observations."@en .
aprov:acquisitionTime skos:definition "The time associated with acquiring the data, distinct from file creation time or coordinate epoch."@en .
aprov:platformName skos:definition "The source-reported textual name of the observing platform."@en .
aprov:sensorType skos:definition "The source-reported textual designation of the observing sensor or sensor type."@en .
