# A creation time that is not an xsd:dateTime, and a directory flag that is not a boolean.
# expect: ex:entry afs:RangeDatatypeShape sh:DatatypeConstraintComponent
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix afs: <https://hexplain.io/ns/aspect/fsmeta#> .
@prefix ex:  <https://hexplain.io/test/fsmeta-invalid#> .

ex:entry afs:fileName "readme.txt" ; afs:creationTime "yesterday" ; afs:isDirectory "no" .
