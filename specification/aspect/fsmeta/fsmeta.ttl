# Hexplain Aspect — Filesystem Metadata (hx-fsmeta) 1.2
# System aspect: filesystem attributes of a file/entry. Shared by archives and disk images.
@prefix :       <https://hexplain.io/ns/aspect/fsmeta#> .
@prefix afs:    <https://hexplain.io/ns/aspect/fsmeta#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix dcat:   <http://www.w3.org/ns/dcat#> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<https://hexplain.io/ns/aspect/fsmeta> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/aspect/fsmeta/1.2> ; owl:versionInfo "1.2" ;
    owl:priorVersion <https://hexplain.io/ns/aspect/fsmeta/1.1> ;
    dcterms:modified "2026-09-27"^^xsd:date ;
    rdfs:label "Hexplain Aspect — Filesystem Metadata (hx-fsmeta)" ;
    rdfs:comment "Aspect for filesystem attributes: name, size, timestamps, directory flag (permissions/owner to follow). Shared by archives and disk images." ;
    dcterms:created "2026-07-22"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "afs" ; vann:preferredNamespaceUri "https://hexplain.io/ns/aspect/fsmeta#" .

# Dublin Core: a recorded modification or creation time IS the date the entry was changed or
# created (dcterms:modified, dcterms:created; no domain, range rdfs:Literal), so these are
# subproperties. dcat:byteSize is not a superproperty of afs:fileSize: its domain is
# dcat:Distribution, which an archive entry need not be.
:fileName a owl:DatatypeProperty ; rdfs:label "file name" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/fsmeta> ; rdfs:range xsd:string .
:fileSize a owl:DatatypeProperty ; rdfs:label "file size" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/fsmeta> ; rdfs:seeAlso dcterms:extent , dcat:byteSize ; rdfs:range xsd:unsignedLong ; rdfs:comment "Logical (uncompressed) size in bytes." .
:modificationTime a owl:DatatypeProperty ; rdfs:label "modification time" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/fsmeta> ; rdfs:subPropertyOf dcterms:modified ; rdfs:range xsd:dateTime .
:creationTime a owl:DatatypeProperty ; rdfs:label "creation time" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/fsmeta> ; rdfs:subPropertyOf dcterms:created ; rdfs:range xsd:dateTime .
:isDirectory a owl:DatatypeProperty ; rdfs:label "is directory" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/fsmeta> ; rdfs:range xsd:boolean .

# ---------- Range datatype shapes ----------
# Each XSD rdfs:range above, enforced wherever the property is used: activation is by
# subjects-of, so an untyped subject is checked too (tools/test_range_datatypes.py).
# Integer ranges accept any XSD integer-family datatype within the range's bounds.
afs:IntegerValueShape a sh:NodeShape ; rdfs:label "Integer value shape" ;
    rdfs:isDefinedBy <https://hexplain.io/ns/aspect/fsmeta> ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:short ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedByte ] ) .
afs:RangeDatatypeShape a sh:NodeShape ; rdfs:label "Range datatype shape" ;
    rdfs:isDefinedBy <https://hexplain.io/ns/aspect/fsmeta> ;
    sh:targetSubjectsOf afs:creationTime ,
        afs:fileName ,
        afs:fileSize ,
        afs:isDirectory ,
        afs:modificationTime ;
    sh:property [ sh:path afs:creationTime ; sh:datatype xsd:dateTime ;
        sh:message "afs:creationTime takes an xsd:dateTime literal (rdfs:range xsd:dateTime)." ] ;
    sh:property [ sh:path afs:fileName ; sh:datatype xsd:string ;
        sh:message "afs:fileName takes an xsd:string literal (rdfs:range xsd:string)." ] ;
    sh:property [ sh:path afs:fileSize ; sh:node afs:IntegerValueShape ; sh:minInclusive 0 ; sh:maxInclusive 18446744073709551615 ;
        sh:message "afs:fileSize takes an integer within the xsd:unsignedLong value space (rdfs:range xsd:unsignedLong)." ] ;
    sh:property [ sh:path afs:isDirectory ; sh:datatype xsd:boolean ;
        sh:message "afs:isDirectory takes an xsd:boolean literal (rdfs:range xsd:boolean)." ] ;
    sh:property [ sh:path afs:modificationTime ; sh:datatype xsd:dateTime ;
        sh:message "afs:modificationTime takes an xsd:dateTime literal (rdfs:range xsd:dateTime)." ] .

# BEGIN GENERATED TERM DOCUMENTATION
# Editorial annotations only; OWL axioms and SHACL constraints above are unchanged.
@prefix afs: <https://hexplain.io/ns/aspect/fsmeta#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://hexplain.io/ns/aspect/fsmeta> skos:scopeNote "Use for logical file or directory metadata recorded by a container or filesystem representation; it need not describe the current host filesystem."@en .
afs:IntegerValueShape skos:definition "Applied through references from other shapes. A conforming value is an integer (of any XSD integer datatype)."@en .
afs:RangeDatatypeShape skos:definition "Applies to subjects using afs:creationTime, afs:fileName, afs:fileSize, afs:isDirectory, afs:modificationTime. afs:creationTime takes an xsd:dateTime literal (rdfs:range xsd:dateTime). afs:fileName takes an xsd:string literal (rdfs:range xsd:string). afs:fileSize takes an integer within the xsd:unsignedLong value space (rdfs:range xsd:unsignedLong). afs:isDirectory takes an xsd:boolean literal (rdfs:range xsd:boolean). afs:modificationTime takes an xsd:dateTime literal (rdfs:range xsd:dateTime)."@en .
afs:creationTime skos:definition "The source-reported time at which an entry was created; precision and timezone availability depend on the format."@en .
afs:fileName skos:definition "The name of a file or directory entry as recorded by its container or filesystem representation."@en .
afs:isDirectory skos:definition "Whether an entry denotes a directory rather than a regular file payload."@en .
afs:modificationTime skos:definition "The source-reported time at which an entry's content was last modified."@en .
