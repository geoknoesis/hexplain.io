# Hexplain Aspect — Filesystem Metadata (hx-fsmeta) 1.1
# System aspect: filesystem attributes of a file/entry. Shared by archives and disk images.
@prefix :       <https://hexplain.io/ns/aspect/fsmeta#> .
@prefix afs:    <https://hexplain.io/ns/aspect/fsmeta#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<https://hexplain.io/ns/aspect/fsmeta> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/aspect/fsmeta/1.1> ; owl:versionInfo "1.1" ;
    owl:priorVersion <https://hexplain.io/ns/aspect/fsmeta/1.0> ;
    dcterms:modified "2026-09-23"^^xsd:date ;
    rdfs:label "Hexplain Aspect — Filesystem Metadata (hx-fsmeta)" ;
    rdfs:comment "Aspect for filesystem attributes: name, size, timestamps, directory flag (permissions/owner to follow). Shared by archives and disk images." ;
    dcterms:created "2026-07-22"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "afs" ; vann:preferredNamespaceUri "https://hexplain.io/ns/aspect/fsmeta#" .

:fileName a owl:DatatypeProperty ; rdfs:label "file name" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/fsmeta> ; rdfs:range xsd:string .
:fileSize a owl:DatatypeProperty ; rdfs:label "file size" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/fsmeta> ; rdfs:seeAlso dcterms:extent ; rdfs:range xsd:unsignedLong ; rdfs:comment "Logical (uncompressed) size in bytes." .
:modificationTime a owl:DatatypeProperty ; rdfs:label "modification time" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/fsmeta> ; rdfs:seeAlso dcterms:modified ; rdfs:range xsd:dateTime .
:creationTime a owl:DatatypeProperty ; rdfs:label "creation time" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/fsmeta> ; rdfs:seeAlso dcterms:created ; rdfs:range xsd:dateTime .
:isDirectory a owl:DatatypeProperty ; rdfs:label "is directory" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/fsmeta> ; rdfs:range xsd:boolean .

# ---------- Range datatype shapes ----------
# Each XSD rdfs:range above, enforced wherever the property is used: activation is by
# subjects-of, so an untyped subject is checked too (tools/test_range_datatypes.py).
# Integer ranges accept any XSD integer-family datatype within the range's bounds.
afs:IntegerValueShape a sh:NodeShape ; rdfs:label "Integer value shape" ;
    rdfs:isDefinedBy <https://hexplain.io/ns/aspect/fsmeta> ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:short ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedByte ] ) .
afs:RangeDatatypeShape a sh:NodeShape ; rdfs:label "Range datatype shape" ;
    rdfs:isDefinedBy <https://hexplain.io/ns/aspect/fsmeta> ;
    sh:targetSubjectsOf afs:creationTime ,
        afs:fileName ,
        afs:fileSize ,
        afs:isDirectory ,
        afs:modificationTime ;
    sh:property [ sh:path afs:creationTime ; sh:datatype xsd:dateTime ;
        sh:message "afs:creationTime takes an xsd:dateTime literal (rdfs:range xsd:dateTime)." ] ;
    sh:property [ sh:path afs:fileName ; sh:datatype xsd:string ;
        sh:message "afs:fileName takes an xsd:string literal (rdfs:range xsd:string)." ] ;
    sh:property [ sh:path afs:fileSize ; sh:node afs:IntegerValueShape ; sh:minInclusive 0 ; sh:maxInclusive 18446744073709551615 ;
        sh:message "afs:fileSize takes an integer within the xsd:unsignedLong value space (rdfs:range xsd:unsignedLong)." ] ;
    sh:property [ sh:path afs:isDirectory ; sh:datatype xsd:boolean ;
        sh:message "afs:isDirectory takes an xsd:boolean literal (rdfs:range xsd:boolean)." ] ;
    sh:property [ sh:path afs:modificationTime ; sh:datatype xsd:dateTime ;
        sh:message "afs:modificationTime takes an xsd:dateTime literal (rdfs:range xsd:dateTime)." ] .

