# A checksum value is xsd:hexBinary; a plain string is not.
# expect: ex:D aintg:RangeDatatypeShape sh:DatatypeConstraintComponent
@prefix ex:    <https://hexplain.io/test/range-invalid#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix aintg: <https://hexplain.io/ns/aspect/integrity#> .

ex:D aintg:checksum "zz" .
