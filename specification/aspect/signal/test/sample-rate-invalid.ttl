# A sample rate is positive and stated once.
# expect: ex:track asig:SampleRateShape sh:MinExclusiveConstraintComponent
# expect: ex:two asig:SampleRateShape sh:MaxCountConstraintComponent
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix asig: <https://hexplain.io/ns/aspect/signal#> .
@prefix ex:   <https://hexplain.io/test/signal-invalid#> .

ex:track asig:sampleRate 0 .
ex:two asig:sampleRate 44100 , 48000 .
