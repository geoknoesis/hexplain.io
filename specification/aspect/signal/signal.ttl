# Hexplain Aspect — Signal (hx-signal) 1.2
# Content aspect: a one-dimensional (temporal) sampled stream. Imports the sampling base.
@prefix :       <https://hexplain.io/ns/aspect/signal#> .
@prefix asig:   <https://hexplain.io/ns/aspect/signal#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix ma:     <http://www.w3.org/ns/ma-ont#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix unit:   <http://qudt.org/vocab/unit/> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .

<https://hexplain.io/ns/aspect/signal> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/aspect/signal/1.2> ; owl:versionInfo "1.2" ;
    dcterms:modified "2026-09-27"^^xsd:date ;
    owl:priorVersion <https://hexplain.io/ns/aspect/signal/1.1> ;
    owl:imports <https://hexplain.io/ns/aspect/sampling> ;
    rdfs:label "Hexplain Aspect — Signal (hx-signal)"@en ;
    rdfs:comment "Aspect for a one-dimensional temporal sampled stream (sample rate; channel layout to follow). Component/channel count comes from hx-sampling. Used by audio."@en ;
    dcterms:created "2026-07-22"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "asig" ; vann:preferredNamespaceUri "https://hexplain.io/ns/aspect/signal#" .

# Units: qudt:hasUnit and qudt:hasQuantityKind describe a quantity, not a property, so they are
# not asserted on the property; its unit is in its definition and linked with rdfs:seeAlso.
:sampleRate a owl:DatatypeProperty ; rdfs:label "sample rate"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/signal> ; rdfs:seeAlso ma:samplingRate ; rdfs:range xsd:decimal ; rdfs:seeAlso unit:HZ , quantitykind:Frequency ; rdfs:comment "Samples per second (Hz)."@en .

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix asamp: <https://hexplain.io/ns/aspect/sampling#> .
:SampleRateShape a sh:NodeShape ; rdfs:label "Positive sample rate"@en ;
    skos:definition "A stated sample rate is a single positive decimal or integer-family value in hertz. Decimal rates admit exact finite fractional rates such as 0.5 Hz; binary floating-point literals and rounded rational approximations must be converted explicitly by the profile."@en ;
    sh:targetSubjectsOf :sampleRate ;
    sh:property [ sh:path :sampleRate ; sh:maxCount 1 ; sh:minExclusive 0 ;
        sh:or ( [ sh:datatype xsd:decimal ] [ sh:node asamp:PositiveIntegerShape ] ) ] .

