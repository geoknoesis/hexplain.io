# A row count is a non-negative integer; a field name is a string.
# expect: ex:table atab:RangeDatatypeShape sh:MinInclusiveConstraintComponent
# expect: ex:column atab:RangeDatatypeShape sh:DatatypeConstraintComponent
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix atab: <https://hexplain.io/ns/aspect/tabular#> .
@prefix ex:   <https://hexplain.io/test/tabular-invalid#> .

ex:table atab:rowCount -1 .
ex:column a atab:Field ; atab:fieldName 5 .
