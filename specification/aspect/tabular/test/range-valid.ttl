@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix atab: <https://hexplain.io/ns/aspect/tabular#> .
@prefix ex:   <https://hexplain.io/test/tabular#> .

ex:table atab:rowCount 0 ; atab:hasField ex:column .
ex:column a atab:Field ; atab:fieldName "NAME" ; atab:fieldDataType "C" .
