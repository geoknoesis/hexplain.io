# Hexplain Aspect — Tabular (hx-tabular) 1.2
# Content-representation aspect: rows of typed columns. Shared by vector attribute tables,
# DBF files, CSV-like data, and database pages. Imports nothing.
@prefix :       <https://hexplain.io/ns/aspect/tabular#> .
@prefix atab:   <https://hexplain.io/ns/aspect/tabular#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<https://hexplain.io/ns/aspect/tabular> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/aspect/tabular/1.2> ; owl:versionInfo "1.2" ;
    owl:priorVersion <https://hexplain.io/ns/aspect/tabular/1.1> ;
    dcterms:modified "2026-09-27"^^xsd:date ;
    rdfs:label "Hexplain Aspect — Tabular (hx-tabular)" ;
    rdfs:comment "Aspect for tabular records: rows of typed columns (field schema). Shared by vector attribute tables, DBF, and CSV-like data." ;
    dcterms:created "2026-07-22"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "atab" ; vann:preferredNamespaceUri "https://hexplain.io/ns/aspect/tabular#" .

:Field a owl:Class ; rdfs:label "Field" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/tabular> ; rdfs:comment "A typed column in a tabular schema." .
:rowCount a owl:DatatypeProperty ; rdfs:label "row count" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/tabular> ; rdfs:range xsd:unsignedLong .
:hasField a owl:ObjectProperty ; rdfs:label "has field" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/tabular> ; rdfs:range :Field .
:fieldName a owl:DatatypeProperty ; rdfs:label "field name" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/tabular> ; rdfs:range xsd:string .
:fieldDataType a owl:DatatypeProperty ; rdfs:label "field data type" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/tabular> ; rdfs:range xsd:string .

# ---------- Range datatype shapes ----------
# Each XSD rdfs:range above, enforced wherever the property is used: activation is by
# subjects-of, so an untyped subject is checked too (tools/test_range_datatypes.py).
# Integer ranges accept any XSD integer-family datatype within the range's bounds.
atab:IntegerValueShape a sh:NodeShape ; rdfs:label "Integer value shape" ;
    rdfs:isDefinedBy <https://hexplain.io/ns/aspect/tabular> ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:short ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedByte ] ) .
atab:RangeDatatypeShape a sh:NodeShape ; rdfs:label "Range datatype shape" ;
    rdfs:isDefinedBy <https://hexplain.io/ns/aspect/tabular> ;
    sh:targetSubjectsOf atab:fieldDataType ,
        atab:fieldName ,
        atab:rowCount ;
    sh:property [ sh:path atab:fieldDataType ; sh:datatype xsd:string ;
        sh:message "atab:fieldDataType takes an xsd:string literal (rdfs:range xsd:string)." ] ;
    sh:property [ sh:path atab:fieldName ; sh:datatype xsd:string ;
        sh:message "atab:fieldName takes an xsd:string literal (rdfs:range xsd:string)." ] ;
    sh:property [ sh:path atab:rowCount ; sh:node atab:IntegerValueShape ; sh:minInclusive 0 ; sh:maxInclusive 18446744073709551615 ;
        sh:message "atab:rowCount takes an integer within the xsd:unsignedLong value space (rdfs:range xsd:unsignedLong)." ] .

# BEGIN GENERATED TERM DOCUMENTATION
# Editorial annotations only; OWL axioms and SHACL constraints above are unchanged.
@prefix atab: <https://hexplain.io/ns/aspect/tabular#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://hexplain.io/ns/aspect/tabular> skos:scopeNote "Use for tabular records and typed column declarations. Source datatype names require interpretation by the relevant format/profile."@en .
atab:IntegerValueShape skos:definition "Applied through references from other shapes. A conforming value is an integer (of any XSD integer datatype)."@en .
atab:RangeDatatypeShape skos:definition "Applies to subjects using atab:fieldDataType, atab:fieldName, atab:rowCount. atab:fieldDataType takes an xsd:string literal (rdfs:range xsd:string). atab:fieldName takes an xsd:string literal (rdfs:range xsd:string). atab:rowCount takes an integer within the xsd:unsignedLong value space (rdfs:range xsd:unsignedLong)."@en .
atab:fieldDataType skos:definition "The source's textual datatype designation for a column; a format profile defines how this name is interpreted."@en .
atab:fieldName skos:definition "The source-level name identifying a column within its table schema."@en .
atab:hasField skos:definition "A typed column declaration belonging to the table's schema."@en .
atab:rowCount skos:definition "The declared number of records in a tabular resource, including zero for an empty table."@en .
