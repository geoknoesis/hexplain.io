# Hexplain Aspect — Encoding (hx-encoding) 1.1
# Orthogonal aspect: how content is coded/compressed/encrypted for storage or transport.
# Imports nothing; imported by any domain whose content is encoded (audio, video, image, archive).
@prefix :       <https://hexplain.io/ns/aspect/encoding#> .
@prefix aenc:   <https://hexplain.io/ns/aspect/encoding#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix ma:     <http://www.w3.org/ns/ma-ont#> .
@prefix qudt:   <http://qudt.org/schema/qudt/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix unit:   <http://qudt.org/vocab/unit/> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<https://hexplain.io/ns/aspect/encoding> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/aspect/encoding/1.1> ; owl:versionInfo "1.1" ;
    owl:priorVersion <https://hexplain.io/ns/aspect/encoding/1.0> ;
    dcterms:modified "2026-09-23"^^xsd:date ;
    rdfs:label "Hexplain Aspect — Encoding (hx-encoding)" ;
    rdfs:comment "Orthogonal aspect for how content is coded, compressed, or encrypted (codec, bitrate; compression and encryption to follow). Controlled values (codec, compression) come from an external register bound by the profile, not from a scheme hosted in this aspect. Imported by any domain whose content is encoded." ;
    dcterms:created "2026-07-22"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "aenc" ; vann:preferredNamespaceUri "https://hexplain.io/ns/aspect/encoding#" .

# ---------- Properties ----------
:codec a owl:ObjectProperty ; rdfs:label "codec" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/encoding> ; rdfs:seeAlso ma:hasFormat ; rdfs:range skos:Concept ; rdfs:comment "Codec, drawn from the codec register bound by the profile." .
:bitrate a owl:DatatypeProperty ; rdfs:label "bitrate" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/encoding> ; rdfs:seeAlso ma:averageBitRate ; rdfs:range xsd:positiveInteger ; qudt:hasQuantityKind quantitykind:DataRate ; qudt:hasUnit unit:BIT-PER-SEC ; rdfs:comment "Average bitrate of the encoded stream, in bits per second." .
:compression a owl:ObjectProperty ; rdfs:label "compression" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/encoding> ; rdfs:range skos:Concept ; rdfs:comment "Lossless compression method, from the compression register bound by the profile." .

# ---------- Range datatype shapes ----------
# Each XSD rdfs:range above, enforced wherever the property is used: activation is by
# subjects-of, so an untyped subject is checked too (tools/test_range_datatypes.py).
# Integer ranges accept any XSD integer-family datatype within the range's bounds.
aenc:IntegerValueShape a sh:NodeShape ; rdfs:label "Integer value shape" ;
    rdfs:isDefinedBy <https://hexplain.io/ns/aspect/encoding> ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:short ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedByte ] ) .
aenc:RangeDatatypeShape a sh:NodeShape ; rdfs:label "Range datatype shape" ;
    rdfs:isDefinedBy <https://hexplain.io/ns/aspect/encoding> ;
    sh:targetSubjectsOf aenc:bitrate ;
    sh:property [ sh:path aenc:bitrate ; sh:node aenc:IntegerValueShape ; sh:minInclusive 1 ;
        sh:message "aenc:bitrate takes a positive integer (rdfs:range xsd:positiveInteger)." ] .

