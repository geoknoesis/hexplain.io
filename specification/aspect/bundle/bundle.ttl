# Hexplain Aspect — Bundle (hx-bundle) 1.5
# Base container-tier aspect: one logical Asset realized by N physical Parts, bound by
# containment / naming-convention / manifest-reference / concatenation. Imports BDDO
# (a part is described by a bddo:Struct).
# Unified semantics: each Part carries an aspect facet; a SHACL rule lifts those facets
# onto the Asset (see LiftByCarriedAspectRule, added with the profile layer).
@prefix :        <https://hexplain.io/ns/aspect/bundle#> .
@prefix abnd:    <https://hexplain.io/ns/aspect/bundle#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .

<https://hexplain.io/ns/aspect/bundle> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/aspect/bundle/1.5> ; owl:versionInfo "1.5" ;
    owl:priorVersion <https://hexplain.io/ns/aspect/bundle/1.4> ;
    dcterms:modified "2026-09-27"^^xsd:date ;
    owl:imports <https://hexplain.io/ns/bddo> ;
    rdfs:label "Hexplain Aspect — Bundle (hx-bundle)"@en ;
    rdfs:comment "Base aspect for multi-part assets: one logical Asset realized by N physical Parts, bound by containment, naming-convention, manifest-reference, or concatenation. Part aspect facets lift onto the Asset for a unified semantic view."@en ;
    dcterms:created "2026-07-26"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "abnd" ; vann:preferredNamespaceUri "https://hexplain.io/ns/aspect/bundle#" .

# ---------- Classes ----------
:Asset a owl:Class ; rdfs:label "Asset"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    rdfs:seeAlso dcat:Dataset ;
    rdfs:comment "A logical resource realized by one or more physical Parts. The single unified semantic subject."@en .
:Part a owl:Class ; rdfs:label "Part"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    rdfs:comment "One physical carrier (a byte stream / file) contributing to an Asset. Composes with hx-fsmeta and BDDO at instance level."@en .
:BindingKind a owl:Class ; rdfs:label "Binding Kind"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    rdfs:comment "The mechanism binding an Asset's Parts. Closed enumeration."@en .
:BundleProfile a owl:Class ; rdfs:label "Bundle Profile"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    rdfs:comment "A reusable format template: its binding kind plus the set of expected member PartSpecs."@en .
:PartSpec a owl:Class ; rdfs:label "Part Spec"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    rdfs:comment "One expected member of a BundleProfile: role, extension, requiredness, and the aspect it carries."@en .

# ---------- Instance-level properties ----------
# A part is included, logically or physically, in its asset: exactly dcterms:hasPart and
# dcterms:isPartOf, which state no domain or range, so the subproperties entail nothing false.
:hasPart a owl:ObjectProperty ; rdfs:label "has part"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    rdfs:range :Part ; owl:inverseOf :partOf ; rdfs:subPropertyOf dcterms:hasPart .
:partOf a owl:ObjectProperty ; rdfs:label "part of"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    rdfs:range :Asset ; rdfs:subPropertyOf dcterms:isPartOf .
:primaryPart a owl:ObjectProperty ; rdfs:label "primary part"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    rdfs:subPropertyOf :hasPart ; rdfs:range :Part ;
    rdfs:comment "The recognition anchor / manifest part (e.g. .shp, .gltf, .mpd)."@en .
:partRole a owl:ObjectProperty ; rdfs:label "part role"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    rdfs:range skos:Concept ; rdfs:comment "The role a Part or PartSpec plays, from a part-role register bound by the profile."@en .
:boundBy a owl:ObjectProperty ; rdfs:label "bound by"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    rdfs:range :BindingKind .
:partIndex a owl:DatatypeProperty ; rdfs:label "part index"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    rdfs:range xsd:nonNegativeInteger ; rdfs:comment "Ordinal of a Part within a segmented/concatenated Asset."@en .
:stem a owl:DatatypeProperty ; rdfs:label "stem"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    rdfs:range xsd:string ; rdfs:comment "Shared basename of a naming-convention bundle (e.g. \"roads\")."@en .

# ---------- Profile-level properties ----------
:partSpec a owl:ObjectProperty ; rdfs:label "part spec"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    rdfs:range :PartSpec .
:carriesAspect a owl:ObjectProperty ; rdfs:label "carries aspect"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    rdfs:range owl:Ontology ;
    rdfs:comment "The aspect ontology whose properties this part contributes. Drives facet lifting. An annotation-style link, NOT an owl:import — orthogonality is preserved."@en .
:describedBy a owl:ObjectProperty ; rdfs:label "described by"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    rdfs:range <https://hexplain.io/ns/bddo#Struct> ;
    rdfs:comment "The BDDO byte-layout struct describing this part's bytes (optional). The struct's local name also NAMES the part for cross-part references: HEL's `asset` root resolves `asset.<StructLocalName>.<field>` through this property, so a sidecar described by a struct named Header is reached as asset.Header. Two PartSpecs of one BundleProfile therefore MUST NOT be describedBy structs sharing a local name."@en .

# ---------- Cross-part references ----------
# A part's description may name a field of ANOTHER part of the same asset. This is not an
# edge case: it is the defining shape of every raw-grid-plus-sidecar raster (ENVI, EHdr,
# GenBin, PAux, MFF, ISCE, ROI_PAC, RRASTER, SAGA, SNODAS, ...), where the grid's extents,
# sample type and byte order all live in the header file and the payload file carries
# nothing but bytes.
#
# Such a reference is written with HEL's `asset` root, e.g. "asset.Header.byteOrder == 0".
# A `...FromField` object property (bddo:sizeFromField, dlv:dimensionSizeFromField, ...)
# is NOT a cross-part reference: the Processing Model resolves it within the part being
# parsed, as in a single file. To size by another part's field, bring the value into the
# part's own scope with a derived field (bddo:valueFromExpression "asset.Header.nrows") and
# name that field -- the pattern the HDL conditional-layout example uses.
#
# Identity versus content. The two are available at different times, and conflating them makes
# a legal description look circular. A part's CONTENT -- what asset.X.field reads -- exists only
# once part X has been parsed. A part's IDENTITY, its name and so its extension, is fixed when
# the asset is ASSEMBLED, before any part is parsed. HEL's partExtension() asks about identity,
# so it is resolvable from the start and, unlike a content reference, a part may ask it about
# ITSELF without any ordering problem. That self-reference is the ordinary case: a PartSpec
# listing several abnd:extension values lists them as ALTERNATIVES, and which one matched can
# decide how that same part is read -- an ESRI .hdr-labelled grid is uint32 at NBITS 32 but
# float32 when the file is .flt, and only the filename distinguishes them.
#
# Resolution. `asset.X` is resolved against the enclosing abnd:Asset, by locating the part whose
# abnd:PartSpec is abnd:describedBy the struct whose local name is X. A description
# carrying a cross-part reference is therefore only meaningful when parsed as part of an
# asset; parsing such a part standalone MUST raise an error rather than yield Null, since a
# silently absent extent would produce a plausible but wrong grid.
#
# Ordering. A CONTENT reference's target part MUST be parsed before the referring one. A
# processor SHOULD derive that order from the references themselves; abnd:primary does not
# imply it, and in the sidecar case the primary part is the payload, which is the DEPENDENT
# one. Identity references impose no order, per the paragraph above, so they must not be
# counted when deriving it -- treating one as a dependency would report a false cycle for the
# ordinary case of a part conditioning on its own extension.
#
# Requiredness. A cross-part reference SHOULD name a part whose PartSpec is abnd:required
# true. Depending on an optional part means the referring description cannot be resolved
# when that part is absent, which is a defect in the profile rather than in the data.
:required a owl:DatatypeProperty ; rdfs:label "required"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    rdfs:range xsd:boolean .
:extension a owl:DatatypeProperty ; rdfs:label "extension"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    rdfs:range xsd:string ; rdfs:comment "Filename extension identifying this member (e.g. \".dbf\"). MULTIPLE values are alternatives, not a requirement for several files: the part is whichever ONE of them is present. Some formats name a single member by its content rather than a fixed suffix -- an ESRI .hdr labelled raster carries its grid in .bil, .bip or .bsq according to the LAYOUT keyword, and .flt when floating point -- so one PartSpec with several extensions describes one part, not three. A profile that genuinely expects several files declares several PartSpecs."@en .
# ---------- Locating a part beyond a flat sibling file ----------
# abnd:extension names a part by suffix, which assumes every member is a sibling of the
# others sharing one stem. That covers the two-file sidecar cases and nothing else. A
# directory-structured asset -- Sentinel-1/2 SAFE, a GRASS mapset, a Zarr store, an Esri
# compact cache -- puts its members at known PATHS, often several matching one description,
# and the flat model cannot say so at all.
:pathPattern a owl:DatatypeProperty ; rdfs:label "path pattern"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    rdfs:range xsd:string ;
    rdfs:comment "A glob matching this member's path relative to the asset root, e.g. \"measurement/*.tiff\". `*` matches within one path segment, `**` across segments, `?` one character. As with abnd:extension, MULTIPLE values are ALTERNATIVES. Mutually exclusive with abnd:extension, which is the flat-sibling shorthand for the pattern \"*<ext>\"."@en .
:minParts a owl:DatatypeProperty ; rdfs:label "minimum parts"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Fewest files that must match this spec. Defaults to 1 when abnd:required is true and 0 otherwise, so the boolean remains sufficient for a single-file member; declare a count only when a spec matches MANY files, which a pattern makes possible and an extension never did."@en .
:maxParts a owl:DatatypeProperty ; rdfs:label "maximum parts"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Most files that may match this spec. Absent means unbounded -- the normal case for a pattern like \"measurement/*.tiff\", where the count is a property of the data rather than of the format."@en .
:nestedProfile a owl:ObjectProperty ; rdfs:label "nested profile"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    rdfs:range :BundleProfile ;
    rdfs:comment "For a member that is itself a structured directory: the BundleProfile its contents conform to, rooted at that member. Lets a profile compose rather than flatten -- a SAFE product describes its annotation directory once instead of enumerating every file in it."@en .

:primary a owl:DatatypeProperty ; rdfs:label "primary"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    rdfs:range xsd:boolean ; rdfs:comment "Marks the PartSpec whose instance is the Asset's primaryPart."@en .
:liftsProperty a owl:ObjectProperty ; rdfs:label "lifts property"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    rdfs:range <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> ;
    rdfs:comment "A property of the part's carried aspect that the lifting rule copies from this part onto the asset. When a PartSpec states any, exactly those are lifted. When it states none, the rule falls back to every property whose rdfs:isDefinedBy is the carried aspect ontology -- a documentation annotation, which is why an explicit list is RECOMMENDED: it keeps lifting independent of how the aspect's terms happen to be annotated and of which annotation files are loaded."@en .

# ---------- Binding-kind enumeration (NamedIndividual + sh:in) ----------
:Containment a owl:NamedIndividual, :BindingKind ; rdfs:label "Containment"@en ;
    rdfs:comment "Parts are physically nested inside one byte stream (ZIP, TAR)."@en .
:NamingConvention a owl:NamedIndividual, :BindingKind ; rdfs:label "Naming Convention"@en ;
    rdfs:comment "Sibling files sharing a stem, one role per extension (Shapefile, ENVI)."@en .
:ManifestReference a owl:NamedIndividual, :BindingKind ; rdfs:label "Manifest Reference"@en ;
    rdfs:comment "A primary part references members by path/URI (glTF, DASH, HLS, VRT)."@en .
:Concatenation a owl:NamedIndividual, :BindingKind ; rdfs:label "Concatenation"@en ;
    rdfs:comment "Parts are ordered fragments of one logical byte stream (multi-volume archives)."@en .

# ---------- Structural SHACL ----------
:AssetShape a sh:NodeShape ; sh:targetClass :Asset ;
    # Not abnd:hasPart: it is also used outside assets (see the competency corpus).
    sh:targetSubjectsOf :primaryPart , :boundBy ;
    sh:property [ sh:path :hasPart ; sh:class :Part ] ;
    sh:property [ sh:path :boundBy ; sh:maxCount 1 ;
        sh:in ( :Containment :NamingConvention :ManifestReference :Concatenation ) ;
        sh:message "abnd:boundBy must be one of the four BindingKind individuals." ] ;
    sh:property [ sh:path :primaryPart ; sh:maxCount 1 ; sh:class :Part ;
        sh:message "An Asset has at most one primaryPart." ] .
:PartShape a sh:NodeShape ; sh:targetClass :Part ;
    sh:targetObjectsOf :primaryPart ;
    sh:property [ sh:path :partRole ; sh:class skos:Concept ;
        sh:message "abnd:partRole must be a skos:Concept." ] .

# ---------- Facet lifting (SHACL-AF rule) ----------
# For each Asset, lift the properties its parts carry that are defined by the aspect the
# profile's matching PartSpec declares via carriesAspect. Full IRIs so it runs identically
# under pyshacl and standalone rdflib. Requires the referenced aspect ontologies in the graph.
:LiftByCarriedAspectRule a sh:NodeShape ; sh:targetClass :Asset ;
    sh:rule [ a sh:SPARQLRule ;
        rdfs:label "Lift part facets onto the Asset"@en ;
        sh:construct """
CONSTRUCT { $this ?p ?v }
WHERE {
  $this <https://hexplain.io/ns/aspect/bundle#hasPart> ?part .
  ?part <https://hexplain.io/ns/aspect/bundle#partRole> ?role ; ?p ?v .
  $this <http://purl.org/dc/terms/conformsTo> ?profile .
  ?profile <https://hexplain.io/ns/aspect/bundle#partSpec> ?spec .
  ?spec <https://hexplain.io/ns/aspect/bundle#partRole> ?role ;
        <https://hexplain.io/ns/aspect/bundle#carriesAspect> ?aspect .
  {
    ?spec <https://hexplain.io/ns/aspect/bundle#liftsProperty> ?p .
  } UNION {
    FILTER NOT EXISTS { ?spec <https://hexplain.io/ns/aspect/bundle#liftsProperty> ?any }
    ?p <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> ?aspect .
  }
}
""" ] .

# ---------- Profile conformance (required parts present) ----------
:RequiredPartsShape a sh:NodeShape ; sh:targetClass :Asset ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "A required part role declared by the conformed profile is missing." ;
        sh:select """
SELECT $this ?role
WHERE {
  $this <http://purl.org/dc/terms/conformsTo> ?profile .
  ?profile <https://hexplain.io/ns/aspect/bundle#partSpec> ?spec .
  ?spec <https://hexplain.io/ns/aspect/bundle#required> true ;
        <https://hexplain.io/ns/aspect/bundle#partRole> ?role .
  FILTER NOT EXISTS {
    $this (<https://hexplain.io/ns/aspect/bundle#hasPart>|<https://hexplain.io/ns/aspect/bundle#primaryPart>) ?p .
    ?p <https://hexplain.io/ns/aspect/bundle#partRole> ?role .
  }
}
""" ] .

abnd:_prefixes sh:declare
    [ sh:prefix "abnd" ; sh:namespace "https://hexplain.io/ns/aspect/bundle#"^^xsd:anyURI ] .

# A part is located one way or the other, and a count range must be satisfiable.
abnd:PartSpecShape a sh:NodeShape ;
    sh:targetClass abnd:PartSpec ;
    sh:targetObjectsOf abnd:partSpec ;
    sh:property [ sh:path abnd:pathPattern ; sh:datatype xsd:string ] ;
    sh:property [ sh:path abnd:minParts ; sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:short ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedByte ] ) ; sh:minInclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path abnd:maxParts ; sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:short ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedByte ] ) ; sh:minInclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path abnd:nestedProfile ; sh:class abnd:BundleProfile ; sh:maxCount 1 ] ;
    sh:not [ sh:and (
        [ sh:property [ sh:path abnd:extension ; sh:minCount 1 ] ]
        [ sh:property [ sh:path abnd:pathPattern ; sh:minCount 1 ] ] ) ] ;
    # Native rather than sh:sparql: sh:lessThanOrEquals says exactly this, and unlike a SPARQL
    # constraint it reports the offending path and value, so a finding points at abnd:minParts
    # instead of only at the spec that carries it.
    sh:property [ sh:path abnd:minParts ; sh:lessThanOrEquals abnd:maxParts ;
        sh:message "abnd:maxParts must not be less than abnd:minParts." ] ;
    # Located one way: a spec with neither an extension nor a pattern matches no file.
    sh:or ( [ sh:property [ sh:path abnd:extension ; sh:minCount 1 ] ]
            [ sh:property [ sh:path abnd:pathPattern ; sh:minCount 1 ] ] ) ;
    sh:message "A part spec is located by abnd:extension or abnd:pathPattern; with neither it matches no file." ;
    # Whole-string rules. An extension is a dot and one or more dot-separated steps, none empty
    # and none holding a path separator or a drive colon. A pattern is one or more '/'-separated
    # segments relative to the asset root: no empty segment (so no leading '/', trailing '/' or
    # '//'), no '.' or '..' segment, no backslash and no drive letter or other colon.
    sh:property [ sh:path abnd:extension ; sh:pattern "^[.][^/\\\\:.]+([.][^/\\\\:.]+)*$" ;
        sh:message "An abnd:extension is a dot followed by one or more non-empty, dot-separated steps (\".dbf\", \".tar.gz\") with no '/', '\\' or ':'; without the dot it would also match a longer suffix such as roads_dbf." ] ;
    sh:property [ sh:path abnd:pathPattern ; sh:pattern "^([^/\\\\:.][^/\\\\:]*|[.][^/\\\\:.][^/\\\\:]*|[.][.][^/\\\\:]+)(/([^/\\\\:.][^/\\\\:]*|[.][^/\\\\:.][^/\\\\:]*|[.][.][^/\\\\:]+))*$" ;
        sh:message "An abnd:pathPattern is a relative path inside the asset root: '/'-separated, non-empty segments, none '.' or '..', with no backslash, no drive letter or other ':', and no leading '/'." ] ;
    sh:property [ sh:path abnd:partRole ; sh:nodeKind sh:IRI ; sh:class skos:Concept ;
        sh:message "abnd:partRole names a skos:Concept of the bound part-role register." ] ;
    sh:property [ sh:path abnd:liftsProperty ; sh:nodeKind sh:IRI ;
        sh:message "abnd:liftsProperty names a property by IRI." ] ;
    sh:sparql [ sh:message "A required part spec must not declare abnd:minParts 0 or abnd:maxParts 0 -- the two contradict." ;
        sh:prefixes abnd:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this abnd:required true .
            { $this abnd:minParts 0 } UNION { $this abnd:maxParts 0 }
        }""" ] ;
    sh:sparql [ sh:message "abnd:nestedProfile {?nested} leads back to the profile that holds this part spec; a profile cannot nest itself." ;
        sh:prefixes abnd:_prefixes ;
        sh:select """SELECT $this ?nested WHERE {
            $this abnd:nestedProfile ?nested .
            ?nested (abnd:partSpec/abnd:nestedProfile)* ?reached .
            ?reached abnd:partSpec $this .
        }""" ] .

# A profile names at most one primary member, and names its described parts unambiguously:
# HEL's asset.<Name> resolves a part by the local name of the struct its spec is describedBy.
abnd:BundleProfileShape a sh:NodeShape ;
    rdfs:label "Bundle profile shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    rdfs:comment "A bundle profile has at most one primary part spec, and no two of its part specs are described by structs sharing a local name."@en ;
    sh:targetClass abnd:BundleProfile ;
    sh:targetSubjectsOf abnd:partSpec ;
    sh:property [ sh:path abnd:partSpec ; sh:class abnd:PartSpec ;
        sh:message "Every abnd:partSpec of a profile is an abnd:PartSpec." ] ;
    sh:sparql [ sh:message "More than one part spec of this profile is abnd:primary true ({?a}, {?b}); an asset has one primary part." ;
        sh:prefixes abnd:_prefixes ;
        sh:select """SELECT $this ?a ?b WHERE {
            $this abnd:partSpec ?a , ?b .
            ?a abnd:primary true . ?b abnd:primary true .
            FILTER(STR(?a) < STR(?b))
        }""" ] ;
    sh:sparql [ sh:message "Part specs {?a} and {?b} are described by structs with the same local name '{?name}', so asset.{?name} would not name one part." ;
        sh:prefixes abnd:_prefixes ;
        sh:select """SELECT $this ?a ?b ?name WHERE {
            $this abnd:partSpec ?a , ?b .
            ?a abnd:describedBy ?sa . ?b abnd:describedBy ?sb .
            FILTER(!sameTerm(?a, ?b) && STR(?a) < STR(?b))
            BIND(REPLACE(STR(?sa), "^.*[#/]", "") AS ?name)
            FILTER(?name = REPLACE(STR(?sb), "^.*[#/]", ""))
        }""" ] .

# ---------- Range datatype shapes ----------
# Each XSD rdfs:range above, enforced wherever the property is used: activation is by
# subjects-of, so an untyped subject is checked too (tools/test_range_datatypes.py).
# Integer ranges accept any XSD integer-family datatype within the range's bounds.
abnd:IntegerValueShape a sh:NodeShape ; rdfs:label "Integer value shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:short ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedByte ] ) .
abnd:RangeDatatypeShape a sh:NodeShape ; rdfs:label "Range datatype shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    sh:targetSubjectsOf abnd:extension ,
        abnd:maxParts ,
        abnd:minParts ,
        abnd:partIndex ,
        abnd:pathPattern ,
        abnd:primary ,
        abnd:required ,
        abnd:stem ;
    sh:property [ sh:path abnd:extension ; sh:datatype xsd:string ;
        sh:message "abnd:extension takes an xsd:string literal (rdfs:range xsd:string)." ] ;
    sh:property [ sh:path abnd:maxParts ; sh:node abnd:IntegerValueShape ; sh:minInclusive 0 ;
        sh:message "abnd:maxParts takes a non-negative integer (rdfs:range xsd:nonNegativeInteger)." ] ;
    sh:property [ sh:path abnd:minParts ; sh:node abnd:IntegerValueShape ; sh:minInclusive 0 ;
        sh:message "abnd:minParts takes a non-negative integer (rdfs:range xsd:nonNegativeInteger)." ] ;
    sh:property [ sh:path abnd:partIndex ; sh:node abnd:IntegerValueShape ; sh:minInclusive 0 ;
        sh:message "abnd:partIndex takes a non-negative integer (rdfs:range xsd:nonNegativeInteger)." ] ;
    sh:property [ sh:path abnd:pathPattern ; sh:datatype xsd:string ;
        sh:message "abnd:pathPattern takes an xsd:string literal (rdfs:range xsd:string)." ] ;
    sh:property [ sh:path abnd:primary ; sh:datatype xsd:boolean ;
        sh:message "abnd:primary takes an xsd:boolean literal (rdfs:range xsd:boolean)." ] ;
    sh:property [ sh:path abnd:required ; sh:datatype xsd:boolean ;
        sh:message "abnd:required takes an xsd:boolean literal (rdfs:range xsd:boolean)." ] ;
    sh:property [ sh:path abnd:stem ; sh:datatype xsd:string ;
        sh:message "abnd:stem takes an xsd:string literal (rdfs:range xsd:string)." ] .

# BEGIN GENERATED TERM DOCUMENTATION
# Editorial annotations only; OWL axioms and SHACL constraints above are unchanged.
@prefix abnd: <https://hexplain.io/ns/aspect/bundle#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://hexplain.io/ns/aspect/bundle> skos:scopeNote "Import to describe an asset made of several files, or of several members of one container, and the reusable profiles that say which members such an asset has. It says nothing about the members' bytes: those are bddo descriptions named by abnd:describedBy."@en .
abnd:Asset skos:scopeNote "Assert on the IRI of one logical asset a Bundle Processor assembled from its parts; it is linked to its profile by dcterms:conformsTo and carries the facets lifted from its parts."@en .
abnd:AssetShape rdfs:label "Asset Shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    skos:definition "Applies to instances of abnd:Asset; subjects using abnd:boundBy, abnd:primaryPart. abnd:boundBy must be one of the four BindingKind individuals. Each value of abnd:hasPart is an instance of abnd:Part. An Asset has at most one primaryPart."@en .
abnd:BindingKind skos:scopeNote "The class of the four controlled values of abnd:boundBy; do not mint further kinds."@en .
abnd:BundleProfile skos:scopeNote "Assert on a reusable description of a multi-part format: its abnd:partSpec members and, optionally, its abnd:boundBy kind."@en .
abnd:Concatenation rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    skos:scopeNote "Use as the abnd:boundBy of an asset whose parts are consecutive fragments of one byte stream, ordered by abnd:partIndex."@en .
abnd:Containment rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    skos:scopeNote "Use as the abnd:boundBy of an asset whose parts are members of one container stream (a ZIP or TAR archive)."@en .
abnd:IntegerValueShape skos:definition "Applied through references from other shapes. A conforming value is an integer (of any XSD integer datatype)."@en .
abnd:LiftByCarriedAspectRule rdfs:label "Lift By Carried Aspect Rule"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    skos:definition "A SHACL rule-bearing shape that derives additional triples for its selected focus nodes. Its rule is an inference operation, not a validation constraint; see the executable rule and activation scope below."@en .
abnd:ManifestReference rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    skos:scopeNote "Use as the abnd:boundBy of an asset whose primary part names its other members by path or IRI."@en .
abnd:NamingConvention rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    skos:scopeNote "Use as the abnd:boundBy of an asset whose members are sibling files sharing a stem, one role per extension."@en .
abnd:Part skos:scopeNote "Assert on each part root a Bundle Processor lifts; it carries its spec's abnd:partRole and the facet properties parsed from the part."@en .
abnd:PartShape rdfs:label "Part Shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    skos:definition "Applies to instances of abnd:Part; objects of abnd:primaryPart. abnd:partRole must be a skos:Concept."@en .
abnd:PartSpec skos:scopeNote "Assert on each object of abnd:partSpec: one expected member, located by abnd:extension or abnd:pathPattern, with a role and optionally its struct, count bounds and carried aspect."@en .
abnd:PartSpecShape rdfs:label "Part Spec Shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    skos:definition "Applies to instances of abnd:PartSpec; objects of abnd:partSpec. A part spec is located by abnd:extension or abnd:pathPattern; with neither it matches no file. An abnd:extension is a dot followed by one or more non-empty, dot-separated steps (\".dbf\", \".tar.gz\") with no '/', '\\' or ':'; without the dot it would also match a longer suffix such as roads_dbf. abnd:liftsProperty names a property by IRI. abnd:maxParts takes at most one value; each is an integer (of any XSD integer datatype) at least 0. abnd:minParts takes at most one value; each is an integer (of any XSD integer datatype) at least 0. abnd:maxParts must not be less than abnd:minParts. abnd:nestedProfile takes at most one value; each is an instance of abnd:BundleProfile. abnd:partRole names a skos:Concept of the bound part-role register. Each value of abnd:pathPattern is an xsd:string literal. An abnd:pathPattern is a relative path inside the asset root: '/'-separated, non-empty segments, none '.' or '..', with no backslash, no drive letter or other ':', and no leading '/'. A required part spec must not declare abnd:minParts 0 or abnd:maxParts 0 -- the two contradict."@en .
abnd:RangeDatatypeShape skos:definition "Applies to subjects using abnd:extension, abnd:maxParts, abnd:minParts, abnd:partIndex, abnd:pathPattern, abnd:primary, abnd:required, abnd:stem. abnd:extension takes an xsd:string literal (rdfs:range xsd:string). abnd:maxParts takes a non-negative integer (rdfs:range xsd:nonNegativeInteger). abnd:minParts takes a non-negative integer (rdfs:range xsd:nonNegativeInteger). abnd:partIndex takes a non-negative integer (rdfs:range xsd:nonNegativeInteger). abnd:pathPattern takes an xsd:string literal (rdfs:range xsd:string). abnd:primary takes an xsd:boolean literal (rdfs:range xsd:boolean). abnd:required takes an xsd:boolean literal (rdfs:range xsd:boolean). abnd:stem takes an xsd:string literal (rdfs:range xsd:string)."@en .
abnd:RequiredPartsShape rdfs:label "Required Parts Shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    skos:definition "Applies to instances of abnd:Asset. A required part role declared by the conformed profile is missing."@en .
abnd:_prefixes rdfs:label "prefixes"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/aspect/bundle> ;
    skos:definition "Namespace prefix declarations reused by SHACL SPARQL constraints and rules. This is validation infrastructure, not a property of parsed data."@en .
abnd:boundBy skos:definition "The binding convention used to associate a member with its asset, selected from the declared BindingKind individuals."@en ;
    skos:scopeNote "Use at most once on an abnd:Asset or abnd:BundleProfile, with one of the four abnd:BindingKind values."@en .
abnd:carriesAspect skos:scopeNote "Use on an abnd:PartSpec to name the aspect ontology whose properties the part contributes to the asset. It is not an owl:imports."@en .
abnd:describedBy skos:scopeNote "Use at most once on an abnd:PartSpec, naming the bddo:Struct that parses the member. The struct's local name is the part's name in HEL (asset.Name), so no two specs of one profile may use structs with the same local name."@en .
abnd:extension skos:scopeNote "Use on an abnd:PartSpec to locate a member at the asset root by its file-name ending, a dot and one or more steps (\".dbf\", \".tar.gz\"). Several values are alternatives. Do not combine with abnd:pathPattern."@en .
abnd:hasPart skos:definition "A member resource belonging to a compound asset; the relation represents logical membership, not a byte offset."@en ;
    skos:scopeNote "Use on an abnd:Asset, once per part root it was assembled from."@en .
abnd:liftsProperty skos:scopeNote "Use on an abnd:PartSpec, once per property of the carried aspect the asset receives from the part, by IRI. Listing the properties is recommended: without a list, every property the aspect defines is lifted."@en .
abnd:maxParts skos:scopeNote "Use at most once on an abnd:PartSpec when a member may match more than one file; absent means one for an extension and unbounded for a pattern. Never 0 on a required spec."@en .
abnd:minParts skos:scopeNote "Use at most once on an abnd:PartSpec that matches several files; absent means 1 when abnd:required is true and 0 otherwise. Never 0 on a required spec."@en .
abnd:nestedProfile skos:scopeNote "Use at most once on an abnd:PartSpec whose member is a directory with a structure of its own, naming the abnd:BundleProfile of that directory. A profile may not nest itself, directly or through other profiles."@en .
abnd:partIndex skos:scopeNote "Use at most once on an abnd:Part of a concatenated asset, giving its zero-based position in the byte stream."@en .
abnd:partOf skos:definition "The asset of which a part is a logical member."@en ;
    skos:scopeNote "Use on an abnd:Part to name its asset where the data states it; a Bundle Processor does not infer it from abnd:hasPart."@en .
abnd:partRole skos:scopeNote "Use exactly once on an abnd:PartSpec and on each abnd:Part it matched, naming a concept of the part-role register the profile binds."@en .
abnd:partSpec skos:definition "A part specification declared by a bundle profile, describing a role and its structural or discovery expectations."@en ;
    skos:scopeNote "Use on an abnd:BundleProfile, once per expected member."@en .
abnd:pathPattern skos:scopeNote "Use on an abnd:PartSpec to locate a member by its path relative to the asset root: '/'-separated segments, with * within a segment, ** across segments and ? for one character, never '.', '..', a backslash or a drive letter. Several values are alternatives. Do not combine with abnd:extension."@en .
abnd:primary skos:scopeNote "Use at most once on an abnd:PartSpec, true for the one member that anchors recognition of the asset; a profile has at most one primary spec."@en .
abnd:primaryPart skos:scopeNote "Use at most once on an abnd:Asset, naming the part root matched to the primary spec."@en .
abnd:required skos:definition "Whether the part described by a part specification is required by the bundle contract."@en ;
    skos:scopeNote "Use at most once on an abnd:PartSpec, true when an asset without that member is invalid."@en .
abnd:stem skos:scopeNote "Use at most once on an abnd:Asset bound by naming convention, giving the basename its members share."@en .
