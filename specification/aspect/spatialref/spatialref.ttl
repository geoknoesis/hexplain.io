# Hexplain Aspect — Spatial Reference (hx-spatialref) 1.0
# Reference-frame aspect: georeferencing / coordinate reference. Neither raster nor vector —
# shared by geo-raster and geo-vector alike. Imports nothing.
@prefix :        <https://hexplain.io/ns/aspect/spatialref#> .
@prefix asref:   <https://hexplain.io/ns/aspect/spatialref#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix geosparql: <http://www.opengis.net/ont/geosparql#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .

<https://hexplain.io/ns/aspect/spatialref> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/aspect/spatialref/1.1> ; owl:versionInfo "1.1 working draft" ; owl:priorVersion <https://hexplain.io/ns/aspect/spatialref/1.0> ; dcterms:modified "2026-09-05"^^xsd:date ;
    rdfs:label "Hexplain Aspect — Spatial Reference (hx-spatialref)" ;
    rdfs:comment "Aspect for georeferencing: coordinate reference systems, geotransforms, registration. Shared by geospatial raster and vector data." ;
    dcterms:created "2026-07-22"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "asref" ; vann:preferredNamespaceUri "https://hexplain.io/ns/aspect/spatialref#" .

:CoordinateReferenceSystem a owl:Class ; rdfs:label "Coordinate Reference System" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> .
:GeoTransform a owl:Class ; rdfs:label "GeoTransform" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ;
    rdfs:comment "The affine mapping from pixel/line to ground coordinates, carrying the six coefficients asref:originX, scaleX, skewX, originY, skewY, scaleY -- GDAL's GT[0..5] in that order. A north-up raster leaves both skews zero; only the skews make a rotated grid expressible." .

:wktString a owl:DatatypeProperty ; rdfs:label "WKT string" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:range xsd:string ; rdfs:comment "Coordinate reference system WKT, not WKT geometry. No equivalence to GeoSPARQL geometry serialization is asserted." .
:epsgCode a owl:DatatypeProperty ; rdfs:label "EPSG code" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:range xsd:positiveInteger .
:originLongitude a owl:DatatypeProperty ; rdfs:label "origin longitude" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:range xsd:double ;
    rdfs:comment "Origin easting expressed as a GEOGRAPHIC longitude. Use only when the CRS really is geographic; for an origin in projected units (metres, feet) use asref:originX, of which this is the geographic special case." .
:originLatitude a owl:DatatypeProperty ; rdfs:label "origin latitude" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:range xsd:double ;
    rdfs:comment "Origin northing expressed as a GEOGRAPHIC latitude. See asref:originLongitude; the general form is asref:originY." .
:originX a owl:DatatypeProperty ; rdfs:label "origin X" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:range xsd:double ;
    rdfs:comment "Easting of the grid origin in the units of the CRS, degrees or metres alike (affine coefficient GT[0]). The general form of asref:originLongitude, which presumes a geographic CRS and is therefore wrong for the projected rasters that make up most of the corpus." .
:originY a owl:DatatypeProperty ; rdfs:label "origin Y" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:range xsd:double ;
    rdfs:comment "Northing of the grid origin in the units of the CRS (affine coefficient GT[3]). The general form of asref:originLatitude." .
:scaleX a owl:DatatypeProperty ; rdfs:label "X scale" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:range xsd:double ;
    rdfs:comment "Ground distance per pixel along X (affine coefficient GT[1])." .
:scaleY a owl:DatatypeProperty ; rdfs:label "Y scale" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:range xsd:double ;
    rdfs:comment "Ground distance per pixel along Y (affine coefficient GT[5]). Conventionally NEGATIVE for a north-up raster, whose rows run southward while northings increase." .
:skewX a owl:DatatypeProperty ; rdfs:label "X skew" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:range xsd:double ;
    rdfs:comment "Rotation/shear term: ground X per pixel ROW (affine coefficient GT[2]). Zero for a north-up raster. Without this and asref:skewY a rotated or sheared grid cannot be georeferenced at all, only misplaced." .
:skewY a owl:DatatypeProperty ; rdfs:label "Y skew" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:range xsd:double ;
    rdfs:comment "Rotation/shear term: ground Y per pixel COLUMN (affine coefficient GT[4]). Zero for a north-up raster." .

# ---------- Ground footprint ----------
:footprintWKT a owl:DatatypeProperty ; rdfs:label "footprint WKT" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ;
    rdfs:seeAlso geosparql:asWKT ; rdfs:range xsd:string ;
    rdfs:comment "The ground area covered, as a WKT geometry in the resource's CRS -- typically a polygon of the four image corners. Formats that state corners directly rather than an affine (NITF's IGEOLO, the BLOCKA corner strings) have no scale or origin to give, so a footprint is the only georeference they carry." .

# ---------- Ground control points ----------
# The other way a format georeferences without an affine: an irregular scatter of
# pixel-to-ground correspondences, to be fitted or interpolated by the consumer.
:GroundControlPoint a owl:Class ; rdfs:label "Ground Control Point" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ;
    rdfs:comment "One correspondence between a pixel position and a ground position. A set of these georeferences an image that no single affine can, e.g. an unrectified swath." .
:hasGroundControlPoint a owl:ObjectProperty ; rdfs:label "has ground control point" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ;
    rdfs:range :GroundControlPoint .
:gcpPixelX a owl:DatatypeProperty ; rdfs:label "GCP pixel X" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:range xsd:double ;
    rdfs:comment "Column position of the control point in the image grid." .
:gcpPixelY a owl:DatatypeProperty ; rdfs:label "GCP pixel Y" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:range xsd:double ;
    rdfs:comment "Row position of the control point in the image grid." .
:gcpX a owl:DatatypeProperty ; rdfs:label "GCP ground X" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:range xsd:double .
:gcpY a owl:DatatypeProperty ; rdfs:label "GCP ground Y" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:range xsd:double .
:gcpZ a owl:DatatypeProperty ; rdfs:label "GCP ground Z" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:range xsd:double ;
    rdfs:comment "Ground elevation of the control point. Optional: many formats give 2-D control only." .
:gcpIdentifier a owl:DatatypeProperty ; rdfs:label "GCP identifier" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:range xsd:string .
:pixelRegistration a owl:ObjectProperty ; rdfs:label "pixel registration" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> .

:PixelCorner a owl:NamedIndividual ; rdfs:label "Pixel Corner Registration" .
:PixelCenter a owl:NamedIndividual ; rdfs:label "Pixel Center Registration" .

:hasCRS a owl:ObjectProperty ; rdfs:range :CoordinateReferenceSystem ; rdfs:label "has coordinate reference system" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:comment "CRS of the resource's ground coordinates. A CRS identifier is not itself a transformation or a geometry." .
:hasGeoTransform a owl:ObjectProperty ; rdfs:range :GeoTransform ; rdfs:label "has geotransform" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> .
:groundControlPointCRS a owl:ObjectProperty ; rdfs:range :CoordinateReferenceSystem ; rdfs:label "ground control point CRS" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:comment "CRS of the ground-control-point set, which may differ from the raster's affine CRS. No reprojection or precedence is implied." .
:coordinateEpoch a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "coordinate epoch" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:comment "Coordinate epoch in decimal years for coordinates in a dynamic reference frame; distinct from acquisition time and CRS reference epoch." .
:crsIdentifier a owl:ObjectProperty ; rdfs:label "CRS identifier" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:comment "Authoritative CRS IRI; supports authorities and compound or vertical systems without assuming a single numeric code scheme." .

# Validation is separate from OWL inference. No universal invertibility requirement:
# a singular affine may be represented, but an inverse request must fail explicitly.
:FiniteDoubleShape a sh:NodeShape ; sh:datatype xsd:double ; sh:minExclusive "-INF"^^xsd:double ; sh:maxExclusive "INF"^^xsd:double ; sh:not [ sh:pattern "^(nan|[+-]?inf)$" ; sh:flags "i" ] .
:CRSShape a sh:NodeShape ; sh:targetClass :CoordinateReferenceSystem ; sh:targetObjectsOf :hasCRS, :groundControlPointCRS ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [ sh:path :wktString ; sh:datatype xsd:string ; sh:minLength 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :crsIdentifier ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ;
    sh:property [ sh:path :coordinateEpoch ; sh:datatype xsd:decimal ; sh:maxCount 1 ] .

# ---------- SHACL ----------
asref:GeoTransformShape a sh:NodeShape ;
    sh:targetClass asref:GeoTransform ; sh:targetObjectsOf asref:hasGeoTransform ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [ sh:path asref:originX ; sh:node :FiniteDoubleShape ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path asref:originY ; sh:node :FiniteDoubleShape ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path asref:scaleX ; sh:node :FiniteDoubleShape ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path asref:scaleY ; sh:node :FiniteDoubleShape ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path asref:skewX ; sh:node :FiniteDoubleShape ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path asref:skewY ; sh:node :FiniteDoubleShape ; sh:minCount 1 ; sh:maxCount 1 ] .

# A control point is useless without both halves of the correspondence.
asref:GroundControlPointShape a sh:NodeShape ;
    sh:targetClass asref:GroundControlPoint ; sh:targetObjectsOf asref:hasGroundControlPoint ;
    sh:property [ sh:path asref:gcpPixelX ; sh:node :FiniteDoubleShape ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path asref:gcpPixelY ; sh:node :FiniteDoubleShape ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path asref:gcpX ; sh:node :FiniteDoubleShape ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path asref:gcpY ; sh:node :FiniteDoubleShape ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path asref:gcpZ ; sh:node :FiniteDoubleShape ; sh:maxCount 1 ] ;
    sh:property [ sh:path asref:gcpIdentifier ; sh:datatype xsd:string ; sh:maxCount 1 ] .

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

:CubicRationalTransform a owl:Class ; rdfs:label "Cubic rational transform" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:comment "A three-input, two-output rational polynomial geolocation model. Four coefficient vectors each have 20 values. polynomialBasis identifies the externally specified monomial order, normalization, input CRS, units and pixel convention. No basis or datum is inferred. Unsupported bases must be reported, not evaluated using a guessed order." .
:hasRationalTransform a owl:ObjectProperty ; rdfs:range :CubicRationalTransform ; rdfs:label "has rational transform" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> .
:polynomialBasis a owl:ObjectProperty ; rdfs:label "polynomial basis contract" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:comment "IRI of the complete published polynomial convention. A profile must define the ordered 20 monomials, normalized inputs, CRS/units and pixel reference. Different coefficient orderings are not interchangeable." .
:lineNumerator a owl:ObjectProperty ; rdfs:range rdf:List ; rdfs:label "line numerator coefficients" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:comment "Ordered vector of 20 finite coefficients; repeated coefficient values are allowed." .
:lineDenominator a owl:ObjectProperty ; rdfs:range rdf:List ; rdfs:label "line denominator coefficients" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:comment "Ordered vector of 20 finite coefficients; repeated coefficient values are allowed." .
:sampleNumerator a owl:ObjectProperty ; rdfs:range rdf:List ; rdfs:label "sample numerator coefficients" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:comment "Ordered vector of 20 finite coefficients; repeated coefficient values are allowed." .
:sampleDenominator a owl:ObjectProperty ; rdfs:range rdf:List ; rdfs:label "sample denominator coefficients" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:comment "Ordered vector of 20 finite coefficients; repeated coefficient values are allowed." .
:lineOffset a owl:DatatypeProperty ; rdfs:range xsd:double ; rdfs:label "line offset" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:comment "Normalization offset for the line coordinate, interpreted using polynomialBasis. Scales must be strictly positive." .
:lineScale a owl:DatatypeProperty ; rdfs:range xsd:double ; rdfs:label "line scale" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:comment "Normalization scale for the line coordinate, interpreted using polynomialBasis. Scales must be strictly positive." .
:sampleOffset a owl:DatatypeProperty ; rdfs:range xsd:double ; rdfs:label "sample offset" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:comment "Normalization offset for the sample coordinate, interpreted using polynomialBasis. Scales must be strictly positive." .
:sampleScale a owl:DatatypeProperty ; rdfs:range xsd:double ; rdfs:label "sample scale" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:comment "Normalization scale for the sample coordinate, interpreted using polynomialBasis. Scales must be strictly positive." .
:latitudeOffset a owl:DatatypeProperty ; rdfs:range xsd:double ; rdfs:label "latitude offset" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:comment "Normalization offset for the latitude coordinate, interpreted using polynomialBasis. Scales must be strictly positive." .
:latitudeScale a owl:DatatypeProperty ; rdfs:range xsd:double ; rdfs:label "latitude scale" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:comment "Normalization scale for the latitude coordinate, interpreted using polynomialBasis. Scales must be strictly positive." .
:longitudeOffset a owl:DatatypeProperty ; rdfs:range xsd:double ; rdfs:label "longitude offset" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:comment "Normalization offset for the longitude coordinate, interpreted using polynomialBasis. Scales must be strictly positive." .
:longitudeScale a owl:DatatypeProperty ; rdfs:range xsd:double ; rdfs:label "longitude scale" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:comment "Normalization scale for the longitude coordinate, interpreted using polynomialBasis. Scales must be strictly positive." .
:heightOffset a owl:DatatypeProperty ; rdfs:range xsd:double ; rdfs:label "height offset" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:comment "Normalization offset for the height coordinate, interpreted using polynomialBasis. Scales must be strictly positive." .
:heightScale a owl:DatatypeProperty ; rdfs:range xsd:double ; rdfs:label "height scale" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/spatialref> ; rdfs:comment "Normalization scale for the height coordinate, interpreted using polynomialBasis. Scales must be strictly positive." .

:CubicRationalTransformShape a sh:NodeShape ; sh:targetClass :CubicRationalTransform ; sh:targetObjectsOf :hasRationalTransform ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [ sh:path :polynomialBasis ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :lineOffset ; sh:node :FiniteDoubleShape ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :lineScale ; sh:node :FiniteDoubleShape ; sh:minCount 1 ; sh:maxCount 1 ; sh:minExclusive 0 ] ;
    sh:property [ sh:path :sampleOffset ; sh:node :FiniteDoubleShape ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :sampleScale ; sh:node :FiniteDoubleShape ; sh:minCount 1 ; sh:maxCount 1 ; sh:minExclusive 0 ] ;
    sh:property [ sh:path :latitudeOffset ; sh:node :FiniteDoubleShape ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :latitudeScale ; sh:node :FiniteDoubleShape ; sh:minCount 1 ; sh:maxCount 1 ; sh:minExclusive 0 ] ;
    sh:property [ sh:path :longitudeOffset ; sh:node :FiniteDoubleShape ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :longitudeScale ; sh:node :FiniteDoubleShape ; sh:minCount 1 ; sh:maxCount 1 ; sh:minExclusive 0 ] ;
    sh:property [ sh:path :heightOffset ; sh:node :FiniteDoubleShape ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :heightScale ; sh:node :FiniteDoubleShape ; sh:minCount 1 ; sh:maxCount 1 ; sh:minExclusive 0 ] ;
    sh:property [ sh:path :lineNumerator ; sh:node :CoefficientVectorShape ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :lineDenominator ; sh:node :CoefficientVectorShape ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :sampleNumerator ; sh:node :CoefficientVectorShape ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :sampleDenominator ; sh:node :CoefficientVectorShape ; sh:minCount 1 ; sh:maxCount 1 ] .

:CoefficientVectorShape a sh:NodeShape ; sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [ sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ; sh:node :FiniteDoubleShape ] ;
    sh:sparql [ sh:message "A coefficient vector must be a well-formed finite RDF list of exactly 20 cells." ; sh:select """
      PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
      SELECT DISTINCT $this WHERE {
        { FILTER NOT EXISTS { $this rdf:rest* rdf:nil } }
        UNION { $this rdf:rest* ?c . FILTER(?c != rdf:nil) FILTER NOT EXISTS { ?c rdf:first ?v ; rdf:rest ?r } }
        UNION { $this rdf:rest* ?c . ?c rdf:first ?v, ?w . FILTER(!sameTerm(?v, ?w)) }
        UNION { $this rdf:rest* ?c . ?c rdf:rest ?v, ?w . FILTER(!sameTerm(?v, ?w)) }
        UNION { $this rdf:rest* ?c . ?c rdf:rest+ ?c }
        UNION { { SELECT $this (COUNT(DISTINCT ?c) AS ?n) WHERE { $this rdf:rest* ?c . FILTER(?c != rdf:nil) } GROUP BY $this } FILTER(?n != 20) }
        UNION { $this rdf:rest* rdf:nil . rdf:nil ?p ?v . FILTER(?p IN (rdf:first,rdf:rest)) }
      }
    """ ] .

