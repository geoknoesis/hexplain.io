# A member that is not typed as an entry, and an entry with two paths, one of them a number.
# expect: ex:container apkg:ContainerShape sh:ClassConstraintComponent
# expect: ex:entry apkg:EntryShape sh:MaxCountConstraintComponent
# expect: ex:entry apkg:EntryShape sh:DatatypeConstraintComponent
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix apkg: <https://hexplain.io/ns/aspect/packaging#> .
@prefix ex:   <https://hexplain.io/test/packaging-invalid#> .

ex:container a apkg:Container ; apkg:hasEntry ex:untyped .
ex:entry a apkg:Entry ; apkg:entryPath "a" , 42 .
