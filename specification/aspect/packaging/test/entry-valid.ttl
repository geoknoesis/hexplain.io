@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix apkg: <https://hexplain.io/ns/aspect/packaging#> .
@prefix ex:   <https://hexplain.io/test/packaging#> .

ex:container a apkg:Container ; apkg:hasEntry ex:entry , ex:unnamed .
ex:entry a apkg:Entry ; apkg:entryPath "docs/readme.txt" .
ex:unnamed a apkg:Entry .
