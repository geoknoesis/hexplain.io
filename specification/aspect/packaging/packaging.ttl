# Hexplain Aspect — Packaging (hx-packaging) 1.0
# Container aspect: multi-entry container membership. Shared by archives (ZIP/TAR) and,
# in principle, box/atom media containers. Imports hx-bundle (containment is one binding kind).
@prefix :       <https://hexplain.io/ns/aspect/packaging#> .
@prefix apkg:   <https://hexplain.io/ns/aspect/packaging#> .
@prefix abnd:   <https://hexplain.io/ns/aspect/bundle#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .

<https://hexplain.io/ns/aspect/packaging> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/aspect/packaging/1.1> ; owl:versionInfo "1.1" ;
    owl:imports <https://hexplain.io/ns/aspect/bundle> ;
    rdfs:label "Hexplain Aspect — Packaging (hx-packaging)" ;
    rdfs:comment "Aspect for multi-entry container membership: containers, entries, and paths. Shared by archives and box/atom media containers." ;
    dcterms:created "2026-07-22"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "apkg" ; vann:preferredNamespaceUri "https://hexplain.io/ns/aspect/packaging#" .

:Container a owl:Class ; rdfs:label "Container" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/packaging> ; rdfs:comment "A file that holds member entries." .
:Entry a owl:Class ; rdfs:label "Entry" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/packaging> ; rdfs:comment "A member of a container." .
:hasEntry a owl:ObjectProperty ; rdfs:label "has entry" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/packaging> ; rdfs:range :Entry .
:entryPath a owl:DatatypeProperty ; rdfs:label "entry path" ; rdfs:isDefinedBy <https://hexplain.io/ns/aspect/packaging> ; rdfs:range xsd:string ; rdfs:comment "Path of the entry within the container." .

# ---------- Bundle alignment: containment is one binding kind ----------
:Container rdfs:subClassOf abnd:Asset .
:Entry     rdfs:subClassOf abnd:Part .
:hasEntry  rdfs:subPropertyOf abnd:hasPart .

# Shapes constrain an explicitly selected data graph; RDFS range assertions alone
# are inferential statements, not a check that a publisher supplied valid values.
:ContainerShape a sh:NodeShape ;
    rdfs:label "Container membership shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/aspect/packaging> ;
    rdfs:comment "Checks resource-valued, explicitly typed entry membership. Empty containers and repeated paths on distinct entries remain legal."@en ;
    skos:scopeNote "Apply to emitted packaging metadata with entry types in the data graph; no inference or network import fetching is required. This shape does not inspect binary archive bytes."@en ;
    sh:targetClass :Container ; sh:targetSubjectsOf :hasEntry ;
    sh:property [ sh:path :hasEntry ; sh:name "Member entry"@en ;
        sh:description "Each member must be a resource typed as an Entry. Membership is optional and repeatable."@en ;
        sh:nodeKind sh:BlankNodeOrIRI ; sh:class :Entry ;
        sh:message "Container members must be resources typed as packaging Entry."@en ] .

:EntryShape a sh:NodeShape ;
    rdfs:label "Entry path shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/aspect/packaging> ;
    rdfs:comment "Checks the optional single verbatim string path of an entry. A path is metadata, not an extraction destination or a globally unique identifier."@en ;
    skos:scopeNote "Applies to Entry instances and subjects of entryPath. Paths may be absent in unnamed box containers; empty paths, traversal-looking paths and duplicate paths across distinct entries are preserved for inspection. Extraction software must apply its own destination policy."@en ;
    sh:targetClass :Entry ; sh:targetSubjectsOf :entryPath ;
    sh:property [ sh:path :entryPath ; sh:name "Verbatim entry path"@en ;
        sh:description "Zero or one xsd:string per entry resource; no uniqueness or filesystem normalization is implied."@en ;
        sh:datatype xsd:string ; sh:maxCount 1 ;
        sh:message "An entry has at most one verbatim xsd:string path."@en ] .

