# A DTED-like grid whose format fixes its no-data value, with stored node-registered bounds, a
# stated value range, and grid-level calibration for a format without bands.
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix araster: <https://hexplain.io/ns/aspect/raster#> .
@prefix ex:      <https://hexplain.io/test/raster-grid-metadata-valid#> .

ex:dted a araster:RasterGrid ; araster:width 1201 ; araster:height 1201 ;
    araster:formatNoDataValue "-32767"^^xsd:short ;
    araster:boundsMinX "-1.0"^^xsd:double ; araster:boundsMaxX "0.0"^^xsd:double ;
    araster:boundsMinY "51.0"^^xsd:double ; araster:boundsMaxY "52.0"^^xsd:double ;
    araster:boundsRegistration araster:nodeRegistration ;
    araster:minimumValue "-12.0"^^xsd:double ; araster:maximumValue "845.5"^^xsd:double ;
    araster:sampleScale "0.1"^^xsd:double ; araster:sampleOffset "0.0"^^xsd:double .
ex:stored a araster:RasterGrid ; araster:formatNoDataValue "-32768"^^xsd:short ; araster:noDataValue "-9999"^^xsd:int .
