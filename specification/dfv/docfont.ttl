# Hexplain Document & Font Vocabulary (DFV) 1.3 — vocabulary + SHACL shapes
@prefix :       <https://hexplain.io/ns/docfont#> .
@prefix dfv:    <https://hexplain.io/ns/docfont#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .

<https://hexplain.io/ns/docfont> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/docfont/1.3> ; owl:versionInfo "1.3" ;
    owl:priorVersion <https://hexplain.io/ns/docfont/1.2> ;
    dcterms:modified "2026-10-12"^^xsd:date ;
    rdfs:label "Hexplain Document & Font Vocabulary (DFV)"@en ;
    rdfs:comment "Semantic vocabulary for document and font file properties."@en ;
    dcterms:created "2025-08-16"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "dfv" ; vann:preferredNamespaceUri "https://hexplain.io/ns/docfont#" .

:Document a owl:Class ; rdfs:label "Document"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ; rdfs:seeAlso dcterms:BibliographicResource .
:Page a owl:Class ; rdfs:label "Page"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> .
:Object a owl:Class ; rdfs:label "Object"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ;
    owl:deprecated true ;
    skos:historyNote "Deprecated in DFV 1.2: a PDF file structure (PDF indirect object, stream, trailer, cross-reference table), not a document or font concept. It belongs in a PDF format profile; the IRI stays defined so existing graphs keep their meaning."@en .
:Stream a owl:Class ; rdfs:label "Stream"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ;
    owl:deprecated true ;
    skos:historyNote "Deprecated in DFV 1.2: a PDF file structure (PDF indirect object, stream, trailer, cross-reference table), not a document or font concept. It belongs in a PDF format profile; the IRI stays defined so existing graphs keep their meaning."@en .
:Trailer a owl:Class ; rdfs:label "Trailer"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ;
    owl:deprecated true ;
    skos:historyNote "Deprecated in DFV 1.2: a PDF file structure (PDF indirect object, stream, trailer, cross-reference table), not a document or font concept. It belongs in a PDF format profile; the IRI stays defined so existing graphs keep their meaning."@en .
:CrossReferenceTable a owl:Class ; rdfs:label "Cross Reference Table"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ;
    owl:deprecated true ;
    skos:historyNote "Deprecated in DFV 1.2: a PDF file structure (PDF indirect object, stream, trailer, cross-reference table), not a document or font concept. It belongs in a PDF format profile; the IRI stays defined so existing graphs keep their meaning."@en .
:BoundingBox a owl:Class ; rdfs:label "Bounding Box"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> .
:Font a owl:Class ; rdfs:label "Font"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> .
:FontDescriptor a owl:Class ; rdfs:label "Font Descriptor"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> .
:FontTable a owl:Class ; rdfs:label "Font Table"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> .
:Glyph a owl:Class ; rdfs:label "Glyph"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> .

# Descriptive metadata reuses Dublin Core directly: dcterms:creator, dcterms:title, dcterms:created, dcterms:modified.
:creatorTool a owl:DatatypeProperty ; rdfs:label "creator tool"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ; rdfs:range xsd:string .
:producerTool a owl:DatatypeProperty ; rdfs:label "producer tool"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ; rdfs:range xsd:string .
:pageCount a owl:DatatypeProperty ; rdfs:label "page count"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ; rdfs:range xsd:positiveInteger .
:hasBoundingBox a owl:ObjectProperty ; rdfs:label "has bounding box"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ; rdfs:range :BoundingBox .
:boxType a owl:DatatypeProperty ; rdfs:label "box type"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ; rdfs:range xsd:string .
:fontFamily a owl:DatatypeProperty ; rdfs:label "font family"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ; rdfs:range xsd:string .
:fontStyle a owl:DatatypeProperty ; rdfs:label "font style"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ; rdfs:range xsd:string .
:characterEncoding a owl:DatatypeProperty ; rdfs:label "character encoding"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ; rdfs:range xsd:string .
:glyphCount a owl:DatatypeProperty ; rdfs:label "glyph count"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ; rdfs:range xsd:positiveInteger .
:glyphIdentifier a owl:DatatypeProperty ; rdfs:label "glyph identifier"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> .
:unicodeCodePoint a owl:DatatypeProperty ; rdfs:label "unicode code point"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ; rdfs:range xsd:hexBinary .

# ---------- SHACL ----------
dfv:DocumentShape a sh:NodeShape ; sh:targetClass dfv:Document ; sh:targetSubjectsOf dfv:pageCount ;
    # A creator is a name (a string) or an agent (an IRI or blank node, as Dublin Core intends
    # for dcterms:creator); a document may have several.
    sh:property [ sh:path dcterms:creator ; sh:or ( [ sh:datatype xsd:string ] [ sh:nodeKind sh:BlankNodeOrIRI ] ) ;
        sh:message "dcterms:creator of a document is a string name or an agent IRI or blank node." ] ;
    sh:property [ sh:path dcterms:title ; sh:datatype xsd:string ; sh:maxCount 1 ;
        sh:message "dcterms:title takes at most one value; each is an xsd:string literal." ] ;
    sh:property [ sh:path dcterms:created ; sh:datatype xsd:dateTime ; sh:maxCount 1 ;
        sh:message "dcterms:created takes at most one value; each is an xsd:dateTime literal." ] ;
    sh:property [ sh:path dcterms:modified ; sh:datatype xsd:dateTime ; sh:maxCount 1 ;
        sh:message "dcterms:modified takes at most one value; each is an xsd:dateTime literal." ] ;
    sh:property [ sh:path dfv:pageCount ; sh:minExclusive 0 ; sh:maxCount 1 ;
        sh:message "dfv:pageCount takes at most one value; each is a number greater than 0." ] .
dfv:PageShape a sh:NodeShape ; sh:targetSubjectsOf dfv:hasBoundingBox ;
    sh:property [ sh:path dfv:hasBoundingBox ; sh:class dfv:BoundingBox ;
        sh:message "Each value of dfv:hasBoundingBox is an instance of dfv:BoundingBox." ] .
dfv:FontShape a sh:NodeShape ; sh:targetClass dfv:Font ;
    sh:targetSubjectsOf dfv:fontFamily, dfv:fontStyle, dfv:glyphCount ;
    sh:property [ sh:path dfv:fontFamily ; sh:datatype xsd:string ; sh:maxCount 1 ;
        sh:message "dfv:fontFamily takes at most one value; each is an xsd:string literal." ] ;
    sh:property [ sh:path dfv:fontStyle ; sh:datatype xsd:string ; sh:maxCount 1 ;
        sh:message "dfv:fontStyle takes at most one value; each is an xsd:string literal." ] ;
    sh:property [ sh:path dfv:glyphCount ; sh:minExclusive 0 ; sh:maxCount 1 ;
        sh:message "dfv:glyphCount takes at most one value; each is a number greater than 0." ] .

# ---------- Range datatype shapes ----------
# Each XSD rdfs:range above, enforced wherever the property is used: activation is by
# subjects-of, so an untyped subject is checked too (tools/test_range_datatypes.py).
# Integer ranges accept any XSD integer-family datatype within the range's bounds.
# One copy per module, byte-identical to bddo:IntegerValueShape (the master; template in
# specification/shared-patterns/integer-value-shape.ttl.template): shapes are validated module by
# module, and a sh:node into another module's graph is silently satisfied when that module is not loaded.
dfv:IntegerValueShape a sh:NodeShape ; rdfs:label "Integer value shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ;
    sh:message "An integer value is a literal of an XSD integer-family datatype (xsd:integer, xsd:positiveInteger, xsd:nonNegativeInteger, xsd:int, xsd:long, xsd:unsignedInt, xsd:unsignedLong, xsd:short, xsd:unsignedShort, xsd:byte or xsd:unsignedByte)." ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:short ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedByte ] ) .
dfv:RangeDatatypeShape a sh:NodeShape ; rdfs:label "Range datatype shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ;
    sh:targetSubjectsOf dfv:boxType ,
        dfv:characterEncoding ,
        dfv:creatorTool ,
        dfv:glyphCount ,
        dfv:pageCount ,
        dfv:producerTool ,
        dfv:unicodeCodePoint ;
    sh:property [ sh:path dfv:boxType ; sh:datatype xsd:string ;
        sh:message "dfv:boxType takes an xsd:string literal (rdfs:range xsd:string)." ] ;
    sh:property [ sh:path dfv:characterEncoding ; sh:datatype xsd:string ;
        sh:message "dfv:characterEncoding takes an xsd:string literal (rdfs:range xsd:string)." ] ;
    sh:property [ sh:path dfv:creatorTool ; sh:datatype xsd:string ;
        sh:message "dfv:creatorTool takes an xsd:string literal (rdfs:range xsd:string)." ] ;
    sh:property [ sh:path dfv:glyphCount ; sh:node dfv:IntegerValueShape ; sh:minInclusive 1 ;
        sh:message "dfv:glyphCount takes a positive integer (rdfs:range xsd:positiveInteger)." ] ;
    sh:property [ sh:path dfv:pageCount ; sh:node dfv:IntegerValueShape ; sh:minInclusive 1 ;
        sh:message "dfv:pageCount takes a positive integer (rdfs:range xsd:positiveInteger)." ] ;
    sh:property [ sh:path dfv:producerTool ; sh:datatype xsd:string ;
        sh:message "dfv:producerTool takes an xsd:string literal (rdfs:range xsd:string)." ] ;
    sh:property [ sh:path dfv:unicodeCodePoint ; sh:datatype xsd:hexBinary ;
        sh:message "dfv:unicodeCodePoint takes an xsd:hexBinary literal (rdfs:range xsd:hexBinary)." ] .

# ---------- Term ownership ----------
# rdfs:isDefinedBy for the terms whose declaration above does not state it. A new term states
# its own; tools/test_term_reference.py requires it of every term this file defines.
:DocumentShape rdfs:isDefinedBy <https://hexplain.io/ns/docfont> .
:FontShape rdfs:isDefinedBy <https://hexplain.io/ns/docfont> .
:PageShape rdfs:isDefinedBy <https://hexplain.io/ns/docfont> .
