# Hexplain Document & Font Vocabulary (DFV) 1.1 — vocabulary + SHACL shapes
@prefix :       <https://hexplain.io/ns/docfont#> .
@prefix dfv:    <https://hexplain.io/ns/docfont#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .

<https://hexplain.io/ns/docfont> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/docfont/1.1> ; owl:versionInfo "1.1" ;
    owl:priorVersion <https://hexplain.io/ns/docfont/1.0> ;
    dcterms:modified "2026-09-23"^^xsd:date ;
    rdfs:label "Hexplain Document & Font Vocabulary (DFV)" ;
    rdfs:comment "Semantic vocabulary for document and font file properties." ;
    dcterms:created "2025-08-16"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "dfv" ; vann:preferredNamespaceUri "https://hexplain.io/ns/docfont#" .

:Document a owl:Class ; rdfs:label "Document" ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ; rdfs:seeAlso dcterms:BibliographicResource .
:Page a owl:Class ; rdfs:label "Page" ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> .
:Object a owl:Class ; rdfs:label "Object" ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ;
    owl:deprecated true ;
    skos:historyNote "Deprecated in DFV 1.2: a PDF file structure (PDF indirect object, stream, trailer, cross-reference table), not a document or font concept. It belongs in a PDF format profile; the IRI stays defined so existing graphs keep their meaning."@en .
:Stream a owl:Class ; rdfs:label "Stream" ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ;
    owl:deprecated true ;
    skos:historyNote "Deprecated in DFV 1.2: a PDF file structure (PDF indirect object, stream, trailer, cross-reference table), not a document or font concept. It belongs in a PDF format profile; the IRI stays defined so existing graphs keep their meaning."@en .
:Trailer a owl:Class ; rdfs:label "Trailer" ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ;
    owl:deprecated true ;
    skos:historyNote "Deprecated in DFV 1.2: a PDF file structure (PDF indirect object, stream, trailer, cross-reference table), not a document or font concept. It belongs in a PDF format profile; the IRI stays defined so existing graphs keep their meaning."@en .
:CrossReferenceTable a owl:Class ; rdfs:label "Cross Reference Table" ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ;
    owl:deprecated true ;
    skos:historyNote "Deprecated in DFV 1.2: a PDF file structure (PDF indirect object, stream, trailer, cross-reference table), not a document or font concept. It belongs in a PDF format profile; the IRI stays defined so existing graphs keep their meaning."@en .
:BoundingBox a owl:Class ; rdfs:label "Bounding Box" ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> .
:Font a owl:Class ; rdfs:label "Font" ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> .
:FontDescriptor a owl:Class ; rdfs:label "Font Descriptor" ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> .
:FontTable a owl:Class ; rdfs:label "Font Table" ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> .
:Glyph a owl:Class ; rdfs:label "Glyph" ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> .

# Descriptive metadata reuses Dublin Core directly: dcterms:creator, dcterms:title, dcterms:created, dcterms:modified.
:creatorTool a owl:DatatypeProperty ; rdfs:label "creator tool" ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ; rdfs:range xsd:string .
:producerTool a owl:DatatypeProperty ; rdfs:label "producer tool" ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ; rdfs:range xsd:string .
:pageCount a owl:DatatypeProperty ; rdfs:label "page count" ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ; rdfs:range xsd:positiveInteger .
:hasBoundingBox a owl:ObjectProperty ; rdfs:label "has bounding box" ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ; rdfs:range :BoundingBox .
:boxType a owl:DatatypeProperty ; rdfs:label "box type" ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ; rdfs:range xsd:string .
:fontFamily a owl:DatatypeProperty ; rdfs:label "font family" ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ; rdfs:range xsd:string .
:fontStyle a owl:DatatypeProperty ; rdfs:label "font style" ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ; rdfs:range xsd:string .
:characterEncoding a owl:DatatypeProperty ; rdfs:label "character encoding" ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ; rdfs:range xsd:string .
:glyphCount a owl:DatatypeProperty ; rdfs:label "glyph count" ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ; rdfs:range xsd:positiveInteger .
:glyphIdentifier a owl:DatatypeProperty ; rdfs:label "glyph identifier" ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> .
:unicodeCodePoint a owl:DatatypeProperty ; rdfs:label "unicode code point" ; rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ; rdfs:range xsd:hexBinary .

# ---------- SHACL ----------
dfv:DocumentShape a sh:NodeShape ; sh:targetClass dfv:Document ; sh:targetSubjectsOf dfv:pageCount ;
    # A creator is a name (a string) or an agent (an IRI or blank node, as Dublin Core intends
    # for dcterms:creator); a document may have several.
    sh:property [ sh:path dcterms:creator ; sh:or ( [ sh:datatype xsd:string ] [ sh:nodeKind sh:BlankNodeOrIRI ] ) ;
        sh:message "dcterms:creator of a document is a string name or an agent IRI or blank node." ] ;
    sh:property [ sh:path dcterms:title ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path dcterms:created ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
    sh:property [ sh:path dcterms:modified ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
    sh:property [ sh:path dfv:pageCount ; sh:minExclusive 0 ; sh:maxCount 1 ] .
dfv:PageShape a sh:NodeShape ; sh:targetSubjectsOf dfv:hasBoundingBox ;
    sh:property [ sh:path dfv:hasBoundingBox ; sh:class dfv:BoundingBox ] .
dfv:FontShape a sh:NodeShape ; sh:targetClass dfv:Font ;
    sh:targetSubjectsOf dfv:fontFamily, dfv:fontStyle, dfv:glyphCount ;
    sh:property [ sh:path dfv:fontFamily ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path dfv:fontStyle ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path dfv:glyphCount ; sh:minExclusive 0 ; sh:maxCount 1 ] .

# ---------- Range datatype shapes ----------
# Each XSD rdfs:range above, enforced wherever the property is used: activation is by
# subjects-of, so an untyped subject is checked too (tools/test_range_datatypes.py).
# Integer ranges accept any XSD integer-family datatype within the range's bounds.
dfv:IntegerValueShape a sh:NodeShape ; rdfs:label "Integer value shape" ;
    rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:short ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedByte ] ) .
dfv:RangeDatatypeShape a sh:NodeShape ; rdfs:label "Range datatype shape" ;
    rdfs:isDefinedBy <https://hexplain.io/ns/docfont> ;
    sh:targetSubjectsOf dfv:boxType ,
        dfv:characterEncoding ,
        dfv:creatorTool ,
        dfv:glyphCount ,
        dfv:pageCount ,
        dfv:producerTool ,
        dfv:unicodeCodePoint ;
    sh:property [ sh:path dfv:boxType ; sh:datatype xsd:string ;
        sh:message "dfv:boxType takes an xsd:string literal (rdfs:range xsd:string)." ] ;
    sh:property [ sh:path dfv:characterEncoding ; sh:datatype xsd:string ;
        sh:message "dfv:characterEncoding takes an xsd:string literal (rdfs:range xsd:string)." ] ;
    sh:property [ sh:path dfv:creatorTool ; sh:datatype xsd:string ;
        sh:message "dfv:creatorTool takes an xsd:string literal (rdfs:range xsd:string)." ] ;
    sh:property [ sh:path dfv:glyphCount ; sh:node dfv:IntegerValueShape ; sh:minInclusive 1 ;
        sh:message "dfv:glyphCount takes a positive integer (rdfs:range xsd:positiveInteger)." ] ;
    sh:property [ sh:path dfv:pageCount ; sh:node dfv:IntegerValueShape ; sh:minInclusive 1 ;
        sh:message "dfv:pageCount takes a positive integer (rdfs:range xsd:positiveInteger)." ] ;
    sh:property [ sh:path dfv:producerTool ; sh:datatype xsd:string ;
        sh:message "dfv:producerTool takes an xsd:string literal (rdfs:range xsd:string)." ] ;
    sh:property [ sh:path dfv:unicodeCodePoint ; sh:datatype xsd:hexBinary ;
        sh:message "dfv:unicodeCodePoint takes an xsd:hexBinary literal (rdfs:range xsd:hexBinary)." ] .

