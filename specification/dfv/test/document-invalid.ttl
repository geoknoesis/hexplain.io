# A page count and a glyph count are positive; a title is a single string.
# expect: ex:doc dfv:DocumentShape sh:MinExclusiveConstraintComponent
# expect: ex:doc dfv:DocumentShape sh:MaxCountConstraintComponent
# expect: ex:font dfv:FontShape sh:MinExclusiveConstraintComponent
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix dfv:     <https://hexplain.io/ns/docfont#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex:      <https://hexplain.io/test/docfont-invalid#> .

ex:doc a dfv:Document ; dcterms:title "Report" , "Rapport" ; dfv:pageCount 0 .
ex:font a dfv:Font ; dfv:glyphCount 0 .
