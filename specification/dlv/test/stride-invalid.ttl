# A dimension declaring two stride mechanisms at once.
# Expected to trip DimensionShape's at-most-one-stride SPARQL constraint.
@prefix bddo: <https://hexplain.io/ns/bddo#> .
@prefix dlv:  <https://hexplain.io/ns/dlv#> .
@prefix ex:   <https://hexplain.io/test/stride-invalid#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Layout a dlv:DataLayout ;
    rdfs:comment "Expected to trip DimensionShape (two stride mechanisms on ex:DimY)." ;
    dlv:cellDataType bddo:uint8 ;
    dlv:hasDimension ( ex:DimY ex:DimX ) .

ex:Rows a bddo:Field ; bddo:dataType bddo:uint32 .

ex:DimY a dlv:Dimension ; dlv:hasAxis dlv:axisY ; dlv:dimensionSize 1024 ;
    dlv:dimensionStride 4096 ;
    dlv:dimensionStrideFromField ex:Rows .

ex:DimX a dlv:Dimension ; dlv:hasAxis dlv:axisX ; dlv:dimensionSize 1024 .
