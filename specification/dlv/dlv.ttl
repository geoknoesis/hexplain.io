# Hexplain Data Layout Vocabulary (DLV) 1.0 — vocabulary + SHACL shapes
# Properties declare rdfs:range; domain and cardinality are in SHACL (no rdfs:domain).
@prefix :       <https://hexplain.io/ns/dlv#> .
@prefix dlv:    <https://hexplain.io/ns/dlv#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix bddo:   <https://hexplain.io/ns/bddo#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .

<https://hexplain.io/ns/dlv> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/dlv/1.1> ; owl:versionInfo "1.1" ;
    owl:imports <https://hexplain.io/ns/bddo> ;
    rdfs:label "Hexplain Data Layout Vocabulary (DLV)" ;
    rdfs:comment "Vocabulary for describing multi-dimensional array layout within a flat byte stream." ;
    dcterms:created "2025-08-16"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "dlv" ; vann:preferredNamespaceUri "https://hexplain.io/ns/dlv#" .

:DataLayout a owl:Class ; rdfs:label "Data Layout" ; rdfs:isDefinedBy <https://hexplain.io/ns/dlv> .
:Dimension  a owl:Class ; rdfs:label "Dimension"  ; rdfs:isDefinedBy <https://hexplain.io/ns/dlv> .
:Axis       a owl:Class ; rdfs:label "Axis"       ; rdfs:isDefinedBy <https://hexplain.io/ns/dlv> .

:hasDimension a owl:ObjectProperty ; rdfs:label "has dimension" ; rdfs:range rdf:List ;
    rdfs:isDefinedBy <https://hexplain.io/ns/dlv> ;
    rdfs:comment "Ordered rdf:List of dimensions, slowest- to fastest-varying." .
:cellDataType a owl:ObjectProperty ; rdfs:label "cell data type" ; rdfs:range bddo:DataType ; rdfs:isDefinedBy <https://hexplain.io/ns/dlv> .
:dimensionSize a owl:DatatypeProperty ; rdfs:label "dimension size" ; rdfs:range xsd:positiveInteger ; rdfs:isDefinedBy <https://hexplain.io/ns/dlv> .
:dimensionSizeFromField a owl:ObjectProperty ; rdfs:label "dimension size from field" ; rdfs:range bddo:Field ; rdfs:isDefinedBy <https://hexplain.io/ns/dlv> .
:dimensionStride a owl:DatatypeProperty ; rdfs:label "dimension stride" ; rdfs:range xsd:positiveInteger ; rdfs:isDefinedBy <https://hexplain.io/ns/dlv> ;
    rdfs:comment "Bytes to advance per step along this dimension (pitch), as a fixed literal. When no stride is declared by any mechanism, addressing is contiguous (stride = size of the next-faster block). Stride stays in BYTES even for a bit-packed layout: rows of a packed grid are normally padded to a byte boundary while the cells within a row are not, so the pitch is whole bytes and dlv:cellBitWidth governs only the packing inside one row." .
:dimensionStrideFromField a owl:ObjectProperty ; rdfs:label "dimension stride from field" ; rdfs:range bddo:Field ; rdfs:isDefinedBy <https://hexplain.io/ns/dlv> ;
    rdfs:comment "The Field whose parsed value is this dimension's stride in bytes. Use when the pitch is carried in the format rather than fixed, e.g. an explicit row-bytes header field." .
:dimensionStrideFromExpression a owl:DatatypeProperty ; rdfs:label "dimension stride from expression" ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://hexplain.io/ns/dlv> ;
    rdfs:comment "A HEL expression giving this dimension's stride in bytes. Use when the pitch is computed rather than stored -- BMP's row padding is ((width * bitsPerPixel + 31) / 32) * 4 with HEL integer division (nonnegative integer operands; overflow is an error), which no literal can express. Mirrors dimensionSize/dimensionSizeFromField: a lone sibling name takes the FromField form, anything else this one." .
# ---------- Sub-byte cells ----------
# Every bddo:DataType is a whole number of bytes, so a grid whose cells are not could not be
# addressed at all: a 1-bit mask, a 4-bit palette index, GRIB2 simple packing at whatever
# width the header names, NITF's 1-bit imagery. dlv:cellBitWidth overrides the cell type's
# intrinsic width, so the type keeps saying how to INTERPRET a cell (signed, unsigned,
# float) while the width says how much room it takes.
#
# Distinct from asamp:bitDepth, which is a sampling concern: significant bits carried inside
# a wider container, NITF's ABPP 12 within NBPP 16. That grid is padded, not packed, and its
# cells stay two bytes apart. cellBitWidth is about PACKING -- consecutive cells sharing a
# byte -- and the two can hold different values for the same raster.
:cellBitWidth a owl:DatatypeProperty ; rdfs:label "cell bit width" ; rdfs:range xsd:positiveInteger ; rdfs:isDefinedBy <https://hexplain.io/ns/dlv> ;
    rdfs:comment "Bits each cell occupies in the packed stream, when that is not the cell type's intrinsic width. Cells are contiguous in the bit stream and may straddle byte boundaries; a cell type is still required, to say how the bits are interpreted. Absent means cells occupy their type's natural width." .
:cellBitWidthFromField a owl:ObjectProperty ; rdfs:label "cell bit width from field" ; rdfs:range bddo:Field ; rdfs:isDefinedBy <https://hexplain.io/ns/dlv> ;
    rdfs:comment "The Field whose parsed value is the packed cell width in bits. GRIB2 carries this in its data-representation section, so the width is a property of the message rather than of the format." .
:cellPackingOrder a owl:ObjectProperty ; rdfs:label "cell packing order" ; rdfs:range bddo:BitOrder ; rdfs:isDefinedBy <https://hexplain.io/ns/dlv> ;
    rdfs:comment "Whether the first cell of a byte occupies its most or least significant bits. Default bddo:MSBFirst, which is what GRIB2, NITF and the 1-bit and 4-bit image formats all use; LSB-first packing exists but is rare. Only meaningful alongside dlv:cellBitWidth." .

:hasAxis a owl:ObjectProperty ; rdfs:label "has axis" ; rdfs:range :Axis ; rdfs:isDefinedBy <https://hexplain.io/ns/dlv> .

# ---------- Chunked (tiled/blocked) layout ----------
:ChunkOrder a owl:Class ; rdfs:label "Chunk Order" ; rdfs:isDefinedBy <https://hexplain.io/ns/dlv> ;
    rdfs:comment "The order in which chunks appear in the chunk offset table." .
:chunkSize a owl:DatatypeProperty ; rdfs:label "chunk size" ; rdfs:range xsd:positiveInteger ; rdfs:isDefinedBy <https://hexplain.io/ns/dlv> ;
    rdfs:comment "Extent of one chunk (tile/block) along this dimension, in cells. When any Dimension of a DataLayout declares a chunk extent, the layout is chunked: the grid is partitioned into chunks of this shape and each chunk is located through the layout's chunk offset table. A trailing partial chunk is padded to the full chunk extent. A Dimension of a chunked layout that declares neither dlv:chunkSize nor dlv:chunkSizeFromField is chunked at its full extent, i.e. its chunk extent is its dlv:dimensionSize (or the value read through dlv:dimensionSizeFromField); a layout chunked on X alone therefore has chunks spanning all of Y. Within a chunked layout, dlv:dimensionStride addresses cells inside one chunk, not across the whole grid." .
:chunkSizeFromField a owl:ObjectProperty ; rdfs:label "chunk size from field" ; rdfs:range bddo:Field ; rdfs:isDefinedBy <https://hexplain.io/ns/dlv> .
:chunkOffsetsFromField a owl:ObjectProperty ; rdfs:label "chunk offsets from field" ; rdfs:range bddo:Field ; rdfs:isDefinedBy <https://hexplain.io/ns/dlv> ;
    rdfs:comment "The repeating Field holding each chunk's byte offset, indexed in chunkOrder (e.g. TIFF TileOffsets, NITF block offsets)." .
:chunkLengthsFromField a owl:ObjectProperty ; rdfs:label "chunk lengths from field" ; rdfs:range bddo:Field ; rdfs:isDefinedBy <https://hexplain.io/ns/dlv> ;
    rdfs:comment "The repeating Field holding each chunk's byte length (e.g. TIFF TileByteCounts). Required when chunks are individually encoded; when absent, a chunk's length is its cell count times the cell width." .
:chunkOffsetBase a owl:ObjectProperty ; rdfs:label "chunk offset base" ; rdfs:range bddo:OffsetBase ; rdfs:isDefinedBy <https://hexplain.io/ns/dlv> ;
    rdfs:comment "What the chunk offsets are relative to. Default bddo:streamStart." .
:chunkOrder a owl:ObjectProperty ; rdfs:label "chunk order" ; rdfs:range :ChunkOrder ; rdfs:isDefinedBy <https://hexplain.io/ns/dlv> ;
    rdfs:comment "Traversal order of the chunk offset table. Default dlv:rowMajor (chunks vary fastest along the fastest-varying dimension)." .

:rowMajor a owl:NamedIndividual, :ChunkOrder ; rdfs:label "Row-major chunk order" .
:columnMajor a owl:NamedIndividual, :ChunkOrder ; rdfs:label "Column-major chunk order" .
:morton a owl:NamedIndividual, :ChunkOrder ; rdfs:label "Morton (Z-order) chunk order" .
:hilbert a owl:NamedIndividual, :ChunkOrder ; rdfs:label "Hilbert curve chunk order" .

:axisX a :Axis ; rdfs:label "X Axis (Width)" .
:axisY a :Axis ; rdfs:label "Y Axis (Height)" .
:axisZ a :Axis ; rdfs:label "Z Axis (Depth)" .
:axisBand a :Axis ; rdfs:label "Band/Channel Axis" .
:axisTime a :Axis ; rdfs:label "Time Axis" .

# ---------- Conditional layout ----------
# A raster's cell type and its axis order are routinely chosen by header fields rather than
# fixed by the format: ENVI's `data type` and `interleave`, EHdr's NBITS and LAYOUT. These
# are TWO conditionals rather than one conditional DataLayout on purpose. Making the whole
# layout conditional multiplies the cases -- ENVI would need one layout per (interleave,
# data type) pair, 3 x 7 = 21 -- whereas separating them needs 3 order rules and 7 cell-type
# rules over the SAME three Dimension nodes. Both mirror bddo:hasConditionalDataType: an
# ordered rdf:List of rules, first satisfied condition wins, conditions are HEL.
:CellDataTypeRule a owl:Class ; rdfs:label "Cell Data Type Rule" ; rdfs:isDefinedBy <https://hexplain.io/ns/dlv> ;
    rdfs:comment "One arm of a hasConditionalCellDataType list: a HEL condition and the cell type it selects." .
:DimensionOrderRule a owl:Class ; rdfs:label "Dimension Order Rule" ; rdfs:isDefinedBy <https://hexplain.io/ns/dlv> ;
    rdfs:comment "One arm of a hasConditionalDimensionOrder list: a HEL condition and the dimension order it selects." .
:hasConditionalCellDataType a owl:ObjectProperty ; rdfs:label "has conditional cell data type" ; rdfs:range rdf:List ; rdfs:isDefinedBy <https://hexplain.io/ns/dlv> ;
    rdfs:comment "Ordered rdf:List of CellDataTypeRule. The first rule whose condition holds gives the layout's cell type. Mutually exclusive with dlv:cellDataType." .
:ruleCellDataType a owl:ObjectProperty ; rdfs:label "rule cell data type" ; rdfs:range bddo:DataType ; rdfs:isDefinedBy <https://hexplain.io/ns/dlv> .
:hasConditionalDimensionOrder a owl:ObjectProperty ; rdfs:label "has conditional dimension order" ; rdfs:range rdf:List ; rdfs:isDefinedBy <https://hexplain.io/ns/dlv> ;
    rdfs:comment "Ordered rdf:List of DimensionOrderRule. The first rule whose condition holds gives the layout's dimension order. Each rule names the SAME Dimension nodes in a different sequence -- band interleaving is a permutation of axes, not a different set of them. Mutually exclusive with dlv:hasDimension." .
:ruleDimensionOrder a owl:ObjectProperty ; rdfs:label "rule dimension order" ; rdfs:range rdf:List ; rdfs:isDefinedBy <https://hexplain.io/ns/dlv> ;
    rdfs:comment "The ordered rdf:List of dlv:Dimension selected by a DimensionOrderRule, slowest- to fastest-varying." .

# ---------- SHACL ----------
dlv:DataLayoutShape a sh:NodeShape ;
    sh:targetClass dlv:DataLayout ;
    sh:property [ sh:path dlv:hasDimension ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ] ;
    sh:property [ sh:path ( dlv:hasDimension [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ; sh:class dlv:Dimension ] ;
    sh:property [ sh:path dlv:cellDataType ; sh:class bddo:DataType ; sh:maxCount 1 ] ;
    sh:property [ sh:path dlv:cellBitWidth ; sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:short ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedByte ] ) ; sh:minExclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path dlv:cellBitWidthFromField ; sh:class bddo:Field ; sh:maxCount 1 ] ;
    sh:property [ sh:path dlv:cellPackingOrder ; sh:maxCount 1 ;
        sh:in ( bddo:MSBFirst bddo:LSBFirst ) ] ;
    # A packed width is fixed or read, never both.
    sh:not [ sh:and ( [ sh:property [ sh:path dlv:cellBitWidth ; sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:short ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedByte ] ) ; sh:minCount 1 ] ]
                      [ sh:property [ sh:path dlv:cellBitWidthFromField ; sh:minCount 1 ] ] ) ] ;
    # Packing order describes packing, so it needs a packed width to describe.
    sh:sparql [ sh:message "dlv:cellPackingOrder is only meaningful with dlv:cellBitWidth or dlv:cellBitWidthFromField." ;
        sh:prefixes dlv:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this dlv:cellPackingOrder ?o .
            FILTER NOT EXISTS { $this dlv:cellBitWidth ?w }
            FILTER NOT EXISTS { $this dlv:cellBitWidthFromField ?f }
        }""" ] ;
    sh:property [ sh:path dlv:hasConditionalCellDataType ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ] ;
    sh:property [ sh:path dlv:hasConditionalDimensionOrder ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ] ;
    # The cell type is fixed or chosen, never both and never neither.
    sh:xone (
        [ sh:property [ sh:path dlv:cellDataType ; sh:minCount 1 ] ;
          sh:property [ sh:path dlv:hasConditionalCellDataType ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path dlv:hasConditionalCellDataType ; sh:minCount 1 ] ;
          sh:property [ sh:path dlv:cellDataType ; sh:maxCount 0 ] ]
    ) ;
    # ...and so is the dimension order.
    sh:xone (
        [ sh:property [ sh:path dlv:hasDimension ; sh:minCount 1 ] ;
          sh:property [ sh:path dlv:hasConditionalDimensionOrder ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path dlv:hasConditionalDimensionOrder ; sh:minCount 1 ] ;
          sh:property [ sh:path dlv:hasDimension ; sh:maxCount 0 ] ]
    ) ;
    sh:property [ sh:path ( dlv:hasConditionalCellDataType [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:class dlv:CellDataTypeRule ;
        sh:message "Every member of a hasConditionalCellDataType list must be a dlv:CellDataTypeRule." ] ;
    sh:property [ sh:path ( dlv:hasConditionalDimensionOrder [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:class dlv:DimensionOrderRule ;
        sh:message "Every member of a hasConditionalDimensionOrder list must be a dlv:DimensionOrderRule." ] .

dlv:CellDataTypeRuleShape a sh:NodeShape ;
    sh:targetClass dlv:CellDataTypeRule ;
    sh:property [ sh:path bddo:condition ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path dlv:ruleCellDataType ; sh:class bddo:DataType ; sh:minCount 1 ; sh:maxCount 1 ] .

dlv:DimensionOrderRuleShape a sh:NodeShape ;
    sh:targetClass dlv:DimensionOrderRule ;
    sh:property [ sh:path bddo:condition ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path dlv:ruleDimensionOrder ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ] ;
    sh:property [ sh:path ( dlv:ruleDimensionOrder [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:class dlv:Dimension ;
        sh:message "Every member of a ruleDimensionOrder list must be a dlv:Dimension." ] .

dlv:DimensionShape a sh:NodeShape ;
    sh:targetClass dlv:Dimension ;
    sh:xone (
        [ sh:property [ sh:path dlv:dimensionSize ; sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:short ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedByte ] ) ; sh:minCount 1 ] ;
          sh:property [ sh:path dlv:dimensionSizeFromField ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path dlv:dimensionSizeFromField ; sh:minCount 1 ] ;
          sh:property [ sh:path dlv:dimensionSize ; sh:maxCount 0 ] ]
    ) ;
    # A stride is optional, but at most one of the three mechanisms may be used.
    sh:sparql [ sh:message "A dlv:Dimension must use at most one stride mechanism (dimensionStride / dimensionStrideFromField / dimensionStrideFromExpression)." ;
        sh:prefixes dlv:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this ?p ?v .
            FILTER(?p IN (dlv:dimensionStride, dlv:dimensionStrideFromField,
                          dlv:dimensionStrideFromExpression))
        } GROUP BY $this HAVING (COUNT(DISTINCT ?p) > 1)""" ] ;
    # A chunk extent is optional, but the two mechanisms are mutually exclusive.
    sh:xone (
        [ sh:property [ sh:path dlv:chunkSize ; sh:maxCount 0 ] ;
          sh:property [ sh:path dlv:chunkSizeFromField ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path dlv:chunkSize ; sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:short ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedByte ] ) ; sh:minCount 1 ] ;
          sh:property [ sh:path dlv:chunkSizeFromField ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path dlv:chunkSizeFromField ; sh:minCount 1 ] ;
          sh:property [ sh:path dlv:chunkSize ; sh:maxCount 0 ] ]
    ) ;
    sh:property [ sh:path dlv:dimensionSize ; sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:short ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedByte ] ) ; sh:minExclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path dlv:dimensionSizeFromField ; sh:class bddo:Field ; sh:maxCount 1 ] ;
    sh:property [ sh:path dlv:dimensionStride ; sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:short ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedByte ] ) ; sh:minExclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path dlv:dimensionStrideFromField ; sh:class bddo:Field ; sh:maxCount 1 ] ;
    sh:property [ sh:path dlv:dimensionStrideFromExpression ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path dlv:hasAxis ; sh:nodeKind sh:IRI ; sh:class dlv:Axis ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path dlv:chunkSize ; sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:short ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedByte ] ) ; sh:minExclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path dlv:chunkSizeFromField ; sh:class bddo:Field ; sh:maxCount 1 ] .

dlv:_prefixes sh:declare
    [ sh:prefix "dlv" ; sh:namespace "https://hexplain.io/ns/dlv#"^^xsd:anyURI ] ,
    [ sh:prefix "rdf" ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] .

# A chunked layout must say where its chunks are.
dlv:ChunkedLayoutShape a sh:NodeShape ;
    sh:targetClass dlv:DataLayout ;
    sh:property [ sh:path dlv:chunkOffsetsFromField ; sh:class bddo:Field ; sh:maxCount 1 ] ;
    sh:property [ sh:path dlv:chunkLengthsFromField ; sh:class bddo:Field ; sh:maxCount 1 ] ;
    sh:property [ sh:path dlv:chunkOffsetBase ; sh:maxCount 1 ;
        sh:in ( bddo:streamStart bddo:streamEnd bddo:parentStart bddo:currentPosition ) ] ;
    sh:property [ sh:path dlv:chunkOrder ; sh:maxCount 1 ; sh:class dlv:ChunkOrder ] ;
    sh:sparql [ sh:message "A chunked dlv:DataLayout (any Dimension declaring dlv:chunkSize or dlv:chunkSizeFromField) must declare dlv:chunkOffsetsFromField." ;
        sh:prefixes dlv:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this dlv:hasDimension/rdf:rest*/rdf:first ?d .
            { ?d dlv:chunkSize ?c } UNION { ?d dlv:chunkSizeFromField ?c }
            FILTER NOT EXISTS { $this dlv:chunkOffsetsFromField ?o }
        }""" ] .

