  "questions": [
    {
      "id": "ORT-01",
      "topic": "Geometry type coverage",
      "question": "Verify all seven measured WKB families map to distinct geometry-type concepts, including GeometryCollection; identify required curve/surface/mesh extensions.",
      "status": "unreviewed",
      "finding": null,
      "disposition": null
    },
    {
      "id": "ORT-02",
      "topic": "Ordinate semantics",
      "question": "Verify XYM is not treated as XYZ, M is not implicitly time/elevation, and unknown flags are distinct from false.",
      "status": "unreviewed",
      "finding": null,
      "disposition": null
    },
    {
      "id": "ORT-03",
      "topic": "CRS and coordinate order",
      "question": "Check stored GeoPackage x/y order versus CRS authority axis order; distinguish SRS identifiers from verified transformations and coordinate epochs.",
      "status": "unreviewed",
      "finding": null,
      "disposition": null
    },
    {
      "id": "ORT-04",
      "topic": "Null and empty",
      "question": "Check NULL geometry, empty Point and empty collections remain distinct; assess missing vs unknown vs invalid semantic values.",
      "status": "unreviewed",
      "finding": null,
      "disposition": null
    },
    {
      "id": "ORT-05",
      "topic": "Envelope semantics",
      "question": "Review XYZ/XYM subset envelopes on XYZM data and rejection of out-of-bounds ordinates against GeoPackage requirements.",
      "status": "unreviewed",
      "finding": null,
      "disposition": null
    },
    {
      "id": "ORT-06",
      "topic": "Targets and entailment",
      "question": "Audit SHACL activation, referenced helper shapes, primaryPart handling and vacuous conformance when external profile definitions are absent.",
      "status": "unreviewed",
      "finding": null,
      "disposition": null
    },
    {
      "id": "ORT-07",
      "topic": "Compound and security scope",
      "question": "Review nesting, ownership, controlled concepts and profiles. Confirm containment does not confer authorization or security inheritance.",
      "status": "unreviewed",
      "finding": null,
      "disposition": null
    },
    {
      "id": "ORT-08",
      "topic": "Numbers and physical layout",
      "question": "Review counts, strides, packing width, integral datatype families, rational quantities, sentinel extents and signedness.",
      "status": "unreviewed",
      "finding": null,
      "disposition": null
    },
    {
      "id": "ORT-09",
      "topic": "Vocabulary architecture",
      "question": "For every module, review term labels/definitions/scopes, reuse, domain/range choices, cardinality and open-world ontology vs validation contracts.",
      "status": "unreviewed",
      "finding": null,
      "disposition": null
    },
    {
      "id": "ORT-10",
      "topic": "Compatibility and publication",
      "question": "Assess stricter shape revisions, retained immutable artifacts, live dereferencing failure, namespace policy and migration impact.",
      "status": "unreviewed",
      "finding": null,
      "disposition": null
    }
  ],
  "revision_note": "Geometry 1.2 value constraints; candidate refreshed after production boundary corrections; independent review still pending"
