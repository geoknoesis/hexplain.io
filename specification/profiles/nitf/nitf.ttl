# Hexplain Profile — NGA NITF 2.1 (MIL-STD-2500C). Byte-level container description.
@prefix nitf:    <https://hexplain.io/ns/profile/nitf#> .
@prefix bddo:    <https://hexplain.io/ns/bddo#> .
@prefix hexplain:<https://hexplain.io/ns/core#> .
@prefix gv:      <https://hexplain.io/ns/geo#> .
@prefix araster: <https://hexplain.io/ns/aspect/raster#> .
@prefix asec:    <https://hexplain.io/ns/aspect/security#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .

<https://hexplain.io/ns/profile/nitf> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/profile/nitf/1.0> ; owl:versionInfo "1.0" ;
    owl:imports <https://hexplain.io/ns/core> ;
    rdfs:label "Hexplain Profile — NGA NITF 2.1" ;
    rdfs:comment "Byte-level description of the National Imagery Transmission Format 2.1 container (MIL-STD-2500C): file header, image/graphic/text/DES/RES subheaders, and the generic Tagged Record Extension framework. NSIF/STANAG 4545 is field-compatible." ;
    rdfs:seeAlso <https://www.everyspec.com/MIL-STD/MIL-STD-2500-2599/MIL-STD-2500C_25693/> ;
    dcterms:created "2026-07-26"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "nitf" ; vann:preferredNamespaceUri "https://hexplain.io/ns/profile/nitf#" .

# ---------- Profile-local data types (NITF fields are BCS/ECS text) ----------
nitf:BCSA a bddo:DataType ; rdfs:label "BCS-A (alphanumeric text)" ;
    bddo:baseType bddo:baseString ; bddo:encoding bddo:ascii ; bddo:xsdType xsd:string .
nitf:BCSN a bddo:DataType ; rdfs:label "BCS-N (numeric text: digits + . / + -)" ;
    bddo:baseType bddo:baseString ; bddo:encoding bddo:ascii ; bddo:xsdType xsd:string .
nitf:BCSNpos a bddo:DataType ; rdfs:label "BCS-N positive integer (digits only)" ;
    bddo:baseType bddo:baseString ; bddo:encoding bddo:ascii ; bddo:xsdType xsd:string .
nitf:ECSA a bddo:DataType ; rdfs:label "ECS-A (restricted to BCS-A subset)" ;
    bddo:baseType bddo:baseString ; bddo:encoding bddo:ascii ; bddo:xsdType xsd:string .

# ---------- Core enumerations (values verbatim from Table A-3) ----------
nitf:PVTYPEEnum a bddo:Enumeration ; rdfs:label "Pixel Value Type" ;
    bddo:hasEnumValue
      [ a bddo:EnumValue ; bddo:enumRawValue "INT" ] , [ a bddo:EnumValue ; bddo:enumRawValue "B" ] ,
      [ a bddo:EnumValue ; bddo:enumRawValue "SI" ] , [ a bddo:EnumValue ; bddo:enumRawValue "R" ] ,
      [ a bddo:EnumValue ; bddo:enumRawValue "C" ] .
nitf:IMODEEnum a bddo:Enumeration ; rdfs:label "Image Mode" ;
    bddo:hasEnumValue
      [ a bddo:EnumValue ; bddo:enumRawValue "B" ] , [ a bddo:EnumValue ; bddo:enumRawValue "P" ] ,
      [ a bddo:EnumValue ; bddo:enumRawValue "R" ] , [ a bddo:EnumValue ; bddo:enumRawValue "S" ] .
nitf:ICORDSEnum a bddo:Enumeration ; rdfs:label "Image Coordinate Representation" ;
    bddo:hasEnumValue
      [ a bddo:EnumValue ; bddo:enumRawValue "U" ] , [ a bddo:EnumValue ; bddo:enumRawValue "G" ] ,
      [ a bddo:EnumValue ; bddo:enumRawValue "N" ] , [ a bddo:EnumValue ; bddo:enumRawValue "S" ] ,
      [ a bddo:EnumValue ; bddo:enumRawValue "D" ] , [ a bddo:EnumValue ; bddo:enumRawValue " " ] .
nitf:IREPEnum a bddo:Enumeration ; rdfs:label "Image Representation" ;
    bddo:hasEnumValue
      [ a bddo:EnumValue ; bddo:enumRawValue "MONO" ] , [ a bddo:EnumValue ; bddo:enumRawValue "RGB" ] ,
      [ a bddo:EnumValue ; bddo:enumRawValue "RGB/LUT" ] , [ a bddo:EnumValue ; bddo:enumRawValue "MULTI" ] ,
      [ a bddo:EnumValue ; bddo:enumRawValue "NODISPLY" ] , [ a bddo:EnumValue ; bddo:enumRawValue "NVECTOR" ] ,
      [ a bddo:EnumValue ; bddo:enumRawValue "POLAR" ] , [ a bddo:EnumValue ; bddo:enumRawValue "VPH" ] ,
      [ a bddo:EnumValue ; bddo:enumRawValue "YCbCr601" ] .
nitf:ICEnum a bddo:Enumeration ; rdfs:label "Image Compression" ;
    bddo:hasEnumValue
      [ a bddo:EnumValue ; bddo:enumRawValue "NC" ] , [ a bddo:EnumValue ; bddo:enumRawValue "NM" ] ,
      [ a bddo:EnumValue ; bddo:enumRawValue "C1" ] , [ a bddo:EnumValue ; bddo:enumRawValue "C3" ] ,
      [ a bddo:EnumValue ; bddo:enumRawValue "C4" ] , [ a bddo:EnumValue ; bddo:enumRawValue "C5" ] ,
      [ a bddo:EnumValue ; bddo:enumRawValue "C6" ] , [ a bddo:EnumValue ; bddo:enumRawValue "C7" ] ,
      [ a bddo:EnumValue ; bddo:enumRawValue "C8" ] , [ a bddo:EnumValue ; bddo:enumRawValue "I1" ] ,
      [ a bddo:EnumValue ; bddo:enumRawValue "M1" ] , [ a bddo:EnumValue ; bddo:enumRawValue "M3" ] ,
      [ a bddo:EnumValue ; bddo:enumRawValue "M4" ] , [ a bddo:EnumValue ; bddo:enumRawValue "M5" ] ,
      [ a bddo:EnumValue ; bddo:enumRawValue "M6" ] , [ a bddo:EnumValue ; bddo:enumRawValue "M7" ] ,
      [ a bddo:EnumValue ; bddo:enumRawValue "M8" ] .
nitf:FSCLASEnum a bddo:Enumeration ; rdfs:label "Security Classification level" ;
    bddo:hasEnumValue
      [ a bddo:EnumValue ; bddo:enumRawValue "T" ] , [ a bddo:EnumValue ; bddo:enumRawValue "S" ] ,
      [ a bddo:EnumValue ; bddo:enumRawValue "C" ] , [ a bddo:EnumValue ; bddo:enumRawValue "R" ] ,
      [ a bddo:EnumValue ; bddo:enumRawValue "U" ] .

# ---------- Generic Tagged Record Extension (Table A-7) ----------
nitf:TRE a bddo:Struct ; rdfs:label "Tagged Record Extension" ;
    bddo:endianness bddo:BigEndian ;
    bddo:hasField ( nitf:TRE_CETAG nitf:TRE_CEL nitf:TRE_CEDATA ) .

nitf:TRE_CETAG a bddo:Field ; rdfs:label "CETAG/RETAG — 6-char tag" ;
    bddo:dataType nitf:BCSA ; bddo:size 6 .
nitf:TRE_CEL a bddo:Field ; rdfs:label "CEL/REL — length of CEDATA" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 5 .
nitf:TRE_CEDATA a bddo:Field ; rdfs:label "CEDATA/REDATA — user-defined data" ;
    bddo:dataType bddo:bytes ; bddo:sizeFromField nitf:TRE_CEL .

# ---------- NITF File Header (Table A-1) ----------
nitf:FileHeader a bddo:Struct ; rdfs:label "NITF File Header (Table A-1)" ;
    bddo:endianness bddo:BigEndian ;
    bddo:hasField (
      nitf:FH_FHDR nitf:FH_FVER nitf:FH_CLEVEL nitf:FH_STYPE nitf:FH_OSTAID nitf:FH_FDT nitf:FH_FTITLE
      nitf:FH_FSCLAS nitf:FH_FSCLSY nitf:FH_FSCODE nitf:FH_FSCTLH nitf:FH_FSREL nitf:FH_FSDCTP nitf:FH_FSDCDT
      nitf:FH_FSDCXM nitf:FH_FSDG nitf:FH_FSDGDT nitf:FH_FSCLTX nitf:FH_FSCATP nitf:FH_FSCAUT nitf:FH_FSCRSN
      nitf:FH_FSSRDT nitf:FH_FSCTLN nitf:FH_FSCOP nitf:FH_FSCPYS nitf:FH_ENCRYP nitf:FH_FBKGC nitf:FH_ONAME
      nitf:FH_OPHONE nitf:FH_FL nitf:FH_HL
      nitf:FH_NUMI nitf:FH_ImageSegTable
      nitf:FH_NUMS nitf:FH_GraphicSegTable
      nitf:FH_NUMX
      nitf:FH_NUMT nitf:FH_TextSegTable
      nitf:FH_NUMDES nitf:FH_DESegTable
      nitf:FH_NUMRES nitf:FH_RESegTable
      nitf:FH_UDHDL nitf:FH_UDHOFL nitf:FH_UDHD
      nitf:FH_XHDL nitf:FH_XHDLOFL nitf:FH_XHD
    ) .

# Fixed prefix (FHDR..FTITLE)
nitf:FH_FHDR a bddo:Field ; rdfs:label "FHDR — File Profile Name" ;
    bddo:dataType nitf:BCSA ; bddo:size 4 ; bddo:hasFixedValue "NITF" .
nitf:FH_FVER a bddo:Field ; rdfs:label "FVER — File Version" ;
    bddo:dataType nitf:BCSA ; bddo:size 5 ; bddo:hasFixedValue "02.10" .
nitf:FH_CLEVEL a bddo:Field ; rdfs:label "CLEVEL — Complexity Level" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 2 .
nitf:FH_STYPE a bddo:Field ; rdfs:label "STYPE — Standard Type" ;
    bddo:dataType nitf:BCSA ; bddo:size 4 ; bddo:hasFixedValue "BF01" .
nitf:FH_OSTAID a bddo:Field ; rdfs:label "OSTAID — Originating Station ID" ;
    bddo:dataType nitf:BCSA ; bddo:size 10 .
nitf:FH_FDT a bddo:Field ; rdfs:label "FDT — File Date and Time (CCYYMMDDhhmmss)" ;
    bddo:dataType nitf:BCSN ; bddo:size 14 .
nitf:FH_FTITLE a bddo:Field ; rdfs:label "FTITLE — File Title" ;
    bddo:dataType nitf:ECSA ; bddo:size 80 .

# Security block (FSCLAS..FSCTLN)
nitf:FH_FSCLAS a bddo:Field ; rdfs:label "FSCLAS — File Security Classification" ;
    bddo:dataType nitf:ECSA ; bddo:size 1 ; bddo:enumeration nitf:FSCLASEnum .
nitf:FH_FSCLSY a bddo:Field ; rdfs:label "FSCLSY — File Security Classification System" ;
    bddo:dataType nitf:ECSA ; bddo:size 2 .
nitf:FH_FSCODE a bddo:Field ; rdfs:label "FSCODE — File Codewords" ;
    bddo:dataType nitf:BCSA ; bddo:size 11 .
nitf:FH_FSCTLH a bddo:Field ; rdfs:label "FSCTLH — File Control and Handling" ;
    bddo:dataType nitf:ECSA ; bddo:size 2 .
nitf:FH_FSREL a bddo:Field ; rdfs:label "FSREL — File Releasing Instructions" ;
    bddo:dataType nitf:ECSA ; bddo:size 20 .
nitf:FH_FSDCTP a bddo:Field ; rdfs:label "FSDCTP — File Declassification Type" ;
    bddo:dataType nitf:ECSA ; bddo:size 2 .
nitf:FH_FSDCDT a bddo:Field ; rdfs:label "FSDCDT — File Declassification Date" ;
    bddo:dataType nitf:ECSA ; bddo:size 8 .
nitf:FH_FSDCXM a bddo:Field ; rdfs:label "FSDCXM — File Declassification Exemption" ;
    bddo:dataType nitf:ECSA ; bddo:size 4 .
nitf:FH_FSDG a bddo:Field ; rdfs:label "FSDG — File Downgrade" ;
    bddo:dataType nitf:ECSA ; bddo:size 1 .
nitf:FH_FSDGDT a bddo:Field ; rdfs:label "FSDGDT — File Downgrade Date" ;
    bddo:dataType nitf:ECSA ; bddo:size 8 .
nitf:FH_FSCLTX a bddo:Field ; rdfs:label "FSCLTX — File Classification Text" ;
    bddo:dataType nitf:ECSA ; bddo:size 43 .
nitf:FH_FSCATP a bddo:Field ; rdfs:label "FSCATP — File Classification Authority Type" ;
    bddo:dataType nitf:ECSA ; bddo:size 1 .
nitf:FH_FSCAUT a bddo:Field ; rdfs:label "FSCAUT — File Classification Authority" ;
    bddo:dataType nitf:ECSA ; bddo:size 40 .
nitf:FH_FSCRSN a bddo:Field ; rdfs:label "FSCRSN — File Classification Reason" ;
    bddo:dataType nitf:ECSA ; bddo:size 1 .
nitf:FH_FSSRDT a bddo:Field ; rdfs:label "FSSRDT — File Security Source Date" ;
    bddo:dataType nitf:ECSA ; bddo:size 8 .
nitf:FH_FSCTLN a bddo:Field ; rdfs:label "FSCTLN — File Security Control Number" ;
    bddo:dataType nitf:ECSA ; bddo:size 15 .

# Copies, encryption, background color, originator, lengths (FSCOP..HL)
nitf:FH_FSCOP a bddo:Field ; rdfs:label "FSCOP — File Copy Number" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 5 .
nitf:FH_FSCPYS a bddo:Field ; rdfs:label "FSCPYS — File Number of Copies" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 5 .
nitf:FH_ENCRYP a bddo:Field ; rdfs:label "ENCRYP — Encryption" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 1 .
nitf:FH_FBKGC a bddo:Field ; rdfs:label "FBKGC — File Background Color (RGB)" ;
    bddo:dataType bddo:bytes ; bddo:size 3 .
nitf:FH_ONAME a bddo:Field ; rdfs:label "ONAME — Originator's Name" ;
    bddo:dataType nitf:ECSA ; bddo:size 24 .
nitf:FH_OPHONE a bddo:Field ; rdfs:label "OPHONE — Originator's Phone Number" ;
    bddo:dataType nitf:ECSA ; bddo:size 18 .
nitf:FH_FL a bddo:Field ; rdfs:label "FL — File Length" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 12 .
nitf:FH_HL a bddo:Field ; rdfs:label "HL — NITF File Header Length" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 6 .

# Segment counts + segment-length tables (interleaved: count field then its table)
nitf:FH_NUMI a bddo:Field ; rdfs:label "NUMI — Number of Image Segments" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 3 .
nitf:FH_ImageSegTable a bddo:Field ; rdfs:label "Image segment length pairs (× NUMI)" ;
    bddo:dataType nitf:ImageSegLenPair ; bddo:repeatCountFromField nitf:FH_NUMI .
nitf:ImageSegLenPair a bddo:Struct ; rdfs:label "{ LISHn, LIn }" ;
    bddo:endianness bddo:BigEndian ; bddo:hasField ( nitf:FH_LISHn nitf:FH_LIn ) .
nitf:FH_LISHn a bddo:Field ; rdfs:label "LISHn — length of nth image subheader" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 6 .
nitf:FH_LIn a bddo:Field ; rdfs:label "LIn — length of nth image segment" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 10 .

nitf:FH_NUMS a bddo:Field ; rdfs:label "NUMS — Number of Graphic Segments" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 3 .
nitf:FH_GraphicSegTable a bddo:Field ; rdfs:label "Graphic segment length pairs (× NUMS)" ;
    bddo:dataType nitf:GraphicSegLenPair ; bddo:repeatCountFromField nitf:FH_NUMS .
nitf:GraphicSegLenPair a bddo:Struct ; rdfs:label "{ LSSHn, LSn }" ;
    bddo:endianness bddo:BigEndian ; bddo:hasField ( nitf:FH_LSSHn nitf:FH_LSn ) .
nitf:FH_LSSHn a bddo:Field ; rdfs:label "LSSHn — length of nth graphic subheader" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 4 .
nitf:FH_LSn a bddo:Field ; rdfs:label "LSn — length of nth graphic segment" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 6 .

nitf:FH_NUMX a bddo:Field ; rdfs:label "NUMX — Reserved for Future Use" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 3 .

nitf:FH_NUMT a bddo:Field ; rdfs:label "NUMT — Number of Text Segments" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 3 .
nitf:FH_TextSegTable a bddo:Field ; rdfs:label "Text segment length pairs (× NUMT)" ;
    bddo:dataType nitf:TextSegLenPair ; bddo:repeatCountFromField nitf:FH_NUMT .
nitf:TextSegLenPair a bddo:Struct ; rdfs:label "{ LTSHn, LTn }" ;
    bddo:endianness bddo:BigEndian ; bddo:hasField ( nitf:FH_LTSHn nitf:FH_LTn ) .
nitf:FH_LTSHn a bddo:Field ; rdfs:label "LTSHn — length of nth text subheader" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 4 .
nitf:FH_LTn a bddo:Field ; rdfs:label "LTn — length of nth text segment" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 5 .

nitf:FH_NUMDES a bddo:Field ; rdfs:label "NUMDES — Number of Data Extension Segments" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 3 .
nitf:FH_DESegTable a bddo:Field ; rdfs:label "DES length pairs (× NUMDES)" ;
    bddo:dataType nitf:DESegLenPair ; bddo:repeatCountFromField nitf:FH_NUMDES .
nitf:DESegLenPair a bddo:Struct ; rdfs:label "{ LDSHn, LDn }" ;
    bddo:endianness bddo:BigEndian ; bddo:hasField ( nitf:FH_LDSHn nitf:FH_LDn ) .
nitf:FH_LDSHn a bddo:Field ; rdfs:label "LDSHn — length of nth data extension segment subheader" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 4 .
nitf:FH_LDn a bddo:Field ; rdfs:label "LDn — length of nth data extension segment" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 9 .

nitf:FH_NUMRES a bddo:Field ; rdfs:label "NUMRES — Number of Reserved Extension Segments" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 3 .
nitf:FH_RESegTable a bddo:Field ; rdfs:label "RES length pairs (× NUMRES)" ;
    bddo:dataType nitf:RESegLenPair ; bddo:repeatCountFromField nitf:FH_NUMRES .
nitf:RESegLenPair a bddo:Struct ; rdfs:label "{ LRESHn, LREn }" ;
    bddo:endianness bddo:BigEndian ; bddo:hasField ( nitf:FH_LRESHn nitf:FH_LREn ) .
nitf:FH_LRESHn a bddo:Field ; rdfs:label "LRESHn — length of nth reserved extension segment subheader" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 4 .
nitf:FH_LREn a bddo:Field ; rdfs:label "LREn — length of nth reserved extension segment" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 7 .

# Extension areas: user-defined header and extended header TRE regions
nitf:FH_UDHDL a bddo:Field ; rdfs:label "UDHDL — User-Defined Header Data Length" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 5 .
nitf:FH_UDHOFL a bddo:Field ; rdfs:label "UDHOFL — user-defined header overflow" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 3 ; bddo:isPresentIf "UDHDL != '00000'" .
nitf:FH_UDHD a bddo:Field ; rdfs:label "UDHD — user-defined header data (TREs)" ;
    bddo:dataType nitf:TRE ; bddo:isPresentIf "UDHDL != '00000'" ;
    bddo:sizeFromExpression "UDHDL - 3" ; bddo:repeatUntil "end-of-region" .

nitf:FH_XHDL a bddo:Field ; rdfs:label "XHDL — Extended Header Data Length" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 5 .
nitf:FH_XHDLOFL a bddo:Field ; rdfs:label "XHDLOFL — extended header overflow" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 3 ; bddo:isPresentIf "XHDL != '00000'" .
nitf:FH_XHD a bddo:Field ; rdfs:label "XHD — extended header data (TREs)" ;
    bddo:dataType nitf:TRE ; bddo:isPresentIf "XHDL != '00000'" ;
    bddo:sizeFromExpression "XHDL - 3" ; bddo:repeatUntil "end-of-region" .

# ---------- NITF Image Subheader (Table A-3) ----------
nitf:ImageSubheader a bddo:Struct ; rdfs:label "NITF Image Subheader (Table A-3)" ;
    bddo:endianness bddo:BigEndian ;
    bddo:hasField (
      nitf:IS_IM nitf:IS_IID1 nitf:IS_IDATIM nitf:IS_TGTID nitf:IS_IID2
      nitf:IS_ISCLAS nitf:IS_ISCLSY nitf:IS_ISCODE nitf:IS_ISCTLH nitf:IS_ISREL nitf:IS_ISDCTP nitf:IS_ISDCDT
      nitf:IS_ISDCXM nitf:IS_ISDG nitf:IS_ISDGDT nitf:IS_ISCLTX nitf:IS_ISCATP nitf:IS_ISCAUT nitf:IS_ISCRSN
      nitf:IS_ISSRDT nitf:IS_ISCTLN
      nitf:IS_ENCRYP nitf:IS_ISORCE
      nitf:IS_NROWS nitf:IS_NCOLS
      nitf:IS_PVTYPE nitf:IS_IREP nitf:IS_ICAT nitf:IS_ABPP nitf:IS_PJUST
      nitf:IS_ICORDS nitf:IS_IGEOLO
      nitf:IS_NICOM nitf:IS_ICOM
      nitf:IS_IC nitf:IS_COMRAT
      nitf:IS_NBANDS nitf:IS_XBANDS nitf:IS_BandTable
      nitf:IS_ISYNC nitf:IS_IMODE
      nitf:IS_NBPR nitf:IS_NBPC nitf:IS_NPPBH nitf:IS_NPPBV nitf:IS_NBPP
      nitf:IS_IDLVL nitf:IS_IALVL nitf:IS_ILOC nitf:IS_IMAG
      nitf:IS_UDIDL nitf:IS_UDOFL nitf:IS_UDID
      nitf:IS_IXSHDL nitf:IS_IXSOFL nitf:IS_IXSHD
    ) .

# Fixed prefix (IM..IID2)
nitf:IS_IM a bddo:Field ; rdfs:label "IM — File Part Type" ;
    bddo:dataType nitf:BCSA ; bddo:size 2 ; bddo:hasFixedValue "IM" .
nitf:IS_IID1 a bddo:Field ; rdfs:label "IID1 — Image Identifier 1" ;
    bddo:dataType nitf:BCSA ; bddo:size 10 .
nitf:IS_IDATIM a bddo:Field ; rdfs:label "IDATIM — Image Date and Time (CCYYMMDDhhmmss)" ;
    bddo:dataType nitf:BCSN ; bddo:size 14 .
nitf:IS_TGTID a bddo:Field ; rdfs:label "TGTID — Target Identifier" ;
    bddo:dataType nitf:BCSA ; bddo:size 17 .
nitf:IS_IID2 a bddo:Field ; rdfs:label "IID2 — Image Identifier 2" ;
    bddo:dataType nitf:ECSA ; bddo:size 80 .

# Security block (ISCLAS..ISCTLN) — identical sizes to FS* block; ISCODE is ECS-A here (unlike file FSCODE)
nitf:IS_ISCLAS a bddo:Field ; rdfs:label "ISCLAS — Image Security Classification" ;
    bddo:dataType nitf:ECSA ; bddo:size 1 ; bddo:enumeration nitf:FSCLASEnum .
nitf:IS_ISCLSY a bddo:Field ; rdfs:label "ISCLSY — Image Security Classification System" ;
    bddo:dataType nitf:ECSA ; bddo:size 2 .
nitf:IS_ISCODE a bddo:Field ; rdfs:label "ISCODE — Image Codewords" ;
    bddo:dataType nitf:ECSA ; bddo:size 11 .
nitf:IS_ISCTLH a bddo:Field ; rdfs:label "ISCTLH — Image Control and Handling" ;
    bddo:dataType nitf:ECSA ; bddo:size 2 .
nitf:IS_ISREL a bddo:Field ; rdfs:label "ISREL — Image Releasing Instructions" ;
    bddo:dataType nitf:ECSA ; bddo:size 20 .
nitf:IS_ISDCTP a bddo:Field ; rdfs:label "ISDCTP — Image Declassification Type" ;
    bddo:dataType nitf:ECSA ; bddo:size 2 .
nitf:IS_ISDCDT a bddo:Field ; rdfs:label "ISDCDT — Image Declassification Date" ;
    bddo:dataType nitf:ECSA ; bddo:size 8 .
nitf:IS_ISDCXM a bddo:Field ; rdfs:label "ISDCXM — Image Declassification Exemption" ;
    bddo:dataType nitf:ECSA ; bddo:size 4 .
nitf:IS_ISDG a bddo:Field ; rdfs:label "ISDG — Image Downgrade" ;
    bddo:dataType nitf:ECSA ; bddo:size 1 .
nitf:IS_ISDGDT a bddo:Field ; rdfs:label "ISDGDT — Image Downgrade Date" ;
    bddo:dataType nitf:ECSA ; bddo:size 8 .
nitf:IS_ISCLTX a bddo:Field ; rdfs:label "ISCLTX — Image Classification Text" ;
    bddo:dataType nitf:ECSA ; bddo:size 43 .
nitf:IS_ISCATP a bddo:Field ; rdfs:label "ISCATP — Image Classification Authority Type" ;
    bddo:dataType nitf:ECSA ; bddo:size 1 .
nitf:IS_ISCAUT a bddo:Field ; rdfs:label "ISCAUT — Image Classification Authority" ;
    bddo:dataType nitf:ECSA ; bddo:size 40 .
nitf:IS_ISCRSN a bddo:Field ; rdfs:label "ISCRSN — Image Classification Reason" ;
    bddo:dataType nitf:ECSA ; bddo:size 1 .
nitf:IS_ISSRDT a bddo:Field ; rdfs:label "ISSRDT — Image Security Source Date" ;
    bddo:dataType nitf:ECSA ; bddo:size 8 .
nitf:IS_ISCTLN a bddo:Field ; rdfs:label "ISCTLN — Image Security Control Number" ;
    bddo:dataType nitf:ECSA ; bddo:size 15 .

# Encryption, source, dimensions, pixel representation
nitf:IS_ENCRYP a bddo:Field ; rdfs:label "ENCRYP — Encryption" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 1 .
nitf:IS_ISORCE a bddo:Field ; rdfs:label "ISORCE — Image Source" ;
    bddo:dataType nitf:ECSA ; bddo:size 42 .
nitf:IS_NROWS a bddo:Field ; rdfs:label "NROWS — Number of Significant Rows in image" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 8 .
nitf:IS_NCOLS a bddo:Field ; rdfs:label "NCOLS — Number of Significant Columns in image" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 8 .
nitf:IS_PVTYPE a bddo:Field ; rdfs:label "PVTYPE — Pixel Value Type" ;
    bddo:dataType nitf:BCSA ; bddo:size 3 ; bddo:enumeration nitf:PVTYPEEnum .
nitf:IS_IREP a bddo:Field ; rdfs:label "IREP — Image Representation" ;
    bddo:dataType nitf:BCSA ; bddo:size 8 ; bddo:enumeration nitf:IREPEnum .
nitf:IS_ICAT a bddo:Field ; rdfs:label "ICAT — Image Category" ;
    bddo:dataType nitf:BCSA ; bddo:size 8 .
nitf:IS_ABPP a bddo:Field ; rdfs:label "ABPP — Actual Bits-Per-Pixel Per Band" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 2 .
nitf:IS_PJUST a bddo:Field ; rdfs:label "PJUST — Pixel Justification" ;
    bddo:dataType nitf:BCSA ; bddo:size 1 .

# Coordinates
nitf:IS_ICORDS a bddo:Field ; rdfs:label "ICORDS — Image Coordinate Representation" ;
    bddo:dataType nitf:BCSA ; bddo:size 1 ; bddo:enumeration nitf:ICORDSEnum .
nitf:IS_IGEOLO a bddo:Field ; rdfs:label "IGEOLO — Image Geographic Location" ;
    bddo:dataType nitf:BCSA ; bddo:size 60 ; bddo:isPresentIf "ICORDS != ' '" .

# Comments (repeat loop driven by NICOM)
nitf:IS_NICOM a bddo:Field ; rdfs:label "NICOM — Number of Image Comments" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 1 .
nitf:IS_ICOM a bddo:Field ; rdfs:label "ICOMn — Image Comment n (× NICOM)" ;
    bddo:dataType nitf:ECSA ; bddo:size 80 ; bddo:repeatCountFromField nitf:IS_NICOM .

# Compression
nitf:IS_IC a bddo:Field ; rdfs:label "IC — Image Compression" ;
    bddo:dataType nitf:BCSA ; bddo:size 2 ; bddo:enumeration nitf:ICEnum .
nitf:IS_COMRAT a bddo:Field ; rdfs:label "COMRAT — Compression Rate Code" ;
    bddo:dataType nitf:BCSA ; bddo:size 4 ; bddo:isPresentIf "IC not in (NC, NM)" .

# Bands (repeat loop driven by NBANDS; XBANDS present only when NBANDS overflows to 0)
nitf:IS_NBANDS a bddo:Field ; rdfs:label "NBANDS — Number of Bands" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 1 .
nitf:IS_XBANDS a bddo:Field ; rdfs:label "XBANDS — Number of Multispectral Bands" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 5 ; bddo:isPresentIf "NBANDS == 0" .
nitf:IS_BandTable a bddo:Field ; rdfs:label "Band records (× NBANDS)" ;
    bddo:dataType nitf:ImageBand ; bddo:repeatCountFromField nitf:IS_NBANDS .

nitf:ImageBand a bddo:Struct ; rdfs:label "Image band record (Table A-3 band loop)" ;
    bddo:endianness bddo:BigEndian ;
    bddo:hasField ( nitf:IB_IREPBAND nitf:IB_ISUBCAT nitf:IB_IFC nitf:IB_IMFLT nitf:IB_NLUTS ) .
nitf:IB_IREPBAND a bddo:Field ; rdfs:label "IREPBANDn" ; bddo:dataType nitf:BCSA ; bddo:size 2 .
nitf:IB_ISUBCAT a bddo:Field ; rdfs:label "ISUBCATn" ; bddo:dataType nitf:BCSA ; bddo:size 6 .
nitf:IB_IFC a bddo:Field ; rdfs:label "IFCn" ; bddo:dataType nitf:BCSA ; bddo:size 1 .
nitf:IB_IMFLT a bddo:Field ; rdfs:label "IMFLTn" ; bddo:dataType nitf:BCSA ; bddo:size 3 .
nitf:IB_NLUTS a bddo:Field ; rdfs:label "NLUTSn (LUT sub-loop omitted in cut #1)" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 1 ;
    rdfs:comment "When NLUTSn != 0, NELUTn(5) + LUTDnm data follow; LUT body deferred (see design non-goals)." .

# Sync, mode, blocking
nitf:IS_ISYNC a bddo:Field ; rdfs:label "ISYNC — Image Sync Code" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 1 .
nitf:IS_IMODE a bddo:Field ; rdfs:label "IMODE — Image Mode" ;
    bddo:dataType nitf:BCSA ; bddo:size 1 ; bddo:enumeration nitf:IMODEEnum .
nitf:IS_NBPR a bddo:Field ; rdfs:label "NBPR — Number of Blocks Per Row" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 4 .
nitf:IS_NBPC a bddo:Field ; rdfs:label "NBPC — Number of Blocks Per Column" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 4 .
nitf:IS_NPPBH a bddo:Field ; rdfs:label "NPPBH — Number of Pixels Per Block Horizontal" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 4 .
nitf:IS_NPPBV a bddo:Field ; rdfs:label "NPPBV — Number of Pixels Per Block Vertical" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 4 .
nitf:IS_NBPP a bddo:Field ; rdfs:label "NBPP — Number of Bits Per Pixel Per Band" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 2 .

# Display level, attachment, location, magnification
nitf:IS_IDLVL a bddo:Field ; rdfs:label "IDLVL — Image Display Level" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 3 .
nitf:IS_IALVL a bddo:Field ; rdfs:label "IALVL — Image Attachment Level" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 3 .
nitf:IS_ILOC a bddo:Field ; rdfs:label "ILOC — Image Location" ;
    bddo:dataType nitf:BCSN ; bddo:size 10 .
nitf:IS_IMAG a bddo:Field ; rdfs:label "IMAG — Image Magnification" ;
    bddo:dataType nitf:BCSA ; bddo:size 4 .

# Extension areas: user-defined image data and extended subheader TRE regions
nitf:IS_UDIDL a bddo:Field ; rdfs:label "UDIDL — User-Defined Image Data Length" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 5 .
nitf:IS_UDOFL a bddo:Field ; rdfs:label "UDOFL — user-defined image data overflow" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 3 ; bddo:isPresentIf "UDIDL != '00000'" .
nitf:IS_UDID a bddo:Field ; rdfs:label "UDID — user-defined image data (TREs)" ;
    bddo:dataType nitf:TRE ; bddo:isPresentIf "UDIDL != '00000'" ;
    bddo:sizeFromExpression "UDIDL - 3" ; bddo:repeatUntil "end-of-region" .

nitf:IS_IXSHDL a bddo:Field ; rdfs:label "IXSHDL — Image Extended Subheader Data Length" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 5 .
nitf:IS_IXSOFL a bddo:Field ; rdfs:label "IXSOFL — image extended subheader overflow" ;
    bddo:dataType nitf:BCSNpos ; bddo:size 3 ; bddo:isPresentIf "IXSHDL != '00000'" .
nitf:IS_IXSHD a bddo:Field ; rdfs:label "IXSHD — image extended subheader data (TREs)" ;
    bddo:dataType nitf:TRE ; bddo:isPresentIf "IXSHDL != '00000'" ;
    bddo:sizeFromExpression "IXSHDL - 3" ; bddo:repeatUntil "end-of-region" .
