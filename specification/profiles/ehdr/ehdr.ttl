# Hexplain Profile — ESRI .hdr labelled raster (EHdr) 1.0
#
# The second instance of the raw-grid-plus-sidecar family, written from the ENVI template to
# see how much of it transfers. Nearly all of it does; the differences are all in the header
# dialect, which is the point -- roughly twenty GDAL drivers vary only there.
#
# Differences worth noting against ENVI:
#   * The separator is a SPACE, not "=". `NROWS 400`, not `NROWS = 400`. Splitting at the
#     FIRST separator plus trimWhitespace makes the aligned form read identically, so the
#     same KeyValueHeader machinery covers both dialects with one property changed.
#   * BYTEORDER is "I"/"M" (Intel/Motorola), not 0/1 -- a string enum rather than numeric.
#   * The grid file's suffix varies with LAYOUT (.bil/.bip/.bsq, or .flt when floating
#     point), so its PartSpec carries several alternative extensions rather than one.
#   * It georeferences: ULXMAP/ULYMAP/XDIM/YDIM map onto hx-spatialref.
#
#   NROWS 400
#   NCOLS 500
#   NBANDS 1
#   NBITS 8
#   BYTEORDER I
#   LAYOUT BIL
#   SKIPBYTES 0
#   ULXMAP -122.5
#   ULYMAP 47.8
#   XDIM 0.01
#   YDIM 0.01
#   NODATA -9999
#
@prefix ehdr:    <https://hexplain.io/ns/profile/ehdr#> .
@prefix bddo:    <https://hexplain.io/ns/bddo#> .
@prefix dlv:     <https://hexplain.io/ns/dlv#> .
@prefix hexplain:<https://hexplain.io/ns/core#> .
@prefix abnd:    <https://hexplain.io/ns/aspect/bundle#> .
@prefix rpr:     <https://hexplain.io/ns/register/part-role#> .
@prefix araster: <https://hexplain.io/ns/aspect/raster#> .
@prefix asamp:   <https://hexplain.io/ns/aspect/sampling#> .
@prefix asref:   <https://hexplain.io/ns/aspect/spatialref#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .

<https://hexplain.io/ns/profile/ehdr> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/profile/ehdr/1.0> ; owl:versionInfo "1.0" ;
    owl:imports <https://hexplain.io/ns/aspect/bundle> ;
    rdfs:label "Hexplain Profile — ESRI .hdr labelled raster (EHdr)" ;
    rdfs:comment "Two-part raster: a space-separated KEYWORD value text header beside a headerless binary grid, bound by shared basename." ;
    dcterms:created "2026-08-09"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "ehdr" ; vann:preferredNamespaceUri "https://hexplain.io/ns/profile/ehdr#" .

<https://hexplain.io/ns/profile/ehdr> hexplain:usesRegister
    [ a hexplain:RegisterBinding ; hexplain:forProperty abnd:partRole ;
      hexplain:register rpr:PartRoleScheme ] .

# ---------- The .hdr text header ----------
# keyValueSeparator is a single SPACE (20). Authors align values with runs of spaces, which
# trimWhitespace absorbs, so `NROWS   400` and `NROWS 400` read alike. Keywords are written
# uppercase by convention but matched case-insensitively, as GDAL does.
ehdr:Header a bddo:KeyValueHeader ; rdfs:label "ESRI .hdr header" ;
    bddo:recordDelimiter "0A"^^xsd:hexBinary ;
    bddo:keyValueSeparator "20"^^xsd:hexBinary ;
    bddo:trimWhitespace true ;
    bddo:keyIsCaseInsensitive true ;
    bddo:hasField ( ehdr:Header.nrows ehdr:Header.ncols ehdr:Header.nbands ehdr:Header.nbits
                    ehdr:Header.byteOrder ehdr:Header.layout ehdr:Header.skipBytes
                    ehdr:Header.ulxMap ehdr:Header.ulyMap ehdr:Header.xDim ehdr:Header.yDim
                    ehdr:Header.noData ) .

ehdr:Header.nrows a bddo:Field ; rdfs:label "NROWS — number of rows" ;
    bddo:key "NROWS" ; bddo:dataType bddo:asciiInteger ; bddo:terminator "0A"^^xsd:hexBinary ;
    hexplain:mapsToProperty araster:height .
ehdr:Header.ncols a bddo:Field ; rdfs:label "NCOLS — number of columns" ;
    bddo:key "NCOLS" ; bddo:dataType bddo:asciiInteger ; bddo:terminator "0A"^^xsd:hexBinary ;
    hexplain:mapsToProperty araster:width .
ehdr:Header.nbands a bddo:Field ; rdfs:label "NBANDS — number of bands" ;
    bddo:key "NBANDS" ; bddo:dataType bddo:asciiInteger ; bddo:terminator "0A"^^xsd:hexBinary ;
    hexplain:mapsToProperty asamp:componentCount .
ehdr:Header.nbits a bddo:Field ; rdfs:label "NBITS — bits per sample" ;
    bddo:key "NBITS" ; bddo:dataType bddo:asciiInteger ; bddo:terminator "0A"^^xsd:hexBinary ;
    hexplain:mapsToProperty asamp:bitDepth .

ehdr:Header.byteOrder a bddo:Field ; rdfs:label "BYTEORDER — I (Intel) or M (Motorola)" ;
    bddo:key "BYTEORDER" ; bddo:dataType bddo:string ; bddo:encoding bddo:ascii ;
    bddo:terminator "0A"^^xsd:hexBinary ; bddo:enumeration ehdr:ByteOrderEnum .
ehdr:Header.layout a bddo:Field ; rdfs:label "LAYOUT — BIL, BIP or BSQ" ;
    bddo:key "LAYOUT" ; bddo:dataType bddo:string ; bddo:encoding bddo:ascii ;
    bddo:terminator "0A"^^xsd:hexBinary ; bddo:enumeration ehdr:LayoutEnum .
ehdr:Header.skipBytes a bddo:Field ; rdfs:label "SKIPBYTES — bytes to skip before the grid" ;
    bddo:key "SKIPBYTES" ; bddo:dataType bddo:asciiInteger ; bddo:terminator "0A"^^xsd:hexBinary .

# Georeferencing. ULXMAP/ULYMAP are the map coordinates of the CENTRE of the upper-left
# pixel, so registration is pixel-centre; see limit 4 on the property names.
ehdr:Header.ulxMap a bddo:Field ; rdfs:label "ULXMAP — x of upper-left pixel centre" ;
    bddo:key "ULXMAP" ; bddo:dataType bddo:asciiDecimal ; bddo:terminator "0A"^^xsd:hexBinary ;
    hexplain:mapsToProperty asref:originLongitude .
ehdr:Header.ulyMap a bddo:Field ; rdfs:label "ULYMAP — y of upper-left pixel centre" ;
    bddo:key "ULYMAP" ; bddo:dataType bddo:asciiDecimal ; bddo:terminator "0A"^^xsd:hexBinary ;
    hexplain:mapsToProperty asref:originLatitude .
ehdr:Header.xDim a bddo:Field ; rdfs:label "XDIM — pixel width in map units" ;
    bddo:key "XDIM" ; bddo:dataType bddo:asciiDecimal ; bddo:terminator "0A"^^xsd:hexBinary ;
    hexplain:mapsToProperty asref:scaleX .
ehdr:Header.yDim a bddo:Field ; rdfs:label "YDIM — pixel height in map units" ;
    bddo:key "YDIM" ; bddo:dataType bddo:asciiDecimal ; bddo:terminator "0A"^^xsd:hexBinary ;
    hexplain:mapsToProperty asref:scaleY .

ehdr:Header.noData a bddo:Field ; rdfs:label "NODATA — value denoting absent data" ;
    bddo:key "NODATA" ; bddo:dataType bddo:asciiDecimal ; bddo:terminator "0A"^^xsd:hexBinary ;
    hexplain:mapsToProperty araster:noDataValue .

ehdr:ByteOrderEnum a bddo:Enumeration ; rdfs:label "EHdr byte order" ;
    bddo:hasEnumValue
      [ a bddo:EnumValue ; bddo:enumRawValue "I" ; rdfs:label "Intel (little-endian)" ] ,
      [ a bddo:EnumValue ; bddo:enumRawValue "M" ; rdfs:label "Motorola (big-endian)" ] .

ehdr:LayoutEnum a bddo:Enumeration ; rdfs:label "EHdr band layout" ;
    bddo:hasEnumValue
      [ a bddo:EnumValue ; bddo:enumRawValue "BIL" ; rdfs:label "Band interleaved by line" ] ,
      [ a bddo:EnumValue ; bddo:enumRawValue "BIP" ; rdfs:label "Band interleaved by pixel" ] ,
      [ a bddo:EnumValue ; bddo:enumRawValue "BSQ" ; rdfs:label "Band sequential" ] .

# ---------- The binary grid ----------
ehdr:Raster a bddo:Struct ; rdfs:label "EHdr raster grid" ;
    bddo:hasConditionalEndianness (
        [ a bddo:EndiannessRule ; bddo:condition "asset.Header.byteOrder == 'I'" ;
          bddo:ruleEndianness bddo:LittleEndian ]
        [ a bddo:EndiannessRule ; bddo:condition "asset.Header.byteOrder == 'M'" ;
          bddo:ruleEndianness bddo:BigEndian ]
    ) ;
    bddo:hasField ( ehdr:Raster.pixels ) .

ehdr:Raster.pixels a bddo:Field ; rdfs:label "the sample grid" ;
    bddo:dataType bddo:bytes ;
    bddo:atOffsetFromField ehdr:Header.skipBytes ; bddo:offsetBase bddo:streamStart ;
    bddo:sizeToEndOfStream true ;
    hexplain:hasDataLayout ehdr:Grid .

# LAYOUT chooses the axis order and NBITS the cell type, so both are conditional. The three
# orders permute the SAME three Dimension nodes -- band interleaving is a permutation, not a
# different set of axes -- which is why these are two independent conditionals rather than
# one conditional layout per (LAYOUT, NBITS) pair.
ehdr:Grid a dlv:DataLayout ; rdfs:label "EHdr sample grid" ;
    dlv:hasConditionalCellDataType (
        [ a dlv:CellDataTypeRule ; bddo:condition "asset.Header.nbits == 8"  ; dlv:ruleCellDataType bddo:uint8 ]
        [ a dlv:CellDataTypeRule ; bddo:condition "asset.Header.nbits == 16" ; dlv:ruleCellDataType bddo:uint16 ]
        [ a dlv:CellDataTypeRule ; bddo:condition "asset.Header.nbits == 32" ; dlv:ruleCellDataType bddo:uint32 ]
    ) ;
    dlv:hasConditionalDimensionOrder (
        [ a dlv:DimensionOrderRule ; bddo:condition "asset.Header.layout == 'BIL'" ;
          dlv:ruleDimensionOrder ( ehdr:DimY ehdr:DimBand ehdr:DimX ) ]
        [ a dlv:DimensionOrderRule ; bddo:condition "asset.Header.layout == 'BIP'" ;
          dlv:ruleDimensionOrder ( ehdr:DimY ehdr:DimX ehdr:DimBand ) ]
        [ a dlv:DimensionOrderRule ; bddo:condition "asset.Header.layout == 'BSQ'" ;
          dlv:ruleDimensionOrder ( ehdr:DimBand ehdr:DimY ehdr:DimX ) ]
    ) .

ehdr:DimY a dlv:Dimension ; dlv:hasAxis dlv:axisY ;
    dlv:dimensionSizeFromField ehdr:Header.nrows .
ehdr:DimBand a dlv:Dimension ; dlv:hasAxis dlv:axisBand ;
    dlv:dimensionSizeFromField ehdr:Header.nbands .
ehdr:DimX a dlv:Dimension ; dlv:hasAxis dlv:axisX ;
    dlv:dimensionSizeFromField ehdr:Header.ncols .

# ---------- Bundle ----------
ehdr:EHdr a abnd:BundleProfile ; rdfs:label "ESRI .hdr labelled raster" ;
    abnd:boundBy abnd:NamingConvention ;
    abnd:partSpec ehdr:hdrSpec , ehdr:gridSpec , ehdr:prjSpec .

ehdr:hdrSpec a abnd:PartSpec ; abnd:extension ".hdr" ; abnd:partRole rpr:Metadata ;
    abnd:required true ; abnd:describedBy ehdr:Header ;
    abnd:carriesAspect <https://hexplain.io/ns/aspect/raster> .

# One part, four possible suffixes: the grid file is named for its LAYOUT, or .flt when the
# samples are floating point. Alternatives, not four separate members.
ehdr:gridSpec a abnd:PartSpec ;
    abnd:extension ".bil" , ".bip" , ".bsq" , ".flt" ;
    abnd:partRole rpr:Payload ; abnd:required true ; abnd:primary true ;
    abnd:describedBy ehdr:Raster .

ehdr:prjSpec a abnd:PartSpec ; abnd:extension ".prj" ; abnd:partRole rpr:SpatialReference ;
    abnd:required false ; abnd:carriesAspect <https://hexplain.io/ns/aspect/spatialref> .

# ---------- LIMITS OF THIS DESCRIPTION ----------
# 1. .flt IS NOT DISTINGUISHED. NBITS 32 selects uint32 above, but the same width means
#    float32 when the grid file is .flt. The cell-type rules condition on header fields; no
#    condition can name which of the PartSpec's alternative extensions the part matched.
# 2. PIXELTYPE (SIGNEDINT/UNSIGNEDINT/FLOAT) is not modelled. asamp:sampleFormat exists and
#    would be its target; it is omitted only because it is an optional GDAL extension
#    keyword rather than part of the base dialect.
# 3. ULXMAP/ULYMAP MAP ONTO GEOGRAPHIC-NAMED PROPERTIES. hx-spatialref offers
#    originLongitude/originLatitude, but an EHdr origin is in whatever CRS the .prj names --
#    projected metres as often as degrees. The values are right and the property names are
#    too narrow; a generic originX/originY (and the full six-coefficient affine, since these
#    four keywords cannot express rotation) is survey item P2-11.
