{
  "codec": "https://hexplain.io/ns/register/media-encoding#LZ4",
  "suiteVersion": 2,
  "sources": [
    {
      "id": "reference-libraries",
      "url": "https://github.com/lz4/lz4",
      "description": "Written by python-lz4 1.9.4 (liblz4 1.9.4), python-zstandard 0.25 (zstd 1.5) and CPython's lzma module (liblzma 5) through hexplain-tools codecs/lz/src/test/resources/codec/generate_vectors.py and codecs/xz/src/test/resources/codec/generate_xz_vectors.py; single-byte corruptions, truncations and concatenations made here.",
      "licence": "BSD-2-Clause (liblz4), BSD-3-Clause (zstd, python-zstandard), 0BSD (liblzma); inputs CC0-1.0"
    },
    {
      "id": "hand-built",
      "url": "https://github.com/lz4/lz4/blob/dev/doc/lz4_Frame_format.md",
      "description": "Frames built byte by byte here from the LZ4 Frame Format Description 1.6.4 and RFC 8878 (Zstandard). Their blocks keep the LZ4 block format's end-of-block rules (the last five bytes are literals, and the last match starts at least twelve bytes before the end of the block); the overlapping-match frame (suite version 2) was checked with liblz4 1.9.4 through python-lz4, as a frame and as a bare block.",
      "licence": "CC0-1.0"
    },
    {
      "id": "round-trip",
      "url": "https://hexplain.io/specification/processing/#round-trip",
      "description": "Round trips worked by hand from the codec's definition (a transform) or fed through the previous step's output (a compressor, whose encoded bytes are the implementation's own: the encode step expects success only, and the decode step reads its output back to the input).",
      "licence": "CC0-1.0"
    }
  ],
