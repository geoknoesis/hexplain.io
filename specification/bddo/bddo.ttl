# Binary Data Description Ontology (BDDO) 1.3 — vocabulary + SHACL shapes
# Canonical machine-readable artifact. Namespace: https://hexplain.io/ns/bddo#
# Modeling: properties declare rdfs:range (value type). Domain and cardinality
# are expressed in SHACL only (no rdfs:domain), to avoid over-committing subjects.
@prefix :       <https://hexplain.io/ns/bddo#> .
@prefix bddo:   <https://hexplain.io/ns/bddo#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .

<https://hexplain.io/ns/bddo> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/bddo/1.3> ;
    owl:versionInfo "1.3" ;
    owl:priorVersion <https://hexplain.io/ns/bddo/1.2> ;
    dcterms:modified "2026-09-24"^^xsd:date ;
    rdfs:label "Binary Data Description Ontology (BDDO)" ;
    rdfs:comment "Vocabulary for declaratively describing the physical structure of binary data." ;
    dcterms:created "2025-08-16"^^xsd:date ;
    dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "bddo" ;
    vann:preferredNamespaceUri "https://hexplain.io/ns/bddo#" .

# ---------- Classes ----------
:Struct       a owl:Class ; rdfs:label "Struct" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "An ordered sequence of fields; a container in a binary format." .
:Field        a owl:Class ; rdfs:label "Field" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "A single element within a Struct: a value, a bit slice, or an array." .
:DataType     a owl:Class ; rdfs:label "Data Type" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> .
:DataTypeRule a owl:Class ; rdfs:label "Data Type Rule" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> .
:Enumeration  a owl:Class ; rdfs:label "Enumeration" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> .
:EnumValue    a owl:Class ; rdfs:label "Enumeration Value" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> .
:Checksum     a owl:Class ; rdfs:label "Checksum" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "A checksum/hash over a byte range. Each END of the range is stated independently: a field reference (coversFromField/coversToField) or a HEL expression yielding a byte offset (coversFromExpression/coversToExpression). The two ends may use different mechanisms -- a checksum covering everything from a named header field to a length carried elsewhere needs exactly that. Note the boundary convention differs by mechanism, because each follows what its inputs naturally give: the field form runs from the FIRST byte of coversFromField to the LAST byte of coversToField (inclusive), while the expression form is the half-open [start,end) that the two offsets delimit." .
:EndiannessRule a owl:Class ; rdfs:label "Endianness Rule" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "One arm of a hasConditionalEndianness list: a HEL condition and the byte order it selects." .
:DispatchTable a owl:Class ; rdfs:label "Dispatch Table" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "A keyed, open selection of a Field's effective type. The value of the key (dispatchOnField or dispatchOnExpression) is matched by equality against the armKey of the table's DispatchArms; the matching arm's armDataType is the effective type, else dispatchDefault, else the Field's dataType. Arms are independent resources rather than list members, so a description that imports this one can contribute an arm without rewriting anything. Contrast hasConditionalDataType, whose ordered predicate rules are closed and may overlap." .
:DispatchArm a owl:Class ; rdfs:label "Dispatch Arm" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "One key-to-type association of a DispatchTable: the type a field takes when the table's key equals armKey. Keys are unique within a table across every graph that contributes to it." .
:SeekScope a owl:Class ; rdfs:label "Seek Scope" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "How far an offset-addressed read may reach: the innermost bounded region (the default, regionScope) or the whole stream (streamScope)." .
# A struct that is instantiated with values: the same row layout used for several widths, or a
# record whose element count is carried by the struct that holds it. Parameters are named like
# fields (by the simple key of their IRI) and read in HEL through the root `param`.
:Parameter a owl:Class ; rdfs:label "Parameter" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "One formal parameter of a parameterised Struct, a member of its bddo:hasParameter list. Its name is the simple key of its IRI (the local name after the last '.'), as for a Field; HEL reads the value the caller supplied as param.<name>. A parameter consumes no bytes, is not a field of the parsed tree and is never lifted." .
# A named intermediate value, computed once where it stands in the member list. It is a member
# of hasField (so its position, and therefore what it may read and what may read it, is the
# list order) but not a field: it consumes no bytes and is neither in the parsed tree nor lifted.
:ParameterType a owl:Class ; rdfs:label "Parameter Type" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The kind of HEL value a Parameter accepts: one of the five individuals below, one per HEL scalar value type." .
:IntegerParameter a owl:NamedIndividual, :ParameterType ; rdfs:label "Integer parameter" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The parameter accepts a HEL Integer." .
:FloatParameter a owl:NamedIndividual, :ParameterType ; rdfs:label "Float parameter" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The parameter accepts a HEL Float; an Integer argument is converted to the Float of the same value." .
:StringParameter a owl:NamedIndividual, :ParameterType ; rdfs:label "String parameter" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The parameter accepts a HEL String." .
:BytesParameter a owl:NamedIndividual, :ParameterType ; rdfs:label "Bytes parameter" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The parameter accepts a HEL Bytes value." .
:BooleanParameter a owl:NamedIndividual, :ParameterType ; rdfs:label "Boolean parameter" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The parameter accepts a HEL Boolean." .
:LocalBinding a owl:Class ; rdfs:label "Local Binding" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "A named HEL value local to one Struct instance: a member of the struct's bddo:hasField list whose bddo:localExpression is evaluated when its position in the list is reached, in the struct's context. Later members, and the struct's own size, count, offset and presence expressions evaluated after it, read it by bare name or instance.<name>. It consumes no bytes, is not part of the parsed tree and is never lifted. Its name is the simple key of its IRI, as for a Field." .
# A struct, a field and a data type are different kinds of thing: a field's value may be typed
# BY a struct, but no resource is both.
[] a owl:AllDisjointClasses ; owl:members ( :Struct :Field :DataType ) .
# The same disjointness as a validation rule: an OWL axiom is only a contradiction for a
# reasoner, so a description typing one node both a Struct and a Field would otherwise load.
:DisjointKindsShape a sh:NodeShape ; rdfs:label "Disjoint kinds shape" ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "A node is at most one of bddo:Struct, bddo:Field and bddo:DataType (subclasses included), as the owl:AllDisjointClasses axiom states." ;
    sh:targetClass :Struct , :Field , :DataType ;
    sh:sparql [ sh:message "A node cannot be both a {?a} and a {?b}: bddo:Struct, bddo:Field and bddo:DataType are disjoint." ;
        sh:prefixes :_prefixes ;
        sh:select """SELECT $this ?a ?b WHERE {
            $this rdf:type/rdfs:subClassOf* ?a , ?b .
            FILTER(?a IN (bddo:Struct, bddo:Field) && ?b IN (bddo:Field, bddo:DataType) && !sameTerm(?a, ?b))
        }""" ] .

# ---------- Delimited text records ----------
# Line- and character-delimited text: key = value headers, CSV, whitespace-separated grids.
# Records may nest, via bddo:hasGrouping, but only in the three token-delimited styles that
# vocabulary describes -- this is not a general grammar. A document with real recursive
# structure is a bddo:TreeDocument instead.
:DelimitedRecords a owl:Class ; rdfs:subClassOf :Struct ; rdfs:label "Delimited Records" ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "A Struct whose children are located by delimiter position rather than byte offset: a byte run split into records by recordDelimiter, each record optionally split into values by fieldDelimiter." .
:KeyValueHeader a owl:Class ; rdfs:subClassOf :DelimitedRecords ; rdfs:label "Key/Value Header" ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "DelimitedRecords whose records are key/value pairs split by keyValueSeparator. Each expected key is a Field carrying bddo:key, or, with no bddo:key, named by its simple key (the local name of its IRI after the last '.'); record order is not significant." .
:DelimitedTable a owl:Class ; rdfs:subClassOf :DelimitedRecords ; rdfs:label "Delimited Table" ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "DelimitedRecords whose records are rows with a fixed column sequence. The hasField list gives the columns in order; the row structure repeats until the byte run is exhausted." .
# ---------- Tree documents ----------
# XML and JSON labels wrap a payload that is otherwise already describable: PDS4, DIMAP, SAFE,
# SENTINEL-2, RadarSat-2, TerraSAR-X, CPHD and Zarr all pair a clean binary array with a
# manifest BDDO could not read, and the whole GML/KML/GeoJSON family is markup end to end.
#
# BDDO does not describe the SYNTAX of these documents -- it addresses nodes in the tree a
# conforming parser produces. That distinction is what keeps this from becoming an XML
# specification: the tree is someone else's output, and BDDO's job is only to say which node
# supplies which field.
:TreeDocument a owl:Class ; rdfs:subClassOf :Struct ; rdfs:label "Tree Document" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "A Struct whose children are located by a path into a parsed node tree rather than by byte offset or delimiter. The byte run is handed to a parser for the declared syntax; each Field names the node supplying its value." .
:TreeSyntax a owl:Class ; rdfs:label "Tree Syntax" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "Which tree grammar a TreeDocument is written in, and therefore how its nodePath values are read." .
:NamespaceBinding a owl:Class ; rdfs:label "Namespace Binding" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "A prefix-to-IRI binding for the paths of an XML TreeDocument." .

:RecordGrouping a owl:Class ; rdfs:label "Record Grouping" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "How a DelimitedRecords container nests: which records open a group, which close it, and where the group's name comes from. A container without one is flat, which is what every DelimitedRecords was before nesting existed." .
:GroupingStyle a owl:Class ; rdfs:label "Grouping Style" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "Which of the three ways a text format marks a nested group." .

# Controlled-vocabulary classes (typed enumerated individuals)
:Endianness       a owl:Class ; rdfs:label "Endianness" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> .
:BitOrder         a owl:Class ; rdfs:label "Bit Order" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> .
:BaseType         a owl:Class ; rdfs:label "Base Type" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> .
:OffsetBase       a owl:Class ; rdfs:label "Offset Base" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> .
:Encoding         a owl:Class ; rdfs:label "Encoding" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> .
:ChecksumAlgorithm a owl:Class ; rdfs:label "Checksum Algorithm" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> .
# Any CRC is fixed by the six parameters of the Rocksoft model, so one class covers every CRC a
# format uses without a new individual per variant. The named CRC individuals below carry the
# same six parameters, and their catalogue check value, as statements about themselves.
:CustomCrc a owl:Class ; rdfs:subClassOf :ChecksumAlgorithm ; rdfs:label "Custom CRC" ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "A CRC stated by its Rocksoft-model parameters rather than named: bddo:crcWidth (8..64 bits), bddo:crcPolynomial, bddo:crcInit, bddo:crcReflectIn, bddo:crcReflectOut and bddo:crcXorOut, all six required. Used as the value of bddo:checksumAlgorithm for a CRC that no named algorithm identifies." .
# Union of DataType and Struct, used as the range of dataType / ruleDataType
:DataTypeOrStruct a owl:Class ; rdfs:label "Data Type or Struct" ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ; owl:unionOf ( :DataType :Struct ) .

# ---------- Structural properties ----------
:hasField     a owl:ObjectProperty ; rdfs:label "has field" ; rdfs:range rdf:List ;
    rdfs:comment "Ordered rdf:List of the members of a Struct: its Fields, and any LocalBindings among them, in the order they are processed." .
:hasParameter a owl:ObjectProperty ; rdfs:label "has parameter" ; rdfs:range rdf:List ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "Ordered rdf:List of the bddo:Parameter resources of a parameterised Struct. Every place that names the struct as a type supplies exactly one argument per parameter, positionally, with bddo:hasArgument." .
:parameterType a owl:ObjectProperty ; rdfs:label "parameter type" ; rdfs:range :ParameterType ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "Restricts the kind of value a Parameter accepts to one HEL value type: bddo:IntegerParameter, bddo:FloatParameter (an Integer argument is converted to Float), bddo:StringParameter, bddo:BytesParameter or bddo:BooleanParameter. Absent, the parameter accepts any scalar value, Null included." .
:hasArgument a owl:ObjectProperty ; rdfs:label "has argument" ; rdfs:range rdf:List ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "Ordered rdf:List of HEL expression strings, the positional arguments for the parameterised Struct this resource names as a type: on a Field, for its bddo:dataType; on a DataTypeRule, for its bddo:ruleDataType; on a DispatchArm, for its bddo:armDataType. A bddo:dispatchDefault has nowhere to state arguments, so it never names a parameterised struct. Each is evaluated in the CALLER's context -- the struct containing the field -- at the point the field is read." .
:localExpression a owl:DatatypeProperty ; rdfs:label "local expression" ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The HEL expression giving a LocalBinding's value, evaluated with the containing struct as instance when the binding's position in the hasField list is reached." .
:endianness   a owl:ObjectProperty ; rdfs:label "endianness" ; rdfs:range :Endianness ;
    rdfs:comment "Byte order for a Struct, Field, or DataType." .
:hasConditionalEndianness a owl:ObjectProperty ; rdfs:label "has conditional endianness" ; rdfs:range rdf:List ;
    rdfs:comment "Ordered rdf:List of EndiannessRule. The first rule whose condition holds selects the byte order for this Struct or Field and, as with bddo:endianness, for its descendants unless they override it. Use for formats that declare their own byte order, such as TIFF's 4949h/4D4Dh marker. Mutually exclusive with bddo:endianness." .
:bitOrder     a owl:ObjectProperty ; rdfs:label "bit order" ; rdfs:range :BitOrder .
:syncOnMarker a owl:DatatypeProperty ; rdfs:label "sync on marker" ; rdfs:range xsd:hexBinary .

# ---------- Field properties ----------
:dataType               a owl:ObjectProperty ; rdfs:label "data type" ; rdfs:range :DataTypeOrStruct .
:hasConditionalDataType a owl:ObjectProperty ; rdfs:label "has conditional data type" ; rdfs:range rdf:List .
:hasDispatchTable       a owl:ObjectProperty ; rdfs:label "has dispatch table" ; rdfs:range :DispatchTable ;
    rdfs:comment "The keyed DispatchTable that selects this Field's effective type. Mutually exclusive with hasConditionalDataType." .
:dispatchOnField        a owl:ObjectProperty ; rdfs:label "dispatch on field" ; rdfs:range :Field ;
    rdfs:comment "The sibling Field whose parsed value is the dispatch key." .
:dispatchOnExpression   a owl:DatatypeProperty ; rdfs:label "dispatch on expression" ; rdfs:range xsd:string ;
    rdfs:comment "A HEL expression whose value is the dispatch key, evaluated as a hasConditionalDataType condition is." .
:dispatchDefault        a owl:ObjectProperty ; rdfs:label "dispatch default" ; rdfs:range :DataTypeOrStruct ;
    rdfs:comment "The type selected when no arm's key equals the dispatch key. Absent means the Field's own dataType applies." .
:armTable               a owl:ObjectProperty ; rdfs:label "arm table" ; rdfs:range :DispatchTable ;
    rdfs:comment "The DispatchTable this DispatchArm contributes to. Declared on the arm so that any graph may add arms to a table defined elsewhere." .
:armKey                 a owl:DatatypeProperty ; rdfs:label "arm key" ;
    rdfs:comment "The key value this arm matches: an xsd:string compared by code points, or an xsd:integer compared numerically." .
:armDataType            a owl:ObjectProperty ; rdfs:label "arm data type" ; rdfs:range :DataTypeOrStruct ;
    rdfs:comment "The datatype or structure selected when this arm's key matches." .
:seekScope              a owl:ObjectProperty ; rdfs:label "seek scope" ; rdfs:range :SeekScope ;
    rdfs:comment "For an offset-addressed Field, whether the read may leave the innermost bounded region (streamScope) or is confined to it (regionScope, the default). The region bound is suspended only for that one read. Used where a table inside one length-delimited container locates payloads stored in another." .
:size                   a owl:DatatypeProperty ; rdfs:label "size (bytes)" ; rdfs:range xsd:positiveInteger .
:sizeFromField          a owl:ObjectProperty ; rdfs:label "size from field" ; rdfs:range :Field .
:sizeFromExpression     a owl:DatatypeProperty ; rdfs:label "size from expression" ; rdfs:range xsd:string .
:sizeToEndOfStream      a owl:DatatypeProperty ; rdfs:label "size to end of stream" ; rdfs:range xsd:boolean .
:terminator             a owl:DatatypeProperty ; rdfs:label "terminator" ; rdfs:range xsd:hexBinary .
:trimNull               a owl:DatatypeProperty ; rdfs:label "trim null" ; rdfs:range xsd:boolean ;
    rdfs:comment "For a fixed-size (padded) string field, the emitted value ends at the first 0x00 byte within the field's width." .
:encoding               a owl:ObjectProperty ; rdfs:label "encoding" ; rdfs:range :Encoding .
:recordDelimiter        a owl:DatatypeProperty ; rdfs:label "record delimiter" ; rdfs:range xsd:hexBinary ;
    rdfs:comment "Byte sequence separating records. Default 0A (LF); a CR LF pair is also accepted when this is 0A." .
:fieldDelimiter         a owl:DatatypeProperty ; rdfs:label "field delimiter" ; rdfs:range xsd:hexBinary ;
    rdfs:comment "Byte sequence separating values within one record. When absent, a record is a single value." .
:keyValueSeparator      a owl:DatatypeProperty ; rdfs:label "key/value separator" ; rdfs:range xsd:hexBinary ;
    rdfs:comment "Byte sequence separating a key from its value within a record of a KeyValueHeader." .
:quoteChar              a owl:DatatypeProperty ; rdfs:label "quote character" ; rdfs:range xsd:hexBinary ;
    rdfs:comment "Byte that quotes a value, allowing it to contain the field or record delimiter. A doubled quote inside a quoted value denotes a literal quote." .
:escapeChar             a owl:DatatypeProperty ; rdfs:label "escape character" ; rdfs:range xsd:hexBinary ;
    rdfs:comment "Byte that escapes the following byte, suppressing its delimiter or quote meaning." .
:commentPrefix          a owl:DatatypeProperty ; rdfs:label "comment prefix" ; rdfs:range xsd:string ;
    rdfs:comment "A record beginning with this string (after optional whitespace) is ignored." .
:skipRecords            a owl:DatatypeProperty ; rdfs:label "skip records" ; rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Number of leading records to discard before parsing, e.g. a CSV column-name row. Default 0." .
:whitespaceSeparated    a owl:DatatypeProperty ; rdfs:label "whitespace separated" ; rdfs:range xsd:boolean ;
    rdfs:comment "If true, values are separated by a RUN of one or more whitespace bytes (space, tab, CR, LF) rather than by a fixed bddo:fieldDelimiter. A run of any length separates exactly two values, so consecutive whitespace never yields an empty value, and leading or trailing whitespace on a record is ignored. This is what column-aligned ASCII grids need -- 'ncols        100', or a row of numbers padded to line up -- which a fixed delimiter cannot express. Mutually exclusive with bddo:fieldDelimiter. When bddo:recordDelimiter is also absent the content is one flat stream of whitespace-separated values rather than rows, which is how an ASCII grid whose rows wrap across lines is read; the grid's shape then comes from the field's dlv:DataLayout or repeat count, not from line breaks." .
:trimWhitespace         a owl:DatatypeProperty ; rdfs:label "trim whitespace" ; rdfs:range xsd:boolean ;
    rdfs:comment "If true, leading and trailing whitespace is removed from every key and value. Default false." .
# ---------- Tree document properties ----------
:treeSyntax a owl:ObjectProperty ; rdfs:label "tree syntax" ; rdfs:range :TreeSyntax ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The grammar of a TreeDocument. Required, because it decides how every nodePath in the container is read." .
:xml a owl:NamedIndividual, :TreeSyntax ; rdfs:label "XML" ;
    rdfs:comment "Paths are ABBREVIATED XPATH: child steps, attribute steps (@name), and positional predicates ([n], 1-based). A deliberately small subset -- no axes, no functions, no comparison predicates -- because a description states where a value IS, and a path that can compute is a query engine's problem rather than a description's." .
:json a owl:NamedIndividual, :TreeSyntax ; rdfs:label "JSON" ;
    rdfs:comment "Paths are JSON POINTERS as defined by RFC 6901: /object/member, array indices as /list/0 (0-based). Adopted rather than invented, so its escaping rules for '/' and '~' inside a member name are already specified and already implemented." .

:nodePath a owl:DatatypeProperty ; rdfs:label "node path" ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "Locates the node supplying this field's value, read according to the container's treeSyntax. A path selecting no node leaves the field absent; a path selecting several is an error unless the field repeats, in which case the field's value is the selected nodes in document order." .
:hasNamespaceBinding a owl:ObjectProperty ; rdfs:label "has namespace binding" ; rdfs:range :NamespaceBinding ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "Binds the prefixes used in this document's paths. XML only, and not optional in practice: PDS4, DIMAP and SAFE are all namespaced, and an unprefixed path against a namespaced document silently matches nothing rather than failing." .
:namespacePrefix a owl:DatatypeProperty ; rdfs:label "namespace prefix" ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The prefix as used in this container's nodePath values. The empty string binds the DEFAULT namespace, which an XPath subset cannot otherwise reach." .
:namespaceIRI a owl:DatatypeProperty ; rdfs:label "namespace IRI" ; rdfs:range xsd:anyURI ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The namespace the prefix stands for, matched against the document's own declarations rather than against the prefix it happens to use -- a document may spell the same namespace with any prefix." .

# ---------- Nested records ----------
# The flat key/value model reaches ESRI .hdr, ENVI and their kin, but stops at the label formats
# that are otherwise the same shape: PVL/ODL (PDS, ISIS2, ISIS3, VICAR) nests with
# OBJECT = ... END_OBJECT, ERMapper with <Name> Begin ... <Name> End, and INI-style labels with
# bracketed section headers. Refusing to nest kept nine drivers at payload-only for want of a
# closing token.
#
# Three styles rather than one general grammar. Each is fully described by two tokens plus where
# the group's NAME comes from, and that is the whole of it -- a general nested-grammar surface
# would be a parser generator, and this is not one.
:hasGrouping a owl:ObjectProperty ; rdfs:label "has grouping" ; rdfs:range :RecordGrouping ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The nesting rule of a DelimitedRecords container. Absent means flat." .
:groupingStyle a owl:ObjectProperty ; rdfs:label "grouping style" ; rdfs:range :GroupingStyle ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> .
:groupOpenToken a owl:DatatypeProperty ; rdfs:label "group open token" ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The literal that marks a record as opening a group: the key OBJECT, the value Begin, or the bracket [ -- read according to groupingStyle." .
:groupCloseToken a owl:DatatypeProperty ; rdfs:label "group close token" ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The literal that closes a group: END_OBJECT, End, or the bracket ]. For sectionHeaded it is the closing bracket of the header rather than a separate record, since a section is ended by the next one." .

:keyedGroup a owl:NamedIndividual, :GroupingStyle ; rdfs:label "keyed group" ;
    rdfs:comment "A record whose KEY equals groupOpenToken opens a group, and its VALUE names it; a record whose key equals groupCloseToken closes the innermost open group. PVL/ODL: OBJECT = IMAGE ... END_OBJECT = IMAGE. The closing record MAY repeat the name; a description need not say so, because the name is already known from the opening record." .
:valuedGroup a owl:NamedIndividual, :GroupingStyle ; rdfs:label "valued group" ;
    rdfs:comment "The mirror image: a record whose VALUE equals groupOpenToken opens a group, and its KEY names it. ERMapper: CoordinateSpace Begin ... CoordinateSpace End." .
:sectionHeaded a owl:NamedIndividual, :GroupingStyle ; rdfs:label "section headed" ;
    rdfs:comment "A record consisting of groupOpenToken, a name, and groupCloseToken opens a group and implicitly closes the previous one; the last runs to the end of the container. INI-style [Section] headers. Nesting is therefore FLAT ONE DEEP -- sections do not contain sections -- which is what the style actually permits, not a limitation of this model." .

:keyPath a owl:DatatypeProperty ; rdfs:label "key path" ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "Locates a field inside nested groups, as group names and finally the key, joined by pathSeparator: 'IMAGE/BAND/NAME'. Mutually exclusive with bddo:key, which locates a field in a flat container -- a field cannot be found two ways, and a description that said both would leave a reader to guess which wins." .
:pathSeparator a owl:DatatypeProperty ; rdfs:label "path separator" ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The separator used in this container's keyPath values. Default '/'. Declared on the container rather than repeated per field, and needed because a format whose group names may contain '/' has to choose something else." .

:key                    a owl:DatatypeProperty ; rdfs:label "key" ; rdfs:range xsd:string ;
    rdfs:comment "The key naming this Field within a KeyValueHeader. Replaces positional location: the Field takes the value of whichever record carries this key. A field of a flat KeyValueHeader that declares no bddo:key is located by its simple key instead." .
:keyIsCaseInsensitive   a owl:DatatypeProperty ; rdfs:label "key is case insensitive" ; rdfs:range xsd:boolean ;
    rdfs:comment "If true, bddo:key matching ignores ASCII case. Default false." .
:numericBase            a owl:DatatypeProperty ; rdfs:label "numeric base" ; rdfs:range xsd:positiveInteger ;
    rdfs:comment "Radix used to read an :asciiInteger field: 8, 10 or 16. Default 10." .
:bitLength              a owl:DatatypeProperty ; rdfs:label "bit length" ; rdfs:range xsd:positiveInteger .
:repeatCount            a owl:DatatypeProperty ; rdfs:label "repeat count" ; rdfs:range xsd:nonNegativeInteger .
:repeatCountFromField   a owl:ObjectProperty ; rdfs:label "repeat count from field" ; rdfs:range :Field .
:repeatCountFromExpression a owl:DatatypeProperty ; rdfs:label "repeat count from expression" ; rdfs:range xsd:string .
:repeatUntil            a owl:DatatypeProperty ; rdfs:label "repeat until" ; rdfs:range xsd:string .
:separatedBy            a owl:DatatypeProperty ; rdfs:label "separated by" ; rdfs:range xsd:string ;
    rdfs:comment "The element extent of a field -- repeated or scalar -- whose value is a number written as text, separated rather than sized or terminated: each element is preceded and followed by a run of separator bytes, and the run belongs to the element that owns it so the byte sequence can be rebuilt exactly. The only defined value is \"whitespace\" (space, tab, CR, LF). A separator is a RUN and a terminator is a SEQUENCE: between two delimiters of a delimited table an empty value is meaningful, whereas an empty run is not a value at all. Permitted only on a field whose data type is a number written as text. Because the LAST element's trailing run consumes every separator byte up to the field's own extent (or end of stream), a field declaring bddo:separatedBy must either be the last field read from its enclosing region, or be immediately followed by data that does not itself begin with a separator byte (space, tab, CR, LF) -- otherwise the trailing run consumes bytes that belong to the following field." .
:atOffset               a owl:DatatypeProperty ; rdfs:label "at offset" ; rdfs:range xsd:nonNegativeInteger .
:atOffsetFromField      a owl:ObjectProperty ; rdfs:label "at offset from field" ; rdfs:range :Field .
:atOffsetFromExpression a owl:DatatypeProperty ; rdfs:label "at offset from expression" ; rdfs:range xsd:string .
:offsetBase             a owl:ObjectProperty ; rdfs:label "offset base" ; rdfs:range :OffsetBase .
:alignment              a owl:DatatypeProperty ; rdfs:label "alignment" ; rdfs:range xsd:positiveInteger .
:hasFixedValue          a owl:DatatypeProperty ; rdfs:label "has fixed value" .
:isPresentIf            a owl:DatatypeProperty ; rdfs:label "is present if" ; rdfs:range xsd:string .
:valueFromExpression    a owl:DatatypeProperty ; rdfs:label "value from expression" ; rdfs:range xsd:string ;
    rdfs:comment "A HEL expression giving the value of a derived, zero-byte field. The field consumes no bytes; its computed value is placed in the parse context under the field's name so later sizing, offset, presence, mapping and validation expressions may reference it. A field with bddo:valueFromExpression declares no bddo:dataType and no sizing, offset or bit-length; the result's type is that of the HEL expression." .
:validIf                a owl:DatatypeProperty ; rdfs:label "valid if" ; rdfs:range xsd:string ;
    rdfs:comment "A HEL boolean expression that MUST hold once this field is parsed; if it evaluates false the parse fails with a validation error. Use for post-parse constraints such as a magic number or a bound on a count. Richer, graph-level constraints belong in SHACL at the semantic layer." .
:rootKeyFromField       a owl:ObjectProperty ; rdfs:label "root key from field" ; rdfs:range :Field ;
    rdfs:comment "After this Field is parsed, its value is also bound in the ROOT parsing context under the key given by the named sibling Field's parsed value, if that key is not already bound (first occurrence wins). Lets a later record address an earlier one through its discriminator -- `root.<key>.<field>` -- when the earlier record sits inside a repeated sequence that HEL cannot search. A neutral generalisation of the chunk-type aliasing that several chunked container formats need." .
:enumeration            a owl:ObjectProperty ; rdfs:label "enumeration" ; rdfs:range :Enumeration .
:checksum               a owl:ObjectProperty ; rdfs:label "checksum" ; rdfs:range :Checksum .

# ---------- DataType / Rule / Enum / Checksum properties ----------
:baseType      a owl:ObjectProperty ; rdfs:label "base type" ; rdfs:range :BaseType .
:bitWidth      a owl:DatatypeProperty ; rdfs:label "bit width" ; rdfs:range xsd:positiveInteger .
:isSigned      a owl:DatatypeProperty ; rdfs:label "is signed" ; rdfs:range xsd:boolean .
:xsdType       a owl:ObjectProperty ; rdfs:label "xsd type" ; rdfs:range rdfs:Datatype ;
    rdfs:comment "The RDF literal datatype produced when a value of this DataType is emitted." .
:condition     a owl:DatatypeProperty ; rdfs:label "condition" ; rdfs:range xsd:string .
:ruleDataType  a owl:ObjectProperty ; rdfs:label "rule data type" ; rdfs:range :DataTypeOrStruct .
:ruleEndianness a owl:ObjectProperty ; rdfs:label "rule endianness" ; rdfs:range :Endianness ;
    rdfs:comment "The byte order selected by an EndiannessRule." .
:hasEnumValue  a owl:ObjectProperty ; rdfs:label "has enum value" ; rdfs:range :EnumValue .
:enumRawValue  a owl:DatatypeProperty ; rdfs:label "enum raw value" .
:enumSymbol    a owl:ObjectProperty ; rdfs:label "enum symbol" .
:enumIsFlags   a owl:DatatypeProperty ; rdfs:label "enum is flags" ; rdfs:range xsd:boolean ;
    rdfs:comment "If true, the Enumeration is a bit-flag set: each EnumValue's raw value is a bitmask, and every symbol whose bit(s) are set in the parsed value is emitted." .
:checksumAlgorithm a owl:ObjectProperty ; rdfs:label "checksum algorithm" ; rdfs:range :ChecksumAlgorithm .
:coversFromField   a owl:ObjectProperty ; rdfs:label "covers from field" ; rdfs:range :Field .
:coversToField     a owl:ObjectProperty ; rdfs:label "covers to field" ; rdfs:range :Field .
# A single expression can only describe a range it computes whole, so a checksum whose start
# is a named field and whose end is computed had no way to say so -- it had to abandon the
# field reference and recompute that offset arithmetically too. Splitting coverage into two
# independent bounds removes that all-or-nothing choice; either end may be a field or an
# expression. Offsets are absolute byte positions in the same frame of reference a size or
# offset expression on this struct would see.
:coversFromExpression a owl:DatatypeProperty ; rdfs:label "covers from expression" ; rdfs:range xsd:string ;
    rdfs:comment "HEL expression evaluating to the covered range's START byte offset, inclusive. Alternative to coversFromField for the same bound." .
:coversToExpression a owl:DatatypeProperty ; rdfs:label "covers to expression" ; rdfs:range xsd:string ;
    rdfs:comment "HEL expression evaluating to the covered range's END byte offset, EXCLUSIVE (one past the last covered byte). Alternative to coversToField for the same bound -- note coversToField names a field whose last byte is included, so the two forms do not take the same number." .
:coversExpression  a owl:DatatypeProperty ; rdfs:label "covers expression" ; rdfs:range xsd:string ;
    owl:deprecated true ;
    rdfs:comment "Deprecated: a single expression yielding the whole [start,end) range. Superseded by the coversFromExpression/coversToExpression pair, which states each bound separately and so can mix field and expression ends. Retained for descriptions written against earlier BDDO." .
# The Rocksoft CRC model. Required on a bddo:CustomCrc; also stated on the named CRC individuals,
# where they record what the name means (tools/test_crc_catalogue.py recomputes each check value).
:crcWidth a owl:DatatypeProperty ; rdfs:label "CRC width" ; rdfs:range xsd:positiveInteger ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The width of a CRC in bits, 8 to 64: the degree of its generator polynomial and the width of its register and result." .
:crcPolynomial a owl:DatatypeProperty ; rdfs:label "CRC polynomial" ; rdfs:range xsd:nonNegativeInteger ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The generator polynomial of a CRC without its top (x^width) term, in normal (unreflected) form, as a non-negative integer below 2^width: CRC-32's is 0x04C11DB7 (79764919), not the reflected 0xEDB88320." .
:crcInit a owl:DatatypeProperty ; rdfs:label "CRC initial value" ; rdfs:range xsd:nonNegativeInteger ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The value the CRC register holds before the first byte is processed, unreflected, below 2^width." .
:crcReflectIn a owl:DatatypeProperty ; rdfs:label "CRC reflect input" ; rdfs:range xsd:boolean ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "If true, each input byte is processed least-significant bit first (reflected); if false, most-significant bit first." .
:crcReflectOut a owl:DatatypeProperty ; rdfs:label "CRC reflect output" ; rdfs:range xsd:boolean ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "If true, the final register is bit-reversed over its width before the final XOR." .
:crcXorOut a owl:DatatypeProperty ; rdfs:label "CRC final XOR" ; rdfs:range xsd:nonNegativeInteger ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The value XORed into the (possibly reflected) final register to give the CRC, below 2^width." .
:crcCheck a owl:DatatypeProperty ; rdfs:label "CRC check value" ; rdfs:range xsd:nonNegativeInteger ; rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    rdfs:comment "The CRC of the nine ASCII bytes \"123456789\" under the algorithm's parameters: the catalogue check value that identifies a CRC variant. Informative on a named algorithm; never required, and never read by a processor." .

# ---------- Deprecated pre-release terms ----------
# Profiles written before BDDO 1.0 still use these IRIs and conforming processors still read
# them, so they are declared rather than silently unknown. Each keeps its original meaning;
# new descriptions MUST use the replacement. They are never emitted by current tooling.
:hasEndianness a owl:ObjectProperty ; rdfs:label "has endianness (deprecated)" ; rdfs:range :Endianness ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    owl:deprecated true ; dcterms:isReplacedBy :endianness ;
    rdfs:comment "Deprecated pre-release spelling of bddo:endianness, with the same meaning. A processor reading a description that states both uses bddo:endianness." .
:usesStruct a owl:ObjectProperty ; rdfs:label "uses struct (deprecated)" ; rdfs:range :Struct ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    owl:deprecated true ;
    rdfs:comment "Deprecated pre-release template reference: the subject Struct's effective field list is the named Struct's fields followed by its own. There is no single replacement term; new descriptions state the fields directly, or compose with a Field whose bddo:dataType is the other Struct (which nests rather than splices)." .
:integer a owl:NamedIndividual, :BaseType ; rdfs:label "Base type Integer (deprecated)" ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    owl:deprecated true ; dcterms:isReplacedBy :baseInteger ;
    rdfs:comment "Deprecated pre-release name of bddo:baseInteger, with the same meaning." .
:float a owl:NamedIndividual, :BaseType ; rdfs:label "Base type Float (deprecated)" ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    owl:deprecated true ; dcterms:isReplacedBy :baseFloat ;
    rdfs:comment "Deprecated pre-release name of bddo:baseFloat, with the same meaning." .

# ---------- Enumerated individuals (typed with their controlled-vocabulary class) ----------
:BigEndian a owl:NamedIndividual, :Endianness ; rdfs:label "Big Endian" .
:LittleEndian a owl:NamedIndividual, :Endianness ; rdfs:label "Little Endian" .
:MSBFirst a owl:NamedIndividual, :BitOrder ; rdfs:label "MSB-first bit order" .
:LSBFirst a owl:NamedIndividual, :BitOrder ; rdfs:label "LSB-first bit order" .
:baseInteger a owl:NamedIndividual, :BaseType ; rdfs:label "Base type Integer" .
:baseFloat   a owl:NamedIndividual, :BaseType ; rdfs:label "Base type Float" .
:baseString  a owl:NamedIndividual, :BaseType ; rdfs:label "Base type String" .
:baseBytes   a owl:NamedIndividual, :BaseType ; rdfs:label "Base type Bytes" .
:streamStart a owl:NamedIndividual, :OffsetBase ; rdfs:label "Offset base: stream start" .
:streamEnd   a owl:NamedIndividual, :OffsetBase ; rdfs:label "Offset base: stream end" .
:parentStart a owl:NamedIndividual, :OffsetBase ; rdfs:label "Offset base: parent start" .
:currentPosition a owl:NamedIndividual, :OffsetBase ; rdfs:label "Offset base: current position" .
:regionScope a owl:NamedIndividual, :SeekScope ; rdfs:label "Seek scope: bounded region" ;
    rdfs:comment "The default: an offset-addressed read must stay within the innermost enclosing bounded region." .
:streamScope a owl:NamedIndividual, :SeekScope ; rdfs:label "Seek scope: whole stream" ;
    rdfs:comment "The read is resolved against the whole stream; the enclosing region bound does not apply to it." .
:utf8 a owl:NamedIndividual, :Encoding ; rdfs:label "UTF-8" .
:ascii a owl:NamedIndividual, :Encoding ; rdfs:label "US-ASCII" .
:utf16le a owl:NamedIndividual, :Encoding ; rdfs:label "UTF-16 LE" .
:utf16be a owl:NamedIndividual, :Encoding ; rdfs:label "UTF-16 BE" .
:latin1 a owl:NamedIndividual, :Encoding ; rdfs:label "ISO-8859-1" .
:crc16 a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "CRC-16" ;
    :crcWidth 16 ; :crcPolynomial 4129 ; :crcInit 65535 ; :crcReflectIn false ; :crcReflectOut false ; :crcXorOut 0 ; :crcCheck 10673 ;
    rdfs:comment "CRC-16/CCITT-FALSE (the catalogue's CRC-16/IBM-3740): polynomial 0x1021, initial value 0xFFFF, no input or output reflection, final XOR 0x0000; check value 0x29B1 over the ASCII bytes \"123456789\". No other CRC-16 variant is identified by this term: CRC-16/ARC, XMODEM, MODBUS and X-25 have terms of their own, and any other is a bddo:CustomCrc. HDL: crc16." .
:crc32 a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "CRC-32" ;
    :crcWidth 32 ; :crcPolynomial 79764919 ; :crcInit 4294967295 ; :crcReflectIn true ; :crcReflectOut true ; :crcXorOut 4294967295 ; :crcCheck 3421780262 ;
    rdfs:comment "CRC-32/ISO-HDLC (the zlib/PNG CRC): polynomial 0x04C11DB7 (0xEDB88320 reflected), initial value 0xFFFFFFFF, input and output reflected, final XOR 0xFFFFFFFF; check value 0xCBF43926 over the ASCII bytes \"123456789\". CRC-32C, BZIP2 and MPEG-2 have terms of their own. HDL: crc32." .
:adler32 a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "Adler-32" .
:md5 a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "MD5" .
:sha1 a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "SHA-1" .
:sha256 a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "SHA-256" .
# Named CRC variants (Rocksoft model; parameters and check values from the CRC catalogue,
# reveng.sourceforge.io/crc-catalogue). Integers are written in decimal; the comment gives hex.
:crc8Smbus a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "CRC-8/SMBUS" ;
    :crcWidth 8 ; :crcPolynomial 7 ; :crcInit 0 ; :crcReflectIn false ; :crcReflectOut false ; :crcXorOut 0 ; :crcCheck 244 ;
    rdfs:comment "CRC-8/SMBUS: width 8, polynomial 0x07, initial value 0x00, input not reflected, output not reflected, final XOR 0x00; check value 0xF4 over the ASCII bytes \"123456789\". HDL: crc8." .
:crc16Arc a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "CRC-16/ARC" ;
    :crcWidth 16 ; :crcPolynomial 32773 ; :crcInit 0 ; :crcReflectIn true ; :crcReflectOut true ; :crcXorOut 0 ; :crcCheck 47933 ;
    rdfs:comment "CRC-16/ARC: width 16, polynomial 0x8005, initial value 0x0000, input reflected, output reflected, final XOR 0x0000; check value 0xBB3D over the ASCII bytes \"123456789\". HDL: crc16arc." .
:crc16Xmodem a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "CRC-16/XMODEM" ;
    :crcWidth 16 ; :crcPolynomial 4129 ; :crcInit 0 ; :crcReflectIn false ; :crcReflectOut false ; :crcXorOut 0 ; :crcCheck 12739 ;
    rdfs:comment "CRC-16/XMODEM: width 16, polynomial 0x1021, initial value 0x0000, input not reflected, output not reflected, final XOR 0x0000; check value 0x31C3 over the ASCII bytes \"123456789\". HDL: crc16xmodem." .
:crc16Modbus a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "CRC-16/MODBUS" ;
    :crcWidth 16 ; :crcPolynomial 32773 ; :crcInit 65535 ; :crcReflectIn true ; :crcReflectOut true ; :crcXorOut 0 ; :crcCheck 19255 ;
    rdfs:comment "CRC-16/MODBUS: width 16, polynomial 0x8005, initial value 0xFFFF, input reflected, output reflected, final XOR 0x0000; check value 0x4B37 over the ASCII bytes \"123456789\". HDL: crc16modbus." .
:crc16X25 a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "CRC-16/X-25" ;
    :crcWidth 16 ; :crcPolynomial 4129 ; :crcInit 65535 ; :crcReflectIn true ; :crcReflectOut true ; :crcXorOut 65535 ; :crcCheck 36974 ;
    rdfs:comment "CRC-16/IBM-SDLC (X-25): width 16, polynomial 0x1021, initial value 0xFFFF, input reflected, output reflected, final XOR 0xFFFF; check value 0x906E over the ASCII bytes \"123456789\". HDL: crc16x25." .
:crc32c a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "CRC-32C" ;
    :crcWidth 32 ; :crcPolynomial 517762881 ; :crcInit 4294967295 ; :crcReflectIn true ; :crcReflectOut true ; :crcXorOut 4294967295 ; :crcCheck 3808858755 ;
    rdfs:comment "CRC-32/ISCSI (CRC-32C): width 32, polynomial 0x1EDC6F41, initial value 0xFFFFFFFF, input reflected, output reflected, final XOR 0xFFFFFFFF; check value 0xE3069283 over the ASCII bytes \"123456789\". HDL: crc32c." .
:crc32Bzip2 a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "CRC-32/BZIP2" ;
    :crcWidth 32 ; :crcPolynomial 79764919 ; :crcInit 4294967295 ; :crcReflectIn false ; :crcReflectOut false ; :crcXorOut 4294967295 ; :crcCheck 4236843288 ;
    rdfs:comment "CRC-32/BZIP2: width 32, polynomial 0x04C11DB7, initial value 0xFFFFFFFF, input not reflected, output not reflected, final XOR 0xFFFFFFFF; check value 0xFC891918 over the ASCII bytes \"123456789\". HDL: crc32bzip2." .
:crc32Mpeg2 a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "CRC-32/MPEG-2" ;
    :crcWidth 32 ; :crcPolynomial 79764919 ; :crcInit 4294967295 ; :crcReflectIn false ; :crcReflectOut false ; :crcXorOut 0 ; :crcCheck 58124007 ;
    rdfs:comment "CRC-32/MPEG-2: width 32, polynomial 0x04C11DB7, initial value 0xFFFFFFFF, input not reflected, output not reflected, final XOR 0x00000000; check value 0x0376E6E7 over the ASCII bytes \"123456789\". HDL: crc32mpeg2." .
:crc64Ecma182 a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "CRC-64/ECMA-182" ;
    :crcWidth 64 ; :crcPolynomial 4823603603198064275 ; :crcInit 0 ; :crcReflectIn false ; :crcReflectOut false ; :crcXorOut 0 ; :crcCheck 7800480153909949255 ;
    rdfs:comment "CRC-64/ECMA-182: width 64, polynomial 0x42F0E1EBA9EA3693, initial value 0x0000000000000000, input not reflected, output not reflected, final XOR 0x0000000000000000; check value 0x6C40DF5F0B497347 over the ASCII bytes \"123456789\". HDL: crc64ecma." .
:crc64Xz a owl:NamedIndividual, :ChecksumAlgorithm ; rdfs:label "CRC-64/XZ" ;
    :crcWidth 64 ; :crcPolynomial 4823603603198064275 ; :crcInit 18446744073709551615 ; :crcReflectIn true ; :crcReflectOut true ; :crcXorOut 18446744073709551615 ; :crcCheck 11051210869376104954 ;
    rdfs:comment "CRC-64/XZ: width 64, polynomial 0x42F0E1EBA9EA3693, initial value 0xFFFFFFFFFFFFFFFF, input reflected, output reflected, final XOR 0xFFFFFFFFFFFFFFFF; check value 0x995DC9BBDF1939FA over the ASCII bytes \"123456789\". HDL: crc64xz." .

# ---------- Core primitive DataType instances ----------
:uint8  a :DataType ; rdfs:label "uint8"  ; :baseType :baseInteger ; :bitWidth 8  ; :isSigned false ; :xsdType xsd:unsignedByte .
:int8   a :DataType ; rdfs:label "int8"   ; :baseType :baseInteger ; :bitWidth 8  ; :isSigned true  ; :xsdType xsd:byte .
:uint16 a :DataType ; rdfs:label "uint16" ; :baseType :baseInteger ; :bitWidth 16 ; :isSigned false ; :xsdType xsd:unsignedShort .
:uint16be a :DataType ; rdfs:label "uint16be" ; :baseType :baseInteger ; :bitWidth 16 ; :isSigned false ; :endianness :BigEndian ; :xsdType xsd:unsignedShort .
:uint16le a :DataType ; rdfs:label "uint16le" ; :baseType :baseInteger ; :bitWidth 16 ; :isSigned false ; :endianness :LittleEndian ; :xsdType xsd:unsignedShort .
:uint24 a :DataType ; rdfs:label "uint24" ; :baseType :baseInteger ; :bitWidth 24 ; :isSigned false ; :xsdType xsd:unsignedInt .
:uint24be a :DataType ; rdfs:label "uint24be" ; :baseType :baseInteger ; :bitWidth 24 ; :isSigned false ; :endianness :BigEndian ; :xsdType xsd:unsignedInt .
:uint24le a :DataType ; rdfs:label "uint24le" ; :baseType :baseInteger ; :bitWidth 24 ; :isSigned false ; :endianness :LittleEndian ; :xsdType xsd:unsignedInt .
:uint32 a :DataType ; rdfs:label "uint32" ; :baseType :baseInteger ; :bitWidth 32 ; :isSigned false ; :xsdType xsd:unsignedInt .
:uint32be a :DataType ; rdfs:label "uint32be" ; :baseType :baseInteger ; :bitWidth 32 ; :isSigned false ; :endianness :BigEndian ; :xsdType xsd:unsignedInt .
:uint32le a :DataType ; rdfs:label "uint32le" ; :baseType :baseInteger ; :bitWidth 32 ; :isSigned false ; :endianness :LittleEndian ; :xsdType xsd:unsignedInt .
:uint64 a :DataType ; rdfs:label "uint64" ; :baseType :baseInteger ; :bitWidth 64 ; :isSigned false ; :xsdType xsd:unsignedLong .
:uint64be a :DataType ; rdfs:label "uint64be" ; :baseType :baseInteger ; :bitWidth 64 ; :isSigned false ; :endianness :BigEndian ; :xsdType xsd:unsignedLong .
:uint64le a :DataType ; rdfs:label "uint64le" ; :baseType :baseInteger ; :bitWidth 64 ; :isSigned false ; :endianness :LittleEndian ; :xsdType xsd:unsignedLong .
:int16 a :DataType ; rdfs:label "int16" ; :baseType :baseInteger ; :bitWidth 16 ; :isSigned true ; :xsdType xsd:short .
:int16be a :DataType ; rdfs:label "int16be" ; :baseType :baseInteger ; :bitWidth 16 ; :isSigned true ; :endianness :BigEndian ; :xsdType xsd:short .
:int16le a :DataType ; rdfs:label "int16le" ; :baseType :baseInteger ; :bitWidth 16 ; :isSigned true ; :endianness :LittleEndian ; :xsdType xsd:short .
:int24 a :DataType ; rdfs:label "int24" ; :baseType :baseInteger ; :bitWidth 24 ; :isSigned true ; :xsdType xsd:int .
:int24be a :DataType ; rdfs:label "int24be" ; :baseType :baseInteger ; :bitWidth 24 ; :isSigned true ; :endianness :BigEndian ; :xsdType xsd:int .
:int24le a :DataType ; rdfs:label "int24le" ; :baseType :baseInteger ; :bitWidth 24 ; :isSigned true ; :endianness :LittleEndian ; :xsdType xsd:int .
:int32 a :DataType ; rdfs:label "int32" ; :baseType :baseInteger ; :bitWidth 32 ; :isSigned true ; :xsdType xsd:int .
:int32be a :DataType ; rdfs:label "int32be" ; :baseType :baseInteger ; :bitWidth 32 ; :isSigned true ; :endianness :BigEndian ; :xsdType xsd:int .
:int32le a :DataType ; rdfs:label "int32le" ; :baseType :baseInteger ; :bitWidth 32 ; :isSigned true ; :endianness :LittleEndian ; :xsdType xsd:int .
:int64 a :DataType ; rdfs:label "int64" ; :baseType :baseInteger ; :bitWidth 64 ; :isSigned true ; :xsdType xsd:long .
:int64be a :DataType ; rdfs:label "int64be" ; :baseType :baseInteger ; :bitWidth 64 ; :isSigned true ; :endianness :BigEndian ; :xsdType xsd:long .
:int64le a :DataType ; rdfs:label "int64le" ; :baseType :baseInteger ; :bitWidth 64 ; :isSigned true ; :endianness :LittleEndian ; :xsdType xsd:long .
:float16 a :DataType ; rdfs:label "float16" ; :baseType :baseFloat ; :bitWidth 16 ; :xsdType xsd:float .
:float16be a :DataType ; rdfs:label "float16be" ; :baseType :baseFloat ; :bitWidth 16 ; :endianness :BigEndian ; :xsdType xsd:float .
:float16le a :DataType ; rdfs:label "float16le" ; :baseType :baseFloat ; :bitWidth 16 ; :endianness :LittleEndian ; :xsdType xsd:float .
:float32 a :DataType ; rdfs:label "float32" ; :baseType :baseFloat ; :bitWidth 32 ; :xsdType xsd:float .
:float32be a :DataType ; rdfs:label "float32be" ; :baseType :baseFloat ; :bitWidth 32 ; :endianness :BigEndian ; :xsdType xsd:float .
:float32le a :DataType ; rdfs:label "float32le" ; :baseType :baseFloat ; :bitWidth 32 ; :endianness :LittleEndian ; :xsdType xsd:float .
:float64 a :DataType ; rdfs:label "float64" ; :baseType :baseFloat ; :bitWidth 64 ; :xsdType xsd:double .
:float64be a :DataType ; rdfs:label "float64be" ; :baseType :baseFloat ; :bitWidth 64 ; :endianness :BigEndian ; :xsdType xsd:double .
:float64le a :DataType ; rdfs:label "float64le" ; :baseType :baseFloat ; :bitWidth 64 ; :endianness :LittleEndian ; :xsdType xsd:double .
:bytes  a :DataType ; rdfs:label "bytes"  ; :baseType :baseBytes  ; :xsdType xsd:hexBinary .
:string a :DataType ; rdfs:label "string" ; :baseType :baseString ; :xsdType xsd:string .

# ---------- ASCII-coded numeric types ----------
# Numbers written as text in a fixed-width field (NITF BCS-N, FITS card values,
# USGSDEM Fortran fields). The parsed HEL value is numeric, so these fields may
# drive sizing, offset and repeat expressions — which bddo:string cannot.
:asciiInteger a :DataType ; rdfs:label "asciiInteger" ; :baseType :baseInteger ; :encoding :ascii ; :xsdType xsd:integer ;
    rdfs:comment "An integer written as text, occupying the field's declared width (bddo:size) or ending at its terminator. Surrounding space and a leading '+'/'-' are accepted. Radix is bddo:numericBase, default 10. Yields a HEL Integer." .
:asciiDecimal a :DataType ; rdfs:label "asciiDecimal" ; :baseType :baseFloat ; :encoding :ascii ; :xsdType xsd:decimal ;
    rdfs:comment "A fixed- or floating-point number written as text, occupying the field's declared width or ending at its terminator. Accepts leading sign, decimal point and an exponent introduced by E, e, D or d -- Fortran writes a double-precision exponent with D, and formats written by Fortran (USGSDEM record A) use it. A value spelled 'nan' (any case, optional leading sign) reads as a not-a-number; an infinite value is not accepted. Yields a HEL Float." .

# ---------- Variable-length integers ----------
# A varint's width is neither intrinsic (as with uint32) nor declared (as with
# asciiInteger's bddo:size): it is DISCOVERED while reading, from the values of the bytes
# themselves. These are therefore the first data types with no width at all, and a field
# using one must not declare a size -- there is nothing for a size to mean, and stating one
# would contradict the bytes. sizeof() on such a field still yields the length actually
# consumed, once it is known.
#
# They are what modern container formats are built from: protobuf key/length prefixes (MVT,
# OSM PBF), the PMTiles directory, Parquet's Thrift-compact footer, FlatGeobuf and
# OpenFileGDB geometry. Framing those was already possible byte by byte; reconstructing the
# VALUE was not, which is what kept them out of reach.
:varuint a :DataType ; rdfs:label "varuint" ; :baseType :baseInteger ; :isSigned false ; :xsdType xsd:nonNegativeInteger ;
    rdfs:comment "Unsigned base-128 varint (LEB128): 7 value bits per byte, little-endian, the high bit set on every byte but the last. Protobuf's plain varint." .
:varint a :DataType ; rdfs:label "varint" ; :baseType :baseInteger ; :isSigned true ; :xsdType xsd:integer ;
    rdfs:comment "Signed base-128 varint: LEB128 carrying a zigzag-encoded value, so small negatives stay short -- n maps to (n << 1) XOR (n >> 63). Protobuf's sint32/sint64. Distinct from reading an unsigned varint and reinterpreting the bits, which is protobuf's int32 and sign-extends instead." .
:sqliteVarint a :DataType ; rdfs:label "sqliteVarint" ; :baseType :baseInteger ; :isSigned true ; :xsdType xsd:integer ;
    rdfs:comment "SQLite's variable-length integer: one to nine BIG-endian bytes, high bit as continuation for the first eight, the ninth contributing all eight bits. A different scheme from LEB128, not a dialect of it; used by SQLite-backed formats (GeoPackage, MBTiles, Rasterlite)." .

# =========================================================
# SHACL shapes (domain + cardinality; refine the declared ranges)
# =========================================================
bddo:_prefixes sh:declare
    [ sh:prefix "bddo" ; sh:namespace "https://hexplain.io/ns/bddo#"^^xsd:anyURI ] ,
    [ sh:prefix "rdf" ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ,
    [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] .

bddo:StructShape a sh:NodeShape ;
    sh:targetClass bddo:Struct ;
    sh:property [ sh:path bddo:hasField ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "bddo:hasField must point to a single rdf:List." ] ;
    sh:property [ sh:path ( bddo:hasField [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:or ( [ sh:class bddo:Field ] [ sh:class bddo:LocalBinding ] ) ;
        sh:message "Every member of a Struct's hasField list must be a bddo:Field or a bddo:LocalBinding." ] ;
    sh:property [ sh:path bddo:endianness ; sh:maxCount 1 ; sh:in ( bddo:BigEndian bddo:LittleEndian ) ] ;
    sh:property [ sh:path bddo:bitOrder ; sh:maxCount 1 ; sh:in ( bddo:MSBFirst bddo:LSBFirst ) ] ;
    sh:property [ sh:path bddo:syncOnMarker ; sh:maxCount 1 ; sh:datatype xsd:hexBinary ] ;
    # Struct-level size bounds the byte extent of the Struct (a bounded region for its children).
    sh:property [ sh:path bddo:size ; sh:minExclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:sizeFromField ; sh:class bddo:Field ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:sizeFromExpression ; sh:datatype xsd:string ; sh:maxCount 1 ] .

# At most one struct-sizing mechanism per Struct.
bddo:StructSizingShape a sh:NodeShape ;
    sh:targetClass bddo:Struct ;
    sh:sparql [ sh:message "A bddo:Struct must use at most one sizing mechanism (size / sizeFromField / sizeFromExpression)." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this ?p ?v .
            FILTER(?p IN (bddo:size, bddo:sizeFromField, bddo:sizeFromExpression))
        } GROUP BY $this HAVING (COUNT(DISTINCT ?p) > 1)""" ] .

bddo:FieldShape a sh:NodeShape ;
    sh:targetClass bddo:Field ;
    sh:or (
        [ sh:property [ sh:path bddo:dataType ; sh:minCount 1 ] ]
        [ sh:property [ sh:path bddo:hasConditionalDataType ; sh:minCount 1 ] ]
        [ sh:property [ sh:path bddo:valueFromExpression ; sh:minCount 1 ] ]
        [ sh:property [ sh:path bddo:hasDispatchTable ; sh:minCount 1 ] ]
    ) ;
    sh:property [ sh:path bddo:dataType ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class bddo:DataType ] [ sh:class bddo:Struct ] ) ] ;
    sh:property [ sh:path ( bddo:hasConditionalDataType [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:class bddo:DataTypeRule ;
        sh:message "Every member of a hasConditionalDataType list must be a bddo:DataTypeRule." ] ;
    sh:property [ sh:path bddo:hasDispatchTable ; sh:maxCount 1 ; sh:class bddo:DispatchTable ] ;
    sh:property [ sh:path bddo:seekScope ; sh:maxCount 1 ; sh:in ( bddo:regionScope bddo:streamScope ) ] ;
    sh:property [ sh:path bddo:size ; sh:minExclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:sizeFromField ; sh:class bddo:Field ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:sizeFromExpression ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:sizeToEndOfStream ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:terminator ; sh:datatype xsd:hexBinary ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:separatedBy ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:in ( "whitespace" ) ] ;
    # bddo:separatedBy IS the field's extent, so it excludes every other way of stating one.
    # All five, not just the two literal spellings: a separated field declaring
    # sizeFromField/sizeFromExpression/sizeToEndOfStream would otherwise satisfy both this shape
    # and bddo:AsciiNumericWidthShape while asserting a width the reader provably ignores
    # (a conforming processor resolves bddo:separatedBy before any size declaration), which is a false
    # statement that validates.
    sh:not [ sh:and (
        [ sh:property [ sh:path bddo:separatedBy ; sh:minCount 1 ] ]
        [ sh:property [ sh:path bddo:size ; sh:minCount 1 ] ] ) ] ;
    sh:not [ sh:and (
        [ sh:property [ sh:path bddo:separatedBy ; sh:minCount 1 ] ]
        [ sh:property [ sh:path bddo:sizeFromField ; sh:minCount 1 ] ] ) ] ;
    sh:not [ sh:and (
        [ sh:property [ sh:path bddo:separatedBy ; sh:minCount 1 ] ]
        [ sh:property [ sh:path bddo:sizeFromExpression ; sh:minCount 1 ] ] ) ] ;
    sh:not [ sh:and (
        [ sh:property [ sh:path bddo:separatedBy ; sh:minCount 1 ] ]
        [ sh:property [ sh:path bddo:sizeToEndOfStream ; sh:minCount 1 ] ] ) ] ;
    sh:not [ sh:and (
        [ sh:property [ sh:path bddo:separatedBy ; sh:minCount 1 ] ]
        [ sh:property [ sh:path bddo:terminator ; sh:minCount 1 ] ] ) ] ;
    sh:property [ sh:path bddo:trimNull ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:encoding ; sh:maxCount 1 ; sh:in ( bddo:utf8 bddo:ascii bddo:utf16le bddo:utf16be bddo:latin1 ) ] ;
    sh:property [ sh:path bddo:bitLength ; sh:minExclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:alignment ; sh:minExclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:atOffset ; sh:minInclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:atOffsetFromField ; sh:class bddo:Field ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:atOffsetFromExpression ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:offsetBase ; sh:maxCount 1 ;
        sh:in ( bddo:streamStart bddo:streamEnd bddo:parentStart bddo:currentPosition ) ] ;
    sh:property [ sh:path bddo:enumeration ; sh:class bddo:Enumeration ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:checksum ; sh:class bddo:Checksum ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:valueFromExpression ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:validIf ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:rootKeyFromField ; sh:class bddo:Field ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:isPresentIf ; sh:datatype xsd:string ; sh:maxCount 1 ] .

# At most one sizing mechanism per field.
bddo:FieldSizingShape a sh:NodeShape ;
    sh:targetClass bddo:Field ;
    sh:sparql [ sh:message "A bddo:Field must use at most one sizing/termination mechanism." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this ?p ?v .
            FILTER(?p IN (bddo:size, bddo:sizeFromField, bddo:sizeFromExpression,
                          bddo:sizeToEndOfStream, bddo:terminator))
        } GROUP BY $this HAVING (COUNT(DISTINCT ?p) > 1)""" ] .

# A variable-length field (bytes/string) MUST declare exactly one sizing/termination.
# Exempt: a field of a delimited-record container gets its extent from the container's
# recordDelimiter/fieldDelimiter, not from its own size or terminator.
bddo:VariableLengthFieldShape a sh:NodeShape ;
    sh:targetClass bddo:Field ;
    sh:sparql [ sh:message "A bddo:bytes or bddo:string field must declare a sizing or termination mechanism." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this bddo:dataType ?dt . FILTER(?dt IN (bddo:bytes, bddo:string))
            FILTER NOT EXISTS {
                $this ?p ?v .
                FILTER(?p IN (bddo:size, bddo:sizeFromField, bddo:sizeFromExpression,
                              bddo:sizeToEndOfStream, bddo:terminator))
            }
            FILTER NOT EXISTS {
                ?p bddo:hasField/rdf:rest*/rdf:first $this .
                ?p a ?c .
                # Every container form that determines a field's extent ITSELF -- a delimited
                # record ends at its delimiter, a tree node at its own boundary -- so a declared
                # width would be a second, contradictory answer. Enumerated rather than inferred
                # via rdfs:subClassOf, because these shapes run without inference; a new
                # container form has to be added here too.
                FILTER(?c IN (bddo:DelimitedRecords, bddo:KeyValueHeader, bddo:DelimitedTable,
                              bddo:TreeDocument))
            }
        }""" ] .

# At most one repetition mechanism per field.
bddo:FieldRepetitionShape a sh:NodeShape ;
    sh:targetClass bddo:Field ;
    sh:sparql [ sh:message "A bddo:Field must use at most one repetition mechanism." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this ?p ?v .
            FILTER(?p IN (bddo:repeatCount, bddo:repeatCountFromField,
                          bddo:repeatCountFromExpression, bddo:repeatUntil))
        } GROUP BY $this HAVING (COUNT(DISTINCT ?p) > 1)""" ] .

# At most one offset mechanism per field.
bddo:FieldOffsetShape a sh:NodeShape ;
    sh:targetClass bddo:Field ;
    sh:sparql [ sh:message "A bddo:Field must use at most one offset mechanism." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this ?p ?v .
            FILTER(?p IN (bddo:atOffset, bddo:atOffsetFromField, bddo:atOffsetFromExpression))
        } GROUP BY $this HAVING (COUNT(DISTINCT ?p) > 1)""" ] .

# A derived (zero-byte) field computes its value from an expression and MUST NOT
# also consume bytes via a data type, sizing, offset, bit-length or enumeration.
bddo:DerivedFieldShape a sh:NodeShape ;
    sh:targetClass bddo:Field ;
    sh:sparql [ sh:message "A bddo:valueFromExpression (derived) field must not also declare a byte-consuming mechanism (dataType, hasConditionalDataType, size*, terminator, bitLength, atOffset* or enumeration)." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this bddo:valueFromExpression ?e .
            $this ?p ?v .
            FILTER(?p IN (bddo:dataType, bddo:hasConditionalDataType, bddo:size,
                          bddo:sizeFromField, bddo:sizeFromExpression, bddo:sizeToEndOfStream,
                          bddo:terminator, bddo:bitLength, bddo:atOffset, bddo:atOffsetFromField,
                          bddo:atOffsetFromExpression, bddo:enumeration))
        }""" ] .

bddo:DataTypeShape a sh:NodeShape ;
    sh:targetClass bddo:DataType ;
    sh:property [ sh:path bddo:baseType ; sh:maxCount 1 ;
        sh:in ( bddo:baseInteger bddo:baseFloat bddo:baseString bddo:baseBytes ) ] ;
    sh:property [ sh:path bddo:bitWidth ; sh:minExclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:isSigned ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:endianness ; sh:maxCount 1 ; sh:in ( bddo:BigEndian bddo:LittleEndian ) ] ;
    sh:property [ sh:path bddo:xsdType ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] .

bddo:DataTypeRuleShape a sh:NodeShape ;
    sh:targetClass bddo:DataTypeRule ;
    sh:property [ sh:path bddo:condition ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:ruleDataType ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class bddo:DataType ] [ sh:class bddo:Struct ] ) ] .

bddo:DispatchTableShape a sh:NodeShape ;
    sh:targetClass bddo:DispatchTable ;
    sh:xone (
        [ sh:property [ sh:path bddo:dispatchOnField ; sh:minCount 1 ] ]
        [ sh:property [ sh:path bddo:dispatchOnExpression ; sh:minCount 1 ] ]
    ) ;
    sh:property [ sh:path bddo:dispatchOnField ; sh:maxCount 1 ; sh:class bddo:Field ] ;
    sh:property [ sh:path bddo:dispatchOnExpression ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path bddo:dispatchDefault ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class bddo:DataType ] [ sh:class bddo:Struct ] ) ] .

bddo:DispatchArmShape a sh:NodeShape ;
    sh:targetClass bddo:DispatchArm ;
    sh:targetSubjectsOf bddo:armTable , bddo:armKey , bddo:armDataType ;
    sh:property [ sh:path bddo:armTable ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bddo:DispatchTable ] ;
    sh:property [ sh:path bddo:armKey ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype xsd:integer ] ) ] ;
    sh:property [ sh:path bddo:armDataType ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class bddo:DataType ] [ sh:class bddo:Struct ] ) ] .

# Keys are unique per table across every contributing graph: two arms with one key would make
# the selection depend on graph order, which is exactly what a keyed table exists to rule out.
bddo:DispatchKeyUniquenessShape a sh:NodeShape ;
    sh:targetClass bddo:DispatchTable ;
    sh:sparql [ sh:message "Two DispatchArms of one DispatchTable declare the same armKey." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this ?key WHERE {
            ?a bddo:armTable $this ; bddo:armKey ?key .
            ?b bddo:armTable $this ; bddo:armKey ?key .
            FILTER(?a != ?b)
        }""" ] .

# A field selects its type one way: keyed (open, disjoint) or ordered predicates (closed).
bddo:TypeSelectionExclusivityShape a sh:NodeShape ;
    sh:targetClass bddo:Field ;
    sh:sparql [ sh:message "A bddo:Field must not declare both hasDispatchTable and hasConditionalDataType." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this bddo:hasDispatchTable ?t ; bddo:hasConditionalDataType ?c .
        }""" ] .

# seekScope describes an offset-addressed read; on a sequential field it describes nothing.
bddo:SeekScopeShape a sh:NodeShape ;
    sh:targetClass bddo:Field ;
    sh:sparql [ sh:message "bddo:seekScope is only meaningful on an offset-addressed Field (atOffset / atOffsetFromField / atOffsetFromExpression)." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this bddo:seekScope ?s .
            FILTER NOT EXISTS { $this ?p ?v . FILTER(?p IN (bddo:atOffset, bddo:atOffsetFromField, bddo:atOffsetFromExpression)) }
        }""" ] .

bddo:EnumerationShape a sh:NodeShape ;
    sh:targetClass bddo:Enumeration ;
    sh:property [ sh:path bddo:hasEnumValue ; sh:minCount 1 ; sh:class bddo:EnumValue ] ;
    sh:property [ sh:path bddo:enumIsFlags ; sh:datatype xsd:boolean ; sh:maxCount 1 ] .

bddo:EnumValueShape a sh:NodeShape ;
    sh:targetClass bddo:EnumValue ;
    sh:property [ sh:path bddo:enumRawValue ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:enumSymbol ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] .

bddo:ChecksumShape a sh:NodeShape ;
    sh:targetClass bddo:Checksum ;
    sh:targetObjectsOf bddo:checksum ;
    sh:property [ sh:path bddo:checksumAlgorithm ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:or ( [ sh:in ( bddo:crc16 bddo:crc32 bddo:adler32 bddo:md5 bddo:sha1 bddo:sha256 bddo:crc8Smbus bddo:crc16Arc bddo:crc16Xmodem bddo:crc16Modbus bddo:crc16X25 bddo:crc32c bddo:crc32Bzip2 bddo:crc32Mpeg2 bddo:crc64Ecma182 bddo:crc64Xz ) ]
                [ sh:class bddo:CustomCrc ] ) ;
        sh:message "bddo:checksumAlgorithm is one of the named algorithms or a bddo:CustomCrc." ] ;
    sh:property [ sh:path bddo:coversFromField ; sh:class bddo:Field ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:coversToField ; sh:class bddo:Field ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:coversExpression ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:coversFromExpression ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:coversToExpression ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    # One mechanism per bound. Both would leave the reader to guess which wins, and the two
    # forms do not even agree on whether the end byte is included, so the guess changes the
    # bytes hashed.
    sh:not [ sh:and ( [ sh:property [ sh:path bddo:coversFromField ; sh:minCount 1 ] ]
                      [ sh:property [ sh:path bddo:coversFromExpression ; sh:minCount 1 ] ] ) ] ;
    sh:not [ sh:and ( [ sh:property [ sh:path bddo:coversToField ; sh:minCount 1 ] ]
                      [ sh:property [ sh:path bddo:coversToExpression ; sh:minCount 1 ] ] ) ] ;
    # The deprecated whole-range form describes both bounds by itself, so pairing it with a
    # per-bound property describes the same bound twice.
    sh:not [ sh:and ( [ sh:property [ sh:path bddo:coversExpression ; sh:minCount 1 ] ]
                      [ sh:or ( [ sh:property [ sh:path bddo:coversFromField ; sh:minCount 1 ] ]
                                [ sh:property [ sh:path bddo:coversToField ; sh:minCount 1 ] ]
                                [ sh:property [ sh:path bddo:coversFromExpression ; sh:minCount 1 ] ]
                                [ sh:property [ sh:path bddo:coversToExpression ; sh:minCount 1 ] ] ) ] ) ] .

# ---------- Custom CRC ----------
bddo:CustomCrcShape a sh:NodeShape ;
    sh:targetClass bddo:CustomCrc ;
    # Datatypes and non-negativity come from bddo:RangeDatatypeShape, which applies wherever the
    # properties are used; this shape adds presence, uniqueness and the width's bounds.
    sh:property [ sh:path bddo:crcWidth ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 8 ; sh:maxInclusive 64 ;
        sh:message "A bddo:CustomCrc states exactly one bddo:crcWidth, an integer from 8 to 64." ] ;
    sh:property [ sh:path bddo:crcPolynomial ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A bddo:CustomCrc states exactly one bddo:crcPolynomial." ] ;
    sh:property [ sh:path bddo:crcInit ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A bddo:CustomCrc states exactly one bddo:crcInit." ] ;
    sh:property [ sh:path bddo:crcXorOut ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A bddo:CustomCrc states exactly one bddo:crcXorOut." ] ;
    sh:property [ sh:path bddo:crcReflectIn ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A bddo:CustomCrc states exactly one bddo:crcReflectIn." ] ;
    sh:property [ sh:path bddo:crcReflectOut ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A bddo:CustomCrc states exactly one bddo:crcReflectOut." ] ;
    # Each register value fits the register: below 2^width. SPARQL has neither a power function
    # nor, in a SHACL constraint, a VALUES table, so 2^width is 256^k * 2^r for width = 8k + r.
    sh:sparql [ sh:message "{?p} {?v} does not fit a {?w}-bit CRC: it must be below 2^{?w}." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this ?p ?v ?w WHERE {
            $this bddo:crcWidth ?w ; ?p ?v .
            FILTER(?p IN (bddo:crcPolynomial, bddo:crcInit, bddo:crcXorOut))
            FILTER(isNumeric(?w) && isNumeric(?v) && ?w >= 8 && ?w <= 64)
            BIND(FLOOR(?w / 8) AS ?k)
            BIND(?w - 8 * ?k AS ?r)
            BIND(IF(?k = 1, 256, IF(?k = 2, 65536, IF(?k = 3, 16777216, IF(?k = 4, 4294967296,
                 IF(?k = 5, 1099511627776, IF(?k = 6, 281474976710656, IF(?k = 7, 72057594037927936,
                 18446744073709551616))))))) AS ?bytes)
            BIND(IF(?r = 0, 1, IF(?r = 1, 2, IF(?r = 2, 4, IF(?r = 3, 8, IF(?r = 4, 16, IF(?r = 5, 32,
                 IF(?r = 6, 64, 128))))))) AS ?bits)
            FILTER(?v >= ?bytes * ?bits)
        }""" ] .

# ---------- Parameterised structs ----------
bddo:ParameterisedStructShape a sh:NodeShape ;
    sh:targetSubjectsOf bddo:hasParameter ;
    sh:property [ sh:path bddo:hasParameter ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "bddo:hasParameter must point to a single rdf:List." ] ;
    sh:property [ sh:path ( bddo:hasParameter [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:class bddo:Parameter ; sh:nodeKind sh:IRI ;
        sh:message "Every member of a hasParameter list is a bddo:Parameter named by its IRI." ] ;
    sh:property [ sh:path rdf:type ; sh:hasValue bddo:Struct ;
        sh:message "bddo:hasParameter is declared on a bddo:Struct." ] .

bddo:ParameterShape a sh:NodeShape ;
    sh:targetClass bddo:Parameter ;
    sh:targetSubjectsOf bddo:parameterType ;
    sh:property [ sh:path bddo:parameterType ; sh:maxCount 1 ;
        sh:in ( bddo:IntegerParameter bddo:FloatParameter bddo:StringParameter bddo:BytesParameter bddo:BooleanParameter ) ;
        sh:message "bddo:parameterType is one of bddo:IntegerParameter, bddo:FloatParameter, bddo:StringParameter, bddo:BytesParameter and bddo:BooleanParameter." ] ;
    sh:not [ sh:class bddo:Field ] .

bddo:ArgumentListShape a sh:NodeShape ;
    sh:targetSubjectsOf bddo:hasArgument ;
    sh:property [ sh:path bddo:hasArgument ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "bddo:hasArgument must point to a single rdf:List." ] ;
    sh:property [ sh:path ( bddo:hasArgument [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:datatype xsd:string ;
        sh:message "Every member of a hasArgument list is a HEL expression, an xsd:string literal." ] .

# Arity: every place that names a struct as a type supplies one argument per parameter. List
# NODES are counted, not members, so two equal argument strings still count twice.
bddo:ArgumentArityShape a sh:NodeShape ;
    sh:targetSubjectsOf bddo:dataType , bddo:ruleDataType , bddo:armDataType ;
    sh:sparql [ sh:message "{?s} declares {?np} parameter(s), but {?na} argument(s) are supplied for it." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this ?s (COUNT(DISTINCT ?pn) AS ?np) (COUNT(DISTINCT ?an) AS ?na) WHERE {
            $this ?tp ?s .
            FILTER(?tp IN (bddo:dataType, bddo:ruleDataType, bddo:armDataType))
            ?s a bddo:Struct .
            OPTIONAL { ?s bddo:hasParameter/rdf:rest* ?pn . FILTER(?pn != rdf:nil) }
            OPTIONAL { $this bddo:hasArgument/rdf:rest* ?an . FILTER(?an != rdf:nil) }
        } GROUP BY $this ?s HAVING (COUNT(DISTINCT ?pn) != COUNT(DISTINCT ?an))""" ] .

# ---------- Local bindings ----------
bddo:LocalBindingShape a sh:NodeShape ;
    sh:targetClass bddo:LocalBinding ;
    sh:targetSubjectsOf bddo:localExpression ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:path bddo:localExpression ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A bddo:LocalBinding states exactly one bddo:localExpression." ] ;
    sh:not [ sh:class bddo:Field ] ;
    # A text container locates its fields by delimiter, key or path rather than by list order,
    # so a binding in one would have no position to be evaluated at.
    sh:sparql [ sh:message "A bddo:LocalBinding is a member of a binary struct; {?container} is a delimited or tree container." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this ?container WHERE {
            ?container bddo:hasField/rdf:rest*/rdf:first $this ; a ?c .
            FILTER(?c IN (bddo:DelimitedRecords, bddo:KeyValueHeader, bddo:DelimitedTable, bddo:TreeDocument))
        }""" ] .

# An ASCII-coded numeric field must have a width, a terminator or a separator, or it cannot be
# read. bddo:separatedBy is an extent mechanism in its own right -- the element is bounded by the
# runs of separator bytes either side of it -- and it is the ONLY one such a field may combine
# with none of the others: see bddo:FieldShape, which forbids pairing it with any size or with a
# terminator, because two answers to "where does this value end" is one too many.
# Exempt: a field of a delimited-record container gets its extent from the container's
# recordDelimiter/fieldDelimiter, not from its own size, terminator or separator.
bddo:AsciiNumericWidthShape a sh:NodeShape ;
    sh:targetClass bddo:Field ;
    sh:sparql [ sh:message "A bddo:asciiInteger / bddo:asciiDecimal field must declare a width (size / sizeFromField / sizeFromExpression), a terminator, or bddo:separatedBy." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this bddo:dataType ?dt .
            FILTER(?dt IN (bddo:asciiInteger, bddo:asciiDecimal))
            FILTER NOT EXISTS { $this bddo:size ?s }
            FILTER NOT EXISTS { $this bddo:sizeFromField ?f }
            FILTER NOT EXISTS { $this bddo:sizeFromExpression ?e }
            FILTER NOT EXISTS { $this bddo:terminator ?t }
            FILTER NOT EXISTS { $this bddo:separatedBy ?sep }
            FILTER NOT EXISTS {
                ?p bddo:hasField/rdf:rest*/rdf:first $this .
                ?p a ?c .
                # Same exemption as bddo:VariableLengthFieldShape, and it must be kept in step
                # with it: both ask "does the container decide this field's extent?", and a new
                # container form has to be listed in both or a description conforms to one shape
                # and not the other.
                FILTER(?c IN (bddo:DelimitedRecords, bddo:KeyValueHeader, bddo:DelimitedTable,
                              bddo:TreeDocument))
            }
        }""" ] .

# numericBase is meaningful only for :asciiInteger.
bddo:NumericBaseShape a sh:NodeShape ;
    sh:targetSubjectsOf bddo:numericBase ;
    sh:property [ sh:path bddo:numericBase ; sh:maxCount 1 ; sh:in ( 8 10 16 ) ;
        sh:message "bddo:numericBase must be 8, 10 or 16." ] ;
    sh:property [ sh:path bddo:dataType ; sh:hasValue bddo:asciiInteger ;
        sh:message "bddo:numericBase applies only to a field whose bddo:dataType is bddo:asciiInteger." ] .

bddo:EndiannessRuleShape a sh:NodeShape ;
    sh:targetClass bddo:EndiannessRule ;
    sh:property [ sh:path bddo:condition ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:ruleEndianness ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( bddo:BigEndian bddo:LittleEndian ) ;
        sh:message "bddo:ruleEndianness must be bddo:BigEndian or bddo:LittleEndian." ] .

bddo:ConditionalEndiannessShape a sh:NodeShape ;
    sh:targetSubjectsOf bddo:hasConditionalEndianness ;
    sh:property [ sh:path bddo:hasConditionalEndianness ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "bddo:hasConditionalEndianness must point to a single rdf:List." ] ;
    sh:property [ sh:path bddo:endianness ; sh:maxCount 0 ;
        sh:message "bddo:endianness and bddo:hasConditionalEndianness are mutually exclusive." ] ;
    sh:property [ sh:path ( bddo:hasConditionalEndianness [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:class bddo:EndiannessRule ;
        sh:message "Every member of a hasConditionalEndianness list must be a bddo:EndiannessRule." ] .

bddo:DelimitedRecordsShape a sh:NodeShape ;
    sh:targetClass bddo:DelimitedRecords ;
    sh:property [ sh:path bddo:recordDelimiter ; sh:datatype xsd:hexBinary ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:fieldDelimiter ; sh:datatype xsd:hexBinary ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:whitespaceSeparated ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ;
    # A run of whitespace and a fixed delimiter are two different separation rules.
    sh:not [ sh:and ( [ sh:property [ sh:path bddo:fieldDelimiter ; sh:minCount 1 ] ]
                      [ sh:property [ sh:path bddo:whitespaceSeparated ; sh:hasValue true ] ] ) ] ;
    sh:property [ sh:path bddo:keyValueSeparator ; sh:datatype xsd:hexBinary ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:quoteChar ; sh:datatype xsd:hexBinary ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:escapeChar ; sh:datatype xsd:hexBinary ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:commentPrefix ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:skipRecords ; sh:minInclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:trimWhitespace ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:hasField ; sh:minCount 1 ;
        sh:message "A bddo:DelimitedRecords must declare at least one field." ] .

# A KeyValueHeader needs a separator, and each of its fields is located at most one way. A field
# with neither locator is located by its simple key (Processing Model, key/value headers), which
# is what an HDL compiler emits for an unquoted header field name.
bddo:KeyValueHeaderShape a sh:NodeShape ;
    sh:targetClass bddo:KeyValueHeader ;
    sh:property [ sh:path bddo:keyValueSeparator ; sh:minCount 1 ;
        sh:message "A bddo:KeyValueHeader must declare bddo:keyValueSeparator." ] ;
    # At most one locator per field: bddo:key in a flat header, bddo:keyPath in a nested one, or
    # neither, when the field is located by its simple key.
    sh:property [ sh:path ( bddo:hasField [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:node [ sh:xone (
            [ sh:property [ sh:path bddo:key ; sh:minCount 1 ; sh:maxCount 1 ] ;
              sh:property [ sh:path bddo:keyPath ; sh:maxCount 0 ] ]
            [ sh:property [ sh:path bddo:keyPath ; sh:minCount 1 ; sh:maxCount 1 ] ;
              sh:property [ sh:path bddo:key ; sh:maxCount 0 ] ]
            [ sh:property [ sh:path bddo:key ; sh:maxCount 0 ] ;
              sh:property [ sh:path bddo:keyPath ; sh:maxCount 0 ] ] ) ;
          sh:message "Every field of a bddo:KeyValueHeader declares at most one bddo:key (flat) or one bddo:keyPath (nested), never both; a field with neither is located by its simple key." ] ] .

# ---------- Tree documents ----------
bddo:TreeDocumentShape a sh:NodeShape ;
    sh:targetClass bddo:TreeDocument ;
    sh:property [ sh:path bddo:treeSyntax ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( bddo:xml bddo:json ) ;
        sh:message "A bddo:TreeDocument must declare exactly one bddo:treeSyntax: bddo:xml or bddo:json." ] ;
    sh:property [ sh:path bddo:hasNamespaceBinding ; sh:class bddo:NamespaceBinding ] ;
    sh:property [ sh:path bddo:hasField ; sh:minCount 1 ;
        sh:message "A bddo:TreeDocument must declare at least one field." ] ;
    # Every field is located by a path, and by nothing else. A byte offset or a record key in a
    # tree document is a leftover from another container form and would address nothing.
    sh:property [ sh:path ( bddo:hasField [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:node [
            sh:property [ sh:path bddo:nodePath ; sh:minCount 1 ; sh:maxCount 1 ] ;
            sh:property [ sh:path bddo:key ; sh:maxCount 0 ] ;
            sh:property [ sh:path bddo:keyPath ; sh:maxCount 0 ] ;
            sh:property [ sh:path bddo:atOffset ; sh:maxCount 0 ] ;
            sh:message "Every field of a bddo:TreeDocument is located by exactly one bddo:nodePath, and not by a key, a key path or a byte offset." ] ] ;
    # Namespaces bind prefixes in XPath. JSON Pointer has no prefixes to bind, so a binding on a
    # JSON document is a misunderstanding worth catching rather than ignoring.
    sh:sparql [ sh:message "bddo:hasNamespaceBinding applies to an XML tree document; JSON Pointer has no namespace prefixes." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this bddo:treeSyntax bddo:json .
            $this bddo:hasNamespaceBinding ?b .
        }""" ] .

bddo:NamespaceBindingShape a sh:NodeShape ;
    sh:targetClass bddo:NamespaceBinding ;
    sh:targetObjectsOf bddo:hasNamespaceBinding ;
    sh:targetSubjectsOf bddo:namespacePrefix , bddo:namespaceIRI ;
    # The prefix MAY be the empty string -- that is how a default namespace is bound -- so
    # minCount rather than a non-blank check.
    sh:property [ sh:path bddo:namespacePrefix ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:namespaceIRI ; sh:datatype xsd:anyURI ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A namespace binding needs the IRI it binds to; a prefix alone names nothing." ] ;
    # XML Namespaces: a namespace name is an absolute IRI (a relative one is deprecated and
    # compares as a string, so two documents could disagree about it).
    sh:property [ sh:path bddo:namespaceIRI ; sh:pattern "^[A-Za-z][A-Za-z0-9+.-]*:" ;
        sh:message "bddo:namespaceIRI must be an absolute IRI (it begins with a scheme)." ] .

# The prefixes a tree document's XML paths use: each bound once, and every one used is bound.
bddo:TreePrefixBindingShape a sh:NodeShape ;
    sh:targetClass bddo:TreeDocument ;
    sh:targetSubjectsOf bddo:hasNamespaceBinding ;
    sh:sparql [ sh:message "Two bddo:hasNamespaceBinding entries of one tree document bind the prefix '{?px}'; a prefix is bound at most once." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this ?px WHERE {
            $this bddo:hasNamespaceBinding ?a , ?b .
            ?a bddo:namespacePrefix ?px . ?b bddo:namespacePrefix ?px .
            FILTER(!sameTerm(?a, ?b))
        }""" ] ;
    sh:sparql [ sh:message "A bddo:nodePath of this XML tree document ({?p}) uses a prefix that no bddo:hasNamespaceBinding binds (only xml is predeclared)." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this ?p WHERE {
            { SELECT $this (GROUP_CONCAT(?px; separator="|") AS ?alts) WHERE {
                $this bddo:treeSyntax bddo:xml .
                OPTIONAL { $this bddo:hasNamespaceBinding/bddo:namespacePrefix ?px . FILTER(?px != "") }
            } GROUP BY $this }
            $this bddo:hasField/rdf:rest*/rdf:first ?f .
            ?f bddo:nodePath ?p .
            # Each bound prefix is matched literally: an NCName may hold '.' and '-', which a
            # regular expression reads as metacharacters, so each is put in a class of its own.
            BIND(REPLACE(?alts, "([.-])", "[$1]") AS ?quoted)
            BIND(REPLACE(?p, CONCAT("(^|[/@])(", IF(?quoted != "", CONCAT(?quoted, "|"), ""), "xml):"), "$1") AS ?rest)
            FILTER(REGEX(?rest, "(^|[/@])[^/@:]+:"))
        }""" ] .

# A path outside a tree document addresses nothing.
bddo:NodePathShape a sh:NodeShape ;
    sh:targetClass bddo:Field ;
    sh:targetSubjectsOf bddo:nodePath ;
    sh:property [ sh:path bddo:nodePath ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    # Path syntax by the container's tree syntax: a JSON Pointer (RFC 6901), or the abbreviated
    # XPath of the Processing Model (child steps, 1-based positional predicates, one final
    # attribute step). Names are any run of characters that are not path punctuation, so every
    # XML name matches; what a name means is resolved at load time.
    sh:sparql [ sh:message "This bddo:nodePath ({?p}) is not a JSON Pointer (RFC 6901): it must be empty or a sequence of /-prefixed reference tokens, with ~ only in ~0 or ~1." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this ?p WHERE {
            $this bddo:nodePath ?p .
            ?container bddo:hasField/rdf:rest*/rdf:first $this ; bddo:treeSyntax bddo:json .
            FILTER(!REGEX(?p, "^(/([^~/]|~[01])*)*$"))
        }""" ] ;
    sh:sparql [ sh:message "This bddo:nodePath ({?p}) is not an abbreviated XPath of child steps, optional [n] positions (n >= 1) and at most one final @attribute step." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this ?p WHERE {
            $this bddo:nodePath ?p .
            ?container bddo:hasField/rdf:rest*/rdf:first $this ; bddo:treeSyntax bddo:xml .
            FILTER(!REGEX(?p, "^(/?([^/@\\\\[\\\\]:\\\\s]+:)?[^/@\\\\[\\\\]:\\\\s]+(\\\\[[1-9][0-9]*\\\\])?(/([^/@\\\\[\\\\]:\\\\s]+:)?[^/@\\\\[\\\\]:\\\\s]+(\\\\[[1-9][0-9]*\\\\])?)*(/@([^/@\\\\[\\\\]:\\\\s]+:)?[^/@\\\\[\\\\]:\\\\s]+)?|@([^/@\\\\[\\\\]:\\\\s]+:)?[^/@\\\\[\\\\]:\\\\s]+)$"))
        }""" ] ;
    # Every container, not just one: a field shared by a tree document and a binary struct would
    # otherwise pass, and the struct would read a field it cannot locate.
    sh:sparql [ sh:message "bddo:nodePath locates a node in a parsed tree, so every container of the field must be a bddo:TreeDocument ({?container} is not, or there is none)." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this ?container WHERE {
            $this bddo:nodePath ?p .
            {
                FILTER NOT EXISTS { ?any bddo:hasField/rdf:rest*/rdf:first $this }
            } UNION {
                ?container bddo:hasField/rdf:rest*/rdf:first $this .
                FILTER NOT EXISTS { ?container a bddo:TreeDocument }
            }
        }""" ] .

# ---------- Nested records ----------
bddo:RecordGroupingShape a sh:NodeShape ;
    sh:targetClass bddo:RecordGrouping ;
    sh:property [ sh:path bddo:groupingStyle ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( bddo:keyedGroup bddo:valuedGroup bddo:sectionHeaded ) ;
        sh:message "A bddo:RecordGrouping must name exactly one style: keyedGroup, valuedGroup or sectionHeaded." ] ;
    # Both tokens, always. A grouping that says where a group starts and not where it ends
    # cannot be read: every record after the first group would be inside it.
    sh:property [ sh:path bddo:groupOpenToken ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:groupCloseToken ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] .

bddo:GroupedRecordsShape a sh:NodeShape ;
    sh:targetClass bddo:DelimitedRecords ;
    sh:property [ sh:path bddo:hasGrouping ; sh:class bddo:RecordGrouping ; sh:maxCount 1 ] ;
    sh:property [ sh:path bddo:pathSeparator ; sh:datatype xsd:string ; sh:maxCount 1 ] .

# A path has nothing to traverse unless its container nests.
bddo:KeyPathShape a sh:NodeShape ;
    sh:targetClass bddo:Field ;
    sh:property [ sh:path bddo:keyPath ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:sparql [ sh:message "bddo:keyPath locates a field inside nested groups, so its container must declare bddo:hasGrouping; without one the container is flat and the path addresses nothing." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this bddo:keyPath ?path .
            FILTER NOT EXISTS {
                ?container bddo:hasField/rdf:rest*/rdf:first $this .
                ?container bddo:hasGrouping ?g .
            }
        }""" ] .

# bddo:key is meaningful only inside a KeyValueHeader; a table's columns are positional.
bddo:DelimitedTableShape a sh:NodeShape ;
    sh:targetClass bddo:DelimitedTable ;
    sh:or ( [ sh:property [ sh:path bddo:fieldDelimiter ; sh:minCount 1 ] ]
            [ sh:property [ sh:path bddo:whitespaceSeparated ; sh:hasValue true ] ] ) ;
    sh:property [ sh:path bddo:keyValueSeparator ; sh:maxCount 0 ;
        sh:message "bddo:keyValueSeparator applies to a KeyValueHeader, not a DelimitedTable." ] ;
    sh:property [ sh:path ( bddo:hasField [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:node [ sh:property [ sh:path bddo:key ; sh:maxCount 0 ;
            sh:message "bddo:key applies to a field of a KeyValueHeader; a DelimitedTable's columns are located by position." ] ] ] .

# A varint's length comes from the data, so declaring a width contradicts it.
bddo:VarintWidthShape a sh:NodeShape ;
    sh:targetClass bddo:Field ;
    sh:sparql [ sh:message "A variable-length integer field (bddo:varuint, bddo:varint, bddo:sqliteVarint) must not declare a width or terminator: its length is discovered from the bytes." ;
        sh:prefixes bddo:_prefixes ;
        sh:select """SELECT $this WHERE {
            $this bddo:dataType ?dt .
            FILTER(?dt IN (bddo:varuint, bddo:varint, bddo:sqliteVarint))
            $this ?p ?v .
            FILTER(?p IN (bddo:size, bddo:sizeFromField, bddo:sizeFromExpression,
                          bddo:sizeToEndOfStream, bddo:terminator, bddo:bitLength))
        }""" ] .

# ---------- Range datatype shapes ----------
# Each XSD rdfs:range above, enforced wherever the property is used: activation is by
# subjects-of, so an untyped subject is checked too (tools/test_range_datatypes.py).
# Integer ranges accept any XSD integer-family datatype within the range's bounds.
bddo:IntegerValueShape a sh:NodeShape ; rdfs:label "Integer value shape" ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:short ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedByte ] ) .
bddo:RangeDatatypeShape a sh:NodeShape ; rdfs:label "Range datatype shape" ;
    rdfs:isDefinedBy <https://hexplain.io/ns/bddo> ;
    sh:targetSubjectsOf bddo:alignment ,
        bddo:atOffset ,
        bddo:atOffsetFromExpression ,
        bddo:bitLength ,
        bddo:bitWidth ,
        bddo:commentPrefix ,
        bddo:condition ,
        bddo:coversExpression ,
        bddo:coversFromExpression ,
        bddo:coversToExpression ,
        bddo:crcCheck ,
        bddo:crcInit ,
        bddo:crcPolynomial ,
        bddo:crcReflectIn ,
        bddo:crcReflectOut ,
        bddo:crcWidth ,
        bddo:crcXorOut ,
        bddo:dispatchOnExpression ,
        bddo:enumIsFlags ,
        bddo:escapeChar ,
        bddo:fieldDelimiter ,
        bddo:groupCloseToken ,
        bddo:groupOpenToken ,
        bddo:isPresentIf ,
        bddo:isSigned ,
        bddo:key ,
        bddo:keyIsCaseInsensitive ,
        bddo:keyPath ,
        bddo:keyValueSeparator ,
        bddo:localExpression ,
        bddo:namespaceIRI ,
        bddo:namespacePrefix ,
        bddo:nodePath ,
        bddo:numericBase ,
        bddo:pathSeparator ,
        bddo:quoteChar ,
        bddo:recordDelimiter ,
        bddo:repeatCount ,
        bddo:repeatCountFromExpression ,
        bddo:repeatUntil ,
        bddo:separatedBy ,
        bddo:size ,
        bddo:sizeFromExpression ,
        bddo:sizeToEndOfStream ,
        bddo:skipRecords ,
        bddo:syncOnMarker ,
        bddo:terminator ,
        bddo:trimNull ,
        bddo:trimWhitespace ,
        bddo:validIf ,
        bddo:valueFromExpression ,
        bddo:whitespaceSeparated ;
    sh:property [ sh:path bddo:alignment ; sh:node bddo:IntegerValueShape ; sh:minInclusive 1 ;
        sh:message "bddo:alignment takes a positive integer (rdfs:range xsd:positiveInteger)." ] ;
