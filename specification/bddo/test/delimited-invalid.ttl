# Two violations: a KeyValueHeader whose field declares two bddo:key values (a field is
# located at most one way), and a KeyValueHeader with no keyValueSeparator.
# Expected to trip bddo:KeyValueHeaderShape.
# expect: ex:BadHeader bddo:KeyValueHeaderShape sh:MinCountConstraintComponent
# expect: ex:BadHeader bddo:KeyValueHeaderShape sh:NodeConstraintComponent
# expect: ex:BadHeader.orphan bddo:KeyValueHeaderShape sh:XoneConstraintComponent
@prefix bddo: <https://hexplain.io/ns/bddo#> .
@prefix ex:   <https://hexplain.io/test/delim-invalid#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

ex:BadHeader a bddo:KeyValueHeader ;
    rdfs:comment "Expected to trip bddo:KeyValueHeaderShape (no keyValueSeparator; field has two keys)." ;
    bddo:recordDelimiter "0A"^^xsd:hexBinary ;
    bddo:hasField ( ex:BadHeader.orphan ) .

ex:BadHeader.orphan a bddo:Field ;
    bddo:key "samples" , "lines" ;
    bddo:dataType bddo:asciiInteger ; bddo:terminator "0A"^^xsd:hexBinary .
