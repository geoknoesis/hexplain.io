# An offset counted from the start of an earlier sibling: the payload begins a stated number of
# bytes after the first byte of the header, wherever the header itself was read.
@prefix bddo: <https://hexplain.io/ns/bddo#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix ex:   <http://example.org/sibling#> .

ex:Block a bddo:Struct ; bddo:hasField ( ex:Block.magic ex:Block.header ex:Block.dataOffset ex:Block.payload ) .
ex:Block.magic a bddo:Field ; bddo:dataType bddo:uint32be .
ex:Block.header a bddo:Field ; bddo:dataType bddo:bytes ; bddo:size 16 .
ex:Block.dataOffset a bddo:Field ; bddo:dataType bddo:uint32le .
ex:Block.payload a bddo:Field ; bddo:dataType bddo:bytes ; bddo:size 8 ;
    bddo:atOffsetFromField ex:Block.dataOffset ; bddo:offsetBase bddo:fieldStart ; bddo:offsetBaseField ex:Block.header .
# The other bases need, and take, no base field.
ex:Block.absolute a bddo:Field ; bddo:dataType bddo:uint8 ; bddo:atOffset 4 ; bddo:offsetBase bddo:streamStart .
