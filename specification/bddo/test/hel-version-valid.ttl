# A description may state the HEL version its expressions are written against, once, as major.minor.
@prefix ex:   <https://hexplain.io/test/hel-version-valid#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix bddo: <https://hexplain.io/ns/bddo#> .

<https://hexplain.io/test/hel-version-valid> a owl:Ontology ; bddo:helVersion "1.0" .
ex:Header a bddo:Struct ; bddo:endianness bddo:BigEndian ; bddo:hasField ( ex:Header.magic ) .
ex:Header.magic a bddo:Field ; bddo:dataType bddo:uint32 .
