# Every registered character encoding on a text field, and a profile-minted custom encoding
# declared (bddo:CustomEncodingShape) but not yet used by a field, so nothing warns.
@prefix bddo: <https://hexplain.io/ns/bddo#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix ex:   <http://example.org/enc#> .

ex:Latin1Name a bddo:Field ; bddo:dataType bddo:string ; bddo:size 32 ; bddo:encoding bddo:latin1 .
ex:Utf32Name a bddo:Field ; bddo:dataType bddo:string ; bddo:size 64 ; bddo:encoding bddo:utf32le .
ex:Utf32BeName a bddo:Field ; bddo:dataType bddo:string ; bddo:size 64 ; bddo:encoding bddo:utf32be .
ex:Ucs2Name a bddo:Field ; bddo:dataType bddo:string ; bddo:size 32 ; bddo:encoding bddo:ucs2le .
ex:Ucs2BeName a bddo:Field ; bddo:dataType bddo:string ; bddo:size 32 ; bddo:encoding bddo:ucs2be .
ex:AnsiName a bddo:Field ; bddo:dataType bddo:string ; bddo:size 32 ; bddo:encoding bddo:windows1252 .
ex:Latin2Name a bddo:Field ; bddo:dataType bddo:string ; bddo:size 32 ; bddo:encoding bddo:iso8859_2 .
ex:CyrillicName a bddo:Field ; bddo:dataType bddo:string ; bddo:size 32 ; bddo:encoding bddo:iso8859_5 .
ex:GreekName a bddo:Field ; bddo:dataType bddo:string ; bddo:size 32 ; bddo:encoding bddo:iso8859_7 .
ex:TurkishName a bddo:Field ; bddo:dataType bddo:string ; bddo:size 32 ; bddo:encoding bddo:iso8859_9 .
ex:EuroName a bddo:Field ; bddo:dataType bddo:string ; bddo:size 32 ; bddo:encoding bddo:iso8859_15 .
ex:MainframeName a bddo:Field ; bddo:dataType bddo:string ; bddo:size 32 ; bddo:encoding bddo:ebcdic037 .
ex:JapaneseName a bddo:Field ; bddo:dataType bddo:string ; bddo:size 32 ; bddo:encoding bddo:shiftJis .
ex:Utf8Name a bddo:Field ; bddo:dataType bddo:string ; bddo:terminator "00"^^xsd:hexBinary ; bddo:encoding bddo:utf8 .

# A profile's own encoding: a bddo:Encoding through its subclass, identified by its IANA name.
ex:cp437 a bddo:CustomEncoding ; rdfs:label "IBM PC code page 437" ; bddo:ianaCharset "IBM437" .
