# A derived field states its expression and nothing that reads, places, aligns or pads bytes.
@prefix bddo: <https://hexplain.io/ns/bddo#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix ex:   <http://example.org/derived#> .

ex:Total a bddo:Field ; bddo:valueFromExpression "a + b" .
ex:Flag a bddo:Field ; bddo:valueFromExpression "kind == 2" .
