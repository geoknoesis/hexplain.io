# Hexplain Register — Checksum Algorithm 1.0
# Controlled values for the hx-integrity aspect: checksum/hash algorithm identifiers as
# published by the relevant standards bodies (IETF, NIST). Split out of the aspect so
# another jurisdiction or profile can publish a sibling register without forking the aspect
# or minting into a namespace it does not own.
# Codes are NOT here: a raw wire code belongs to the format that encodes it, and is carried
# by that profile's HDL enum.
@prefix rck: <https://hexplain.io/ns/register/checksum#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .

<https://hexplain.io/ns/register/checksum> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/register/checksum/1.0> ; owl:versionInfo "1.0" ;
    rdfs:label "Hexplain Register — Checksum Algorithm" ;
    dcterms:created "2026-08-08"^^xsd:date ;
    dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "rck" ;
    vann:preferredNamespaceUri "https://hexplain.io/ns/register/checksum#" .

# ---------- Checksum Algorithm Register (SKOS) ----------
rck:ChecksumAlgorithmScheme a skos:ConceptScheme ; rdfs:isDefinedBy <https://hexplain.io/ns/register/checksum> ;
    skos:prefLabel "Checksum Algorithm Register"@en .
rck:CRC32 a skos:Concept ; skos:inScheme rck:ChecksumAlgorithmScheme ; skos:topConceptOf rck:ChecksumAlgorithmScheme ; skos:prefLabel "CRC-32"@en .
rck:MD5 a skos:Concept ; skos:inScheme rck:ChecksumAlgorithmScheme ; skos:topConceptOf rck:ChecksumAlgorithmScheme ; skos:prefLabel "MD5"@en .
rck:SHA1 a skos:Concept ; skos:inScheme rck:ChecksumAlgorithmScheme ; skos:topConceptOf rck:ChecksumAlgorithmScheme ; skos:prefLabel "SHA-1"@en .
rck:SHA256 a skos:Concept ; skos:inScheme rck:ChecksumAlgorithmScheme ; skos:topConceptOf rck:ChecksumAlgorithmScheme ; skos:prefLabel "SHA-256"@en .

