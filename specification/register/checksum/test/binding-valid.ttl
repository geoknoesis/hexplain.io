# A profile binds the integrity aspect's algorithm property to this register; a lifted
# resource then names one of its concepts.
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix rck:   <https://hexplain.io/ns/register/checksum#> .
@prefix aintg: <https://hexplain.io/ns/aspect/integrity#> .
@prefix ex:    <https://example.org/checksum#> .

ex:profile hexplain:usesRegister [ a hexplain:RegisterBinding ; hexplain:forProperty aintg:checksumAlgorithm ; hexplain:register rck:ChecksumAlgorithmScheme ] .
ex:payload aintg:checksumAlgorithm rck:CRC32 ; aintg:checksum "CBF43926"^^xsd:hexBinary .
ex:archive aintg:checksumAlgorithm rck:SHA256 .
