usnato:X7 a skos:Concept ; skos:inScheme usnato:ExemptionScheme ; skos:topConceptOf usnato:ExemptionScheme ; skos:prefLabel "Exemption X7"@en .
usnato:X8 a skos:Concept ; skos:inScheme usnato:ExemptionScheme ; skos:topConceptOf usnato:ExemptionScheme ; skos:prefLabel "Exemption X8"@en .
usnato:X251 a skos:Concept ; skos:inScheme usnato:ExemptionScheme ; skos:topConceptOf usnato:ExemptionScheme ; skos:prefLabel "Exemption X251"@en .
usnato:X252 a skos:Concept ; skos:inScheme usnato:ExemptionScheme ; skos:topConceptOf usnato:ExemptionScheme ; skos:prefLabel "Exemption X252"@en .
usnato:X253 a skos:Concept ; skos:inScheme usnato:ExemptionScheme ; skos:topConceptOf usnato:ExemptionScheme ; skos:prefLabel "Exemption X253"@en .
usnato:X254 a skos:Concept ; skos:inScheme usnato:ExemptionScheme ; skos:topConceptOf usnato:ExemptionScheme ; skos:prefLabel "Exemption X254"@en .
usnato:X255 a skos:Concept ; skos:inScheme usnato:ExemptionScheme ; skos:topConceptOf usnato:ExemptionScheme ; skos:prefLabel "Exemption X255"@en .
usnato:X256 a skos:Concept ; skos:inScheme usnato:ExemptionScheme ; skos:topConceptOf usnato:ExemptionScheme ; skos:prefLabel "Exemption X256"@en .
usnato:X257 a skos:Concept ; skos:inScheme usnato:ExemptionScheme ; skos:topConceptOf usnato:ExemptionScheme ; skos:prefLabel "Exemption X257"@en .
usnato:X258 a skos:Concept ; skos:inScheme usnato:ExemptionScheme ; skos:topConceptOf usnato:ExemptionScheme ; skos:prefLabel "Exemption X258"@en .
