@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rgeo: <https://hexplain.io/ns/register/geometry-type#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://hexplain.io/ns/register/geometry-type> skos:definition "The vocabulary module publishing Hexplain Register — Geometry Type terms, its imports and associated validation declarations."@en ;
    skos:scopeNote "Load to obtain the concepts of this register. A profile binds its schemes to the properties they supply with hexplain:usesRegister; the aspect the values serve does not import it. Use concept IRIs as values; concept schemes and collections organize those values rather than describing parsed instances."@en .
rgeo:GeometryTypeScheme rdfs:label "Geometry Type Register"@en ;
    skos:definition "The controlled concept scheme grouping geometry type values. Membership identifies the applicable value set; raw format codes are defined by profiles rather than by this scheme."@en .
rgeo:LineString rdfs:label "LineString"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/geometry-type> ;
    skos:definition "A geometry consisting of an ordered sequence of positions joined by line segments."@en .
rgeo:MultiLineString rdfs:label "MultiLineString"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/geometry-type> ;
    skos:definition "A geometry collection whose members are line strings."@en .
rgeo:MultiPoint rdfs:label "MultiPoint"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/geometry-type> ;
    skos:definition "A geometry collection whose members are points."@en .
rgeo:MultiPolygon rdfs:label "MultiPolygon"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/geometry-type> ;
    skos:definition "A geometry collection whose members are polygons."@en .
rgeo:Point rdfs:label "Point"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/geometry-type> ;
    skos:definition "A geometry consisting of a single coordinate position."@en .
rgeo:Polygon rdfs:label "Polygon"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/geometry-type> ;
    skos:definition "A planar surface geometry bounded by an exterior ring and optionally interior rings."@en .
