# Hexplain Register — Geometry Type 1.0
# Controlled values for the hx-geometry aspect: geometry-type identifiers aligned to the
# OGC Simple Features / GeoSPARQL vocabulary. Split out of the aspect so another jurisdiction
# or profile can publish a sibling register without forking the aspect or minting into a
# namespace it does not own.
# Codes are NOT here: a raw wire code belongs to the format that encodes it, and is carried
# by that profile's HDL enum.
@prefix rgeo: <https://hexplain.io/ns/register/geometry-type#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix geosparql: <http://www.opengis.net/ont/geosparql#> .

<https://hexplain.io/ns/register/geometry-type> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/register/geometry-type/1.0> ; owl:versionInfo "1.0" ;
    rdfs:label "Hexplain Register — Geometry Type" ;
    dcterms:created "2026-08-08"^^xsd:date ;
    dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "rgeo" ;
    vann:preferredNamespaceUri "https://hexplain.io/ns/register/geometry-type#" .

# ---------- Geometry Type Register (SKOS) ----------
rgeo:GeometryTypeScheme a skos:ConceptScheme ; rdfs:isDefinedBy <https://hexplain.io/ns/register/geometry-type> ;
    skos:prefLabel "Geometry Type Register"@en .
rgeo:Point a skos:Concept ; skos:inScheme rgeo:GeometryTypeScheme ; skos:topConceptOf rgeo:GeometryTypeScheme ;
    skos:prefLabel "Point"@en ; skos:closeMatch geosparql:Point .
rgeo:LineString a skos:Concept ; skos:inScheme rgeo:GeometryTypeScheme ; skos:topConceptOf rgeo:GeometryTypeScheme ;
    skos:prefLabel "LineString"@en .
rgeo:Polygon a skos:Concept ; skos:inScheme rgeo:GeometryTypeScheme ; skos:topConceptOf rgeo:GeometryTypeScheme ;
    skos:prefLabel "Polygon"@en .
rgeo:MultiPoint a skos:Concept ; skos:inScheme rgeo:GeometryTypeScheme ; skos:topConceptOf rgeo:GeometryTypeScheme ;
    skos:prefLabel "MultiPoint"@en .
rgeo:MultiLineString a skos:Concept ; skos:inScheme rgeo:GeometryTypeScheme ; skos:topConceptOf rgeo:GeometryTypeScheme ;
    skos:prefLabel "MultiLineString"@en .
rgeo:MultiPolygon a skos:Concept ; skos:inScheme rgeo:GeometryTypeScheme ; skos:topConceptOf rgeo:GeometryTypeScheme ;
    skos:prefLabel "MultiPolygon"@en .

