# Hexplain Register — Geometry Type 1.3
# Controlled values for the hx-geometry aspect: geometry-type identifiers aligned to the
# OGC Simple Features vocabulary (the sf: namespace GeoSPARQL uses for geometry types;
# GeoSPARQL itself has no geo:Point class). A concept points at its Simple Features class with
# rdfs:seeAlso, not a SKOS mapping: sf:Point is an OWL class, and skos:closeMatch relates
# concepts. Split out of the aspect so another jurisdiction
# or profile can publish a sibling register without forking the aspect or minting into a
# namespace it does not own.
# Codes are NOT here: a raw wire code belongs to the format that encodes it, and is carried
# by that profile's HDL enum.
@prefix rgeo: <https://hexplain.io/ns/register/geometry-type#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix sf:     <http://www.opengis.net/ont/sf#> .

<https://hexplain.io/ns/register/geometry-type> a owl:Ontology ;
    rdfs:seeAlso <https://hexplain.io/specification/register/geometry-type/geometry-type-doc.ttl> ;
    owl:versionIRI <https://hexplain.io/ns/register/geometry-type/1.3> ; owl:versionInfo "1.3" ;
    owl:priorVersion <https://hexplain.io/ns/register/geometry-type/1.2> ;
    dcterms:modified "2026-10-13"^^xsd:date ;
    rdfs:label "Hexplain Register — Geometry Type"@en ;
    dcterms:created "2026-08-08"^^xsd:date ;
    dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "rgeo" ;
    vann:preferredNamespaceUri "https://hexplain.io/ns/register/geometry-type#" .

# ---------- Geometry Type Register (SKOS) ----------
rgeo:GeometryTypeScheme a skos:ConceptScheme ; rdfs:isDefinedBy <https://hexplain.io/ns/register/geometry-type> ;
    skos:prefLabel "Geometry Type Register"@en .
rgeo:Point a skos:Concept ; skos:definition "A geometry consisting of a single coordinate position."@en ; skos:inScheme rgeo:GeometryTypeScheme ; skos:topConceptOf rgeo:GeometryTypeScheme ;
    skos:prefLabel "Point"@en ; rdfs:seeAlso sf:Point .
rgeo:LineString a skos:Concept ; skos:definition "A geometry consisting of an ordered sequence of positions joined by line segments."@en ; skos:inScheme rgeo:GeometryTypeScheme ; skos:topConceptOf rgeo:GeometryTypeScheme ;
    skos:prefLabel "LineString"@en ; rdfs:seeAlso sf:LineString .
rgeo:Polygon a skos:Concept ; skos:definition "A planar surface geometry bounded by an exterior ring and optionally interior rings."@en ; skos:inScheme rgeo:GeometryTypeScheme ; skos:topConceptOf rgeo:GeometryTypeScheme ;
    skos:prefLabel "Polygon"@en ; rdfs:seeAlso sf:Polygon .
rgeo:MultiPoint a skos:Concept ; skos:definition "A geometry collection whose members are points."@en ; skos:inScheme rgeo:GeometryTypeScheme ; skos:topConceptOf rgeo:GeometryTypeScheme ;
    skos:prefLabel "MultiPoint"@en ; rdfs:seeAlso sf:MultiPoint .
rgeo:MultiLineString a skos:Concept ; skos:definition "A geometry collection whose members are line strings."@en ; skos:inScheme rgeo:GeometryTypeScheme ; skos:topConceptOf rgeo:GeometryTypeScheme ;
    skos:prefLabel "MultiLineString"@en ; rdfs:seeAlso sf:MultiLineString .
rgeo:MultiPolygon a skos:Concept ; skos:definition "A geometry collection whose members are polygons."@en ; skos:inScheme rgeo:GeometryTypeScheme ; skos:topConceptOf rgeo:GeometryTypeScheme ;
    skos:prefLabel "MultiPolygon"@en ; rdfs:seeAlso sf:MultiPolygon .

rgeo:GeometryCollection a skos:Concept ;
    skos:inScheme rgeo:GeometryTypeScheme ; skos:topConceptOf rgeo:GeometryTypeScheme ;
    skos:prefLabel "GeometryCollection"@en ; rdfs:seeAlso sf:GeometryCollection ; rdfs:label "Geometry collection"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/geometry-type> ;
    skos:definition "A geometry containing zero or more member geometries, potentially of different geometry types."@en ;
    skos:scopeNote "Use for ISO WKB type 7 or its dimensional variants. Collection membership does not itself imply a shared CRS, common ordinate layout, topology, ordering semantics or nonemptiness; the selected format profile supplies those constraints."@en .

# ---------- Term ownership ----------
# rdfs:isDefinedBy for the terms whose declaration above does not state it. A new term states
# its own; tools/test_term_reference.py requires it of every term this file defines.
rgeo:LineString rdfs:isDefinedBy <https://hexplain.io/ns/register/geometry-type> .
rgeo:MultiLineString rdfs:isDefinedBy <https://hexplain.io/ns/register/geometry-type> .
rgeo:MultiPoint rdfs:isDefinedBy <https://hexplain.io/ns/register/geometry-type> .
rgeo:MultiPolygon rdfs:isDefinedBy <https://hexplain.io/ns/register/geometry-type> .
rgeo:Point rdfs:isDefinedBy <https://hexplain.io/ns/register/geometry-type> .
rgeo:Polygon rdfs:isDefinedBy <https://hexplain.io/ns/register/geometry-type> .
