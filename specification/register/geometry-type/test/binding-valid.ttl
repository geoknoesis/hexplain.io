@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix rgeo:  <https://hexplain.io/ns/register/geometry-type#> .
@prefix ageom: <https://hexplain.io/ns/aspect/geometry#> .
@prefix ex:    <https://example.org/geometry#> .

ex:profile hexplain:usesRegister [ a hexplain:RegisterBinding ; hexplain:forProperty ageom:geometryType ; hexplain:register rgeo:GeometryTypeScheme ] .
ex:parcel ageom:geometryType rgeo:Polygon ; ageom:hasZ false ; ageom:hasM false .
ex:route ageom:geometryType rgeo:MultiLineString .
