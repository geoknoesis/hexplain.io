# expect: ex:image hexplain:RegisterBindingShape sh:SPARQLConstraintComponent
# expect: ex:Old hexplain:RegisterLifecycleShape sh:OrConstraintComponent
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix rcol:   <https://hexplain.io/ns/register/color#> .
@prefix rgeo:   <https://hexplain.io/ns/register/geometry-type#> .
@prefix acolor: <https://hexplain.io/ns/aspect/color#> .
@prefix ex:     <https://example.org/color#> .

ex:profile hexplain:usesRegister [ a hexplain:RegisterBinding ; hexplain:forProperty acolor:colorSpace ; hexplain:register rcol:ColorSpaceScheme ] .
# A geometry type is not a colour space.
ex:image acolor:colorSpace rgeo:Point .
# A retired entry of this register that states no status and no note.
ex:Old a skos:Concept ; skos:inScheme rcol:ColorSpaceScheme ; skos:prefLabel "Old space"@en ; owl:deprecated true .
