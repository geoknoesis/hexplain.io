# Hexplain Register — Colour Space 1.1
# Controlled values for the hx-color aspect: colour space identifiers as published by the
# relevant standards bodies (ITU-R, IEC). Split out of the aspect so another jurisdiction or
# profile can publish a sibling register without forking the aspect or minting into a
# namespace it does not own.
# Codes are NOT here: a raw wire code belongs to the format that encodes it, and is carried
# by that profile's HDL enum.
@prefix rcol: <https://hexplain.io/ns/register/color#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .

<https://hexplain.io/ns/register/color> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/register/color/1.1> ; owl:versionInfo "1.1" ;
    dcterms:modified "2026-09-27"^^xsd:date ;
    owl:priorVersion <https://hexplain.io/ns/register/color/1.0> ;
    rdfs:label "Hexplain Register — Colour Space"@en ;
    dcterms:created "2026-08-08"^^xsd:date ;
    dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "rcol" ;
    vann:preferredNamespaceUri "https://hexplain.io/ns/register/color#" .

# ---------- Colour Space Register (SKOS) ----------
rcol:ColorSpaceScheme a skos:ConceptScheme ; rdfs:isDefinedBy <https://hexplain.io/ns/register/color> ;
    skos:prefLabel "Colour Space Register"@en .
rcol:BT601 a skos:Concept ; skos:inScheme rcol:ColorSpaceScheme ; skos:topConceptOf rcol:ColorSpaceScheme ;
    skos:prefLabel "ITU-R BT.601"@en ; skos:altLabel "Rec. 601"@en .
rcol:BT709 a skos:Concept ; skos:inScheme rcol:ColorSpaceScheme ; skos:topConceptOf rcol:ColorSpaceScheme ;
    skos:prefLabel "ITU-R BT.709"@en ; skos:altLabel "Rec. 709"@en .
rcol:BT2020 a skos:Concept ; skos:inScheme rcol:ColorSpaceScheme ; skos:topConceptOf rcol:ColorSpaceScheme ;
    skos:prefLabel "ITU-R BT.2020"@en ; skos:altLabel "Rec. 2020"@en .
rcol:sRGB a skos:Concept ; skos:inScheme rcol:ColorSpaceScheme ; skos:topConceptOf rcol:ColorSpaceScheme ;
    skos:prefLabel "sRGB"@en .

# BEGIN GENERATED TERM DOCUMENTATION
# Editorial annotations only; OWL axioms and SHACL constraints above are unchanged.
@prefix rcol: <https://hexplain.io/ns/register/color#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://hexplain.io/ns/register/color> skos:definition "The vocabulary module publishing Hexplain Register — Colour Space terms, its imports and associated validation declarations."@en ;
    skos:scopeNote "Load to obtain the concepts of this register. A profile binds its schemes to the properties they supply with hexplain:usesRegister; the aspect the values serve does not import it. Use concept IRIs as values; concept schemes and collections organize those values rather than describing parsed instances."@en .
rcol:BT2020 rdfs:label "ITU-R BT.2020"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/color> ;
    skos:definition "Identifier for color interpretation associated with the BT.2020 ultra-high-definition television convention; this does not by itself choose an HDR transfer function."@en .
rcol:BT601 rdfs:label "ITU-R BT.601"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/color> ;
    skos:definition "Identifier for color interpretation associated with the BT.601 television-system convention; the profile must supply the applicable variant and signal range."@en .
rcol:BT709 rdfs:label "ITU-R BT.709"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/color> ;
    skos:definition "Identifier for color interpretation associated with the BT.709 high-definition television convention; transfer and range details must be retained by the profile."@en .
rcol:ColorSpaceScheme rdfs:label "Colour Space Register"@en ;
    skos:definition "The controlled concept scheme grouping colour space values. Membership identifies the applicable value set; raw format codes are defined by profiles rather than by this scheme."@en .
rcol:sRGB rdfs:label "sRGB"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/color> ;
    skos:definition "Identifier for the sRGB color-space convention. Channel coding and embedding of any color profile remain format-specific."@en .
