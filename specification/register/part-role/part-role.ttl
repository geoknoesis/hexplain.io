# Hexplain Register — Part Role 1.1
# Controlled values for the hx-bundle aspect. Unlike the other five registers, this one is
# NOT an external standards vocabulary: it is Hexplain's own vocabulary for the roles a Part
# can play within a multi-part Asset. Split out of the aspect so a profile or jurisdiction can
# publish a sibling register (e.g. adding roles) without forking the aspect.
# Codes are NOT here: a raw wire code belongs to the format that encodes it, and is carried
# by that profile's HDL enum.
@prefix rpr: <https://hexplain.io/ns/register/part-role#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .

<https://hexplain.io/ns/register/part-role> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/register/part-role/1.1> ; owl:versionInfo "1.1" ;
    dcterms:modified "2026-09-27"^^xsd:date ;
    owl:priorVersion <https://hexplain.io/ns/register/part-role/1.0> ;
    rdfs:label "Hexplain Register — Part Role" ;
    dcterms:created "2026-08-08"^^xsd:date ;
    dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "rpr" ;
    vann:preferredNamespaceUri "https://hexplain.io/ns/register/part-role#" .

# ---------- Part-role register (SKOS, open) ----------
rpr:PartRoleScheme a skos:ConceptScheme ; rdfs:isDefinedBy <https://hexplain.io/ns/register/part-role> ;
    skos:prefLabel "Part Role Register"@en .
rpr:GeometryCarrier   a skos:Concept ; skos:inScheme rpr:PartRoleScheme ; skos:topConceptOf rpr:PartRoleScheme ; skos:prefLabel "Geometry carrier"@en .
rpr:AttributeTable    a skos:Concept ; skos:inScheme rpr:PartRoleScheme ; skos:topConceptOf rpr:PartRoleScheme ; skos:prefLabel "Attribute table"@en .
rpr:SpatialReference  a skos:Concept ; skos:inScheme rpr:PartRoleScheme ; skos:topConceptOf rpr:PartRoleScheme ; skos:prefLabel "Spatial reference"@en .
rpr:CharacterEncoding a skos:Concept ; skos:inScheme rpr:PartRoleScheme ; skos:topConceptOf rpr:PartRoleScheme ; skos:prefLabel "Character encoding"@en .
rpr:SpatialIndex      a skos:Concept ; skos:inScheme rpr:PartRoleScheme ; skos:topConceptOf rpr:PartRoleScheme ; skos:prefLabel "Spatial index"@en .
rpr:Manifest          a skos:Concept ; skos:inScheme rpr:PartRoleScheme ; skos:topConceptOf rpr:PartRoleScheme ; skos:prefLabel "Manifest"@en .
rpr:Segment           a skos:Concept ; skos:inScheme rpr:PartRoleScheme ; skos:topConceptOf rpr:PartRoleScheme ; skos:prefLabel "Segment"@en .
rpr:Sidecar           a skos:Concept ; skos:inScheme rpr:PartRoleScheme ; skos:topConceptOf rpr:PartRoleScheme ; skos:prefLabel "Sidecar"@en .
rpr:Metadata          a skos:Concept ; skos:inScheme rpr:PartRoleScheme ; skos:topConceptOf rpr:PartRoleScheme ; skos:prefLabel "Metadata"@en .
rpr:Thumbnail         a skos:Concept ; skos:inScheme rpr:PartRoleScheme ; skos:topConceptOf rpr:PartRoleScheme ; skos:prefLabel "Thumbnail"@en .
rpr:Checksum          a skos:Concept ; skos:inScheme rpr:PartRoleScheme ; skos:topConceptOf rpr:PartRoleScheme ; skos:prefLabel "Checksum"@en .
