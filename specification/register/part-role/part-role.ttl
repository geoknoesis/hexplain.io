@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rpr: <https://hexplain.io/ns/register/part-role#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://hexplain.io/ns/register/part-role> skos:definition "The vocabulary module publishing Hexplain Register — Part Role terms, its imports and associated validation declarations."@en ;
    skos:scopeNote "Load to obtain the concepts of this register. A profile binds its schemes to the properties they supply with hexplain:usesRegister; the aspect the values serve does not import it. Use concept IRIs as values; concept schemes and collections organize those values rather than describing parsed instances."@en .
rpr:AttributeTable rdfs:label "Attribute table"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/part-role> ;
    skos:definition "A member carrying non-geometric records or attributes associated with the asset's features."@en .
rpr:CharacterEncoding rdfs:label "Character encoding"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/part-role> ;
    skos:definition "A member identifying how textual bytes in the asset are decoded into characters."@en .
rpr:Checksum rdfs:label "Checksum"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/part-role> ;
    skos:definition "A member carrying integrity values used to check one or more other members."@en .
rpr:GeometryCarrier rdfs:label "Geometry carrier"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/part-role> ;
    skos:definition "A member carrying the explicit geometries associated with the asset's features."@en .
rpr:Manifest rdfs:label "Manifest"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/part-role> ;
    skos:definition "A member identifying the asset's constituent members and their organization or references."@en .
rpr:Metadata rdfs:label "Metadata"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/part-role> ;
    skos:definition "A member carrying descriptive information about another member or the asset as a whole."@en .
rpr:PartRoleScheme rdfs:label "Part Role Register"@en ;
    skos:definition "The controlled concept scheme grouping part role values. Membership identifies the applicable value set; raw format codes are defined by profiles rather than by this scheme."@en .
rpr:Payload rdfs:label "Payload"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/part-role> ;
    skos:definition "A member carrying the principal data values or encoded content of a compound asset."@en .
rpr:Segment rdfs:label "Segment"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/part-role> ;
    skos:definition "One ordered portion of an asset distributed across multiple members."@en .
rpr:Sidecar rdfs:label "Sidecar"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/part-role> ;
    skos:definition "An accompanying member associated with a primary resource by the bundle's binding convention."@en .
rpr:SpatialIndex rdfs:label "Spatial index"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/part-role> ;
    skos:definition "A member carrying an index for locating spatial content efficiently; it is distinct from the content itself."@en .
rpr:SpatialReference rdfs:label "Spatial reference"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/part-role> ;
    skos:definition "A member carrying coordinate-reference or georeferencing information needed to interpret spatial content."@en .
rpr:Thumbnail rdfs:label "Thumbnail"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/part-role> ;
    skos:definition "A member carrying a reduced preview intended for visual recognition of the asset."@en .
