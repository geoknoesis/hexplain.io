# Hexplain Register — Media Encoding 1.2
# Controlled values for the hx-encoding aspect: codec and compression identifiers as
# published by the relevant standards bodies (ISO/IEC MPEG, ITU-T, IETF). Split out of the
# aspect so another jurisdiction or profile can publish a sibling register without forking
# the aspect or minting into a namespace it does not own.
# Codes are NOT here: a raw wire code (e.g. a fourCC) belongs to the format that encodes it,
# and is carried by that profile's HDL enum.
@prefix menc: <https://hexplain.io/ns/register/media-encoding#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix hexplain: <https://hexplain.io/ns/core#> .

<https://hexplain.io/ns/register/media-encoding> a owl:Ontology ;
    rdfs:seeAlso <https://hexplain.io/specification/register/media-encoding/media-encoding-doc.ttl> ;
    owl:versionIRI <https://hexplain.io/ns/register/media-encoding/1.2> ; owl:versionInfo "1.2" ;
    owl:priorVersion <https://hexplain.io/ns/register/media-encoding/1.1> ;
    dcterms:modified "2026-10-13"^^xsd:date ;
    # core supplies the codec contract vocabulary the minimum-set concepts carry below.
    owl:imports <https://hexplain.io/ns/core> ;
    rdfs:label "Hexplain Register — Media Encoding"@en ;
    dcterms:created "2026-08-08"^^xsd:date ;
    dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "menc" ;
    vann:preferredNamespaceUri "https://hexplain.io/ns/register/media-encoding#" .

# ---------- Codec Register (SKOS) ----------
# Open, extensible. Grouped for convenience into video and audio collections.
menc:CodecScheme a skos:ConceptScheme ; rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:prefLabel "Codec Register"@en .

menc:VideoCodecs a skos:Collection ; skos:prefLabel "Video codecs"@en ;
    skos:member menc:H264 , menc:HEVC , menc:ProRes , menc:VP9 , menc:AV1 .
menc:AudioCodecs a skos:Collection ; skos:prefLabel "Audio codecs"@en ;
    skos:member menc:AAC , menc:MP3 , menc:FLAC , menc:Opus , menc:PCM .
menc:ImageCodecs a skos:Collection ; skos:prefLabel "Image codecs"@en ;
    skos:member menc:JPEG, menc:WebP, menc:JPEGXL, menc:LERC .

menc:H264 a skos:Concept ; skos:definition "Identifier for the H.264/AVC video coding family. Profiles must identify applicable bitstream framing and configuration."@en ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "H.264"@en ; skos:altLabel "AVC"@en , "MPEG-4 Part 10"@en ; rdfs:seeAlso <https://www.iso.org/standard/75400.html> ;
    hexplain:status hexplain:statusValid .
menc:HEVC a skos:Concept ; skos:definition "Identifier for the H.265/HEVC video coding family. Container framing is specified separately."@en ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "H.265"@en ; skos:altLabel "HEVC"@en , "MPEG-H Part 2"@en ;
    hexplain:status hexplain:statusValid .
menc:ProRes a skos:Concept ; skos:definition "Identifier for the ProRes video coding family; the concrete variant belongs to the format/profile metadata."@en ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "Apple ProRes"@en ; skos:altLabel "ProRes"@en ;
    hexplain:status hexplain:statusValid .
menc:VP9 a skos:Concept ; skos:definition "Identifier for the VP9 video coding format; container framing remains separate."@en ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "VP9"@en ;
    hexplain:status hexplain:statusValid .
menc:AV1 a skos:Concept ; skos:definition "Identifier for the AV1 video coding format; container and configuration details remain separate."@en ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "AV1"@en ;
    hexplain:status hexplain:statusValid .
menc:AAC a skos:Concept ; skos:definition "Identifier for the Advanced Audio Coding family; profiles specify the object type and framing when required."@en ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "AAC"@en ; skos:altLabel "Advanced Audio Coding"@en ;
    hexplain:status hexplain:statusValid .
menc:MP3 a skos:Concept ; skos:definition "Identifier for MPEG audio Layer III coded audio, distinct from a file's metadata-tag container."@en ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "MP3"@en ; skos:altLabel "MPEG-1 Audio Layer III"@en ;
    hexplain:status hexplain:statusValid .
menc:FLAC a skos:Concept ; skos:definition "Identifier for Free Lossless Audio Codec data, whose purpose is lossless audio representation."@en ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "FLAC"@en ; skos:altLabel "Free Lossless Audio Codec"@en ;
    hexplain:status hexplain:statusValid .
menc:Opus a skos:Concept ; skos:definition "Identifier for Opus coded audio; transport/container framing is not implied by this concept alone."@en ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "Opus"@en ;
    hexplain:status hexplain:statusValid .
menc:PCM a skos:Concept ; skos:definition "Identifier for linearly quantized pulse-code-modulated samples; width, signedness, channel organization and byte order must be specified separately."@en ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "Linear PCM"@en ; skos:altLabel "PCM"@en ;
    hexplain:status hexplain:statusValid .
menc:JPEG a skos:Concept ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ; skos:prefLabel "JPEG"@en ;
    rdfs:comment "ITU-T T.81 baseline, extended (12-bit) and progressive Huffman-coded JPEG, decoded with libjpeg's integer IDCT and upsampling. tables supplies an abbreviated table-specification stream (TIFF JPEGTables) kept in the session for every later image; colorTransform ycbcr-to-rgb converts as libjpeg does; rows stops after that many rows; output raw-planes returns the component planes before upsampling and conversion."@en ;
    hexplain:status hexplain:statusValid ;
    skos:definition "ITU-T T.81 (JPEG) DCT-based lossy image coding, in its baseline, extended and progressive Huffman-coded forms."@en .
menc:WebP a skos:Concept ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ; skos:prefLabel "WebP"@en ;
    rdfs:comment "A WebP bitstream (VP8 lossy with optional ALPH, or VP8L lossless) decoded as libwebp 1.5 decodes it to 8-bit RGB or RGBA; bands asks for 3 or 4 bands (an image without alpha reads as opaque)."@en ;
    hexplain:status hexplain:statusValid ;
    skos:definition "Google's WebP image coding, VP8 lossy with an optional alpha chunk or VP8L lossless, decoded to 8-bit RGB or RGBA."@en .
menc:JPEGXL a skos:Concept ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ; skos:prefLabel "JPEG XL"@en ;
    rdfs:comment "An ISO/IEC 18181 JPEG XL codestream in its exact-integer (modular, non-XYB) subset, 8- or 16-bit samples, colour channels then extra channels; anything outside that subset is an Unsupported feature."@en ;
    hexplain:status hexplain:statusValid ;
    skos:definition "ISO/IEC 18181 (JPEG XL) image coding, in the exact-integer modular subset of the codestream that this register defines."@en .
menc:LERC a skos:Concept ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ; skos:prefLabel "LERC"@en ;
    rdfs:comment "Esri's Limited Error Raster Compression version 2 (blob versions 1-6), decoded bit for bit as Esri LERC 4.0 decodes it. layout blob returns every band's samples band after band with a validity mask per band; layout tiff assembles one TIFF strip or tile of width x height x samplesPerPixel samples as libtiff's tif_lerc.c does (masks become NaN for floats or alpha when alphaFromMask), first unwrapping the Deflate or Zstandard layer lercParameters names."@en ;
    hexplain:status hexplain:statusValid ;
    skos:definition "Esri Limited Error Raster Compression, a bounded-error coding of integer and floating-point raster samples with a validity mask per band."@en .

# ---------- Compression Register (SKOS) ----------
menc:CompressionScheme a skos:ConceptScheme ; rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:prefLabel "Compression Register"@en .
menc:Store a skos:Concept ; skos:definition "Identity encoding: bytes are stored without a compression transform."@en ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "Store (none)"@en ;
    hexplain:status hexplain:statusValid .
menc:Zlib a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "zlib"@en ; rdfs:comment "RFC 1950 zlib framing around DEFLATE, including its header and Adler-32 checksum. Distinct from raw DEFLATE and gzip framing."@en ;
    hexplain:status hexplain:statusValid ;
    skos:definition "Identifier for DEFLATE data wrapped in RFC 1950 zlib framing: a two-byte header, the compressed stream and an Adler-32 checksum."@en .
menc:Deflate a skos:Concept ; skos:definition "Identifier for the DEFLATE compression format. A gzip or zlib wrapper must not be inferred from this identifier alone."@en ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "Deflate"@en ;
    hexplain:status hexplain:statusValid .
menc:Gzip a skos:Concept ; skos:definition "Identifier for gzip-framed compressed data, distinct from an unwrapped DEFLATE bitstream."@en ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "gzip"@en ;
    hexplain:status hexplain:statusValid .
menc:BZip2 a skos:Concept ; skos:definition "Identifier for bzip2 compressed data; the profile must identify framing and relevant options when they affect interpretation."@en ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "bzip2"@en ;
    hexplain:status hexplain:statusValid .
menc:LZMA a skos:Concept ; skos:definition "Identifier for the LZMA compression family; framing, dictionary and variant information must be supplied where required."@en ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "LZMA"@en ;
    hexplain:status hexplain:statusValid .
menc:XZ a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "XZ"@en ;
    rdfs:comment "The .xz container: one or more streams of LZMA2-filtered blocks with an integrity check (CRC32, CRC64 or SHA-256). menc:LZMA names the algorithm family, not this framing."@en ;
    skos:note "TIFF compression 34925 and numcodecs' LZMA compressor store this container. Parameters: concatenated (1, the default, decodes every stream with stream padding as the xz tool does; 0 decodes the first stream and ignores what follows, as libtiff and GDAL's Zarr reader do), level (0-9, used when encoding) and memoryLimitKiB (the decoder memory a stream may need, default 73728)."@en ;
    hexplain:status hexplain:statusValid ;
    skos:definition "The .xz container of LZMA2-filtered blocks with a per-stream integrity check, as the xz tool writes it."@en .

menc:TransformScheme a skos:ConceptScheme ; skos:prefLabel "Transform Register"@en ;
    rdfs:comment "Format-neutral byte and sample transforms a pipeline step can apply: predictors, bit reversal, colour conversions and array filters."@en .

menc:LZW a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "LZW"@en ;
    rdfs:comment "Lempel-Ziv-Welch coding with a 12-bit dictionary. The parameter variant names the framing; this version defines \"tiff\": TIFF 6.0 section 13, codes most significant bit first, Clear 256 and EndOfInformation 257, and the early change to a wider code one entry before the dictionary fills."@en ;
    hexplain:status hexplain:statusValid ;
    skos:definition "Lempel-Ziv-Welch dictionary compression with 12-bit codes, in the framing its variant parameter names."@en .
menc:PackBits a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "PackBits"@en ;
    rdfs:comment "Byte-oriented run-length coding (TIFF 6.0 section 9): a signed control byte n copies n+1 literal bytes (0 <= n <= 127), repeats the next byte 1-n times (-127 <= n <= -1), or does nothing (-128)."@en ;
    hexplain:status hexplain:statusValid ;
    skos:definition "The byte-oriented run-length coding of TIFF section 9, a signed control byte before each literal run or repeated byte."@en .
menc:CCITTModifiedHuffman a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "CCITT Modified Huffman"@en ;
    rdfs:comment "One-dimensional CCITT T.4 run-length coding of bilevel rows without EOL codes, each row starting on a byte (rowAlignment 8, TIFF compression 2) or 16-bit word (rowAlignment 16, TIFF compression 32771) boundary, decoded with libtiff's recovery rules. Output: rows of ceil(columns / 8) bytes, most significant bit first, 1 for black."@en ;
    hexplain:status hexplain:statusValid ;
    skos:definition "One-dimensional ITU-T T.4 modified Huffman run-length coding of bilevel rows without EOL codes, each row starting on a byte or word boundary."@en .
menc:CCITTGroup3 a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "CCITT Group 3"@en ;
    rdfs:comment "CCITT T.4 (Group 3) facsimile coding, one- or two-dimensional as bit 0 of options (the T4Options tag) says, each row after an EOL code unless noEol, decoded with libtiff's recovery rules; the reference line carries across strips in the session."@en ;
    hexplain:status hexplain:statusValid ;
    skos:definition "ITU-T T.4 (Group 3) facsimile run-length coding of bilevel rows, one- or two-dimensional, each row introduced by an EOL code."@en .
menc:CCITTGroup4 a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "CCITT Group 4"@en ;
    rdfs:comment "CCITT T.6 (Group 4) two-dimensional facsimile coding without EOL codes, decoded with libtiff's recovery rules; an early EOFB ends the output."@en ;
    hexplain:status hexplain:statusValid ;
    skos:definition "ITU-T T.6 (Group 4) two-dimensional facsimile coding of bilevel rows without EOL codes, ended by EOFB."@en .
menc:NeXT a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "NeXT 2-bit RLE"@en ;
    rdfs:comment "NeXT's run-length coding of 2-bit grey rows (literal rows, literal spans and runs), as libtiff's tif_next.c decodes it."@en ;
    hexplain:status hexplain:statusValid ;
    skos:definition "NeXT's run-length coding of 2-bit greyscale rows as literal rows, literal spans and runs."@en .
menc:ThunderScan a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "ThunderScan 4-bit RLE"@en ;
    rdfs:comment "ThunderScan's 4-bit run-length and delta coding of grey rows, as libtiff's tif_thunder.c decodes it."@en ;
    hexplain:status hexplain:statusValid ;
    skos:definition "ThunderScan's 4-bit run-length and delta coding of greyscale rows."@en .
menc:FloatingPointPredictor a skos:Concept ; skos:inScheme menc:TransformScheme ; skos:topConceptOf menc:TransformScheme ; skos:prefLabel "Floating-point predictor"@en ;
    rdfs:comment "Adobe TIFF Technical Note 3's floating-point predictor: each row's sample bytes regrouped by significance (every sample's most significant byte first) and differenced byte by byte, each byte predicted from the byte samplesPerPixel positions earlier. Decoding sums the differences and reassembles the samples in the byte order littleEndian names."@en ;
    hexplain:status hexplain:statusValid ;
    skos:definition "A reversible transform that regroups the bytes of floating-point samples by significance and differences them, undone before the samples are reassembled."@en .
menc:BitReverse a skos:Concept ; skos:inScheme menc:TransformScheme ; skos:topConceptOf menc:TransformScheme ; skos:prefLabel "Bit reversal"@en ;
    rdfs:comment "Reverses the order of the bits within every byte (TIFF FillOrder 2 to FillOrder 1). Its own inverse."@en ;
    hexplain:status hexplain:statusValid ;
    skos:definition "A reversible transform that reverses the order of the bits within every byte, converting between least- and most-significant-bit-first fill orders."@en .
menc:YCbCrToRGB a skos:Concept ; skos:inScheme menc:TransformScheme ; skos:topConceptOf menc:TransformScheme ; skos:prefLabel "YCbCr to RGB"@en ;
    rdfs:comment "Converts 8-bit YCbCr samples to RGB with libtiff's integer tables (tif_color.c) for the given coefficients and reference black/white. layout pixels takes three interleaved samples per pixel; units takes TIFF YCbCr sampling units (subsampling luma samples then Cb and Cr); planes takes the three component planes of a raw JPEG decode."@en ;
    hexplain:status hexplain:statusValid ;
    skos:definition "A sample transform converting 8-bit YCbCr samples to RGB with stated luma coefficients, reference black and white levels and chroma subsampling."@en .
menc:CIELabToRGB a skos:Concept ; skos:inScheme menc:TransformScheme ; skos:topConceptOf menc:TransformScheme ; skos:prefLabel "CIE L*a*b* to RGB"@en ;
    rdfs:comment "Converts 8-bit CIE L*a*b* samples to sRGB as libtiff's TIFFCIELabToRGB does for the given white point (D50 by default); alpha appends an opaque fourth band."@en ;
    hexplain:status hexplain:statusValid ;
    skos:definition "A sample transform converting 8-bit CIE L*a*b* samples to sRGB for a stated white point."@en .
menc:CMYKToRGB a skos:Concept ; skos:inScheme menc:TransformScheme ; skos:topConceptOf menc:TransformScheme ; skos:prefLabel "CMYK to RGB"@en ;
    rdfs:comment "Converts 8-bit CMYK (InkSet 1) samples to RGB as libtiff's RGBA interface does: each channel is (255 - K) x (255 - C/M/Y) / 255; alpha appends an opaque fourth band."@en ;
    hexplain:status hexplain:statusValid ;
    skos:definition "A sample transform converting 8-bit CMYK ink samples to RGB by the simple multiplicative formula."@en .

menc:Zstd a skos:Concept ; skos:definition "Identifier for data in the Zstandard frame format (one or more concatenated frames); dictionary requirements belong to the profile."@en ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "Zstandard"@en ;
    skos:note "Zstandard frames (RFC 8878), one or several concatenated; skippable frames are skipped. The Processing Model (Codecs beyond the minimum set) defines decoding; a frame that needs a dictionary is refused."@en ;
    hexplain:status hexplain:statusValid .
menc:Snappy a skos:Concept ; skos:definition "Identifier for Snappy compression; raw versus framed representation must be determined by the profile."@en ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "Snappy"@en ;
    hexplain:status hexplain:statusValid .
menc:LZ4 a skos:Concept ; skos:definition "Identifier for data in the LZ4 Frame format, the self-describing framed representation of LZ4 compression; the raw block representation is menc:LZ4Block."@en ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "LZ4"@en ;
    skos:note "The LZ4 Frame format: magic number 184D2204, a frame descriptor, blocks and an optional content checksum. A raw block without the frame is menc:LZ4Block."@en ;
    hexplain:status hexplain:statusValid .
# The raw block format carries no length and no magic, so it cannot share the frame's concept:
# a decoder has to be told both that it is looking at a bare block and how long its output is.
menc:LZ4Block a skos:Concept ; skos:definition "Identifier for a single raw LZ4 compressed block, which carries no length of its own: the decoded size must be supplied by the profile."@en ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "LZ4 block"@en ;
    skos:note "One LZ4 compressed block, without the frame format's header. Its decoded length is not recorded in the data, so a pipeline step names it with the parameter decodedSize (Processing Model, Codecs beyond the minimum set)."@en ;
    hexplain:status hexplain:statusValid .
menc:RunLength a skos:Concept ; skos:definition "An encoding that represents repeated values as runs; the profile must identify the actual run/count representation."@en ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "Run-length encoding"@en ;
    hexplain:status hexplain:statusValid .
menc:Blosc a skos:Concept ; skos:definition "Identifier for the Blosc compression framework, which combines an inner compressor with configurable preprocessing and block settings."@en ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "Blosc"@en ;
    skos:note "A meta-compressor: it wraps an inner codec and its own shuffle and level settings, which travel as hexplain:codecParameter on the step."@en ;
    hexplain:status hexplain:statusValid .

# Reversible TRANSFORMS rather than compressors. They shrink nothing on their own; they
# rearrange bytes so that the compressor after them does better, and they only ever appear
# as a step of a pipeline. They live in this register because that is what a pipeline step
# draws from -- the alternative, a parallel filter register, would split one list in two.
menc:Delta a skos:Concept ; skos:definition "A predictive transform that represents values by differences from preceding or predicted values; the variant and arithmetic are profile parameters."@en ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "Delta / predictor"@en ;
    skos:note "Stores each value as its difference from the previous one. TIFF calls this a horizontal predictor and numbers its variants; the variant travels as a parameter. Its parameters are named by the Processing Model (Codecs, Delta parameters): elementSize (required: 1, 2, 4 or 8), littleEndian (0 or 1), samplesPerPixel (default 1), rowBytes (0 or a multiple of elementSize x samplesPerPixel) and predictor (2, horizontal, by default; 1, none)."@en ;
    hexplain:status hexplain:statusValid .
menc:Shuffle a skos:Concept ; skos:definition "A reversible transform grouping corresponding bytes of successive fixed-width values to prepare them for compression."@en ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "Byte shuffle"@en ;
    skos:note "Groups the Nth byte of every value together, so the high bytes of similar numbers become runs. HDF5 and Blosc both use it."@en ;
    hexplain:status hexplain:statusValid .
menc:BitShuffle a skos:Concept ; skos:definition "A reversible transform grouping corresponding bits of successive values to prepare them for compression; element/block parameters belong to the profile."@en ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "Bit shuffle"@en ;
    hexplain:status hexplain:statusValid .
menc:BloscLZ a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "BloscLZ"@en ;
    rdfs:comment "c-blosc's BloscLZ compressor (c-blosc 1.21.6 blosclz_decompress): literal runs of 1-32 bytes and matches at a 13-bit distance or, escaped, beyond 8191. Decodes at most decodedSize bytes; as in C, a match that is the stream's last instruction is not copied."@en ;
    hexplain:status hexplain:statusValid ;
    skos:definition "The LZ77-style block compressor built into the Blosc framework, with 13-bit match distances and escaped longer ones."@en .
menc:TypedDelta a skos:Concept ; skos:inScheme menc:TransformScheme ; skos:topConceptOf menc:TransformScheme ; skos:prefLabel "Typed delta"@en ;
    rdfs:comment "numcodecs' Delta filter: a running sum over elements of the numpy dtype dtype (i1, u1, [<>|]i2/i4/i8, u2/u4/u8, f4, f8), integers wrapping and floats in their own precision; astype, when given, must equal dtype."@en ;
    hexplain:status hexplain:statusValid ;
    skos:definition "A reversible transform storing each element of a typed numeric array as its difference from the previous one, undone by a running sum in that type."@en .
menc:FixedScaleOffset a skos:Concept ; skos:inScheme menc:TransformScheme ; skos:topConceptOf menc:TransformScheme ; skos:prefLabel "Fixed scale and offset"@en ;
    rdfs:comment "numcodecs' FixedScaleOffset filter decoded as GDAL does: astype values widened to dtype, then value / scale + offset in double precision (rounded to binary32 for <f4)."@en ;
    hexplain:status hexplain:statusValid ;
    skos:definition "A sample transform that restores floating-point values from samples stored as a narrower integer type by dividing by a fixed scale and adding an offset."@en .
menc:Quantize a skos:Concept ; skos:inScheme menc:TransformScheme ; skos:topConceptOf menc:TransformScheme ; skos:prefLabel "Quantize"@en ;
    rdfs:comment "numcodecs' Quantize filter: decoding converts astype floats to dtype floats; digits is the precision the encoder kept."@en ;
    hexplain:status hexplain:statusValid ;
    skos:definition "A lossy floating-point filter that rounds samples to a fixed number of significant decimal digits when encoding; decoding converts the stored type back."@en .
menc:BitRound a skos:Concept ; skos:inScheme menc:TransformScheme ; skos:topConceptOf menc:TransformScheme ; skos:prefLabel "Bit round"@en ;
    rdfs:comment "numcodecs' BitRound filter, which rounds float mantissas to keepbits bits when encoding; decoding is the identity."@en ;
    hexplain:status hexplain:statusValid ;
    skos:definition "A lossy floating-point filter that discards the low-order mantissa bits beyond a kept precision when encoding; decoding is the identity."@en .
menc:SGILogRLE a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "SGI LogL RLE"@en ;
    rdfs:comment "SGI's LogL run-length coding (TIFF compression 34676): each row stored as its high then low byte plane, each run-length coded; decodes to the 16-bit log-luminance codes, little-endian, as libtiff's SGILOGDATAFMT_16BIT returns them."@en ;
    hexplain:status hexplain:statusValid ;
    skos:definition "SGI's run-length coding of 16-bit log-luminance (LogL) codes, each row stored as separately coded high and low byte planes."@en .
menc:MicrosoftRLE a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "Microsoft RLE"@en ;
    rdfs:comment "The BMP RLE8 and RLE4 run-length codings (bitsPerPixel 8 or 4) of a bottom-up width x height image, decoded as GDAL's BMP driver reads them and returned top row first, one byte per pixel. A delta escape that skips pixels is an Unsupported feature."@en ;
    hexplain:status hexplain:statusValid ;
    skos:definition "The Windows bitmap RLE8 and RLE4 run-length codings of bottom-up indexed-colour images, escapes included."@en .

# ---------- Codec contracts: the Processing Model's minimum set ----------
# Every contract and parameter spec is a named resource: <Concept>.contract and
# <Concept>.contract.<parameterKey>. As blank nodes they were minted afresh by every parse, so a
# graph holding the register twice (a processor's bundled copy beside the published one) stated
# two contracts per concept and broke hexplain:CodecContractBindingShape. Named, a repeated load
# adds nothing.
