# Hexplain Register — Media Encoding 1.2
# Controlled values for the hx-encoding aspect: codec and compression identifiers as
# published by the relevant standards bodies (ISO/IEC MPEG, ITU-T, IETF). Split out of the
# aspect so another jurisdiction or profile can publish a sibling register without forking
# the aspect or minting into a namespace it does not own.
# Codes are NOT here: a raw wire code (e.g. a fourCC) belongs to the format that encodes it,
# and is carried by that profile's HDL enum.
@prefix menc: <https://hexplain.io/ns/register/media-encoding#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .

<https://hexplain.io/ns/register/media-encoding> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/register/media-encoding/1.2> ; owl:versionInfo "1.2" ;
    owl:priorVersion <https://hexplain.io/ns/register/media-encoding/1.1> ;
    dcterms:modified "2026-09-27"^^xsd:date ;
    rdfs:label "Hexplain Register — Media Encoding" ;
    dcterms:created "2026-08-08"^^xsd:date ;
    dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "menc" ;
    vann:preferredNamespaceUri "https://hexplain.io/ns/register/media-encoding#" .

# ---------- Codec Register (SKOS) ----------
# Open, extensible. Grouped for convenience into video and audio collections.
menc:CodecScheme a skos:ConceptScheme ; rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:prefLabel "Codec Register"@en .

menc:VideoCodecs a skos:Collection ; skos:prefLabel "Video codecs"@en ;
    skos:member menc:H264 , menc:HEVC , menc:ProRes , menc:VP9 , menc:AV1 .
menc:AudioCodecs a skos:Collection ; skos:prefLabel "Audio codecs"@en ;
    skos:member menc:AAC , menc:MP3 , menc:FLAC , menc:Opus , menc:PCM .

menc:H264 a skos:Concept ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "H.264"@en ; skos:altLabel "AVC"@en , "MPEG-4 Part 10"@en ; rdfs:seeAlso <https://www.iso.org/standard/75400.html> .
menc:HEVC a skos:Concept ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "H.265"@en ; skos:altLabel "HEVC"@en , "MPEG-H Part 2"@en .
menc:ProRes a skos:Concept ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "Apple ProRes"@en ; skos:altLabel "ProRes"@en .
menc:VP9 a skos:Concept ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "VP9"@en .
menc:AV1 a skos:Concept ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "AV1"@en .
menc:AAC a skos:Concept ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "AAC"@en ; skos:altLabel "Advanced Audio Coding"@en .
menc:MP3 a skos:Concept ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "MP3"@en ; skos:altLabel "MPEG-1 Audio Layer III"@en .
menc:FLAC a skos:Concept ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "FLAC"@en ; skos:altLabel "Free Lossless Audio Codec"@en .
menc:Opus a skos:Concept ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "Opus"@en .
menc:PCM a skos:Concept ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "Linear PCM"@en ; skos:altLabel "PCM"@en .

# ---------- Compression Register (SKOS) ----------
menc:CompressionScheme a skos:ConceptScheme ; rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:prefLabel "Compression Register"@en .
menc:Store a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "Store (none)"@en .
menc:Zlib a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "zlib"@en ; rdfs:comment "RFC 1950 zlib framing around DEFLATE, including its header and Adler-32 checksum. Distinct from raw DEFLATE and gzip framing." .
menc:Deflate a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "Deflate"@en .
menc:Gzip a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "gzip"@en .
menc:BZip2 a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "bzip2"@en .
menc:LZMA a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "LZMA"@en .
menc:Zstd a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "Zstandard"@en ;
    skos:note "Zstandard frames (RFC 8878), one or several concatenated; skippable frames are skipped. The Processing Model (Codecs beyond the minimum set) defines decoding; a frame that needs a dictionary is refused." .
menc:Snappy a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "Snappy"@en .
menc:LZ4 a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "LZ4"@en ;
    skos:note "The LZ4 Frame format: magic number 184D2204, a frame descriptor, blocks and an optional content checksum. A raw block without the frame is menc:LZ4Block." .
# The raw block format carries no length and no magic, so it cannot share the frame's concept:
# a decoder has to be told both that it is looking at a bare block and how long its output is.
menc:LZ4Block a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "LZ4 block"@en ;
    skos:note "One LZ4 compressed block, without the frame format's header. Its decoded length is not recorded in the data, so a pipeline step names it with the parameter decodedSize (Processing Model, Codecs beyond the minimum set)." .
menc:RunLength a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "Run-length encoding"@en .
menc:Blosc a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "Blosc"@en ;
    skos:note "A meta-compressor: it wraps an inner codec and its own shuffle and level settings, which travel as hexplain:codecParameter on the step." .

# Reversible TRANSFORMS rather than compressors. They shrink nothing on their own; they
# rearrange bytes so that the compressor after them does better, and they only ever appear
# as a step of a pipeline. They live in this register because that is what a pipeline step
# draws from -- the alternative, a parallel filter register, would split one list in two.
menc:Delta a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "Delta / predictor"@en ;
    skos:note "Stores each value as its difference from the previous one. TIFF calls this a horizontal predictor and numbers its variants; the variant travels as a parameter. Its parameters are named by the Processing Model (Codecs, Delta parameters): elementSize (required: 1, 2, 4 or 8), littleEndian (0 or 1), samplesPerPixel (default 1), rowBytes (0 or a multiple of elementSize x samplesPerPixel) and predictor (2, horizontal, by default; 1, none)." .
menc:Shuffle a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "Byte shuffle"@en ;
    skos:note "Groups the Nth byte of every value together, so the high bytes of similar numbers become runs. HDF5 and Blosc both use it." .
menc:BitShuffle a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "Bit shuffle"@en .

# BEGIN GENERATED TERM DOCUMENTATION
# Editorial annotations only; OWL axioms and SHACL constraints above are unchanged.
@prefix menc: <https://hexplain.io/ns/register/media-encoding#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://hexplain.io/ns/register/media-encoding> skos:definition "The vocabulary module publishing Hexplain Register — Media Encoding terms, its imports and associated validation declarations."@en ;
    skos:scopeNote "Load to obtain the concepts of this register. A profile binds its schemes to the properties they supply with hexplain:usesRegister; the aspect the values serve does not import it. Codec/algorithm concepts require any applicable variant, framing and parameter information from the profile."@en .
menc:AAC rdfs:label "AAC"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:definition "Identifier for the Advanced Audio Coding family; profiles specify the object type and framing when required."@en .
menc:AV1 rdfs:label "AV1"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:definition "Identifier for the AV1 video coding format; container and configuration details remain separate."@en .
menc:AudioCodecs rdfs:label "Audio codecs"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:definition "An editorial grouping of audio codecs concepts for navigation and selection. Collection membership does not assert a subclass or broader/narrower hierarchy."@en .
menc:BZip2 rdfs:label "bzip2"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:definition "Identifier for bzip2 compressed data; the profile must identify framing and relevant options when they affect interpretation."@en .
menc:BitShuffle rdfs:label "Bit shuffle"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:definition "A reversible transform grouping corresponding bits of successive values to prepare them for compression; element/block parameters belong to the profile."@en .
menc:Blosc rdfs:label "Blosc"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:definition "Identifier for the Blosc compression framework, which combines an inner compressor with configurable preprocessing and block settings."@en .
menc:CodecScheme rdfs:label "Codec Register"@en ;
    skos:definition "The controlled concept scheme grouping codec values. Membership identifies the applicable value set; raw format codes are defined by profiles rather than by this scheme."@en .
menc:CompressionScheme rdfs:label "Compression Register"@en ;
    skos:definition "The controlled concept scheme grouping compression values. Membership identifies the applicable value set; raw format codes are defined by profiles rather than by this scheme."@en .
menc:Deflate rdfs:label "Deflate"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:definition "Identifier for the DEFLATE compression format. A gzip or zlib wrapper must not be inferred from this identifier alone."@en .
menc:Delta rdfs:label "Delta / predictor"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:definition "A predictive transform that represents values by differences from preceding or predicted values; the variant and arithmetic are profile parameters."@en .
menc:FLAC rdfs:label "FLAC"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:definition "Identifier for Free Lossless Audio Codec data, whose purpose is lossless audio representation."@en .
menc:Gzip rdfs:label "gzip"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:definition "Identifier for gzip-framed compressed data, distinct from an unwrapped DEFLATE bitstream."@en .
menc:H264 rdfs:label "H.264"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:definition "Identifier for the H.264/AVC video coding family. Profiles must identify applicable bitstream framing and configuration."@en .
menc:HEVC rdfs:label "H.265"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:definition "Identifier for the H.265/HEVC video coding family. Container framing is specified separately."@en .
menc:LZ4 rdfs:label "LZ4"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:definition "Identifier for data in the LZ4 Frame format, the self-describing framed representation of LZ4 compression; the raw block representation is menc:LZ4Block."@en .
menc:LZ4Block rdfs:label "LZ4 block"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:definition "Identifier for a single raw LZ4 compressed block, which carries no length of its own: the decoded size must be supplied by the profile."@en .
menc:LZMA rdfs:label "LZMA"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:definition "Identifier for the LZMA compression family; framing, dictionary and variant information must be supplied where required."@en .
menc:MP3 rdfs:label "MP3"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:definition "Identifier for MPEG audio Layer III coded audio, distinct from a file's metadata-tag container."@en .
menc:Opus rdfs:label "Opus"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:definition "Identifier for Opus coded audio; transport/container framing is not implied by this concept alone."@en .
menc:PCM rdfs:label "Linear PCM"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:definition "Identifier for linearly quantized pulse-code-modulated samples; width, signedness, channel organization and byte order must be specified separately."@en .
menc:ProRes rdfs:label "Apple ProRes"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:definition "Identifier for the ProRes video coding family; the concrete variant belongs to the format/profile metadata."@en .
menc:RunLength rdfs:label "Run-length encoding"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:definition "An encoding that represents repeated values as runs; the profile must identify the actual run/count representation."@en .
menc:Shuffle rdfs:label "Byte shuffle"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:definition "A reversible transform grouping corresponding bytes of successive fixed-width values to prepare them for compression."@en .
menc:Snappy rdfs:label "Snappy"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:definition "Identifier for Snappy compression; raw versus framed representation must be determined by the profile."@en .
menc:Store rdfs:label "Store (none)"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:definition "Identity encoding: bytes are stored without a compression transform."@en .
menc:VP9 rdfs:label "VP9"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:definition "Identifier for the VP9 video coding format; container framing remains separate."@en .
menc:VideoCodecs rdfs:label "Video codecs"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:definition "An editorial grouping of video codecs concepts for navigation and selection. Collection membership does not assert a subclass or broader/narrower hierarchy."@en .
menc:Zlib rdfs:label "zlib"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> .
menc:Zstd rdfs:label "Zstandard"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:definition "Identifier for data in the Zstandard frame format (one or more concatenated frames); dictionary requirements belong to the profile."@en .
