# Hexplain Register — Media Encoding 1.2
# Controlled values for the hx-encoding aspect: codec and compression identifiers as
# published by the relevant standards bodies (ISO/IEC MPEG, ITU-T, IETF). Split out of the
# aspect so another jurisdiction or profile can publish a sibling register without forking
# the aspect or minting into a namespace it does not own.
# Codes are NOT here: a raw wire code (e.g. a fourCC) belongs to the format that encodes it,
# and is carried by that profile's HDL enum.
@prefix menc: <https://hexplain.io/ns/register/media-encoding#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix hexplain: <https://hexplain.io/ns/core#> .

<https://hexplain.io/ns/register/media-encoding> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/register/media-encoding/1.2> ; owl:versionInfo "1.2" ;
    owl:priorVersion <https://hexplain.io/ns/register/media-encoding/1.1> ;
    dcterms:modified "2026-09-27"^^xsd:date ;
    # core supplies the codec contract vocabulary the minimum-set concepts carry below.
    owl:imports <https://hexplain.io/ns/core> ;
    rdfs:label "Hexplain Register — Media Encoding"@en ;
    dcterms:created "2026-08-08"^^xsd:date ;
    dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "menc" ;
    vann:preferredNamespaceUri "https://hexplain.io/ns/register/media-encoding#" .

# ---------- Codec Register (SKOS) ----------
# Open, extensible. Grouped for convenience into video and audio collections.
menc:CodecScheme a skos:ConceptScheme ; rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:prefLabel "Codec Register"@en .

menc:VideoCodecs a skos:Collection ; skos:prefLabel "Video codecs"@en ;
    skos:member menc:H264 , menc:HEVC , menc:ProRes , menc:VP9 , menc:AV1 .
menc:AudioCodecs a skos:Collection ; skos:prefLabel "Audio codecs"@en ;
    skos:member menc:AAC , menc:MP3 , menc:FLAC , menc:Opus , menc:PCM .

menc:H264 a skos:Concept ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "H.264"@en ; skos:altLabel "AVC"@en , "MPEG-4 Part 10"@en ; rdfs:seeAlso <https://www.iso.org/standard/75400.html> .
menc:HEVC a skos:Concept ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "H.265"@en ; skos:altLabel "HEVC"@en , "MPEG-H Part 2"@en .
menc:ProRes a skos:Concept ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "Apple ProRes"@en ; skos:altLabel "ProRes"@en .
menc:VP9 a skos:Concept ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "VP9"@en .
menc:AV1 a skos:Concept ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "AV1"@en .
menc:AAC a skos:Concept ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "AAC"@en ; skos:altLabel "Advanced Audio Coding"@en .
menc:MP3 a skos:Concept ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "MP3"@en ; skos:altLabel "MPEG-1 Audio Layer III"@en .
menc:FLAC a skos:Concept ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "FLAC"@en ; skos:altLabel "Free Lossless Audio Codec"@en .
menc:Opus a skos:Concept ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "Opus"@en .
menc:PCM a skos:Concept ; skos:inScheme menc:CodecScheme ; skos:topConceptOf menc:CodecScheme ;
    skos:prefLabel "Linear PCM"@en ; skos:altLabel "PCM"@en .

# ---------- Compression Register (SKOS) ----------
menc:CompressionScheme a skos:ConceptScheme ; rdfs:isDefinedBy <https://hexplain.io/ns/register/media-encoding> ;
    skos:prefLabel "Compression Register"@en .
menc:Store a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "Store (none)"@en .
menc:Zlib a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "zlib"@en ; rdfs:comment "RFC 1950 zlib framing around DEFLATE, including its header and Adler-32 checksum. Distinct from raw DEFLATE and gzip framing."@en .
menc:Deflate a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "Deflate"@en .
menc:Gzip a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "gzip"@en .
menc:BZip2 a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "bzip2"@en .
menc:LZMA a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "LZMA"@en .
menc:XZ a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "XZ"@en ;
    rdfs:comment "The .xz container: one or more streams of LZMA2-filtered blocks with an integrity check (CRC32, CRC64 or SHA-256). menc:LZMA names the algorithm family, not this framing." ;
    skos:note "TIFF compression 34925 and numcodecs' LZMA compressor store this container. Parameters: concatenated (1, the default, decodes every stream with stream padding as the xz tool does; 0 decodes the first stream and ignores what follows, as libtiff and GDAL's Zarr reader do), level (0-9, used when encoding) and memoryLimitKiB (the decoder memory a stream may need, default 73728)." .

menc:TransformScheme a skos:ConceptScheme ; skos:prefLabel "Transform Register"@en ;
    rdfs:comment "Format-neutral byte and sample transforms a pipeline step can apply: predictors, bit reversal, colour conversions and array filters." .

menc:LZW a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "LZW"@en ;
    rdfs:comment "Lempel-Ziv-Welch coding with a 12-bit dictionary. The parameter variant names the framing; this version defines \"tiff\": TIFF 6.0 section 13, codes most significant bit first, Clear 256 and EndOfInformation 257, and the early change to a wider code one entry before the dictionary fills." .
menc:PackBits a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "PackBits"@en ;
    rdfs:comment "Byte-oriented run-length coding (TIFF 6.0 section 9): a signed control byte n copies n+1 literal bytes (0 <= n <= 127), repeats the next byte 1-n times (-127 <= n <= -1), or does nothing (-128)." .
menc:CCITTModifiedHuffman a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "CCITT Modified Huffman"@en ;
    rdfs:comment "One-dimensional CCITT T.4 run-length coding of bilevel rows without EOL codes, each row starting on a byte (rowAlignment 8, TIFF compression 2) or 16-bit word (rowAlignment 16, TIFF compression 32771) boundary, decoded with libtiff's recovery rules. Output: rows of ceil(columns / 8) bytes, most significant bit first, 1 for black." .
menc:CCITTGroup3 a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "CCITT Group 3"@en ;
    rdfs:comment "CCITT T.4 (Group 3) facsimile coding, one- or two-dimensional as bit 0 of options (the T4Options tag) says, each row after an EOL code unless noEol, decoded with libtiff's recovery rules; the reference line carries across strips in the session." .
menc:CCITTGroup4 a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "CCITT Group 4"@en ;
    rdfs:comment "CCITT T.6 (Group 4) two-dimensional facsimile coding without EOL codes, decoded with libtiff's recovery rules; an early EOFB ends the output." .
menc:NeXT a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "NeXT 2-bit RLE"@en ;
    rdfs:comment "NeXT's run-length coding of 2-bit grey rows (literal rows, literal spans and runs), as libtiff's tif_next.c decodes it." .
menc:ThunderScan a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "ThunderScan 4-bit RLE"@en ;
    rdfs:comment "ThunderScan's 4-bit run-length and delta coding of grey rows, as libtiff's tif_thunder.c decodes it." .
menc:FloatingPointPredictor a skos:Concept ; skos:inScheme menc:TransformScheme ; skos:topConceptOf menc:TransformScheme ; skos:prefLabel "Floating-point predictor"@en ;
    rdfs:comment "Adobe TIFF Technical Note 3's floating-point predictor: each row's sample bytes regrouped by significance (every sample's most significant byte first) and differenced byte by byte, each byte predicted from the byte samplesPerPixel positions earlier. Decoding sums the differences and reassembles the samples in the byte order littleEndian names." .
menc:BitReverse a skos:Concept ; skos:inScheme menc:TransformScheme ; skos:topConceptOf menc:TransformScheme ; skos:prefLabel "Bit reversal"@en ;
    rdfs:comment "Reverses the order of the bits within every byte (TIFF FillOrder 2 to FillOrder 1). Its own inverse." .

menc:Zstd a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "Zstandard"@en ;
    skos:note "Zstandard frames (RFC 8878), one or several concatenated; skippable frames are skipped. The Processing Model (Codecs beyond the minimum set) defines decoding; a frame that needs a dictionary is refused."@en .
menc:Snappy a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "Snappy"@en .
menc:LZ4 a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "LZ4"@en ;
    skos:note "The LZ4 Frame format: magic number 184D2204, a frame descriptor, blocks and an optional content checksum. A raw block without the frame is menc:LZ4Block."@en .
# The raw block format carries no length and no magic, so it cannot share the frame's concept:
# a decoder has to be told both that it is looking at a bare block and how long its output is.
menc:LZ4Block a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "LZ4 block"@en ;
    skos:note "One LZ4 compressed block, without the frame format's header. Its decoded length is not recorded in the data, so a pipeline step names it with the parameter decodedSize (Processing Model, Codecs beyond the minimum set)."@en .
menc:RunLength a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "Run-length encoding"@en .
menc:Blosc a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "Blosc"@en ;
    skos:note "A meta-compressor: it wraps an inner codec and its own shuffle and level settings, which travel as hexplain:codecParameter on the step."@en .

# Reversible TRANSFORMS rather than compressors. They shrink nothing on their own; they
# rearrange bytes so that the compressor after them does better, and they only ever appear
# as a step of a pipeline. They live in this register because that is what a pipeline step
# draws from -- the alternative, a parallel filter register, would split one list in two.
menc:Delta a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "Delta / predictor"@en ;
    skos:note "Stores each value as its difference from the previous one. TIFF calls this a horizontal predictor and numbers its variants; the variant travels as a parameter. Its parameters are named by the Processing Model (Codecs, Delta parameters): elementSize (required: 1, 2, 4 or 8), littleEndian (0 or 1), samplesPerPixel (default 1), rowBytes (0 or a multiple of elementSize x samplesPerPixel) and predictor (2, horizontal, by default; 1, none)."@en .
menc:Shuffle a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "Byte shuffle"@en ;
    skos:note "Groups the Nth byte of every value together, so the high bytes of similar numbers become runs. HDF5 and Blosc both use it."@en .
menc:BitShuffle a skos:Concept ; skos:inScheme menc:CompressionScheme ; skos:topConceptOf menc:CompressionScheme ; skos:prefLabel "Bit shuffle"@en .

# ---------- Codec contracts: the Processing Model's minimum set ----------
menc:Store hexplain:codecContract [ a hexplain:CodecContract ;
    hexplain:contractVersion 1 ; hexplain:vectorSuiteVersion 1 ;
    hexplain:codecKind hexplain:BytesToBytes ; hexplain:keepsSession false ;
    hexplain:raisesCategory "ResourceLimit" ] .
menc:Deflate hexplain:codecContract [ a hexplain:CodecContract ;
    hexplain:contractVersion 1 ; hexplain:vectorSuiteVersion 1 ;
    hexplain:codecKind hexplain:BytesToBytes ; hexplain:keepsSession false ;
    hexplain:raisesCategory "Validation", "ResourceLimit" ;
    hexplain:declaresParameter [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "level" ;
        hexplain:parameterType hexplain:IntegerParameterType ; hexplain:defaultValue -1 ;
        hexplain:minimumValue -1 ; hexplain:maximumValue 9 ] ] .
menc:Zlib hexplain:codecContract [ a hexplain:CodecContract ;
    hexplain:contractVersion 1 ; hexplain:vectorSuiteVersion 1 ;
    hexplain:codecKind hexplain:BytesToBytes ; hexplain:keepsSession false ;
    hexplain:raisesCategory "Validation", "Checksum", "ResourceLimit" ;
    hexplain:declaresParameter
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "level" ;
          hexplain:parameterType hexplain:IntegerParameterType ; hexplain:defaultValue -1 ;
          hexplain:minimumValue -1 ; hexplain:maximumValue 9 ] ,
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "trailing" ;
          hexplain:parameterType hexplain:StringParameterType ; hexplain:defaultValue "refuse" ;
          hexplain:allowedValue "refuse", "ignore" ] ] .
menc:Gzip hexplain:codecContract [ a hexplain:CodecContract ;
    hexplain:contractVersion 1 ; hexplain:vectorSuiteVersion 1 ;
    hexplain:codecKind hexplain:BytesToBytes ; hexplain:keepsSession false ;
    hexplain:raisesCategory "Validation", "Checksum", "ResourceLimit" ;
    hexplain:declaresParameter [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "trailing" ;
        hexplain:parameterType hexplain:StringParameterType ; hexplain:defaultValue "refuse" ;
        hexplain:allowedValue "refuse", "ignore" ] ] .
menc:Delta hexplain:codecContract [ a hexplain:CodecContract ;
    hexplain:contractVersion 1 ; hexplain:vectorSuiteVersion 1 ;
    hexplain:codecKind hexplain:BytesToBytes ; hexplain:keepsSession false ;
    hexplain:raisesCategory "Validation", "Unsupported", "ResourceLimit" ;
    hexplain:declaresParameter
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "elementSize" ;
          hexplain:parameterType hexplain:IntegerParameterType ; hexplain:requiredParameter true ;
          hexplain:allowedValue 1, 2, 4, 8 ] ,
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "predictor" ;
          hexplain:parameterType hexplain:IntegerParameterType ; hexplain:defaultValue 2 ;
          hexplain:minimumValue 1 ] ,
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "littleEndian" ;
          hexplain:parameterType hexplain:IntegerParameterType ; hexplain:defaultValue 0 ;
          hexplain:allowedValue 0, 1 ] ,
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "samplesPerPixel" ;
          hexplain:parameterType hexplain:IntegerParameterType ; hexplain:defaultValue 1 ;
          hexplain:minimumValue 1 ] ,
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "rowBytes" ;
          hexplain:parameterType hexplain:IntegerParameterType ; hexplain:defaultValue 0 ;
          hexplain:minimumValue 0 ] ] .
menc:LZ4 hexplain:codecContract [ a hexplain:CodecContract ;
    hexplain:contractVersion 1 ; hexplain:vectorSuiteVersion 1 ;
    hexplain:codecKind hexplain:BytesToBytes ; hexplain:keepsSession false ;
    hexplain:raisesCategory "Validation", "Checksum", "Unsupported", "ResourceLimit" ] .
menc:LZ4Block hexplain:codecContract [ a hexplain:CodecContract ;
    hexplain:contractVersion 1 ; hexplain:vectorSuiteVersion 1 ;
    hexplain:codecKind hexplain:BytesToBytes ; hexplain:keepsSession false ;
    hexplain:raisesCategory "Validation", "ResourceLimit" ;
    hexplain:declaresParameter [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "decodedSize" ;
        hexplain:parameterType hexplain:IntegerParameterType ; hexplain:requiredParameter true ;
        hexplain:minimumValue 1 ; hexplain:maximumValue 2147483647 ] ] .
menc:Zstd hexplain:codecContract [ a hexplain:CodecContract ;
    hexplain:contractVersion 1 ; hexplain:vectorSuiteVersion 1 ;
    hexplain:codecKind hexplain:BytesToBytes ; hexplain:keepsSession false ;
    hexplain:raisesCategory "Validation", "Checksum", "Unsupported", "ResourceLimit" ] .
menc:XZ hexplain:codecContract [ a hexplain:CodecContract ;
    hexplain:contractVersion 1 ; hexplain:vectorSuiteVersion 1 ;
    hexplain:codecKind hexplain:BytesToBytes ; hexplain:keepsSession false ;
    hexplain:raisesCategory "Validation", "Checksum", "Unsupported", "ResourceLimit" ;
    hexplain:declaresParameter
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "concatenated" ;
          hexplain:parameterType hexplain:IntegerParameterType ; hexplain:defaultValue 1 ; hexplain:allowedValue 0, 1 ] ,
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "level" ;
          hexplain:parameterType hexplain:IntegerParameterType ; hexplain:defaultValue 6 ;
          hexplain:minimumValue 0 ; hexplain:maximumValue 9 ] ,
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "memoryLimitKiB" ;
          hexplain:parameterType hexplain:IntegerParameterType ; hexplain:defaultValue 73728 ;
          hexplain:minimumValue 1 ; hexplain:maximumValue 4194304 ] ] .
menc:LZW hexplain:codecContract [ a hexplain:CodecContract ; hexplain:contractVersion 1 ; hexplain:vectorSuiteVersion 1 ;
    hexplain:codecKind hexplain:BytesToBytes ; hexplain:keepsSession false ;
    hexplain:raisesCategory "Validation", "ResourceLimit" ;
    hexplain:declaresParameter [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "variant" ;
        hexplain:parameterType hexplain:StringParameterType ; hexplain:defaultValue "tiff" ; hexplain:allowedValue "tiff" ] ] .
menc:PackBits hexplain:codecContract [ a hexplain:CodecContract ; hexplain:contractVersion 1 ; hexplain:vectorSuiteVersion 1 ;
    hexplain:codecKind hexplain:BytesToBytes ; hexplain:keepsSession false ; hexplain:raisesCategory "Validation", "ResourceLimit" ] .
menc:CCITTModifiedHuffman hexplain:codecContract [ a hexplain:CodecContract ; hexplain:contractVersion 1 ; hexplain:vectorSuiteVersion 1 ;
    hexplain:codecKind hexplain:BytesToBytes ; hexplain:keepsSession true ; hexplain:raisesCategory "Validation", "ResourceLimit" ;
    hexplain:declaresParameter
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "columns" ; hexplain:parameterType hexplain:IntegerParameterType ;
          hexplain:requiredParameter true ; hexplain:minimumValue 1 ; hexplain:maximumValue 536870848 ] ,
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "rows" ; hexplain:parameterType hexplain:IntegerParameterType ;
          hexplain:requiredParameter true ; hexplain:minimumValue 0 ] ,
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "fillOrder" ; hexplain:parameterType hexplain:IntegerParameterType ;
          hexplain:defaultValue 1 ; hexplain:allowedValue 1, 2 ] ,
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "rowAlignment" ; hexplain:parameterType hexplain:IntegerParameterType ;
          hexplain:defaultValue 8 ; hexplain:allowedValue 8, 16 ] ] .
menc:CCITTGroup3 hexplain:codecContract [ a hexplain:CodecContract ; hexplain:contractVersion 1 ; hexplain:vectorSuiteVersion 1 ;
    hexplain:codecKind hexplain:BytesToBytes ; hexplain:keepsSession true ; hexplain:raisesCategory "Validation", "ResourceLimit" ;
    hexplain:declaresParameter
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "columns" ; hexplain:parameterType hexplain:IntegerParameterType ;
          hexplain:requiredParameter true ; hexplain:minimumValue 1 ; hexplain:maximumValue 536870848 ] ,
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "rows" ; hexplain:parameterType hexplain:IntegerParameterType ;
          hexplain:requiredParameter true ; hexplain:minimumValue 0 ] ,
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "options" ; hexplain:parameterType hexplain:IntegerParameterType ;
          hexplain:defaultValue 0 ; hexplain:minimumValue 0 ] ,
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "fillOrder" ; hexplain:parameterType hexplain:IntegerParameterType ;
          hexplain:defaultValue 1 ; hexplain:allowedValue 1, 2 ] ,
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "noEol" ; hexplain:parameterType hexplain:IntegerParameterType ;
          hexplain:defaultValue 0 ; hexplain:allowedValue 0, 1 ] ] .
menc:CCITTGroup4 hexplain:codecContract [ a hexplain:CodecContract ; hexplain:contractVersion 1 ; hexplain:vectorSuiteVersion 1 ;
    hexplain:codecKind hexplain:BytesToBytes ; hexplain:keepsSession true ; hexplain:raisesCategory "Validation", "ResourceLimit" ;
    hexplain:declaresParameter
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "columns" ; hexplain:parameterType hexplain:IntegerParameterType ;
          hexplain:requiredParameter true ; hexplain:minimumValue 1 ; hexplain:maximumValue 536870848 ] ,
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "rows" ; hexplain:parameterType hexplain:IntegerParameterType ;
          hexplain:requiredParameter true ; hexplain:minimumValue 0 ] ,
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "options" ; hexplain:parameterType hexplain:IntegerParameterType ;
          hexplain:defaultValue 0 ; hexplain:minimumValue 0 ] ,
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "fillOrder" ; hexplain:parameterType hexplain:IntegerParameterType ;
          hexplain:defaultValue 1 ; hexplain:allowedValue 1, 2 ] ] .
menc:NeXT hexplain:codecContract [ a hexplain:CodecContract ; hexplain:contractVersion 1 ; hexplain:vectorSuiteVersion 1 ;
    hexplain:codecKind hexplain:BytesToBytes ; hexplain:keepsSession false ; hexplain:raisesCategory "Validation", "ResourceLimit" ;
    hexplain:declaresParameter
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "columns" ; hexplain:parameterType hexplain:IntegerParameterType ;
          hexplain:requiredParameter true ; hexplain:minimumValue 1 ] ,
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "rowBytes" ; hexplain:parameterType hexplain:IntegerParameterType ;
          hexplain:requiredParameter true ; hexplain:minimumValue 1 ] ,
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "rows" ; hexplain:parameterType hexplain:IntegerParameterType ;
          hexplain:requiredParameter true ; hexplain:minimumValue 0 ] ] .
menc:ThunderScan hexplain:codecContract [ a hexplain:CodecContract ; hexplain:contractVersion 1 ; hexplain:vectorSuiteVersion 1 ;
    hexplain:codecKind hexplain:BytesToBytes ; hexplain:keepsSession false ; hexplain:raisesCategory "Validation", "ResourceLimit" ;
    hexplain:declaresParameter
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "columns" ; hexplain:parameterType hexplain:IntegerParameterType ;
          hexplain:requiredParameter true ; hexplain:minimumValue 1 ] ,
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "rowBytes" ; hexplain:parameterType hexplain:IntegerParameterType ;
          hexplain:requiredParameter true ; hexplain:minimumValue 1 ] ,
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "rows" ; hexplain:parameterType hexplain:IntegerParameterType ;
          hexplain:requiredParameter true ; hexplain:minimumValue 0 ] ] .
menc:FloatingPointPredictor hexplain:codecContract [ a hexplain:CodecContract ; hexplain:contractVersion 1 ; hexplain:vectorSuiteVersion 1 ;
    hexplain:codecKind hexplain:BytesToBytes ; hexplain:keepsSession false ; hexplain:raisesCategory "Validation", "ResourceLimit" ;
    hexplain:declaresParameter
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "elementSize" ; hexplain:parameterType hexplain:IntegerParameterType ;
          hexplain:requiredParameter true ; hexplain:allowedValue 2, 3, 4, 8 ] ,
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "samplesPerPixel" ; hexplain:parameterType hexplain:IntegerParameterType ;
          hexplain:defaultValue 1 ; hexplain:minimumValue 1 ] ,
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "rowBytes" ; hexplain:parameterType hexplain:IntegerParameterType ;
          hexplain:defaultValue 0 ; hexplain:minimumValue 0 ] ,
        [ a hexplain:CodecParameterSpec ; hexplain:parameterKey "littleEndian" ; hexplain:parameterType hexplain:IntegerParameterType ;
          hexplain:defaultValue 1 ; hexplain:allowedValue 0, 1 ] ] .
menc:BitReverse hexplain:codecContract [ a hexplain:CodecContract ; hexplain:contractVersion 1 ; hexplain:vectorSuiteVersion 1 ;
    hexplain:codecKind hexplain:BytesToBytes ; hexplain:keepsSession false ; hexplain:raisesCategory "ResourceLimit" ] .

