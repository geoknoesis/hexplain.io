# Hexplain Core Ontology 1.0 — vocabulary + SHACL shapes
# Properties declare rdfs:range; domain and cardinality are in SHACL (no rdfs:domain).
@prefix :         <https://hexplain.io/ns/core#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix bddo:     <https://hexplain.io/ns/bddo#> .
@prefix dlv:      <https://hexplain.io/ns/dlv#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix vann:     <http://purl.org/vocab/vann/> .

<https://hexplain.io/ns/core> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/core/1.0> ; owl:versionInfo "1.0" ;
    owl:imports <https://hexplain.io/ns/bddo> , <https://hexplain.io/ns/dlv> ;
    rdfs:label "Hexplain Core Ontology" ;
    rdfs:comment "Properties linking the physical, layout, and semantic layers of the Hexplain framework." ;
    dcterms:created "2025-08-16"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "hexplain" ; vann:preferredNamespaceUri "https://hexplain.io/ns/core#" .

:MappingRule a owl:Class ; rdfs:label "Mapping Rule" ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "A rule for conditionally mapping a physical field to a semantic property." .
:ClassMappingRule a owl:Class ; rdfs:label "Class Mapping Rule" ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "A rule selecting the owl:Class a bddo:Struct represents based on a discriminator condition; used in a hexplain:hasConditionalClassMapping list to model tagged unions / variant records." .

# Mapping properties (OWL 2 punning; domain in SHACL). rdfs:range declared.
:mapsToClass a owl:ObjectProperty ; rdfs:label "maps to class" ; rdfs:range owl:Class ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "Relates a bddo:Struct to the owl:Class it physically represents." .
:mapsToProperty a owl:ObjectProperty ; rdfs:label "maps to property" ; rdfs:range rdf:Property ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "Relates a bddo:Field to the rdf:Property it supplies a value for." .
:hasDataLayout a owl:ObjectProperty ; rdfs:label "has data layout" ; rdfs:range dlv:DataLayout ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "Relates a bddo:Field to a dlv:DataLayout describing its multi-dimensional interpretation." .
:isEncodedWith a owl:ObjectProperty ; rdfs:label "is encoded with" ; rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The algorithm needed to interpret a data block, drawn from whichever codec or compression register the profile binds. A processor decodes the block, then re-parses the decoded bytes against the field's data type when it is a bddo:Struct." .
# ---------- Encoding pipelines ----------
# One codec is the exception, not the rule. A TIFF strip is horizontally differenced and
# then deflated; an HDF5 dataset runs a filter pipeline (shuffle, then deflate); a Zarr
# array chains delta into Blosc, itself parameterised by an inner codec, a shuffle mode and
# a level; a Parquet page is dictionary- or run-length-encoded before Snappy. With a single
# unparameterised codec, all of these could say only the last step and lost both the earlier
# ones and every setting -- enough to identify the compression but never enough to undo it.
#
# ORDER IS ENCODE ORDER: the steps as the writer applied them, so a reader inverts them in
# REVERSE. Stating this matters, because a pipeline read the wrong way round is still a
# plausible-looking pipeline; TIFF's difference-then-deflate inverts to inflate-then-undifference.
:EncodingStep a owl:Class ; rdfs:label "Encoding Step" ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "One stage of an encoding pipeline: a codec, plus the parameters it was applied with." .
:CodecParameter a owl:Class ; rdfs:label "Codec Parameter" ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "A named setting of a codec. Deliberately a name/value pair rather than a fixed vocabulary: codec options are open-ended and vendor-specific, and enumerating them would date immediately." .
:hasEncodingStep a owl:ObjectProperty ; rdfs:label "has encoding step" ; rdfs:range rdf:List ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "Ordered rdf:List of EncodingStep, in the order the ENCODER applied them; a decoder inverts them in reverse. Mutually exclusive with hexplain:isEncodedWith, which remains the shorthand for a single unparameterised codec." .
:codec a owl:ObjectProperty ; rdfs:label "codec" ; rdfs:range skos:Concept ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The algorithm this step applies, drawn from whichever codec or compression register the profile binds -- the same registers hexplain:isEncodedWith draws on." .
:codecParameter a owl:ObjectProperty ; rdfs:label "codec parameter" ; rdfs:range :CodecParameter ; rdfs:isDefinedBy <https://hexplain.io/ns/core> .
:parameterName a owl:DatatypeProperty ; rdfs:label "parameter name" ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The setting's name as the codec itself names it: \"clevel\", \"shuffle\", \"predictor\"." .
:parameterValue a owl:DatatypeProperty ; rdfs:label "parameter value" ; rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The setting's value, as the literal the format carries. Left untyped: a level is an integer, a Blosc inner codec a string, a flag a boolean." .

:hasConditionalMapping a owl:ObjectProperty ; rdfs:label "has conditional mapping" ; rdfs:range rdf:List ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> .
:condition a owl:DatatypeProperty ; rdfs:label "condition" ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> .
:semanticProperty a owl:ObjectProperty ; rdfs:label "semantic property" ; rdfs:range rdf:Property ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> .
:valueExpression a owl:DatatypeProperty ; rdfs:label "value expression" ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "A HEL expression computing the value to emit for the mapped property instead of the field's raw parsed value (e.g. fixed-point or unit scaling). Evaluated in the field's context." .
:valueDatatype a owl:ObjectProperty ; rdfs:label "value datatype" ; rdfs:range rdfs:Datatype ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The xsd datatype of a computed hexplain:valueExpression result; defaults to the natural datatype of the HEL result type." .

# Object-valued edges: the mapped triple's object is an IRI, not a literal.
:mapsToObjectProperty a owl:ObjectProperty ; rdfs:label "maps to object property" ; rdfs:range owl:ObjectProperty ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "Relates a bddo:Field to the owl:ObjectProperty whose object is an IRI rather than a literal: the resource minted for a nested Struct instance (when the field's bddo:dataType is a bddo:Struct) or the field's enumeration symbol IRI (when it carries a bddo:enumeration whose bddo:enumSymbol values are IRIs). Use hexplain:mapsToProperty for literal-valued fields and this property for IRI-valued edges, so that a described format yields a connected RDF graph rather than isolated literals." .

# Conditional class mapping (tagged unions / variant records).
:hasConditionalClassMapping a owl:ObjectProperty ; rdfs:label "has conditional class mapping" ; rdfs:range rdf:List ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "Ordered rdf:List of hexplain:ClassMappingRule on a bddo:Struct. The class the Struct maps to is the hexplain:semanticClass of the first rule whose hexplain:condition holds — modelling tagged unions and variant records, where a record's type depends on a discriminator field. Mutually exclusive with hexplain:mapsToClass." .
:semanticClass a owl:ObjectProperty ; rdfs:label "semantic class" ; rdfs:range owl:Class ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The owl:Class selected by a hexplain:ClassMappingRule when its condition holds." .

# Unit of measure and language tag annotations.
:unit a owl:ObjectProperty ; rdfs:label "unit" ; rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The unit of measure of the quantity a bddo:Field carries, as an IRI drawn from a unit vocabulary (e.g. QUDT or UCUM; the range is skos:Concept but any unit IRI is permitted). Annotation only: it records the physical unit of the emitted value and does not rescale it — use hexplain:valueExpression for numeric conversion." .
:language a owl:DatatypeProperty ; rdfs:label "language" ; rdfs:range xsd:language ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "A fixed BCP-47 language tag applied to the string literal emitted for a bddo:Field, producing a language-tagged literal. Mutually exclusive with hexplain:languageFromField." .
:languageFromField a owl:ObjectProperty ; rdfs:label "language from field" ; rdfs:range bddo:Field ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The bddo:Field whose parsed string value supplies the BCP-47 language tag for this field's emitted string literal, for formats that carry a text run's language in a sibling field. Mutually exclusive with hexplain:language." .

#################### Register bindings ####################
# A profile states which controlled register supplies the values of a property whose range is
# skos:Concept. Aspects deliberately do NOT import registers -- that absence is what makes a
# register swappable -- so the binding is declared here, per profile, and enforced by
# hexplain:RegisterBindingShape.
hexplain:RegisterBinding a owl:Class ; rdfs:label "register binding" ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "A statement that one property draws its values from one controlled register." .
hexplain:usesRegister a owl:ObjectProperty ; rdfs:label "uses register" ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ; rdfs:range hexplain:RegisterBinding ;
    rdfs:comment "Binds a property used by this profile to the register supplying its values." .
hexplain:forProperty a owl:ObjectProperty ; rdfs:label "for property" ; rdfs:range rdf:Property ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:comment "The property being bound." .
hexplain:register a owl:ObjectProperty ; rdfs:label "register" ;
    rdfs:isDefinedBy <https://hexplain.io/ns/core> ;
    rdfs:range skos:ConceptScheme ;
    rdfs:comment "The skos:ConceptScheme whose members are the permitted values." .

# ---------- SHACL ----------
hexplain:MapsToClassShape a sh:NodeShape ;
    sh:targetSubjectsOf hexplain:mapsToClass ;
    sh:class bddo:Struct ;
    sh:property [ sh:path hexplain:mapsToClass ; sh:nodeKind sh:IRI ; sh:class owl:Class ] .
hexplain:MapsToPropertyShape a sh:NodeShape ;
    sh:targetSubjectsOf hexplain:mapsToProperty ;
    sh:class bddo:Field ;
    sh:property [ sh:path hexplain:mapsToProperty ; sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class rdf:Property ] [ sh:class owl:DatatypeProperty ]
                [ sh:class owl:ObjectProperty ] [ sh:class owl:AnnotationProperty ] ) ] .
hexplain:HasDataLayoutShape a sh:NodeShape ;
    sh:targetSubjectsOf hexplain:hasDataLayout ;
    sh:class bddo:Field ;
    sh:property [ sh:path hexplain:hasDataLayout ; sh:class dlv:DataLayout ; sh:maxCount 1 ] .
hexplain:IsEncodedWithShape a sh:NodeShape ;
    sh:targetSubjectsOf hexplain:isEncodedWith ;
    sh:property [ sh:path hexplain:isEncodedWith ; sh:nodeKind sh:IRI ; sh:class skos:Concept ; sh:maxCount 1 ] ;
    # A block is encoded one way or the other: a single shorthand codec, or a pipeline.
    sh:not [ sh:and ( [ sh:property [ sh:path hexplain:isEncodedWith ; sh:minCount 1 ] ]
                      [ sh:property [ sh:path hexplain:hasEncodingStep ; sh:minCount 1 ] ] ) ] .

hexplain:EncodingPipelineShape a sh:NodeShape ;
    sh:targetSubjectsOf hexplain:hasEncodingStep ;
    sh:property [ sh:path hexplain:hasEncodingStep ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "hexplain:hasEncodingStep must point to a single rdf:List." ] ;
    sh:property [ sh:path ( hexplain:hasEncodingStep [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:class hexplain:EncodingStep ;
        sh:message "Every member of a hasEncodingStep list must be a hexplain:EncodingStep." ] .

hexplain:EncodingStepShape a sh:NodeShape ;
    sh:targetClass hexplain:EncodingStep ;
    sh:property [ sh:path hexplain:codec ; sh:nodeKind sh:IRI ; sh:class skos:Concept ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "An encoding step must name exactly one codec." ] ;
    sh:property [ sh:path hexplain:codecParameter ; sh:class hexplain:CodecParameter ] .

# A parameter without both halves says nothing.
hexplain:CodecParameterShape a sh:NodeShape ;
    sh:targetClass hexplain:CodecParameter ;
    sh:property [ sh:path hexplain:parameterName ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path hexplain:parameterValue ; sh:minCount 1 ; sh:maxCount 1 ] .
hexplain:ValueExpressionShape a sh:NodeShape ;
    sh:targetSubjectsOf hexplain:valueExpression ;
    # A Field computes one value; a MappingRule computes the value for the arm it belongs to.
    # The second was rejected until now, which made conditional mapping able to choose the
    # PROPERTY per condition but never the VALUE -- so a field meaning different things under
    # different discriminators could name the right property and then emit the raw bytes into
    # it. NITF's IGEOLO is the case: 60 characters that are decimal degrees, degrees-minutes-
    # seconds, UTM or MGRS depending on ICORDS, and only the first two are even the same
    # quantity.
    sh:or ( [ sh:class bddo:Field ] [ sh:class hexplain:MappingRule ] ) ;
    sh:property [ sh:path hexplain:valueExpression ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path hexplain:valueDatatype ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] .
hexplain:HasConditionalMappingShape a sh:NodeShape ;
    sh:targetSubjectsOf hexplain:hasConditionalMapping ;
    sh:class bddo:Field ;
    sh:property [ sh:path ( hexplain:hasConditionalMapping [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:class hexplain:MappingRule ;
        sh:message "Every member of a hasConditionalMapping list must be a hexplain:MappingRule." ] .
hexplain:MappingRuleShape a sh:NodeShape ;
    sh:targetClass hexplain:MappingRule ;
    sh:property [ sh:path hexplain:condition ; sh:nodeKind sh:Literal ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path hexplain:semanticProperty ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:or ( [ sh:class rdf:Property ] [ sh:class owl:DatatypeProperty ]
                [ sh:class owl:ObjectProperty ] [ sh:class owl:AnnotationProperty ] ) ] ;
    # Optional: absent means the arm emits the field's parsed value unchanged.
    sh:property [ sh:path hexplain:valueExpression ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path hexplain:valueDatatype ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] .
hexplain:MapsToObjectPropertyShape a sh:NodeShape ;
    sh:targetSubjectsOf hexplain:mapsToObjectProperty ;
    sh:class bddo:Field ;
    sh:property [ sh:path hexplain:mapsToObjectProperty ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:or ( [ sh:class rdf:Property ] [ sh:class owl:ObjectProperty ] ) ] .
hexplain:HasConditionalClassMappingShape a sh:NodeShape ;
    sh:targetSubjectsOf hexplain:hasConditionalClassMapping ;
    sh:class bddo:Struct ;
    sh:property [ sh:path hexplain:mapsToClass ; sh:maxCount 0 ;
        sh:message "hexplain:mapsToClass and hexplain:hasConditionalClassMapping are mutually exclusive." ] ;
    sh:property [ sh:path ( hexplain:hasConditionalClassMapping [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:class hexplain:ClassMappingRule ;
        sh:message "Every member of a hasConditionalClassMapping list must be a hexplain:ClassMappingRule." ] .
hexplain:ClassMappingRuleShape a sh:NodeShape ;
    sh:targetClass hexplain:ClassMappingRule ;
    sh:property [ sh:path hexplain:condition ; sh:nodeKind sh:Literal ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path hexplain:semanticClass ; sh:nodeKind sh:IRI ; sh:class owl:Class ; sh:minCount 1 ; sh:maxCount 1 ] .
hexplain:UnitShape a sh:NodeShape ;
    sh:targetSubjectsOf hexplain:unit ;
    sh:class bddo:Field ;
    sh:property [ sh:path hexplain:unit ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] .
hexplain:LanguageShape a sh:NodeShape ;
    sh:targetSubjectsOf hexplain:language ;
    sh:class bddo:Field ;
    sh:property [ sh:path hexplain:language ; sh:datatype xsd:language ; sh:maxCount 1 ] ;
    sh:property [ sh:path hexplain:languageFromField ; sh:maxCount 0 ;
        sh:message "hexplain:language and hexplain:languageFromField are mutually exclusive." ] .
hexplain:LanguageFromFieldShape a sh:NodeShape ;
    sh:targetSubjectsOf hexplain:languageFromField ;
    sh:class bddo:Field ;
    sh:property [ sh:path hexplain:languageFromField ; sh:class bddo:Field ; sh:maxCount 1 ] .

hexplain:_prefixes sh:declare
    [ sh:prefix "hexplain" ; sh:namespace "https://hexplain.io/ns/core#"^^xsd:anyURI ] ,
    [ sh:prefix "skos" ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ] .

# One shape enforces EVERY hexplain:usesRegister declaration, so adding a binding needs no new
# shape and no generated artifact. Targets exactly those nodes that use a bound property.
hexplain:RegisterBindingShape a sh:NodeShape ;
    sh:target [ a sh:SPARQLTarget ;
        sh:prefixes hexplain:_prefixes ;
        sh:select """SELECT ?this WHERE {
            ?binding hexplain:forProperty ?p .
            ?this ?p ?v .
        }""" ] ;
    sh:sparql [
        sh:message "Value {?value} of {?p} is not skos:inScheme the declared register {?scheme}." ;
        sh:prefixes hexplain:_prefixes ;
        sh:select """SELECT $this ?p ?value ?scheme WHERE {
            ?binding hexplain:forProperty ?p ; hexplain:register ?scheme .
            $this ?p ?value .
            FILTER NOT EXISTS { ?value skos:inScheme ?scheme }
        }""" ] .

