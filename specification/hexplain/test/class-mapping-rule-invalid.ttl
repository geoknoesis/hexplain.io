# A conditional class mapping must still choose a class: a property is neither owl:Class nor rdfs:Class.
# expect: ex:NameRule hexplain:ClassMappingRuleShape sh:OrConstraintComponent
# expect-only
@prefix ex:    <https://hexplain.io/test/class-mapping-rule-invalid#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix bddo:  <https://hexplain.io/ns/bddo#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .

ex:name a rdf:Property .
ex:Record a bddo:Struct ; hexplain:hasConditionalClassMapping ( ex:NameRule ) .
ex:NameRule a hexplain:ClassMappingRule ; hexplain:condition "true" ; hexplain:semanticClass ex:name .
