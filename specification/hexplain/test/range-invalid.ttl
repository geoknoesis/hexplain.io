# Physical extents of lifted resources: an offset cannot be negative and a length is a number.
# expect: ex:Neg hexplain:RangeDatatypeShape sh:MinInclusiveConstraintComponent
# expect: ex:Text hexplain:RangeDatatypeShape sh:NodeConstraintComponent
@prefix ex:    <https://hexplain.io/test/range-invalid#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .

ex:Neg hexplain:byteOffset -5 ; hexplain:byteLength 4 .
ex:Text hexplain:byteOffset 0 ; hexplain:byteLength "abc" .
