# Zero offsets and lengths are values of xsd:nonNegativeInteger.
@prefix ex:    <https://hexplain.io/test/range-valid#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix hexplain: <https://hexplain.io/ns/core#> .

ex:R hexplain:byteOffset 0 ; hexplain:byteLength "0"^^xsd:unsignedLong .
