# expect-only
# expect: ex:strayDocument hexplain:RegisterBindingShape sh:SPARQLConstraintComponent
# expect: ex:oldDocument hexplain:RegisterDeprecatedValueShape sh:SPARQLConstraintComponent
@prefix hexplain: <https://hexplain.io/ns/core#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix ex:       <https://example.org/ex#> .
@prefix reg:      <https://example.org/reg#> .

# One marking property drawing on two registers, bound once per register (a US profile and a
# NATO profile): a value is valid when it is in ANY scheme bound to the property.
reg:UsScheme a skos:ConceptScheme .
reg:NatoScheme a skos:ConceptScheme .
reg:Secret a skos:Concept ; skos:inScheme reg:UsScheme .
reg:NatoSecret a skos:Concept ; skos:inScheme reg:NatoScheme .
<https://example.org/us-profile> hexplain:usesRegister
    [ a hexplain:RegisterBinding ; hexplain:forProperty ex:classification ; hexplain:register reg:UsScheme ] .
<https://example.org/nato-profile> hexplain:usesRegister
    [ a hexplain:RegisterBinding ; hexplain:forProperty ex:classification ; hexplain:register reg:NatoScheme ] .

# In neither bound scheme.
reg:Elsewhere a skos:Concept .
ex:strayDocument ex:classification reg:Elsewhere .
# In a bound scheme, but retired: legal for old data, reported as a warning.
reg:OldSecret a skos:Concept ; skos:inScheme reg:UsScheme ; owl:deprecated true ;
    hexplain:status hexplain:statusSuperseded ; dcterms:isReplacedBy reg:Secret ;
    skos:historyNote "Replaced by reg:Secret."@en .
ex:oldDocument ex:classification reg:OldSecret .
