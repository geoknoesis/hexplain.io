# expect: ex:C-Orphan conf:ConstraintShape sh:NodeKindConstraintComponent
# expect: ex:C-Orphan conf:ConstraintShape sh:OrConstraintComponent
# expect: ex:C-Orphan conf:ConstraintShape sh:MinCountConstraintComponent
@prefix conf: <https://hexplain.io/ns/conf#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix ex:   <https://example.org/nitf#> .

ex:C-Orphan a conf:Constraint ;
    conf:scope [ ] ;
    conf:assertion "FHDR == 'NITF'" ;
    conf:message "FHDR must be 'NITF'." .
