# Hexplain Network Protocol Vocabulary (NPV) 1.3 — vocabulary + SHACL shapes
@prefix :       <https://hexplain.io/ns/net#> .
@prefix npv:    <https://hexplain.io/ns/net#> .
@prefix anet:   <https://hexplain.io/ns/aspect/networkflow#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .

<https://hexplain.io/ns/net> a owl:Ontology ;
    owl:versionIRI <https://hexplain.io/ns/net/1.3> ; owl:versionInfo "1.3" ;
    owl:priorVersion <https://hexplain.io/ns/net/1.2> ;
    dcterms:modified "2026-09-27"^^xsd:date ;
    owl:imports <https://hexplain.io/ns/aspect/networkflow> ;
    rdfs:label "Hexplain Network Protocol Vocabulary (NPV)"@en ;
    rdfs:comment "Semantic vocabulary for network-protocol fields."@en ;
    dcterms:created "2025-08-16"^^xsd:date ; dcterms:creator <https://geoknoesis.com> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "npv" ; vann:preferredNamespaceUri "https://hexplain.io/ns/net#" .

:Packet a owl:Class ; rdfs:label "Packet"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/net> .
:EthernetFrame a owl:Class ; rdfs:subClassOf :Packet ; rdfs:label "Ethernet Frame"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/net> .
:IPv4Packet a owl:Class ; rdfs:subClassOf :Packet ; rdfs:label "IPv4 Packet"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/net> .
:IPv6Packet a owl:Class ; rdfs:subClassOf :Packet ; rdfs:label "IPv6 Packet"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/net> .
:TCPSegment a owl:Class ; rdfs:subClassOf :Packet ; rdfs:label "TCP Segment"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/net> .
:UDPDatagram a owl:Class ; rdfs:subClassOf :Packet ; rdfs:label "UDP Datagram"@en ; rdfs:isDefinedBy <https://hexplain.io/ns/net> .

# Protocol addressing/flow properties are the networkflow aspect (anet:), imported above.

# ---------- SHACL ----------
npv:AddressShape a sh:NodeShape ; sh:targetSubjectsOf anet:sourceAddress, anet:destinationAddress ;
    sh:property [ sh:path anet:sourceAddress ; sh:datatype xsd:string ; sh:maxCount 1 ;
        sh:message "anet:sourceAddress takes at most one value; each is an xsd:string literal." ] ;
    sh:property [ sh:path anet:destinationAddress ; sh:datatype xsd:string ; sh:maxCount 1 ;
        sh:message "anet:destinationAddress takes at most one value; each is an xsd:string literal." ] .
npv:PortShape a sh:NodeShape ; sh:targetSubjectsOf anet:sourcePort, anet:destinationPort ;
    sh:property [ sh:path anet:sourcePort ; sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:short ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:unsignedByte ] ) ; sh:minInclusive 0 ; sh:maxInclusive 65535 ; sh:maxCount 1 ;
        sh:message "anet:sourcePort takes at most one value; each is an integer (of any XSD integer datatype) at least 0, at most 65535." ] ;
    sh:property [ sh:path anet:destinationPort ; sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:short ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:unsignedByte ] ) ; sh:minInclusive 0 ; sh:maxInclusive 65535 ; sh:maxCount 1 ;
        sh:message "anet:destinationPort takes at most one value; each is an integer (of any XSD integer datatype) at least 0, at most 65535." ] .
npv:TcpShape a sh:NodeShape ; sh:targetSubjectsOf anet:sequenceNumber, anet:acknowledgmentNumber, anet:tcpFlags ;
    sh:property [ sh:path anet:sequenceNumber ; sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:short ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:unsignedByte ] ) ; sh:minInclusive 0 ; sh:maxInclusive 4294967295 ; sh:maxCount 1 ;
        sh:message "anet:sequenceNumber takes at most one value; each is an integer (of any XSD integer datatype) at least 0, at most 4294967295." ] ;
    sh:property [ sh:path anet:acknowledgmentNumber ; sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:positiveInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ] [ sh:datatype xsd:short ] [ sh:datatype xsd:byte ] [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:unsignedInt ] [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:unsignedByte ] ) ; sh:minInclusive 0 ; sh:maxInclusive 4294967295 ; sh:maxCount 1 ;
        sh:message "anet:acknowledgmentNumber takes at most one value; each is an integer (of any XSD integer datatype) at least 0, at most 4294967295." ] ;
    sh:property [ sh:path anet:tcpFlags ; sh:datatype xsd:hexBinary ; sh:maxCount 1 ;
        sh:message "anet:tcpFlags takes at most one value; each is an xsd:hexBinary literal." ] .

# BEGIN GENERATED TERM DOCUMENTATION
# Editorial annotations only; OWL axioms and SHACL constraints above are unchanged.
@prefix npv: <https://hexplain.io/ns/net#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://hexplain.io/ns/net> skos:scopeNote "Use for protocol data units. Protocol-specific wire interpretation remains in the format profile; networkflow supplies shared endpoint and sequence metadata."@en .
npv:AddressShape rdfs:label "Address Shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/net> ;
    skos:definition "Applies to subjects using anet:destinationAddress, anet:sourceAddress. anet:destinationAddress takes at most one value; each is an xsd:string literal. anet:sourceAddress takes at most one value; each is an xsd:string literal."@en .
npv:EthernetFrame skos:definition "A link-layer frame represented according to an Ethernet format profile."@en .
npv:IPv4Packet skos:definition "A network-layer packet represented according to an Internet Protocol version 4 profile."@en .
npv:IPv6Packet skos:definition "A network-layer packet represented according to an Internet Protocol version 6 profile."@en .
npv:Packet skos:definition "A protocol data unit represented as a semantic network resource; protocol-specific interpretation is supplied by its type and profile."@en .
npv:PortShape rdfs:label "Port Shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/net> ;
    skos:definition "Applies to subjects using anet:destinationPort, anet:sourcePort. anet:destinationPort takes at most one value; each is an integer (of any XSD integer datatype) at least 0, at most 65535. anet:sourcePort takes at most one value; each is an integer (of any XSD integer datatype) at least 0, at most 65535."@en .
npv:TCPSegment skos:definition "A transport-layer protocol data unit represented according to a TCP profile."@en .
npv:TcpShape rdfs:label "Tcp Shape"@en ;
    rdfs:isDefinedBy <https://hexplain.io/ns/net> ;
    skos:definition "Applies to subjects using anet:acknowledgmentNumber, anet:sequenceNumber, anet:tcpFlags. anet:acknowledgmentNumber takes at most one value; each is an integer (of any XSD integer datatype) at least 0, at most 4294967295. anet:sequenceNumber takes at most one value; each is an integer (of any XSD integer datatype) at least 0, at most 4294967295. anet:tcpFlags takes at most one value; each is an xsd:hexBinary literal."@en .
npv:UDPDatagram skos:definition "A transport-layer protocol data unit represented according to a UDP profile."@en .
